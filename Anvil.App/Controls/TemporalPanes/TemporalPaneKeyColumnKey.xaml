<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalPaneKeyColumnKey — ONE LAYER KEY of a minimized temporal pane (TemporalPaneKeyColumn): an ICON ONLY, no text.

      ┌────┐
      │ ◇  │  32 × 30 — exactly an expander header's frame (SectionHeaderHeight 28 + its 1 px border × 2), so the keys
      └────┘  stand on the rows' pitch (Spacing 8 in the column)
        ON      = raised face (SectionHeaderBackground) + accent icon
        PARTIAL = ON with the icon at 55% — some of the section's types (the header box's [-])
        OFF     = no face, secondary icon
        hover   = the header's PointerOver wash; pressed = its Lifted wash

     CLICK (or Enter / Space) = the layer's show/hide — the HEADER BOX's own click (TemporalPaneKeyColumnItem.Toggle).
     RIGHT-CLICK (or Shift+F10 / the Menu key — ContextRequested) = the OPACITY ROW, a windowed flyout to the key's right:

      ┌────┬──────────────────────────────────────────┐
      │ ◇  │ Radar            ─────────●──────   85%  │  ← one 28 px row, the header's columns: name 122 · slider · % 40
      └────┴──────────────────────────────────────────┘

     ⚠️ AUTO-HIDE (the user's call, 2026-11-21): the row closes 3 s after it opens, or 3 s after the pointer AND focus
     leave it; while either is in it, it stays. A click elsewhere still closes it at once (light dismiss).
     ⚠️ The slider is the header slider's VALUE (Item.Opacity → DragMoveLayerExpander.OpacityValue, two-way to the VM) —
     never a second copy of the number.
     ⚠️ Brushes are {ThemeResource} in VISUAL STATES (LayerStates / PointerStates), never resolved in code. -->
<UserControl x:Class="Anvil.Controls.TemporalPanes.TemporalPaneKeyColumnKey"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="32" Height="30"
             IsTabStop="True" UseSystemFocusVisuals="True"
             Tapped="OnTapped" KeyDown="OnKeyDown" ContextRequested="OnContextRequested"
             PointerEntered="OnPointerEntered" PointerExited="OnPointerExited"
             PointerPressed="OnPointerPressed" PointerReleased="OnPointerReleased"
             PointerCanceled="OnPointerExited" PointerCaptureLost="OnPointerExited">

    <UserControl.Resources>
        <!-- THE OPACITY ROW (right-click). Windowed (ShouldConstrainToRootBounds false), like every flyout over the map —
             else the owned panel windows paint over it. Opaque raised face, the header's corner and hairline. -->
        <Flyout x:Name="OpacityFlyout" ShouldConstrainToRootBounds="False" Placement="RightEdgeAlignedTop"
                Opened="OnFlyoutOpened" Closed="OnFlyoutClosed">
            <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Background" Value="{ThemeResource SectionHeaderBackground}"/>
                    <Setter Property="BorderBrush" Value="{ThemeResource SectionBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Flyout.FlyoutPresenterStyle>

            <Grid x:Name="OpacityRow" Width="280" Height="{StaticResource SectionHeaderHeight}" Padding="10,0,10,0" ColumnSpacing="6"
                  Background="Transparent"
                  PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited"
                  GotFocus="OnRowGotFocus" LostFocus="OnRowLostFocus">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="122"/> <!-- the layer's name (the header's title column) -->
                    <ColumnDefinition Width="*"/>   <!-- the slider -->
                    <ColumnDefinition Width="40"/>  <!-- the readout -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{x:Bind Item.Name, Mode=OneWay, FallbackValue=''}"
                           FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                <!-- ⚠️ The same three keys as the header's slider: the stock Slider is 32 tall; this centres its 18 px thumb. -->
                <Slider x:Name="OpacityRowSlider" Grid.Column="1"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        Minimum="0" Maximum="1" StepFrequency="0.05" SmallChange="0.05" LargeChange="0.1"
                        IsThumbToolTipEnabled="False"
                        Value="{x:Bind Item.Opacity, Mode=TwoWay, FallbackValue=1}"
                        IsEnabled="{x:Bind Item.IsOpacityEnabled, Mode=OneWay, FallbackValue=False}"
                        AutomationProperties.Name="Opacity">
                    <Slider.Resources>
                        <x:Double x:Key="SliderHorizontalHeight">18</x:Double>
                        <x:Double x:Key="SliderPreContentMargin">7</x:Double>
                        <x:Double x:Key="SliderPostContentMargin">7</x:Double>
                    </Slider.Resources>
                </Slider>

                <TextBlock Grid.Column="2" Style="{StaticResource TabularNumberTextStyle}"
                           Text="{x:Bind Item.Percent, Mode=OneWay, FallbackValue=''}"
                           FontSize="{StaticResource CaptionFontSize}" TextAlignment="Right" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Flyout>
    </UserControl.Resources>

    <Grid x:Name="KeyFace" CornerRadius="4" Background="Transparent"
          ToolTipService.ToolTip="{x:Bind Item.ToolTip, Mode=OneWay, FallbackValue=''}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayerStates">
                <VisualState x:Name="On">
                    <VisualState.Setters>
                        <Setter Target="KeyFace.Background" Value="{ThemeResource SectionHeaderBackground}"/>
                        <Setter Target="KeyIcon.Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Partial">
                    <VisualState.Setters>
                        <Setter Target="KeyFace.Background" Value="{ThemeResource SectionHeaderBackground}"/>
                        <Setter Target="KeyIcon.Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <Setter Target="KeyIcon.Opacity" Value="0.55"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Off"/>
            </VisualStateGroup>
            <VisualStateGroup x:Name="PointerStates">
                <VisualState x:Name="Rest"/>
                <VisualState x:Name="Over">
                    <VisualState.Setters>
                        <Setter Target="KeyWash.Opacity" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Target="KeyWash.Opacity" Value="1"/>
                        <Setter Target="KeyWash.Background" Value="{ThemeResource SectionHeaderLiftedBackground}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Hover / press wash OVER the layer face (two groups can't both set one Background). -->
        <Border x:Name="KeyWash" CornerRadius="4" Opacity="0" Background="{ThemeResource SectionHeaderPointerOverBackground}"/>

        <!-- The icon: a stroked path on a 24 × 24 grid, drawn 16 px. Its DATA is the layer's (code-behind sets Path.Data
             from TemporalPaneKeyColumnItem.IconData); its colour is the state's. -->
        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path x:Name="KeyIcon" Width="24" Height="24"
                  StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stroke="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Viewbox>
    </Grid>
</UserControl>
