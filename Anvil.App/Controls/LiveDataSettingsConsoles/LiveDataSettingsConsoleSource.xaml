<?xml version="1.0" encoding="utf-8"?>
<!-- LiveDataSettingsConsoleSource — Settings → Live Data's "Source" section, on a Primitives/SettingsConsolePlate: WHERE the
     NowCast feeds' live updates come from. ONE source at a time (NOAA Weather Wire REPLACES IEM, the user's call 2026-10-19).

       Source  [Restore defaults]                                                                  DEFAULT
       Updates from  [ IEM live feed | NOAA Weather Wire | Polling only ]   Within seconds · no account   IEM live feed
       96            420                                                    hint (follows the pick)  150, right

     ⚠️ A Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText "live.source", whose Choices are the
     per-source hints LiveDataViewModel.SourceHint picks). Restore defaults = IEM; the Weather Wire account is KEPT. -->
<UserControl x:Class="Anvil.Controls.LiveDataSettingsConsoles.LiveDataSettingsConsoleSource"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="LiveDataSettingsConsoleSourcePlate" Title="Source" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="SourceRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    ToolTipService.ToolTip="Back to the IEM live feed (asks first). Your Weather Wire account is kept"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <prim:SettingsConsoleRow Label="Updates from" AboutKey="live.source" Default="{x:Bind ViewModel.DefaultSourceText}"
                                     Hint="{x:Bind ViewModel.SourceHint, Mode=OneWay}">
                <prim:SegmentedPicker x:Name="LiveSourcePicker"
                                      ItemsSource="{x:Bind ViewModel.SourceLabels}"
                                      SelectedIndex="{x:Bind ViewModel.SourceIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
