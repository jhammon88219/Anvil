<?xml version="1.0" encoding="utf-8"?>
<!-- DragMoveLayerExpanderTropicalBody — the "Tropical" section body (TropicalViewModel): hurricane, tropical storm, storm surge and
     extreme wind watches + warnings as forecast zones. Shown in BOTH temporal panes: live in Now, the loaded window
     in Past (counts as in effect at the displayed frame — they follow the scrubber).

     ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓   the card (DragMoveLayerExpanderHeaderCard, FLUSH under
     ▓  Tropical Storm Isaias     3 products · 76 zones ▓   the header, ONE line): the storm(s) in effect (NHC's
     ──────────────────────────────────────────────────────  ATCF names) left; how much is out right, the moment in
                                                             PastCast ("At 4:51 PM ·"); loading / failures take it
       WARNINGS
       [x] ■ Extreme wind                          0     ← one DragMoveLayerExpanderCountRow PER PRODUCT, generated
       [x] ■ Storm surge                           0       from TropicalProducts (NWS priority order); swatch = the
       [x] ■ Hurricane                             0       NWS colour; count = ZONES in effect at the FAR RIGHT; a
       [x] ■ Tropical storm                        0       zero row is DIMMED, never hidden; the tooltip is the NWS
       WATCHES                                             name + what it means
       [x] ■ Storm surge                          21
       [x] ■ Hurricane                            40
       [x] ■ Tropical storm                       15

     ⚠️ Swatches are the NWS hazard-map colours (TropicalProducts.Fill — DATA, never themed; the page reads the same
     colour from the file). ⚠️ Opacity and the heading are the HOST's DragMoveLayerExpander, as for every overlay control. -->
<UserControl x:Class="Anvil.Controls.TemporalPanes.DragMoveLayerExpanders.DragMoveLayerExpanderTropicalBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tp="using:Anvil.Controls.TemporalPanes"
             xmlns:dragMoveLayerExpanders="using:Anvil.Controls.TemporalPanes.DragMoveLayerExpanders"
             xmlns:conv="using:Anvil.Converters"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:local="using:Anvil.Controls.Composites"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>

        <!-- One product: toggle, colour, name, zones in effect (DragMoveLayerExpanderCountRow — every expander's row:
             count at the far right, hover lift). Item type: TropicalKindRow. -->
        <DataTemplate x:Key="KindRowTemplate" x:DataType="vm:TropicalKindRow">
            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="{x:Bind Label}"
                    IsChecked="{x:Bind IsShown, Mode=TwoWay}"
                    Count="{x:Bind dragMoveLayerExpanders:DragMoveLayerExpanderTropicalBody.Fmt(Count), Mode=OneWay}"
                    Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ToolTip}">
                <Border Width="11" Height="11" CornerRadius="2"
                        Background="{x:Bind Fill, Converter={StaticResource HexToBrush}}"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>
        </DataTemplate>
        <!-- The rows' spacing (4, halved 2026-10-21) — the row control carries none. -->
        <ItemsPanelTemplate x:Key="KindRowsPanel">
            <StackPanel Spacing="4"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Top">
        <!-- THE CARD, flush under the section header (DragMoveLayerExpanderHeaderCard; it brings its own 14 below). -->
        <dragMoveLayerExpanders:DragMoveLayerExpanderHeaderCard
                Headline="{x:Bind ViewModel.CardHeadline, Mode=OneWay}"
                Context="{x:Bind ViewModel.CardContext, Mode=OneWay}"
                Footer="{x:Bind ViewModel.CardFooter, Mode=OneWay}"/>

        <TextBlock Text="WARNINGS" Style="{StaticResource AtlasFieldLabelStyle}" Margin="0,0,0,6"/>
        <ItemsControl ItemsSource="{x:Bind ViewModel.Warnings}" ItemTemplate="{StaticResource KindRowTemplate}"
                      ItemsPanel="{StaticResource KindRowsPanel}"/>

        <TextBlock Text="WATCHES" Style="{StaticResource AtlasFieldLabelStyle}" Margin="0,12,0,6"/>
        <ItemsControl ItemsSource="{x:Bind ViewModel.Watches}" ItemTemplate="{StaticResource KindRowTemplate}"
                      ItemsPanel="{StaticResource KindRowsPanel}"/>
    </StackPanel>
</UserControl>
