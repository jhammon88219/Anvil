<?xml version="1.0" encoding="utf-8"?>
<!-- StorageSettingsTab — Settings → Storage (2026-11-16: + the whole Basemap page): what Anvil keeps on disk and its limits, the
     map in use and your map files, getting an offline map, and the online map.

       ┌ Disk usage  [Restore defaults] ──────────────────────────── DEFAULT ┐  StorageManagers/StorageManagerSettingsConsole
       │ 39.9 GB [📁 Open folder] · the bar (Maps first) · the table (Maps ·    │  (Maps = every map file Anvil knows; no Clear,
       │ Radar volumes · Radar diagnostics · Weather data · Logs · Your usage)  │   no limits)
       └────────────────────────────────────────────────────────────────────────┘
          12 px of the body's darker ground
       ┌ Map ───────────────────────────────────────────────────────────────── ┐  StorageSettingsConsoles/StorageSettingsConsoleMap
       │ In use · Files (Use / folder / delete-asks-inline) · Add a map file…   │
       └────────────────────────────────────────────────────────────────────────┘
       ┌ Offline map  [Restore defaults] ──────────────────────────── DEFAULT ┐  …ConsoleOfflineMap
       │ Area · Detail · Save to · File · Download (+ progress / Retry)         │
       └────────────────────────────────────────────────────────────────────────┘
       ┌ Online map ────────────────────────────────────────────────────────── ┐  …ConsoleOnlineMap
       │ Map key · Test · Use online map                                        │
       └────────────────────────────────────────────────────────────────────────┘
       (Reset all Storage settings = the window's page header, beside the title — this page's ResetAll, ISettingsPage)

     ⚠️ Every reset ASKS first. Reset all = every limit + the Offline map choices; it deletes no map file and keeps the map key.
     ⚠️ The sizes are only re-measured when this page becomes VISIBLE (MapViewModel.RefreshForSettingsTab) — it walks several
     folders, so it must not run on every Settings open. The map files are re-read on show too (BasemapSetupViewModel.Refresh:
     the folder can change from the setup window or Explorer).
     ⚠️ "Show map setup at launch" moved to General → Startup (a launch preference). The Basemap page's enum slot redirects here. -->
<UserControl x:Class="Anvil.Controls.Composites.StorageSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:storageManagers="using:Anvil.Controls.StorageManagers"
             xmlns:storageSettingsConsoles="using:Anvil.Controls.StorageSettingsConsoles"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel Spacing="12" VerticalAlignment="Top">
        <storageManagers:StorageManagerSettingsConsole x:Name="StorageManagerSettingsConsole"
                                                      ViewModel="{x:Bind ViewModel.Storage, Mode=OneWay}"/>
        <storageSettingsConsoles:StorageSettingsConsoleMap x:Name="StorageSettingsConsoleMap" ViewModel="{x:Bind ViewModel.BasemapSetup}"/>
        <storageSettingsConsoles:StorageSettingsConsoleOfflineMap x:Name="StorageSettingsConsoleOfflineMap" ViewModel="{x:Bind ViewModel.BasemapSetup}"/>
        <storageSettingsConsoles:StorageSettingsConsoleOnlineMap x:Name="StorageSettingsConsoleOnlineMap" ViewModel="{x:Bind ViewModel.BasemapSetup}"/>    </StackPanel>
</UserControl>
