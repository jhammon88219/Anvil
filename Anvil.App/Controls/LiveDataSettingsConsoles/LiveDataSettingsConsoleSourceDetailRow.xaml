<?xml version="1.0" encoding="utf-8"?>
<!-- LiveDataSettingsConsoleSourceDetailRow — ONE row of the Source plate's details table (canvas artboard 31, 2026-11-18):
     a trait (label) and its value for each of the three sources.

         How fast     │ 15–20 s …          │ Fastest …                        │ Up to each …          ← │ = a separator in the
       ┌──────────────────────────────────────────────────────────────────────────────────────────────┐   gap BEFORE each source
       │ Account        None                  Free NWS account · one computer    None                   │ ← hover = the Settings
       └──────────────────────────────────────────────────────────────────────────────────────────────┘   row hover lift; the label
         96 label     │  *  IEM            │  *  Weather Wire                 │  *  Polling             brightens, separators hide
     (canvas artboard 33, 2026-11-18)

     ⚠️ The columns MUST match the head row in LiveDataSettingsConsoleSource (96 · * · * · *, ColumnSpacing 12, the -8 bleed +
     8 padding that lets the lift reach past the text the way a SettingsConsoleRow's does).
     Not clickable: picking a source happens ONLY on the Updates from line (user's call, 2026-11-18).
     ⭐ The two sources NOT picked grey to 45% (PickedIndex ← the plate's SourceIndex, 2026-11-19): the picked column reads
     at full strength, so the table says "this is what you chose" without another mark. -->

<UserControl x:Class="Anvil.Controls.LiveDataSettingsConsoles.LiveDataSettingsConsoleSourceDetailRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             PointerEntered="OnPointerEntered" PointerExited="OnPointerLeft"
             PointerCanceled="OnPointerLeft" PointerCaptureLost="OnPointerLeft">

    <UserControl.Resources>
        <Style x:Key="DetailCellStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,7"/>
        </Style>
        <Style x:Key="DetailSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="-7,0,0,0"/>
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="DetailRowRoot" Margin="-8,0" Padding="8,0" CornerRadius="4" ColumnSpacing="12" Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="DetailRowRoot.Background" Value="{ThemeResource SettingsRowHoverBrush}"/>
                        <Setter Target="DetailRowLabel.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <Setter Target="DetailRowSeparatorIem.Visibility" Value="Collapsed"/>
                        <Setter Target="DetailRowSeparatorNwws.Visibility" Value="Collapsed"/>
                        <Setter Target="DetailRowSeparatorPolling.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SettingsLabelColumnWidth}"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The separators: 1 px in the middle of the 12 px gap BEFORE each source column (row height, so the rows' pieces
             join into one line; the head row draws its own). Hidden while this row is hovered. -->
        <Rectangle x:Name="DetailRowSeparatorIem" Grid.Column="1" Style="{StaticResource DetailSeparatorStyle}"/>
        <Rectangle x:Name="DetailRowSeparatorNwws" Grid.Column="2" Style="{StaticResource DetailSeparatorStyle}"/>
        <Rectangle x:Name="DetailRowSeparatorPolling" Grid.Column="3" Style="{StaticResource DetailSeparatorStyle}"/>

        <TextBlock x:Name="DetailRowLabel" Style="{StaticResource DetailCellStyle}" Text="{x:Bind Label, Mode=OneWay}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <!-- The sources you DIDN'T pick grey back (PickedIndex), easing over 120 ms. -->
        <TextBlock Grid.Column="1" Style="{StaticResource DetailCellStyle}" Text="{x:Bind Iem, Mode=OneWay}"
                   Opacity="{x:Bind CellOpacity(PickedIndex, 0), Mode=OneWay}">
            <TextBlock.OpacityTransition><ScalarTransition Duration="0:0:0.12"/></TextBlock.OpacityTransition>
        </TextBlock>
        <TextBlock Grid.Column="2" Style="{StaticResource DetailCellStyle}" Text="{x:Bind Nwws, Mode=OneWay}"
                   Opacity="{x:Bind CellOpacity(PickedIndex, 1), Mode=OneWay}">
            <TextBlock.OpacityTransition><ScalarTransition Duration="0:0:0.12"/></TextBlock.OpacityTransition>
        </TextBlock>
        <TextBlock Grid.Column="3" Style="{StaticResource DetailCellStyle}" Text="{x:Bind Polling, Mode=OneWay}"
                   Opacity="{x:Bind CellOpacity(PickedIndex, 2), Mode=OneWay}">
            <TextBlock.OpacityTransition><ScalarTransition Duration="0:0:0.12"/></TextBlock.OpacityTransition>
        </TextBlock>
    </Grid>
</UserControl>
