<?xml version="1.0" encoding="utf-8"?>
<!-- AboutSettingsConsoleLinkRow — one project on Settings → About → Built with (artboard 27, 2026-11-18).

       MapLibre GL JS ↗                                              the map
       └ the NAME is the link (accent text + E8A7)                   └ what it does, Caption grey, FAR RIGHT

     A click goes through AboutAnvil.OpenLink (asks first — Dialogs/LeaveAnvilDialog — unless "Don't ask again").
     No lifts: it's a link, not a setting. -->
<UserControl x:Class="Anvil.Controls.AboutSettingsConsoles.AboutSettingsConsoleLinkRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid x:Name="AboutSettingsConsoleLinkRowCells" MinHeight="32" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <HyperlinkButton x:Name="AboutSettingsConsoleLinkRowLink" Padding="0" VerticalAlignment="Center" Click="OnLinkClick"
                         ToolTipService.ToolTip="{x:Bind Url, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Style="{StaticResource BodyTextStyle}" Text="{x:Bind Title, Mode=OneWay}"/>
                <FontIcon Glyph="&#xE8A7;" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </HyperlinkButton>
        <TextBlock x:Name="AboutSettingsConsoleLinkRowWhat" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right"
                   VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind What, Mode=OneWay}"/>
    </Grid>
</UserControl>
