<?xml version="1.0" encoding="utf-8"?>
<!-- BarActivityReadout — the bar's ACTIVITY slot: what Anvil is working on right now (MapViewModel.Activity =
     BarActivityViewModel). Sits in the bar between the console and Atlas; MainWindow MEASURES its span
     (left = the tools tier's 1-pane key's left, the right section's one left edge; right = Atlas less the
     cluster's 8 px) — see AlignActivityBay.

       ╔══════════════════════════════════════════════════════════╗   ← plate: BarKeySide tall, so it lines up with
       ║  Checking radar sites  [+1]                    84 / 159  ║     Atlas top and bottom. Its BORDER is the tone:
       ║  ████████████████░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░  ║   ← main bar (a source's own fraction)
       ╚══════════════════════════════════════════════════════════╝
         border = the tone: blue = radar work · green = done flash · red = failed · grey/idle = the plain
         hairline (the coloured ring fades out in its own colour). ⚠️ The 3 px tone MARK at the left is GONE
         (2026-10-08, the user's call) — the border replaced it; text starts at the plate's 14 px inset.
         ⚠️ NO PASTCAST LOOP LINE (removed 2026-10-10): a PastCast load shows only on the gate, which can't be escaped.

       NowCast's LIVE POLL (lowest rank, EVERY poll):
       ║  Checking for a new scan                  3 of 5 chunks  ║   ← thin line = the poll's chunk download
       then, nothing newer:    No new scan    1:42:10 PM scan is the newest   (grey: hairline only)
       or a newer scan:
       ║  New scan                     1:47:12 PM scan · painting  ║   ← main bar = the build: ⅓ decoding,
       ║  ████████████████████████████████████░░░░░░░░░░░░░░░░░░░  ║     ⅔ built and waiting to be DRAWN
       ║  ───────────────────────────────────────────────────────  ║
       then   New frame · 1:47:12 PM                    Complete     ← green flash ONLY once the page drew it
                                                                       (radarPainted); holds FlashMs.
                                                                       Not drawn ("Ready" instead): scrubbed back, or
                                                                       no paint in 10 s (a minimized window draws nothing)

       NOTHING ACTIVE → the plate DIMS to 45% (IsShown false; it never disappears — "so the user always knows to
       look there") and shows the IDLE line (tone Idle, plain hairline):
       ┌──────────────────────────────────────────────────────────┐
       │  Next check in 0:18                 Scan due ~1:47:12 PM  │   ← regime-aware; fixed time: "every 30 s"
       │  Last frame: on screen 3.0 s after due                   │   ← LastFrameLine: the last live frame's paint vs
       │  ──────────────────────────────░░░░░░░░░░░░░░░░░░░░░░░░  │     the due time shown above (regime-aware only;
       └──────────────────────────────────────────────────────────┘     hidden before the first timed frame / new site)
       PastCast / no site: an EMPTY dimmed plate. No site id anywhere in the slot.

     ⚠️ The tone colours are LITERALS (BarActivityReadout.xaml.cs ToneBrush), like the gate's: never resolve a
     theme brush in C#. The blue matches the gate's built bar; green/red are the old site-check toast's. They colour the TONE BORDER and the main bar.
     ⚠️ Wording and priority live in the view model, not here. -->
<UserControl x:Class="Anvil.Controls.Composites.BarActivityReadout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid x:Name="Plate"
          Height="{StaticResource BarKeySide}"
          CornerRadius="8" BorderThickness="1"
          BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
          Background="Transparent"
          Opacity="{x:Bind PlateOpacity(ViewModel.IsShown), Mode=OneWay}"
          IsHitTestVisible="{x:Bind ViewModel.IsShown, Mode=OneWay}">
        <Grid.OpacityTransition>
            <ScalarTransition Duration="0:0:0.25"/>
        </Grid.OpacityTransition>
        <!-- ⚠️ NO HOVER DOOR (removed 2026-10-10 with the gate's escape): the slot is a readout, nothing to click. -->

        <!-- THE TONE BORDER (replaced the 3 px tone mark, 2026-10-08): a 1 px coloured ring drawn just INSIDE the plate's
             themed hairline (a child can't paint over its parent's own border, and a negative margin would be clipped by
             the rounded plate; the hairline beside it reads as part of the ring). Code-behind sets its literal brush + fades its opacity (ApplyTone) — a quiet tone
             (idle / housekeeping) fades it out WITHOUT changing the brush, so a green flash fades green, never grey. -->
        <Border x:Name="ToneBorder" CornerRadius="7" BorderThickness="1" Opacity="0"
                IsHitTestVisible="False">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.3"/>
            </Border.OpacityTransition>
        </Border>

        <StackPanel VerticalAlignment="Center" Margin="14,0,14,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="TitleText" Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                               FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Border Padding="5,0" CornerRadius="4" VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind HasText(ViewModel.QueuedText), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.QueuedText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Detail, Mode=OneWay}" FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>

            <!-- IDLE ONLY: how the last live frame did against its due time (LastFrameLine; empty = collapsed). -->
            <TextBlock Text="{x:Bind ViewModel.LastFrameLine, Mode=OneWay}" FontSize="11.5" Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind HasText(ViewModel.LastFrameLine), Mode=OneWay}"/>

            <!-- Main bar: star columns split by the fraction, so it needs no measured width. -->
            <Grid Height="5" CornerRadius="2.5" Margin="0,7,0,0"
                  Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                  Visibility="{x:Bind ViewModel.HasProgress, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind Filled(ViewModel.Progress), Mode=OneWay}"/>
                    <ColumnDefinition Width="{x:Bind Rest(ViewModel.Progress), Mode=OneWay}"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="2.5" Background="{x:Bind ToneBrush(ViewModel.Tone), Mode=OneWay}"/>
            </Grid>

            <!-- Thin line under it (the loop's downloaded). -->
            <Grid Height="2" CornerRadius="1" Margin="0,2,0,0"
                  Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                  Visibility="{x:Bind ViewModel.HasSecondary, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind Filled(ViewModel.Secondary), Mode=OneWay}"/>
                    <ColumnDefinition Width="{x:Bind Rest(ViewModel.Secondary), Mode=OneWay}"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="1" Background="#FF8A8F98"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
