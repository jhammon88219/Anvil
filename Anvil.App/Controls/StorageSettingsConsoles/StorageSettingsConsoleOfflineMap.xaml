<?xml version="1.0" encoding="utf-8"?>
<!-- StorageSettingsConsoleOfflineMap — Settings → Storage's "Offline map" section (was the Basemap page's "Download an offline
     map"), on a Primitives/SettingsConsolePlate. Over BasemapSetupViewModel — the same instance as the setup window.

       Offline map  [Restore defaults]                                                             DEFAULT
       Area      ☑ Lower 48 states            155 radars                                    Lower 48 states
                 ☐ Alaska                       7 radars   …  ☐ Canada   Radars coming soon
       Detail    [   Standard   |   Full   ]               Streets at city zoom · about 4.4 GB      Standard
       Save to   C:\Users\you\Anvil Maps        [Browse…]                                       Anvil Maps
       File      anvil-map-standard-l48.pmtiles            You already have this map — kept beside it
                 [Download]                                In the background — Anvil keeps its map until you switch
                 ▓▓▓▓▓▓░░░░░░░░░░░░░░░░░░░    [Cancel]    ← only while running
                 Step 4 of 5 · Download · 1.70 GB of 4.40 GB · 94 MB/s · about 1 minute left
                 ⚠ Your connection dropped at 1.7 GB of 4.4 GB…   [Retry]                   ← only after one stopped
       96        420                                       hint (one line)                 150, right

     ⚠️ THE COLUMNS (96 · 420 · * · 150) are the page's. The area list is Basemaps/BasemapAreaChecklist (shared with the setup
     window's offline card). Runs in the background HERE; Anvil keeps its current map until you switch. Restore defaults (asks
     first) is greyed while a download runs. Every download also carries the whole world to zoom 7 (BasemapAreas.WorldOverview). -->
<UserControl x:Class="Anvil.Controls.StorageSettingsConsoles.StorageSettingsConsoleOfflineMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:basemaps="using:Anvil.Controls.Basemaps"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="StorageSettingsConsoleOfflineMapPlate" Title="Offline map" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="OfflineMapRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    IsEnabled="{x:Bind Not(ViewModel.IsDownloading), Mode=OneWay}"
                    ToolTipService.ToolTip="The area, detail and folder back to the DEFAULT column (asks first). Your map files are kept"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <Grid ColumnSpacing="12" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- area -->
                <RowDefinition Height="Auto"/> <!-- detail -->
                <RowDefinition Height="Auto"/> <!-- save to -->
                <RowDefinition Height="Auto"/> <!-- file -->
                <RowDefinition Height="Auto"/> <!-- download -->
                <RowDefinition Height="Auto"/> <!-- progress | stopped -->
            </Grid.RowDefinitions>

            <TextBlock Margin="0,6,0,0" Text="Area"/>
            <basemaps:BasemapAreaChecklist x:Name="OfflineMapAreaChecklist" Grid.Column="1" ViewModel="{x:Bind ViewModel}"/>
            <TextBlock Grid.Column="2" Margin="0,6,0,0" VerticalAlignment="Top" Style="{StaticResource SettingsConsoleHintTextStyle}"
                       Text="The world to zoom 7 always comes too"/>
            <TextBlock Grid.Column="3" Margin="0,6,0,0" VerticalAlignment="Top" Style="{StaticResource SettingsConsoleDefaultTextStyle}"
                       Text="{x:Bind ViewModel.DefaultAreaText}"/>

            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Detail"/>
            <prim:SegmentedPicker x:Name="OfflineMapDetailPicker" Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{x:Bind ViewModel.DetailLabels}"
                                  SelectedIndex="{x:Bind ViewModel.DetailIndex, Mode=TwoWay}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="{x:Bind ViewModel.SizeSummaryText, Mode=OneWay}"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.DefaultDetailText}"/>

            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Save to"/>
            <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.SaveFolder, Mode=OneWay}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.SaveFolder, Mode=OneWay}"/>
                <Button x:Name="OfflineMapBrowseButton" Grid.Column="1" Content="Browse…" Click="OnBrowseSaveFolderClick"
                        IsEnabled="{x:Bind Not(ViewModel.IsDownloading), Mode=OneWay}"/>
            </Grid>
            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.DefaultSaveFolderText}"/>

            <!-- The exact name the download gets (BasemapFileNames): the options, plus -2, -3… beside a same-options map. -->
            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="File"/>
            <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                       TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                       Text="{x:Bind ViewModel.PlannedFileName, Mode=OneWay}"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="{x:Bind ViewModel.DuplicateNote, Mode=OneWay}"/>

            <Button x:Name="OfflineMapDownloadButton" Grid.Row="4" Grid.Column="1" Content="Download" Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanStartDownload, Mode=OneWay}" Click="{x:Bind ViewModel.StartDownload}"/>
            <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource SettingsConsoleHintTextStyle}"
                       Text="In the background — Anvil keeps its map until you switch"/>

            <!-- While a download runs (from here OR the setup window): the bar, one readout line, Cancel. -->
            <Grid x:Name="OfflineMapDownloadProgress" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="8" RowSpacing="4"
                  Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- The DOWNLOAD step's bar only (empty through the steps before it); the line names the step. -->
                <ProgressBar VerticalAlignment="Center" Maximum="100" Value="{x:Bind ViewModel.DownloadPercent, Mode=OneWay}"/>
                <Button x:Name="OfflineMapCancelButton" Grid.Column="1" Content="Cancel" Click="{x:Bind ViewModel.CancelDownload}"
                        ToolTipService.ToolTip="Stops the download. What's downloaded is kept — Download picks it up again."/>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.DownloadLineText, Mode=OneWay}"
                           FontSize="12" TextWrapping="Wrap" Style="{StaticResource TabularNumberTextStyle}"/>
            </Grid>

            <!-- A download that stopped: what happened, and Retry (it picks up what arrived). -->
            <Grid x:Name="OfflineMapDownloadFailed" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="8"
                  Visibility="{x:Bind ViewModel.IsDownloadFailed, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7BA;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FailureText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button x:Name="OfflineMapRetryButton" Grid.Column="2" Content="Retry" Click="{x:Bind ViewModel.RetryDownload}"/>
            </Grid>
        </Grid>
    </prim:SettingsConsolePlate>
</UserControl>
