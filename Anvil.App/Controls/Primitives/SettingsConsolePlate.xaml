<?xml version="1.0" encoding="utf-8"?>
<!-- SettingsConsolePlate — the CASING every Settings section wears (2026-11-16, replacing SettingsExpander on each page as it
     is redone; Dev keeps its expanders). It draws only the outside; each section's rows are its OWN named control
     (e.g. AppearanceSettingsConsoles/AppearanceSettingsConsoleEdges) that wraps itself in one of these.

       ┌─────────────────────────────────────────────────────────────────────────────┐
       │ Units     [Restore defaults]                                        DEFAULT  │ ← ONE title row (General B, 2026-11-16):
       │ Unit set  [US|Metric|Forecaster|Custom]                              Custom  │   title (28 SemiBold, line 34) in the
       │ …                                                                 ▒▒  …  ▒▒ │   LABEL column (≥ 96) · HeaderContent
       └─────────────────────────────────────────────────────────────────────▀▀▀▀▀▀▀─┘   on the CONTROL column's left edge, so
        ▒ = the DEFAULT WELL (amber wash, inset 6, radius 4) behind the column, title row to last row
        face CardBackgroundFillColorDefaultBrush · hairline SectionBorderBrush           it lines up with the control below ·
        radius 6 · padding 14,12,14,14                                                    DEFAULT far right (caution amber)

     ⚠️ Pages space plates 12 apart on the body's darker ground — the gap IS the separator (no dividers, no expanders).
     ⚠️ Never collapses. The title row's first column is the rows' LABEL column (96, column spacing 12) so HeaderContent starts
     where every row's control starts; a title wider than 96 pushes it right rather than clipping. DEFAULT is right-aligned to
     the same right edge as the rows' default column, whatever their columns. Its amber = SettingsCautionForegroundBrush: the
     column is what a reset writes. -->
<UserControl x:Class="Anvil.Controls.Primitives.SettingsConsolePlate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Border x:Name="SettingsConsolePlateSurface" CornerRadius="6" BorderThickness="1" Padding="14,12,14,14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SectionBorderBrush}">
        <Grid>
        <!-- THE DEFAULT WELL (artboard 18, 2026-11-17): the DEFAULT column's own area — a rounded well inset 6 px from the
             plate's top / right / bottom edge, a faint wash of the caution amber, no line. Negative margins reach out of the
             plate's padding (14,12,14,14 → 6 left on each side). Width = the column (150) + 8 each side, so its edges match
             the row lifts' (a row bleeds 8 past the padding). Only on plates with a DEFAULT column (ShowDefaultHeader). -->
        <Border x:Name="SettingsConsolePlateDefaultWell" HorizontalAlignment="Right" Width="{StaticResource SettingsDefaultWellWidth}"
                Margin="0,-6,-8,-8" CornerRadius="4" IsHitTestVisible="False"
                Background="{ThemeResource SettingsDefaultWellBrush}"
                Visibility="{x:Bind Show(ShowDefaultHeader), Mode=OneWay}"/>
        <StackPanel>
            <Grid x:Name="SettingsConsolePlateTitleLine" ColumnSpacing="12" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SettingsConsolePlateTitle" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold"
                           LineHeight="{StaticResource TitleLineHeight}" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"
                           Text="{x:Bind Title, Mode=OneWay}"/>
                <ContentPresenter x:Name="SettingsConsolePlateHeaderContent" Grid.Column="1" VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Content="{x:Bind HeaderContent, Mode=OneWay}"/>
                <TextBlock x:Name="SettingsConsolePlateDefaultHeader" Grid.Column="2" Text="DEFAULT" VerticalAlignment="Center"
                           FontSize="{StaticResource OverlineFontSize}" CharacterSpacing="{StaticResource OverlineCharacterSpacing}"
                           Foreground="{ThemeResource SettingsCautionForegroundBrush}"
                           Visibility="{x:Bind Show(ShowDefaultHeader), Mode=OneWay}"/>
            </Grid>

            <ContentPresenter x:Name="SettingsConsolePlateBody" Content="{x:Bind Body, Mode=OneWay}"/>
        </StackPanel>
        </Grid>
    </Border>
</UserControl>
