<?xml version="1.0" encoding="utf-8"?>
<!-- MapSettingsTab — the Map tab of the Settings window: what the BASEMAP is. One section.

       ┌──────────────────────────────────────────────────────┐
       │  ⌄  Basemap                                          │
       │    [Data Viz Black          ]                        │
       │    [ ] Use online tiles                              │  ← SOURCE, not style: the styles
       │    [https://api.protomaps…]                          │     are Protomaps-SCHEMA, so both
       │    Offline — bundled PMTiles.                        │     sources render identically
       └──────────────────────────────────────────────────────┘

     WHAT BELONGS IN THIS TAB: controls that act on the BASEMAP — what is drawn under everything, and
     where its tiles come from. What the map DRAWS on top (radar-site markers, the mile grid, the Inspect
     cursor) is the Radar tab next door. The older, wider rule still holds underneath both: nothing in
     either tab repeats per pane — a control needing a copy per pane belongs in RadarControls.

     ⚠️ IT USED TO OWN THE CAMERA TOO, and no longer does. Fit to view and Reset north went to
     Composites/MapControlsStrip; the CONUS checkbox, the "isolate a state (hover & click)" checkbox and
     the state-name combo went with them, collapsed into that strip's ONE isolation combo (No Isolation /
     Isolate CONUS / Select to Isolate / the 52 states). All of it is a GESTURE you make while reading the
     map, which is the same test that pulled Markers and Inspect out of the Radar tab; what is left here is
     a PREFERENCE you set once.
     ⚠️ So this tab is down to a single section, which is thin for a tab. That is fine for now — do NOT
     re-add the camera controls to fill it out. One control in two places is one that will drift.

     This was the top half of the former MapControlsWindow, which is now two tabs rather than one long
     scroll. -->

<UserControl x:Class="Anvil.Controls.Composites.MapSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- Body: one Expander per section (Styles.xaml SectionExpanderStyle), grid rows inside each. -->
    <Grid RowSpacing="8" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- basemap -->
        </Grid.RowDefinitions>

        <Expander Grid.Row="0" Header="Basemap" IsExpanded="True"
                  Style="{StaticResource SectionExpanderStyle}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Basemap combo -->
                    <RowDefinition Height="Auto"/> <!-- Use online tiles -->
                    <RowDefinition Height="Auto"/> <!-- Online tiles URL -->
                    <RowDefinition Height="Auto"/> <!-- Tile source status -->
                </Grid.RowDefinitions>

                <ComboBox Grid.Row="0" Margin="4,0,0,0"
                          Width="240" HorizontalAlignment="Left"
                          ItemsSource="{x:Bind ViewModel.AvailableStyles}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{x:Bind ViewModel.SelectedStyle, Mode=TwoWay}"
                          ToolTipService.ToolTip="Map basemap style"/>

                <!-- Tile SOURCE — orthogonal to the style above. The styles are Protomaps-schema styles, so every
                     one of them renders identically against either source; this only changes where the vector
                     tiles come from. Offline is the default and the fallback. -->
                <CheckBox Grid.Row="1" Margin="4,4,0,0"
                          Content="Use online tiles (needs a network connection)"
                          IsChecked="{x:Bind ViewModel.UseOnlineTiles, Mode=TwoWay}"
                          ToolTipService.ToolTip="Stream the basemap instead of reading the bundled offline PMTiles file. The map's look is unchanged — same styles, same fonts."/>

                <!-- TwoWay on LostFocus (the x:Bind default), deliberately NOT PropertyChanged: pushing a
                     half-typed URL would re-style every pane on each keystroke.
                     ⚠️ Stays ENABLED while offline on purpose — you paste the key BEFORE flipping the toggle, and
                     disabling it would force the trip through an unusable online state to configure one. -->
                <TextBox Grid.Row="2" Margin="4,2,0,0"
                         Width="360" HorizontalAlignment="Left"
                         PlaceholderText="https://api.protomaps.com/tiles/v4.json?key=…"
                         Text="{x:Bind ViewModel.OnlineTilesUrl, Mode=TwoWay}"
                         ToolTipService.ToolTip="A Protomaps-schema source: the Protomaps API TileJSON (free for non-commercial use, needs your key), a {z}/{x}/{y} template, or a self-hosted pmtiles:// archive."/>

                <TextBlock Grid.Row="3" Margin="4,2,0,0"
                           TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"
                           Text="{x:Bind ViewModel.TileSourceStatus, Mode=OneWay}"
                           Style="{StaticResource SettingsFieldLabelStyle}"/>
            </Grid>
        </Expander>

    </Grid>
</UserControl>
