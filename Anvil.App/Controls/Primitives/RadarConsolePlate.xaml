<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     RadarConsolePlate — the CASING of the floating radar console: one moulded plate with a centred tab standing on it.
     It is chrome only, with two content slots the host fills (MainWindow): TabContent (the site picker,
     Composites/RadarConsoleSiteTab) and ConsoleContent (RadarControls + ModelConsole).

                          ░╭──────────────────────────────╮░
                          ░│         TabContent           │░      ← row 0, centred, sized by its content
            ░╭────────────╯                              ╰────────────╮░   ╯ ╰ = 8 px inside curves
            ░│                     ConsoleContent                     │░   ← row 1, sized by its content
            ░╰────────────────────────────────────────────────────────╯░

     ⚠️ THE WHOLE LOOK IS Primitives/PlateOutline — one outline behind both slots (face, hairline, shadow). The SAME
     drawing the pane selectors wear (OverlayBar IsFloating), so the floating boxes always match. Nothing here draws a
     border, a background or a shadow of its own; change the look there, not here.
     ⚠️ The slots only PAD. Their paddings keep the sizes the console had as an OverlayBar + a separate tab:
     console 12.5 / 6.5 (was a 0.5 line + 12,6); tab 8.5 sides, 6.5 top, 3 foot (was a 0.5 line + 8,6, reaching 3 into
     the console).
     The tab's box is measured in code (OnShapeChanged) and handed to the outline — where the tab lands depends on
     both slots' measured widths.
     Host contract: TabContent, ConsoleContent. Centre it and place it; it never stretches.
     ============================================================================ -->
<UserControl x:Class="Anvil.Controls.Primitives.RadarConsolePlate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             SizeChanged="OnShapeChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- the tab -->
            <RowDefinition Height="Auto"/> <!-- the console -->
        </Grid.RowDefinitions>

        <!-- Behind both slots, over the plate's whole rect. Raised face = the pane selectors'. -->
        <prim:PlateOutline x:Name="PlateOutline"
                           Grid.RowSpan="2"
                           IsRaised="True"/>

        <Border x:Name="RadarConsolePlateTabSlot"
                Grid.Row="0"
                HorizontalAlignment="Center"
                Padding="8.5,6.5,8.5,3"
                SizeChanged="OnShapeChanged">
            <ContentPresenter Content="{x:Bind TabContent, Mode=OneWay}"/>
        </Border>

        <Border x:Name="RadarConsolePlateConsoleSlot"
                Grid.Row="1"
                Padding="12.5,6.5">
            <ContentPresenter HorizontalAlignment="Stretch"
                              Content="{x:Bind ConsoleContent, Mode=OneWay}"/>
        </Border>
    </Grid>
</UserControl>
