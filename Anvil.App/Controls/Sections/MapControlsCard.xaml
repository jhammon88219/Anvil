<?xml version="1.0" encoding="utf-8"?>
<!-- MapControlsCard — the "Map" card: whole-map controls in one place. Opened by the "Map" button on the
     top bar's right edge (hidden by the card's own down-triangle), using the SAME ControlCard chrome as the
     settings / temporal cards. Sections stack in the body:
       • Basemap — the map style combo (was launch-only before; this is its first on-screen control).
       • View — the CONUS-only base-extent toggle + a Fit-to-view button (center + zoom to frame the
         current region: the isolated state, else CONUS).
       • State Isolation — a toggle that arms hover-to-highlight + click-to-isolate on the map (as before),
         PLUS a combo to isolate a state directly by name (the only way to SWITCH states once one is
         isolated, since the mask then covers the others). Both drive ViewModel.StateIso.
     Bound to the coordinator MapViewModel (basemap + FitToViewAsync on it, isolation on its StateIso). -->
<UserControl x:Class="Anvil.Controls.Sections.MapControlsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Anvil.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Section header inside the body (e.g. "Basemap", "State Isolation"). -->
        <Style x:Key="MapCardSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="40"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>
        <!-- Inline field label (e.g. "State"). -->
        <Style x:Key="MapCardFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ctl:ControlCard Title="Map"
                         CardHeight="408"
                         CloseRequested="OnCardCloseRequested"
                         Visibility="{x:Bind VisibleWhen(ViewModel.IsMapControlsCardOpen), Mode=OneWay}">
            <ctl:ControlCard.CardBody>
                <!-- Body: [section label] over its controls, grid rows (no StackPanels). -->
                <Grid RowSpacing="8" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Basemap label -->
                        <RowDefinition Height="Auto"/> <!-- Basemap combo -->
                        <RowDefinition Height="Auto"/> <!-- View label -->
                        <RowDefinition Height="Auto"/> <!-- CONUS toggle -->
                        <RowDefinition Height="Auto"/> <!-- Fit to view button -->
                        <RowDefinition Height="Auto"/> <!-- State Isolation label -->
                        <RowDefinition Height="Auto"/> <!-- Isolate toggle -->
                        <RowDefinition Height="Auto"/> <!-- State combo row -->
                    </Grid.RowDefinitions>

                    <!-- ── Basemap ── -->
                    <TextBlock Grid.Row="0" Text="Basemap"
                               Style="{StaticResource MapCardSectionLabelStyle}"/>
                    <ComboBox Grid.Row="1" Margin="4,0,0,0"
                              Width="240" HorizontalAlignment="Left"
                              ItemsSource="{x:Bind ViewModel.AvailableStyles}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{x:Bind ViewModel.SelectedStyle, Mode=TwoWay}"
                              ToolTipService.ToolTip="Map basemap style"/>

                    <!-- ── View extent ── -->
                    <TextBlock Grid.Row="2" Text="View" Margin="0,6,0,0"
                               Style="{StaticResource MapCardSectionLabelStyle}"/>

                    <!-- Base extent: mask everything outside the contiguous 48 (on by default), or the full
                         map. A single isolated state (below) still overrides this until cleared. -->
                    <CheckBox Grid.Row="3" Margin="4,0,0,0"
                              Content="CONUS only (mask outside the lower 48)"
                              IsChecked="{x:Bind ViewModel.StateIso.IsConusIsolated, Mode=TwoWay}"
                              ToolTipService.ToolTip="Hide everything outside the contiguous United States. Uncheck for the full map (incl. AK/HI/PR)."/>

                    <!-- Fit-to-view: frame the current region (isolated state, else CONUS) — center + zoom.
                         (WinUI button; the camera move goes through IMapService like flyTo. A candidate to
                         promote to a persistent on-map corner control later.) -->
                    <Button Grid.Row="4" Margin="4,2,0,0"
                            Click="OnFitToViewClick"
                            ToolTipService.ToolTip="Frame the current view (isolated state, else CONUS) — center &amp; zoom to fit">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14" Glyph="&#xE740;"/>
                            <TextBlock Text="Fit to view" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- ── State Isolation ── -->
                    <TextBlock Grid.Row="5" Text="State Isolation" Margin="0,6,0,0"
                               Style="{StaticResource MapCardSectionLabelStyle}"/>

                    <!-- Arms hover-to-highlight + click-to-isolate on the map (the original workflow). -->
                    <CheckBox Grid.Row="6" Margin="4,0,0,0"
                              Content="Isolate a state (hover &amp; click the map)"
                              IsChecked="{x:Bind ViewModel.StateIso.IsArmed, Mode=TwoWay}"
                              ToolTipService.ToolTip="Highlight a state on hover; click it to isolate. Or pick one below."/>

                    <!-- Direct pick by name — also the way to SWITCH states while one is isolated (the mask
                         then hides the others from clicking). Picking arms the mode if it was off. -->
                    <Grid Grid.Row="7" Margin="4,0,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="State"
                                   Style="{StaticResource MapCardFieldLabelStyle}"/>
                        <ComboBox Grid.Column="1"
                                  Width="200" HorizontalAlignment="Left"
                                  PlaceholderText="Pick a state…"
                                  ItemsSource="{x:Bind ViewModel.StateIso.States}"
                                  SelectedItem="{x:Bind ViewModel.StateIso.SelectedState, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Isolate this state (arms isolation if it's off)"/>
                    </Grid>
                </Grid>
            </ctl:ControlCard.CardBody>
        </ctl:ControlCard>
    </Grid>
</UserControl>
