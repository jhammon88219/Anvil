<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalPaneRailButton — ONE layer section's button on a temporal pane's RAIL (TemporalPanes/TemporalPaneRail).

       LEFT edge (Past / Now)         RIGHT edge (Fore, MIRRORED)
       ┌────┬──┐                      ┌──┬────┐
       │ Wn │› │  ← undocked          │‹ │ Ol │   the SIDECAR sits on the MAP side; its chevron points TOWARD
       └────┴──┘                      └──┴────┘   the map while undocked (it would push the section out)
       ┌────┬──┐                      ┌──┬────┐
       │ Wn │‹ │  ← docked (lit)      │› │ Ol │   …and back toward the edge while docked (it would pull it in)
       └────┴──┘                      └──┴────┘
        body  car

     BODY = the section's stand-in LETTERS (real icons are later polish), tooltip = its name. Lit (the bar keys'
     accent border + raised face) = the layer is ON (any of its types shown); a click TOGGLES THE LAYER — the same
     toggle as the section header's box (TemporalPaneSectionViewModel.Toggle). Disabled while the layer can't be
     toggled (Damage surveys before a window is loaded).
     CAR = DOCK: lit while the section is docked beside the rail; a click docks / undocks it (ToggleDocked). Never a
     3-dot mark — a chevron (CarGlyph). The two halves sit in swapped columns on the right edge (BodyColumn / CarColumn).
     ⚠️ Both IsChecked binds are ONE-WAY + re-asserted after the click (a ToggleButton flips itself before Click). -->
<UserControl x:Class="Anvil.Controls.TemporalPanes.TemporalPaneRailButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid ColumnSpacing="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- The bar keys' look (BarKeyToggleStyle) at the rail's size. -->
        <ToggleButton x:Name="TemporalPaneRailButtonBody"
                      Grid.Column="{x:Bind BodyColumn(Section.IsRightEdge), Mode=OneWay}"
                      Style="{StaticResource BarKeyToggleStyle}"
                      Width="30" Height="32"
                      ToolTipService.ToolTip="{x:Bind Section.Title, Mode=OneWay}"
                      IsChecked="{x:Bind Section.IsOn, Mode=OneWay}"
                      IsEnabled="{x:Bind Section.IsEnabled, Mode=OneWay}"
                      Click="OnBodyClick">
            <TextBlock Text="{x:Bind Section.Letter, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </ToggleButton>

        <ToggleButton x:Name="TemporalPaneRailButtonCar"
                      Grid.Column="{x:Bind CarColumn(Section.IsRightEdge), Mode=OneWay}"
                      Style="{StaticResource BarKeyToggleStyle}"
                      Width="12" Height="32" Padding="0"
                      ToolTipService.ToolTip="{x:Bind CarToolTip(Section.IsDocked), Mode=OneWay}"
                      IsChecked="{x:Bind Section.IsDocked, Mode=OneWay}"
                      Click="OnCarClick">
            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="9"
                      Glyph="{x:Bind CarGlyph(Section.IsDocked, Section.IsRightEdge), Mode=OneWay}"/>
        </ToggleButton>
    </Grid>
</UserControl>
