<?xml version="1.0" encoding="utf-8"?>
<!-- EdgeHatchSettingsTab — EDGE-HATCH (experimental bolt-on, grep EDGE-HATCH): the Settings window's "Edges" tab. How the
     chrome meets the map: a cross-hatch band (above the bottom tiers, and on an open pane's map side) instead of the
     black cast shadow. Every control writes ONE AppSettings value through EdgeHatchViewModel; the bands follow live.

       ┌──────────────────────────────────────────────────────────┐
       │                                     [ Restore defaults ] │  ← ABOVE the sections (every reset is)
       │  ⌄  Edge hatch                                           │
       │    Style       [ Thinning | Fading | Both | Black shadow ]│  ← Black shadow = the old cast shadow
       │    Line colour [ Bar surface | Black | Faint white ]     │
       │    Band width   ───●──────────────  35 px                │
       │    Line spacing ──●───────────────   5 px                │
       │    Line weight  ─────────────────●  2.0 px               │
       │    [✓] Hatch the panes' map-side edges                   │
       └──────────────────────────────────────────────────────────┘

     ⚠️ Section open/closed persists under "settings/edges/…" (SettingsWindow.Persist). -->
<UserControl x:Class="Anvil.Controls.Composites.EdgeHatchSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid RowSpacing="8" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- restore -->
            <RowDefinition Height="Auto"/> <!-- Edge hatch -->
        </Grid.RowDefinitions>

        <Button x:Name="EdgeHatchRestoreDefaultsButton" Grid.Row="0" HorizontalAlignment="Right" Content="Restore defaults"
                Click="{x:Bind ViewModel.RestoreDefaults}"
                ToolTipService.ToolTip="Both, bar surface colour, 35 px band, 5 px spacing, 2.0 px lines, panes hatched"/>

        <prim:SettingsExpander Grid.Row="1" Header="Edge hatch" IsExpanded="True">
            <Grid RowSpacing="10" ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Margin="4,0,0,0" VerticalAlignment="Center" Text="Style"/>
                <prim:SegmentedPicker x:Name="EdgeHatchStylePicker" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                      HorizontalAlignment="Left" Width="360"
                                      ItemsSource="{x:Bind ViewModel.StyleLabels}"
                                      SelectedIndex="{x:Bind ViewModel.StyleIndex, Mode=TwoWay}"/>

                <TextBlock Grid.Row="1" Margin="4,0,0,0" VerticalAlignment="Center" Text="Line colour"/>
                <prim:SegmentedPicker x:Name="EdgeHatchColorPicker" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                      HorizontalAlignment="Left" Width="300"
                                      IsEnabled="{x:Bind ViewModel.IsHatch, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.ColorLabels}"
                                      SelectedIndex="{x:Bind ViewModel.ColorIndex, Mode=TwoWay}"/>

                <TextBlock Grid.Row="2" Margin="4,0,0,0" VerticalAlignment="Center" Text="Band width"/>
                <Slider x:Name="EdgeHatchWidthSlider" Grid.Row="2" Grid.Column="1" Minimum="16" Maximum="72" StepFrequency="1"
                        IsEnabled="{x:Bind ViewModel.IsHatch, Mode=OneWay}"
                        Value="{x:Bind ViewModel.Width, Mode=TwoWay}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource TabularNumberTextStyle}"
                           Text="{x:Bind ViewModel.WidthText, Mode=OneWay}"/>

                <TextBlock Grid.Row="3" Margin="4,0,0,0" VerticalAlignment="Center" Text="Line spacing"/>
                <Slider x:Name="EdgeHatchSpacingSlider" Grid.Row="3" Grid.Column="1" Minimum="3" Maximum="12" StepFrequency="1"
                        IsEnabled="{x:Bind ViewModel.IsHatch, Mode=OneWay}"
                        Value="{x:Bind ViewModel.Spacing, Mode=TwoWay}"/>
                <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource TabularNumberTextStyle}"
                           Text="{x:Bind ViewModel.SpacingText, Mode=OneWay}"/>

                <TextBlock Grid.Row="4" Margin="4,0,0,0" VerticalAlignment="Center" Text="Line weight"/>
                <Slider x:Name="EdgeHatchWeightSlider" Grid.Row="4" Grid.Column="1" Minimum="0.5" Maximum="2" StepFrequency="0.5"
                        IsEnabled="{x:Bind ViewModel.IsHatch, Mode=OneWay}"
                        Value="{x:Bind ViewModel.Weight, Mode=TwoWay}"/>
                <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource TabularNumberTextStyle}"
                           Text="{x:Bind ViewModel.WeightText, Mode=OneWay}"/>

                <CheckBox x:Name="EdgeHatchOnPanesCheckBox" Grid.Row="5" Grid.ColumnSpan="3" Margin="4,0,0,0"
                          Content="Hatch the panes' map-side edges"
                          IsEnabled="{x:Bind ViewModel.IsHatch, Mode=OneWay}"
                          IsChecked="{x:Bind ViewModel.OnPanes, Mode=TwoWay}"/>
            </Grid>
        </prim:SettingsExpander>
    </Grid>
</UserControl>
