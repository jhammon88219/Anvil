<?xml version="1.0" encoding="utf-8"?>
<!-- RadarSettingsTab — Settings → Radar (2026-11-16: the old Radar page + the whole Radar Console page, merged): how live
     radar is polled, the RAM a PastCast loop may hold, the site keys, and the console's scrubber.

       ┌ Live polling  [Restore defaults] ──────────────────────────── DEFAULT ┐  RadarSettingsConsoleLivePolling
       │ Check · Every (greyed unless Fixed time)                               │
       └────────────────────────────────────────────────────────────────────────┘
          12 px of the body's darker ground
       ┌ Memory  [Restore defaults] ───────────────────────────────── DEFAULT ┐  RadarSettingsConsoleMemory
       │ This PC · Radar may use (+ frames per layout, caution line)           │
       └────────────────────────────────────────────────────────────────────────┘
       ┌ Site keys  [Restore defaults] ────────────────────────────── DEFAULT ┐  RadarSettingsConsoleSiteKeys
       │ Hide the others · Only home + favorites · Only near the cursor         │
       └────────────────────────────────────────────────────────────────────────┘
       ┌ Scrubber  [Restore defaults] ─────────────────────────────── DEFAULT ┐  RadarSettingsConsoleScrubber
       │ Style · Preview (the chosen style, live)                               │
       └────────────────────────────────────────────────────────────────────────┘
       ┌ Hatch scrubber  [Restore defaults] ───────────────────────── DEFAULT ┐  RadarSettingsConsoleHatchScrubber
       │ Line colour · spacing · weight · opacity (greyed unless Style = Hatch) │
       └────────────────────────────────────────────────────────────────────────┘
       [                  Reset all Radar settings  (caution amber)              ]  Primitives/CautionResetButton

     ⚠️ Every reset ASKS first (Dialogs/ConfirmResetDialog). The resets live on MapViewModel (ResetLivePolling …), not on
     RadarViewModel — its live-poll members are the sealed engine's; the page only calls their public setters.
     ⚠️ Radar Console keeps its enum slot (a saved index) and opens this page (MapViewModel.SettingsTabIndex).
     ⚠️ Gone from here, don't re-add: Home site (General → Startup), the distance unit (General → Units), rings + ruler (their
     own page), the mile grid (deleted — the ruler replaced it), Inspect (a map-tools key), the per-network marker toggles
     (map-tools rail), the PastCast "hold the map" opt-out (every load is held). -->
<UserControl x:Class="Anvil.Controls.Composites.RadarSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:radarSettingsConsoles="using:Anvil.Controls.RadarSettingsConsoles"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel Spacing="12" VerticalAlignment="Top">
        <radarSettingsConsoles:RadarSettingsConsoleLivePolling x:Name="RadarSettingsConsoleLivePolling" ViewModel="{x:Bind ViewModel}"/>
        <radarSettingsConsoles:RadarSettingsConsoleMemory x:Name="RadarSettingsConsoleMemory" ViewModel="{x:Bind ViewModel}"/>
        <radarSettingsConsoles:RadarSettingsConsoleSiteKeys x:Name="RadarSettingsConsoleSiteKeys" ViewModel="{x:Bind ViewModel}"/>
        <radarSettingsConsoles:RadarSettingsConsoleScrubber x:Name="RadarSettingsConsoleScrubber" ViewModel="{x:Bind ViewModel}"/>
        <radarSettingsConsoles:RadarSettingsConsoleHatchScrubber x:Name="RadarSettingsConsoleHatchScrubber" ViewModel="{x:Bind ViewModel}"/>
        <prim:CautionResetButton x:Name="RadarSettingsResetAllButton"
                                 Text="Reset all Radar settings" Click="OnResetAll"
                                 ToolTipService.ToolTip="Every Radar section back to its DEFAULT column (asks first)"/>
    </StackPanel>
</UserControl>
