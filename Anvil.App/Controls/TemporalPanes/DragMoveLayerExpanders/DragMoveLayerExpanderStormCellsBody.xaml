<?xml version="1.0" encoding="utf-8"?>
<!-- DragMoveLayerExpanderStormCellsBody — the radar's storm-cell attributes (StormCellsViewModel): a card, one row per mark. Shown
     in BOTH temporal panes — live cells in Now, the loaded window's in Past — for the LOADED radar site.

     ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓   the card (DragMoveLayerExpanderHeaderCard, FLUSH
     ▓  14 storm cells                Scan 4:14 PM · TLX▓   under the header, ONE line): cells in the scan ON
     ──────────────────────────────────────────────────────  SCREEN left, which scan and site right; loading /
                                                             failure / "no scan near this frame" take that slot
       [x] ● Cell tracks                            14  ← one DragMoveLayerExpanderCountRow per mark: the toggle,
       [x] ▼ Tornado vortex (TVS)                    1    the map mark, the name, and how many the DISPLAYED scan
       [x] ◯ Mesocyclone                             2    has — the count at the FAR RIGHT
       [x] ◆ Severe hail                             3

     ⚠️ THE COUNTS FOLLOW THE SCRUBBER, not the clock: they are the scan the radar frame on screen shows, so
     they change as the loop plays. That is the point — it is the same number the map is drawing.
     ⚠️ The marks are the map's (storm-cells.js): white dot, red triangle, yellow ring, cyan diamond. Literals
     in both places — change one, change the other. Data colours, never themed.
     ⚠️ Opacity and the section heading are the HOST's (DragMoveLayerExpander), as for every overlay control. -->
<UserControl x:Class="Anvil.Controls.TemporalPanes.DragMoveLayerExpanders.DragMoveLayerExpanderStormCellsBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tp="using:Anvil.Controls.TemporalPanes"
             xmlns:dragMoveLayerExpanders="using:Anvil.Controls.TemporalPanes.DragMoveLayerExpanders"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- the card (its bottom edge is the rule) -->
            <RowDefinition Height="Auto"/> <!-- the four mark rows -->
        </Grid.RowDefinitions>

        <!-- THE CARD, flush under the section header (DragMoveLayerExpanderHeaderCard; its bottom edge is the rule). -->
        <dragMoveLayerExpanders:DragMoveLayerExpanderHeaderCard Grid.Row="0"
                Headline="{x:Bind ViewModel.CardHeadline, Mode=OneWay}"
                Context="{x:Bind ViewModel.CardContext, Mode=OneWay}"
                Footer="{x:Bind ViewModel.CardFooter, Mode=OneWay}"/>

        <!-- One DragMoveLayerExpanderCountRow per mark (every expander's row: count at the far right, hover lift). -->
        <StackPanel Grid.Row="1" Spacing="4">
            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="Cell tracks"
                    IsChecked="{x:Bind ViewModel.ShowTracks, Mode=TwoWay}"
                    Count="{x:Bind Fmt(ViewModel.CellCount), Mode=OneWay}"
                    ToolTipService.ToolTip="Show each cell, its id, where it has been and its 15–60 minute forecast track">
                <Ellipse Width="9" Height="9" Fill="#FFFFFF" Stroke="#141414" StrokeThickness="1.5"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>
            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="Tornado vortex (TVS)"
                    IsChecked="{x:Bind ViewModel.ShowTvs, Mode=TwoWay}"
                    Count="{x:Bind Fmt(ViewModel.TvsCount), Mode=OneWay}"
                    ToolTipService.ToolTip="Show tornado vortex signatures (a hollow triangle is an elevated TVS)">
                <Path Data="M0,0 L12,0 L6,10 Z" Fill="#FF2A2A" Stroke="#141414" StrokeThickness="1"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>
            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="Mesocyclone"
                    IsChecked="{x:Bind ViewModel.ShowMeso, Mode=TwoWay}"
                    Count="{x:Bind Fmt(ViewModel.MesoCount), Mode=OneWay}"
                    ToolTipService.ToolTip="Show mesocyclones — strength rank 5 and up (a thicker ring is rank 8+)">
                <Ellipse Width="12" Height="12" Stroke="#FFE14D" StrokeThickness="2"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>
            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="Severe hail"
                    IsChecked="{x:Bind ViewModel.ShowHail, Mode=TwoWay}"
                    Count="{x:Bind Fmt(ViewModel.HailCount), Mode=OneWay}"
                    ToolTipService.ToolTip="Show cells more likely than not to hold severe hail, with the largest expected size">
                <Path Data="M6,0 L12,6 L6,12 L0,6 Z" Fill="#3FD0FF" Stroke="#141414" StrokeThickness="1"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>
        </StackPanel>
    </Grid>
</UserControl>
