<?xml version="1.0" encoding="utf-8"?>
<!-- NowCastTab — the body of the NowCast window: storm cells, storm reports, warnings, watches and the radar layer, one
     LAYER SECTION each. One of three mode bodies (see Controls/Windows/TemporalWindow, registered once per
     mode); the window supplies the surface, the title and the pin, so this is content only.
     ⚠️ The file keeps its "Tab" name from when the three were tabs of one Timeframe window. It is the same
     control, unchanged by the split; renaming all three would be churn. Bound to the coordinator MapViewModel.

       ┌──────────────────────────────────────────────────────────────┐
       │  ┌──┐                                    │ 5:42:07 PM        │  ← THE HEADER: FIXED, no section
       │  │██│  NowCast                          │   Mon Sep 28      │    header, can't collapse. Clock =
       │  └──┘  ↑ the window's ONLY "NowCast" (TemporalWindow hides its title for Now)   the MACHINE's time
       │   ↑ FEED STATUS bar (22 × row height): warnings feed age, green → amber → red; grey = none yet
       │  ┌━━━━━━━━━━━━━┐ ┌━━━━━━━━━━━━━┐ ┌━━━━━━━━━━━━━┐           │
       │  │ 5      ‹  › │ │ 27     ‹  › │ │ 8      ‹  › │           │  ← every warning IN EFFECT, not
       │  │ Tornado     │ │ Severe      │ │ Flash flood │           │    what the Warnings rows show;
       │  │ ─────────── │ │ ─────────── │ │ ─────────── │           │    a zero tile is DIMMED, not hidden
       │  │▒Oklahoma▒▒3▒│ │ Texas     9 │ │ Mississip 6 │           │    (stripe = the data colour)
       │  │ Kansas    2 │ │ Oklahoma  7 │ │ Louisiana 2 │           │  ← STATE LINES (*Stepper.States), 13 px
       │  │ 2 of 5 · Cle│ │ Kansas    5 │ │ 1 emergency │           │    whole-row buttons: most first; a
       │  │             │ │ …every state│ │             │           │    warning counts ONCE, in its first
       │  │             │ │ 4 destruct. │ │             │           │    county's state, so lines sum to the
       │  └─────────────┘ └─────────────┘ └─────────────┘           │    count. NO CAP — tiles grow.
       │   ↑ while its ‹ › have you on a warning the tag line reads   │  ‹ › = WarningStepper: › flies to the
       │     "2 of 3 · place · PDS" in accent (NO outline — removed)   │    next (worst first, wraps); ‹ = back
       │   ▒ = LIT line (accent wash + text): the state of that       │    stack, off until › used; the COUNT
       │     warning, or a CLICKED line — which frames + flashes ALL  │    resets. Flash even if unticked.
       │     its warnings ("All 3 in Oklahoma"); not on the ‹ stack,  │
       │     doesn't narrow the arrows                                │
       │                                                              │  ← 24 px gap before the sections
       │ ⠿ › [x] Storm cells     ─────────────────●   100%            │  ← TOP of the list = TOP of the map
       │ ⠿ › [x] Storm reports   ─────────────────●   100%            │
       │ ⠿ ⌄ [x] Warnings        ─────────────────●   100%            │
       │   ┌──────────────────────────────────────────┐               │
       │   │ 7 active warnings                        │               │
       │   │ Updated 12:04 PM · checking every 15s    │               │
       │   └──────────────────────────────────────────┘               │
       │   [x] ■ Tornado                            0                 │
       │   [x] ■ Severe thunderstorm                7                 │
       │ ⠿ › [-] Watches         ─────────────────●   100%            │  [-] = some types ticked
       │ ⠿ › [x] Mesoscale discussions ───────────●   100%            │  MDs + MPDs: areas + a reader
       │ ⠿   [x] Radar           ──────────────●──     85%            │  ← no body: nothing to open
       └──────────────────────────────────────────────────────────────┘
         ↑ the sections sit in PanelScroller: a 16 px gutter on the right is ALWAYS claimed; its thumb
           draws only once they overflow. The header above does not scroll.

     ⚠️ THE ORDER OF THIS LIST IS THE MAP'S Z-ORDER, and the user owns it: drag a section by its grip ⠿ (or
     Alt+Up/Down) and OnSectionsReordered hands the new order to MapViewModel.SetLayerOrder, which saves it
     (AppSettings.NowCastLayerOrder — separate from PastCast's) and restacks the map. The order below is the
     DEFAULT, matching layers.js DEFAULT_ORDER; a saved order is applied over it once, on first load.
     ⚠️ Each LayerId is a Models/Map/LayerOrder id, mirrored in layers.js GROUPS — change all three.

     ⚠️ THE HEADER CHECKBOX IS A SELECT-ALL for its section (VM ToggleAll / AllShown): all ticked → clears
     them, otherwise ticks them all (a partial [-] goes to all on). IsChecked is ONE-WAY and the click calls
     the VM. Radar has no type rows, so its box is the layer show/hide (RadarViewModel.ShowRadarLayer).
     ⚠️ EVERY BOX STARTS TICKED, and the map still launches clean: a tick means "draw while the mode runs"
     (IsModeActive, set in MapViewModel.OnTemporalModesChanged). Turning NowCast on brings them all up.

     ⚠️ OPACITY LIVES IN THE HEADER (PanelSection ShowOpacity), live while the section is closed, and
     disabled while the layer draws nothing (AnyShown / ShowRadarLayer).
     ⚠️ THE RADAR VALUE IS GLOBAL — one radar layer, shared by live and replay. PastCast shows the same
     slider; that is survivable only because Past and Now are mutually exclusive (their windows can't both
     be open).

     Warnings is the only section open on a FIRST run. Every section's open/closed state is then PERSISTED
     (PanelSection.PersistExpansion → AppSettings.SectionExpanded, keys "now/<LayerId>"), and so is every
     tick and opacity here (ViewModels/Map/TemporalWindowPersistence).
     ⚠️ The window opens at a FIXED full height (WindowManager's Left anchor), not sized to this body, so the
     SECTIONS scroll inside Primitives/PanelScroller (the header stays put) — PastCast's arrangement.

     Both alert sections are the SAME control (Composites/PhenomOverlayInput) bound to a different view
     model, exactly as watches.js and warnings.js are the same JS factory with a different config. Storm
     reports stay their own control — the PastCast window shows that same block, so it is content of TWO
     hosts.

     ⚠️ This tab does NOT arm or clear NowCast; that is the NowCast key in the bottom bar's centre cluster.
     A tab body configures a mode, the key runs it.

     THE HEADER is NowCast's twin of PastCast's Timeframe block: fixed above the sections, same padding, same
     height (Styles.xaml TemporalHeaderMinHeight, on both — the tiles row is STAR and takes the slack).
       • Name row — the status bar, "NowCast" (the window's title moved here; the user's call, 2026-10-01), then
         behind a hairline the time over the date. Zone + UTC + age moved into TOOLTIPS (time / bar).
       • Clock — the machine's local time, ticked by a DispatcherTimer that runs only while this body is loaded
         (code-behind). The zone label is built from Windows' zone NAME ("Central Daylight Time" → "CDT").
       • FEED STATUS = Warnings.LastUpdated's age, which a FAILED fetch leaves alone — so a stuck feed walks the
         bar green → amber (FeedAgingAfter) → red (FeedStaleAfter); grey before the first fetch. The SAME four
         literals as the Atlas status bar / age tile and the map key's square (data, never themed). Don't
         reset the age on failure — that is the honest readout.
       • Tiles — Warnings.TornadoCount/SevereCount/FlashFloodCount, which count EVERY active warning in the
         fetch, never the ticked rows (user's call). Tag lines = WarningThreatCounts, split per type. Stripe
         colours are DATA (the same literals as PhenomOverlayInput's swatches) — never themed. -->
<UserControl x:Class="Anvil.Controls.Composites.NowCastTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:Anvil.Controls.Composites"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- The three tiles' look, local: nothing else draws a tile. BorderBrush (the stripe) is set per tile. -->
    <UserControl.Resources>
        <Style x:Key="WarningTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0,3,0,0"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
            <Setter Property="Background" Value="{ThemeResource OverlayBarSurfaceHoverBrush}"/>
        </Style>
        <Style x:Key="WarningTileCountStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="SemiLight"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="WarningTileLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="WarningTileTagStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- One STATE LINE of a tile: "Oklahoma          3" — a whole-row button (click = fly to that state's
             warnings, WarningStateLine.Fly). Name trims, the count is its own right column. The row bleeds 6 px
             each side so its hover / lit wash pads the text while the text stays on the tile's edge.
             ⚠️ LIT (IsLit: the clicked state, or the state of the warning the ‹ › have you on) = an accent wash
             under the row + the accent text pair. Two text pairs swapped by Visibility, because a theme brush
             can't be picked in code; the lists are rebuilt when the lit line moves, so OneTime binds are enough. -->
        <Style x:Key="WarningStateLineButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="-6,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <DataTemplate x:Key="WarningStateLineTemplate" x:DataType="vm:WarningStateLine">
            <Button Style="{StaticResource WarningStateLineButtonStyle}" Click="{x:Bind Fly}"
                    ToolTipService.ToolTip="Fly to these warnings">
                <Grid>
                    <Border Visibility="{x:Bind IsLit}" CornerRadius="4" Opacity="0.18"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <Grid ColumnSpacing="6" Padding="6,3" Visibility="{x:Bind IsUnlit}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind CountText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                    <Grid ColumnSpacing="6" Padding="6,3" Visibility="{x:Bind IsLit}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind CountText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>
        <Style x:Key="WarningTileRuleStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
            <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
        </Style>
        <!-- "2 of 3 · Cleveland, OK · PDS" — the tag line's place while the tile's arrows have you on a warning. -->
        <Style x:Key="WarningTilePositionStyle" TargetType="TextBlock" BasedOn="{StaticResource WarningTileTagStyle}">
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
        </Style>
        <!-- The ‹ › pair in a tile's top-right. The stock button's template (its hover/pressed/disabled faces),
             shrunk and made transparent at rest so it sits on the tile rather than on a plate of its own. -->
        <Style x:Key="WarningTileArrowStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- the header: clock + warning tiles, always there -->
            <RowDefinition Height="*"/>    <!-- the sections, in the scroller -->
        </Grid.RowDefinitions>

        <!-- ===================== HEADER: clock, then the three warning tiles ===================== -->
        <!-- Padding 12 = PanelSection's body padding; bottom 24 = the gap before the first section header.
             ⚠️ The RIGHT 16 = that 12 + PanelScroller.GutterWidth (16) − the scroller's 12 px bleed, so the tiles
             line up with the section bodies below, which sit left of the always-claimed gutter — PastCast's
             Timeframe rule exactly. Change all three together. -->
        <Grid Grid.Row="0" Padding="12,12,16,24" MinHeight="{StaticResource TemporalHeaderMinHeight}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- status bar · NowCast │ time over date -->
                <RowDefinition Height="*"/>    <!-- the tiles (take the slack) -->
            </Grid.RowDefinitions>

            <!-- THE NAME ROW. Its height is the time-over-date stack's; the status bar and the name stretch to it,
                 so the block's top and bottom edges are one line each. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>   <!-- status bar -->
                    <ColumnDefinition Width="*"/>    <!-- NowCast -->
                    <ColumnDefinition Width="Auto"/> <!-- hairline · time over date -->
                </Grid.ColumnDefinitions>

                <!-- FEED STATUS — the Atlas row's left bar / the map key's square: a full-height block forming the
                     row's left edge, outer corners rounded only. Fill + tooltip set in code (UpdateClock): LITERAL
                     data colours, never themed. -->
                <Border x:Name="FeedStatus" Grid.Column="0" CornerRadius="5,0,0,5"/>

                <TextBlock Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"
                           Text="NowCast" FontSize="30" FontWeight="SemiLight"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                <Border Grid.Column="2" BorderThickness="1,0,0,0" Padding="12,0,0,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <!-- Tabular figures so the ticking seconds don't jitter the column. UTC is its tooltip. -->
                        <TextBlock x:Name="ClockTime" HorizontalAlignment="Right"
                                   FontSize="15" Typography.NumeralAlignment="Tabular"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="ClockDate" HorizontalAlignment="Right"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,14,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ⚠️ The ‹ › pair rides each tile's top-right, bound straight to its WarningStepper (Forward /
                     Back); clicking the COUNT resets it (Reset). While its arrows have you on a warning, the tag line
                     swaps for the accent "2 of 3 · place" line — the ONLY active marker. ⚠️ NO OUTLINE: an accent
                     border drawn over the tile covered its coloured top stripe and read as the card changing (the
                     user's call, 2026-09-30, removed). The tile's own tooltip stays on the Border, the buttons carry
                     their own. Glyphs E76B / E76C (ChevronLeft / Right) are NOT verified by rendering in the real font. -->
                <Grid Grid.Column="0" Opacity="{x:Bind TileOpacity(ViewModel.Warnings.TornadoCount), Mode=OneWay}">
                    <Border Style="{StaticResource WarningTileStyle}" BorderBrush="#FF2A2A"
                            ToolTipService.ToolTip="Tornado warnings in effect nationwide — all of them, whatever the Warnings rows below show">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Warnings.TornadoCount, Mode=OneWay}" Style="{StaticResource WarningTileCountStyle}"
                                           Tapped="{x:Bind ViewModel.Warnings.TornadoStepper.Reset}"/>
                                <TextBlock Text="Tornado" Style="{StaticResource WarningTileLabelStyle}"/>
                                <Border Style="{StaticResource WarningTileRuleStyle}"
                                        Visibility="{x:Bind NonZero(ViewModel.Warnings.TornadoCount), Mode=OneWay}"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Warnings.TornadoStepper.States, Mode=OneWay}"
                                              ItemTemplate="{StaticResource WarningStateLineTemplate}"/>
                                <TextBlock Text="{x:Bind ViewModel.Warnings.TornadoThreats, Mode=OneWay}" Style="{StaticResource WarningTileTagStyle}"
                                           Visibility="{x:Bind Hidden(ViewModel.Warnings.TornadoStepper.IsActive), Mode=OneWay}"/>
                                <TextBlock Text="{x:Bind ViewModel.Warnings.TornadoStepper.PositionText, Mode=OneWay}" Style="{StaticResource WarningTilePositionStyle}"
                                           Visibility="{x:Bind Shown(ViewModel.Warnings.TornadoStepper.IsActive), Mode=OneWay}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0">
                                <Button Style="{StaticResource WarningTileArrowStyle}"
                                        IsEnabled="{x:Bind ViewModel.Warnings.TornadoStepper.CanBack, Mode=OneWay}"
                                        Click="{x:Bind ViewModel.Warnings.TornadoStepper.Back}"
                                        ToolTipService.ToolTip="Back to the last tornado warning you visited">
                                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Glyph="&#xE76B;"/>
                                </Button>
                                <Button Style="{StaticResource WarningTileArrowStyle}"
                                        IsEnabled="{x:Bind ViewModel.Warnings.TornadoStepper.CanForward, Mode=OneWay}"
                                        Click="{x:Bind ViewModel.Warnings.TornadoStepper.Forward}"
                                        ToolTipService.ToolTip="Fly to the next tornado warning (worst first)">
                                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Glyph="&#xE76C;"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" Opacity="{x:Bind TileOpacity(ViewModel.Warnings.SevereCount), Mode=OneWay}">
                    <Border Style="{StaticResource WarningTileStyle}" BorderBrush="#FFD21A"
                            ToolTipService.ToolTip="Severe thunderstorm warnings in effect nationwide — all of them, whatever the Warnings rows below show">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Warnings.SevereCount, Mode=OneWay}" Style="{StaticResource WarningTileCountStyle}"
                                           Tapped="{x:Bind ViewModel.Warnings.SevereStepper.Reset}"/>
                                <TextBlock Text="Severe" Style="{StaticResource WarningTileLabelStyle}"/>
                                <Border Style="{StaticResource WarningTileRuleStyle}"
                                        Visibility="{x:Bind NonZero(ViewModel.Warnings.SevereCount), Mode=OneWay}"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Warnings.SevereStepper.States, Mode=OneWay}"
                                              ItemTemplate="{StaticResource WarningStateLineTemplate}"/>
                                <TextBlock Text="{x:Bind ViewModel.Warnings.SevereThreats, Mode=OneWay}" Style="{StaticResource WarningTileTagStyle}"
                                           Visibility="{x:Bind Hidden(ViewModel.Warnings.SevereStepper.IsActive), Mode=OneWay}"/>
                                <TextBlock Text="{x:Bind ViewModel.Warnings.SevereStepper.PositionText, Mode=OneWay}" Style="{StaticResource WarningTilePositionStyle}"
                                           Visibility="{x:Bind Shown(ViewModel.Warnings.SevereStepper.IsActive), Mode=OneWay}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0">
                                <Button Style="{StaticResource WarningTileArrowStyle}"
                                        IsEnabled="{x:Bind ViewModel.Warnings.SevereStepper.CanBack, Mode=OneWay}"
                                        Click="{x:Bind ViewModel.Warnings.SevereStepper.Back}"
                                        ToolTipService.ToolTip="Back to the last severe thunderstorm warning you visited">
                                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Glyph="&#xE76B;"/>
                                </Button>
                                <Button Style="{StaticResource WarningTileArrowStyle}"
                                        IsEnabled="{x:Bind ViewModel.Warnings.SevereStepper.CanForward, Mode=OneWay}"
                                        Click="{x:Bind ViewModel.Warnings.SevereStepper.Forward}"
                                        ToolTipService.ToolTip="Fly to the next severe thunderstorm warning (worst first)">
                                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Glyph="&#xE76C;"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="2" Opacity="{x:Bind TileOpacity(ViewModel.Warnings.FlashFloodCount), Mode=OneWay}">
                    <Border Style="{StaticResource WarningTileStyle}" BorderBrush="#2EE05A"
                            ToolTipService.ToolTip="Flash flood warnings in effect nationwide — all of them, whatever the Warnings rows below show">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Warnings.FlashFloodCount, Mode=OneWay}" Style="{StaticResource WarningTileCountStyle}"
                                           Tapped="{x:Bind ViewModel.Warnings.FlashFloodStepper.Reset}"/>
                                <TextBlock Text="Flash flood" Style="{StaticResource WarningTileLabelStyle}"/>
                                <Border Style="{StaticResource WarningTileRuleStyle}"
                                        Visibility="{x:Bind NonZero(ViewModel.Warnings.FlashFloodCount), Mode=OneWay}"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Warnings.FlashFloodStepper.States, Mode=OneWay}"
                                              ItemTemplate="{StaticResource WarningStateLineTemplate}"/>
                                <TextBlock Text="{x:Bind ViewModel.Warnings.FlashFloodThreats, Mode=OneWay}" Style="{StaticResource WarningTileTagStyle}"
                                           Visibility="{x:Bind Hidden(ViewModel.Warnings.FlashFloodStepper.IsActive), Mode=OneWay}"/>
                                <TextBlock Text="{x:Bind ViewModel.Warnings.FlashFloodStepper.PositionText, Mode=OneWay}" Style="{StaticResource WarningTilePositionStyle}"
                                           Visibility="{x:Bind Shown(ViewModel.Warnings.FlashFloodStepper.IsActive), Mode=OneWay}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0">
                                <Button Style="{StaticResource WarningTileArrowStyle}"
                                        IsEnabled="{x:Bind ViewModel.Warnings.FlashFloodStepper.CanBack, Mode=OneWay}"
                                        Click="{x:Bind ViewModel.Warnings.FlashFloodStepper.Back}"
                                        ToolTipService.ToolTip="Back to the last flash flood warning you visited">
                                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Glyph="&#xE76B;"/>
                                </Button>
                                <Button Style="{StaticResource WarningTileArrowStyle}"
                                        IsEnabled="{x:Bind ViewModel.Warnings.FlashFloodStepper.CanForward, Mode=OneWay}"
                                        Click="{x:Bind ViewModel.Warnings.FlashFloodStepper.Forward}"
                                        ToolTipService.ToolTip="Fly to the next flash flood warning (worst first)">
                                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Glyph="&#xE76C;"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

    <!-- THE SECTIONS SCROLL; the header above them doesn't. Primitives/PanelScroller — present whether or not
         the sections overflow yet (the user's call, 2026-09-30): its gutter is always claimed, the thumb only
         draws on overflow. ⚠️ Margin right -12 BLEEDS the gutter into the window's 16 px body margin (see the
         PanelScroller header): the gutter ends 4 px from the window edge, as in PastCast. -->
    <prim:PanelScroller Grid.Row="1" Margin="0,0,-12,0">
    <!-- ⚠️ A StackPanel, not a Grid of rows: the sections' CHILD ORDER is the display order, which is what
         a drag re-arranges. -->
    <StackPanel x:Name="Sections" VerticalAlignment="Top" Spacing="8">

        <prim:PanelSection Header="Storm cells" LayerId="cells" Reordered="OnSectionsReordered"
                           ShowCheckBox="True"
                           IsChecked="{x:Bind ViewModel.StormCells.AllShown, Mode=OneWay}"
                           CheckBoxClick="OnStormCellsHeaderClick"
                           CheckBoxToolTip="Show or hide every storm-cell mark"
                           ShowOpacity="True"
                           OpacityValue="{x:Bind ViewModel.StormCells.Opacity, Mode=TwoWay}"
                           IsOpacityEnabled="{x:Bind ViewModel.StormCells.AnyShown, Mode=OneWay}"
                           OpacityToolTip="Opacity of the storm-cell marks and tracks">
            <comp:StormCellsInput ViewModel="{x:Bind ViewModel.StormCells, Mode=OneWay}"/>
        </prim:PanelSection>

        <prim:PanelSection Header="Storm reports" LayerId="reports" Reordered="OnSectionsReordered"
                           ShowCheckBox="True"
                           IsCheckBoxEnabled="{x:Bind ViewModel.StormReports.IsReady, Mode=OneWay}"
                           IsChecked="{x:Bind ViewModel.StormReports.AllShown, Mode=OneWay}"
                           CheckBoxClick="OnStormReportsHeaderClick"
                           CheckBoxToolTip="Show or hide every report type"
                           ShowOpacity="True"
                           OpacityValue="{x:Bind ViewModel.StormReports.Opacity, Mode=TwoWay}"
                           IsOpacityEnabled="{x:Bind ViewModel.StormReports.AnyShown, Mode=OneWay}"
                           OpacityToolTip="Opacity of the storm-report dots">
            <comp:StormReportsInput ViewModel="{x:Bind ViewModel.StormReports, Mode=OneWay}"/>
        </prim:PanelSection>

        <prim:PanelSection Header="Warnings" LayerId="warnings" Reordered="OnSectionsReordered"
                           IsExpanded="True"
                           ShowCheckBox="True"
                           IsChecked="{x:Bind ViewModel.Warnings.AllShown, Mode=OneWay}"
                           CheckBoxClick="OnWarningsHeaderClick"
                           CheckBoxToolTip="Show or hide every warning type"
                           ShowOpacity="True"
                           OpacityValue="{x:Bind ViewModel.Warnings.Opacity, Mode=TwoWay}"
                           IsOpacityEnabled="{x:Bind ViewModel.Warnings.AnyShown, Mode=OneWay}"
                           OpacityToolTip="Opacity of the warning polygons (fill and outline together)">
            <comp:PhenomOverlayInput AlertNoun="warnings"
                                     ViewModel="{x:Bind ViewModel.Warnings, Mode=OneWay}"/>
        </prim:PanelSection>

        <prim:PanelSection Header="Watches" LayerId="watches" Reordered="OnSectionsReordered"
                           ShowCheckBox="True"
                           IsChecked="{x:Bind ViewModel.Watches.AllShown, Mode=OneWay}"
                           CheckBoxClick="OnWatchesHeaderClick"
                           CheckBoxToolTip="Show or hide every watch type"
                           ShowOpacity="True"
                           OpacityValue="{x:Bind ViewModel.Watches.Opacity, Mode=TwoWay}"
                           IsOpacityEnabled="{x:Bind ViewModel.Watches.AnyShown, Mode=OneWay}"
                           OpacityToolTip="Opacity of the watch boxes (fill and outline together)">
            <comp:PhenomOverlayInput AlertNoun="watches"
                                     ViewModel="{x:Bind ViewModel.Watches, Mode=OneWay}"/>
        </prim:PanelSection>

        <!-- Mesoscale discussions: SPC MDs + WPC MPDs, drawn as in effect now, the last 24 h listed to read.
             Shared control with the Past window. A click on an MD's area opens THIS section (code-behind). -->
        <prim:PanelSection x:Name="DiscussionsSection" Header="Mesoscale discussions" LayerId="mds" Reordered="OnSectionsReordered"
                           ShowCheckBox="True"
                           IsChecked="{x:Bind ViewModel.Discussions.AllShown, Mode=OneWay}"
                           CheckBoxClick="OnDiscussionsHeaderClick"
                           CheckBoxToolTip="Show or hide every discussion kind"
                           ShowOpacity="True"
                           OpacityValue="{x:Bind ViewModel.Discussions.Opacity, Mode=TwoWay}"
                           IsOpacityEnabled="{x:Bind ViewModel.Discussions.AnyShown, Mode=OneWay}"
                           OpacityToolTip="Opacity of the discussion areas and labels">
            <comp:DiscussionsInput ViewModel="{x:Bind ViewModel.Discussions, Mode=OneWay}"/>
        </prim:PanelSection>

        <!-- Header only: the layer's show/hide and its opacity are all it has. -->
        <prim:PanelSection Header="Radar" LayerId="radar" Reordered="OnSectionsReordered"
                           ShowCheckBox="True"
                           IsChecked="{x:Bind ViewModel.Radar.ShowRadarLayer, Mode=OneWay}"
                           CheckBoxClick="OnRadarHeaderClick"
                           CheckBoxToolTip="Show the radar layer"
                           ShowOpacity="True"
                           OpacityValue="{x:Bind ViewModel.Radar.RadarOpacity, Mode=TwoWay}"
                           IsOpacityEnabled="{x:Bind ViewModel.Radar.ShowRadarLayer, Mode=OneWay}"
                           OpacityToolTip="Opacity of the radar layer — turn it down to read what is under it"/>
    </StackPanel>
    </prim:PanelScroller>
    </Grid>
</UserControl>
