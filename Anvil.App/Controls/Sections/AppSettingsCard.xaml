<?xml version="1.0" encoding="utf-8"?>
<!-- AppSettingsCard — the app-wide settings card, the RIGHT-side mirror of the temporal cards. Hosted in
     the OverlayBar's SettingsCardHost slot (above the bar, right-aligned) and opened by the settings cog
     on the bar's right edge; hidden by the card's own down-triangle. Uses the SAME ControlCard chrome
     (fixed size, down-triangle) as the temporal cards, so the UX is symmetrical: temporal settings open on
     the left, app settings on the right. This is the app-wide settings area; sections stack in the body as
     [section label] over its controls. Today: a "Radar Settings" section with the Show Research Radars
     toggle (the Show TDWRs toggle lands here later). Bound to the coordinator MapViewModel. -->
<UserControl x:Class="Anvil.Controls.Sections.AppSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Anvil.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Section header inside the settings body (e.g. "Radar Settings"). -->
        <Style x:Key="SettingsSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="40"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ctl:ControlCard Title="Settings"
                         CardHeight="400"
                         CloseRequested="OnCardCloseRequested"
                         Visibility="{x:Bind VisibleWhen(ViewModel.IsSettingsCardOpen), Mode=OneWay}">
            <ctl:ControlCard.CardBody>
                <!-- Body: one section per group, [label] over its controls. Grid rows (no StackPanels). -->
                <Grid RowSpacing="8" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- section label: Radar Settings -->
                        <RowDefinition Height="Auto"/> <!-- Show TDWRs -->
                        <RowDefinition Height="Auto"/> <!-- Show Research Radars -->
                        <RowDefinition Height="Auto"/> <!-- Storm motion (SRV) inputs -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Radar Settings"
                               Style="{StaticResource SettingsSectionLabelStyle}"/>

                    <!-- Opt-in TDWRs (the FAA Terminal Doppler Weather Radar T*** network). -->
                    <CheckBox Grid.Row="1"
                              Margin="4,0,0,0"
                              Content="Show TDWRs"
                              IsChecked="{x:Bind ViewModel.Radar.ShowTdwrs, Mode=TwoWay}"
                              ToolTipService.ToolTip="Show FAA Terminal Doppler Weather Radar markers (e.g. TOKC, TDAL)"/>

                    <!-- Opt-in research/test radars (e.g. the ROC test bed KCRI). Moved here from the radar
                         console so app-wide toggles live in one place. -->
                    <CheckBox Grid.Row="2"
                              Margin="4,0,0,0"
                              Content="Show Research Radars"
                              IsChecked="{x:Bind ViewModel.Radar.ShowResearchRadars, Mode=TwoWay}"
                              ToolTipService.ToolTip="Show research/test radar markers such as KCRI (ROC test bed, Norman OK)"/>

                    <!-- Storm motion for the Storm-Rel Velocity (SRV) product. AUTO (default) derives it from
                         the radar's own velocity (VAD wind profile → Bunkers right-mover), RadarScope-style
                         and fully offline — the readout shows the current estimate. Unchecking Auto reveals
                         the manual override: speed + the bearing the storm is moving TOWARD. SRV subtracts
                         this motion's along-beam component so rotation reads near zero; 0 kt = SRV equals base
                         velocity. NumberBox commits on Enter / focus-loss, so a change triggers ONE SRV rebuild
                         rather than one per keystroke. -->
                    <Grid Grid.Row="3" Margin="4,4,0,0" ColumnSpacing="10" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- sub-label -->
                            <RowDefinition Height="Auto"/> <!-- Auto checkbox -->
                            <RowDefinition Height="Auto"/> <!-- auto readout -->
                            <RowDefinition Height="Auto"/> <!-- speed (manual) -->
                            <RowDefinition Height="Auto"/> <!-- direction (manual) -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Storm Motion (SRV)"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                        <CheckBox Grid.Row="1" Grid.ColumnSpan="2"
                                  Content="Automatic (from velocity)"
                                  IsChecked="{x:Bind ViewModel.Radar.StormMotionAuto, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Derive the storm motion from the radar's own VAD wind profile (Bunkers right-mover), like RadarScope"/>

                        <!-- Live auto estimate (e.g. "245° at 18 kt · Bunkers R"); shown only in Auto mode. -->
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="26,0,0,0"
                                   Text="{x:Bind ViewModel.Radar.AutoStormMotionText, Mode=OneWay}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind VisibleWhen(ViewModel.Radar.StormMotionAuto), Mode=OneWay}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Speed (kt)" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <NumberBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" MinWidth="120"
                                   Minimum="0" Maximum="120" SmallChange="1" LargeChange="5"
                                   SpinButtonPlacementMode="Compact"
                                   IsEnabled="{x:Bind ViewModel.Radar.StormMotionManual, Mode=OneWay}"
                                   Value="{x:Bind ViewModel.Radar.StormMotionSpeedKt, Mode=TwoWay}"
                                   ToolTipService.ToolTip="Manual storm motion speed in knots (0 = SRV equals base velocity)"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Toward (°)" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <NumberBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" MinWidth="120"
                                   Minimum="0" Maximum="360" SmallChange="5" LargeChange="10"
                                   SpinButtonPlacementMode="Compact"
                                   IsEnabled="{x:Bind ViewModel.Radar.StormMotionManual, Mode=OneWay}"
                                   Value="{x:Bind ViewModel.Radar.StormMotionDirectionDeg, Mode=TwoWay}"
                                   ToolTipService.ToolTip="Manual compass bearing the storm is moving toward (0 = N, 90 = E)"/>
                    </Grid>
                </Grid>
            </ctl:ControlCard.CardBody>
        </ctl:ControlCard>
    </Grid>
</UserControl>
