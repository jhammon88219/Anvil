<?xml version="1.0" encoding="utf-8"?>
<!-- RadarSiteExplorerWindow — a non-modal, searchable master–detail browser over the WHOLE radar network the
     app can access (operational WSR-88D, research/test, TDWR). Floats over the map (map stays live),
     opened by the "Sites" button on the bar (left of the Settings cog). Shares the OverlayBar surface
     chrome but is its own larger footprint. Bound to the coordinator
     MapViewModel (like SettingsWindow): it reaches into ViewModel.SiteExplorer.* for the list/detail
     and ViewModel.IsSiteExplorerOpen for its own visibility/close.

       Radar Sites   118 of 204                       [lock][pin]   ← own title + live count
       [ Search ICAO or name…    ] [All networks ▾] [x] Online only [x] Favorites only
       ┌── list (360px) ─────────────┐   detail (scrolls, capped 760 wide, left-aligned)
       │ HOME                        │   KTLX        (● Online) (Operational) [★] [⌂ Home site] [On map]
       │ ● KTLX ⌂       Operational ☆│   Norman
       │ FAVORITES · 2               │   ───────────────────────────────────────────────────────────── hairline
       │ ● KFWS         Operational ★│   LATEST SCAN   12:06 PM (4 min ago)     ┌──────────────────┐
       │ ALL SITES · 201             │   SCAN MODE     VCP 35 · clear-air      │  [cam]           │ ← PLACEHOLDER
       │ ○ KABR         Operational ☆│   COORDINATES   35.333, -97.278         │  Site photo      │   240×135
       │ …                           │   DISTANCE      142 mi from your loc.   └──────────────────┘
       └─────────────────────────────┘

     SECTIONS (Home / Favorites · n / All sites · n) come from a grouped CollectionViewSource over
     SiteExplorer.SiteGroups. ⚠️ Its Source is set in code when ViewModel lands (OnViewModelChanged) — a CVS
     can't x:Bind — and it must land BEFORE the SelectedItem binding runs, which the DP callback order gives.
     A row sits in ONE section. The row's ☆/★ toggles favorite without selecting the row; [★] and [⌂] in the
     header act on the selected site (RadarSiteFavoritesViewModel). Home is one site: setting it moves it.

     The header owns the action: the button reads "On map" (disabled) while the selected site IS the
     map's site. Chips are neutral pills; only the status dot carries colour. The DISTANCE row collapses
     when there's no location marker, so it never leaves a hole.

     The row's network label sits flush RIGHT only because the item container stretches its content
     (HorizontalContentAlignment=Stretch) — without it the row Grid shrinks and the label hugs the name.
     The photo panel is a dummy: nothing feeds it yet (no bundled per-site photos exist).

     No outer frame in the sketch because there is none in the app either — the OS caption is the only
     chrome, and content extends into it, which is why the title + count row is drawn here.

     The list selection FOLLOWS the map's radar site (marker click → that row selected, scrolled into
     view, even while the window is closed), and "Load on map" greys out while the selected row IS the
     map's site. A search/filter that hides the loaded site keeps it in the detail pane.

     ⚠️ The detail's live scan info has TWO sources, and the split is deliberate: the site the LOOP is
     on reads its time straight off RadarViewModel (no fetch — re-fetching it would download the whole
     chunks listing and clobber the shared live cache), every other site asks
     ILevel2RadarService.GetLatestScanAsync. -->

<UserControl x:Class="Anvil.Controls.Windows.RadarSiteExplorerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Anvil.Controls.Primitives"
             xmlns:conv="using:Anvil.Converters"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:win="using:Anvil.Controls.Windows"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:OfflineToBrushConverter x:Key="OfflineToBrush"/>

        <!-- The list's sections. Source set in code-behind (see the header). -->
        <CollectionViewSource x:Key="SiteGroupsSource" IsSourceGrouped="True"/>

        <!-- Small caps field label in the detail pane. -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="40"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>
        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- Root Grid -->
    <!-- Dark surface fills the whole window; content sits top-left. -->
    <Grid Background="{ThemeResource OverlayBarSurfaceBrush}">
            <Grid RowSpacing="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- title -->
                    <RowDefinition Height="Auto"/> <!-- search + filters -->
                    <RowDefinition Height="*"/>    <!-- body: list | detail -->
                </Grid.RowDefinitions>

                <!-- Content extends into the title bar (the native caption shows only the buttons), so
                     the panel carries its own title + the live result count. -->
                <Grid Grid.Row="0" Margin="16,14,16,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Radar Sites"
                               FontSize="15" FontWeight="SemiBold" CharacterSpacing="40"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.SiteExplorer.ResultCountText, Mode=OneWay}"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>

                <!-- Search + filters. -->
                <Grid Grid.Row="1" Margin="16,0,16,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             PlaceholderText="Search ICAO or name…"
                             Text="{x:Bind ViewModel.SiteExplorer.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox Grid.Column="1" MinWidth="130"
                              SelectedIndex="{x:Bind ViewModel.SiteExplorer.SelectedClassIndex, Mode=TwoWay}"
                              ToolTipService.ToolTip="Filter by network">
                        <ComboBoxItem Content="All networks"/>
                        <ComboBoxItem Content="Operational"/>
                        <!-- Greyed while Settings → Radar hides the network (the list hides its sites too). -->
                        <ComboBoxItem Content="Research"
                                      IsEnabled="{x:Bind ViewModel.SiteExplorer.IsResearchFilterEnabled, Mode=OneWay}"/>
                        <ComboBoxItem Content="TDWR"
                                      IsEnabled="{x:Bind ViewModel.SiteExplorer.IsTdwrFilterEnabled, Mode=OneWay}"/>
                    </ComboBox>
                    <CheckBox Grid.Column="2" Content="Online only"
                              VerticalAlignment="Center"
                              IsChecked="{x:Bind ViewModel.SiteExplorer.OnlineOnly, Mode=TwoWay}"/>
                    <CheckBox Grid.Column="3" Content="Favorites only"
                              VerticalAlignment="Center"
                              IsChecked="{x:Bind ViewModel.SiteExplorer.FavoritesOnly, Mode=TwoWay}"/>
                </Grid>

                <!-- Body: site list (left) | detail (right). Side + bottom inset. -->
                <Grid Grid.Row="2"
                      Margin="16,0,16,14"
                      ColumnSpacing="14">
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: the filtered site list. -->
                    <Border Grid.Column="0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <ListView ItemsSource="{Binding Source={StaticResource SiteGroupsSource}}"
                                  SelectedItem="{x:Bind ViewModel.SiteExplorer.SelectedSite, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  Loaded="OnSiteListLoaded"
                                  SelectionChanged="OnSiteListSelectionChanged">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderContainerStyle>
                                        <Style TargetType="ListViewHeaderItem">
                                            <Setter Property="MinHeight" Value="0"/>
                                            <Setter Property="Padding" Value="10,10,10,4"/>
                                        </Style>
                                    </GroupStyle.HeaderContainerStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate x:DataType="vm:RadarSiteGroup">
                                            <TextBlock Text="{x:Bind Header}" Style="{StaticResource FieldLabelStyle}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:RadarSiteRow">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Status dot (online/offline). -->
                                        <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                                                 Fill="{x:Bind IsOffline, Converter={StaticResource OfflineToBrush}, Mode=OneWay}"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Id}" FontWeight="SemiBold" FontSize="13"/>
                                                <FontIcon Glyph="&#xE80F;" FontSize="11" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          Visibility="{x:Bind win:RadarSiteExplorerWindow.ShowIf(IsHome), Mode=OneWay}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Name}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ClassLabel}" FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <!-- Favorite star: toggles without selecting the row (the Button takes the click). -->
                                        <Button Grid.Column="3" VerticalAlignment="Center"
                                                Padding="6,4" MinWidth="0" MinHeight="0"
                                                Background="Transparent" BorderThickness="0"
                                                Click="OnRowFavoriteClick"
                                                ToolTipService.ToolTip="{x:Bind win:RadarSiteExplorerWindow.FavoriteToolTip(IsFavorite), Mode=OneWay}">
                                            <FontIcon FontSize="13"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      Glyph="{x:Bind win:RadarSiteExplorerWindow.StarGlyph(IsFavorite), Mode=OneWay}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- Right: detail pane for the selected site. -->
                    <Grid Grid.Column="1">
                        <!-- Empty hint when nothing is selected. -->
                        <TextBlock Text="Select a site to see its details."
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Visibility="{x:Bind CollapsedWhen(ViewModel.SiteExplorer.HasSelection), Mode=OneWay}"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{x:Bind VisibleWhen(ViewModel.SiteExplorer.HasSelection), Mode=OneWay}">
                        <!-- Width-capped + left-aligned: on a wide window the detail stays one compact block
                             instead of spreading its fields (and stranding the button) across the pane.
                             ⚠️ The cap is a star COLUMN's MaxWidth, not the Grid's MaxWidth+Left — a Left-aligned
                             Grid sizes to content, which collapses the * columns and un-pins the button. -->
                        <Grid RowSpacing="12"
                              VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="760"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- header: title | chips | action -->
                                <RowDefinition Height="Auto"/> <!-- hairline -->
                                <RowDefinition Height="Auto"/> <!-- body: fields | photo -->
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/> <!-- status chip -->
                                    <ColumnDefinition Width="Auto"/> <!-- network chip -->
                                    <ColumnDefinition Width="Auto"/> <!-- favorite -->
                                    <ColumnDefinition Width="Auto"/> <!-- home -->
                                    <ColumnDefinition Width="Auto"/> <!-- load -->
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{x:Bind ViewModel.SiteExplorer.DetailId, Mode=OneWay}"
                                               FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="{x:Bind ViewModel.SiteExplorer.DetailName, Mode=OneWay}"
                                               FontSize="13" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <!-- Status chip: neutral pill, the dot is the only colour. -->
                                <Border Grid.Column="1" VerticalAlignment="Center"
                                        CornerRadius="11" Padding="10,3"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind SelectedStatusBrush(ViewModel.SiteExplorer.SelectedSite), Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SiteExplorer.DetailStatusText, Mode=OneWay}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" VerticalAlignment="Center"
                                        CornerRadius="11" Padding="10,3"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.SiteExplorer.DetailClassLabel, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>

                                <Button Grid.Column="3" VerticalAlignment="Center"
                                        Margin="8,0,0,0"
                                        Click="OnDetailFavoriteClick"
                                        ToolTipService.ToolTip="{x:Bind win:RadarSiteExplorerWindow.FavoriteToolTip(ViewModel.SiteExplorer.SelectedSite.IsFavorite), Mode=OneWay}">
                                    <FontIcon FontSize="16"
                                              Glyph="{x:Bind win:RadarSiteExplorerWindow.StarGlyph(ViewModel.SiteExplorer.SelectedSite.IsFavorite), Mode=OneWay}"/>
                                </Button>

                                <Button Grid.Column="4" VerticalAlignment="Center"
                                        Click="OnDetailHomeClick"
                                        ToolTipService.ToolTip="{x:Bind win:RadarSiteExplorerWindow.HomeToolTip(ViewModel.SiteExplorer.SelectedSite.IsHome), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE80F;"/>
                                        <TextBlock Text="{x:Bind win:RadarSiteExplorerWindow.HomeLabel(ViewModel.SiteExplorer.SelectedSite.IsHome), Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="5" VerticalAlignment="Center" MinWidth="120"
                                        Click="OnLoadClick"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="{x:Bind ViewModel.SiteExplorer.LoadButtonText, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.SiteExplorer.CanLoadOnMap, Mode=OneWay}"/>
                            </Grid>

                            <Rectangle Grid.Row="1" Height="1"
                                       Fill="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>

                            <Grid Grid.Row="2" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>

                                <!-- Label | value sheet. -->
                                <Grid Grid.Column="0" ColumnSpacing="16" RowSpacing="10" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="LATEST SCAN" VerticalAlignment="Center"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <!-- Spinner and value share ONE cell so the ring never indents the value: laid
                                         out side by side, an inactive ring still reserves its width and pushed this
                                         line out of line with every other field. They can't collide — the value is
                                         empty for exactly as long as the fetch is in flight (see LatestScanText). -->
                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="{x:Bind ViewModel.SiteExplorer.LatestScanText, Mode=OneWay}"
                                                   Style="{StaticResource FieldValueStyle}"/>
                                        <ProgressRing Width="14"
                                                      Height="14"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      IsActive="{x:Bind ViewModel.SiteExplorer.IsLoadingScanInfo, Mode=OneWay}"
                                                      Visibility="{x:Bind VisibleWhen(ViewModel.SiteExplorer.IsLoadingScanInfo), Mode=OneWay}"/>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="SCAN MODE" VerticalAlignment="Center"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{x:Bind ViewModel.SiteExplorer.VcpModeText, Mode=OneWay}"
                                               Style="{StaticResource FieldValueStyle}"/>

                                    <TextBlock Grid.Row="2" Text="COORDINATES" VerticalAlignment="Center"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{x:Bind ViewModel.SiteExplorer.DetailCoords, Mode=OneWay}"
                                               Style="{StaticResource FieldValueStyle}"/>

                                    <!-- Collapses with no location marker, so it never leaves a gap. -->
                                    <TextBlock Grid.Row="3" Text="DISTANCE" VerticalAlignment="Center"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Visibility="{x:Bind VisibleWhenText(ViewModel.SiteExplorer.DetailDistanceText), Mode=OneWay}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Text="{x:Bind ViewModel.SiteExplorer.DetailDistanceText, Mode=OneWay}"
                                               Style="{StaticResource FieldValueStyle}"
                                               Visibility="{x:Bind VisibleWhenText(ViewModel.SiteExplorer.DetailDistanceText), Mode=OneWay}"/>
                                </Grid>

                                <!-- Site photo — DUMMY placeholder; nothing feeds it yet. 16:9. -->
                                <Border Grid.Column="1" Height="135" VerticalAlignment="Top"
                                        CornerRadius="8" BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                        <FontIcon Glyph="&#xE722;" FontSize="24"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="Site photo" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

        <!-- Lock (no move/resize) + pin (keep on top). -->
        <ctl:LockToggle IsChecked="{x:Bind ViewModel.IsSiteExplorerLocked, Mode=TwoWay}"/>
        <ctl:PinToggle IsChecked="{x:Bind ViewModel.IsSiteExplorerOnTop, Mode=TwoWay}"/>
    </Grid>
</UserControl>
