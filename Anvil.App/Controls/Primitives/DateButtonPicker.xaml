<?xml version="1.0" encoding="utf-8"?>
<!-- DateButtonPicker — a whole calendar date (MM/DD/YYYY) behind ONE button, so a form spends half a row on
     it instead of a CalendarDatePicker's full one. Built for PastCast's Timeframe (Date | Start Time on one
     row); TimeButtonPicker is its twin and the two flyouts are the SAME SIZE on purpose.

       CLOSED   [ 📅 05/24/2011           ˅ ]     the COMMITTED Date, invariant MM/dd/yyyy

       OPEN     ┌──────────────────────────┐      280 × 392 (256 × 368 + the presenter's 12 padding) —
                │ [ May           ˅][2011˅]│      TimeButtonPicker's exact size; change both
                │ Su Mo Tu We Th Fr Sa     │      ← DAYS view (6 weeks; other months' days dim, inert)
                │  1  2  3  4  5  6  7     │      Month ˅ swaps the grid for 12 MONTHS, Year ˅ for every
                │  …     [24]  …           │        YEAR MinDate..MaxDate; a pick there returns to DAYS
                │                          │      days outside MinDate..MaxDate are disabled
                │ [05/24/2011    ] MM/DD/YYYY      typing a valid in-range date moves the draft too
                │ [         Set          ] │      ← the ONLY commit: writes Date, closes
                └──────────────────────────┘

     ⚠️ EVERYTHING IN THE FLYOUT IS A DRAFT. Date is written in exactly one place, OnSetClick. Light-dismiss
     (click away, Esc) discards the draft and the next open re-seeds from Date. No month arrows (the user's
     call, 2026-10-02) — Month ˅ / Year ˅ do the moving.
     ⚠️ Set writes LOCAL MIDNIGHT built from PARTS (see RadarViewModel.LocalMidnight's two traps): the host's
     date facade reads the value's own Y/M/D, and a DateTime-based constructor can throw.
     ⚠️ The flyout is WINDOWED (ShouldConstrainToRootBounds="False") and OPAQUE, as on SectionedComboBox: the
     host is an owned panel window and the default flyout brush is acrylic.
     The calendar body is THREE DECLARED PAGES (days / months / years) in one cell, one shown at a time; Render only
     lists each page's cells (CalendarCells) and picks the page. A cell's look is one of three templates (a plain
     cell, the selected one, or another month's inert day) — UI is defined here, never built in code. -->
<UserControl x:Class="Anvil.Controls.Primitives.DateButtonPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Anvil.Controls.Primitives"
             xmlns:layout="using:Anvil.Layout"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- ⚠️ The weekday letters + other months' days get their colour from a STYLE (ThemeResource), never a
             brush looked up in C# (that returns the OS theme's brush, not the app's pinned theme). -->
        <Style x:Key="WeekdayTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>
        <Style x:Key="OtherMonthTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
        </Style>

        <!-- A calendar cell: flat until hovered. The selected cell is SelectedCellStyle (accent). -->
        <Style x:Key="CellStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="SelectedCellStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <!-- THE THREE CELLS. Plain and Selected are buttons (Pick on click; disabled outside MinDate..MaxDate);
             Inert is a neighbouring month's day — shown for the calendar's shape, never clickable. -->
        <DataTemplate x:Key="PlainCellTemplate" x:DataType="local:CalendarCell">
            <Button Style="{StaticResource CellStyle}" Content="{x:Bind Text}" IsEnabled="{x:Bind IsEnabled}"
                    Click="{x:Bind Pick}"/>
        </DataTemplate>
        <DataTemplate x:Key="SelectedCellTemplate" x:DataType="local:CalendarCell">
            <Button Style="{StaticResource SelectedCellStyle}" Content="{x:Bind Text}" IsEnabled="{x:Bind IsEnabled}"
                    Click="{x:Bind Pick}"/>
        </DataTemplate>
        <DataTemplate x:Key="InertCellTemplate" x:DataType="local:CalendarCell">
            <TextBlock Style="{StaticResource OtherMonthTextStyle}" Text="{x:Bind Text}"/>
        </DataTemplate>
        <local:CalendarCellTemplateSelector x:Key="CellSelector"
                                            Plain="{StaticResource PlainCellTemplate}"
                                            Selected="{StaticResource SelectedCellTemplate}"
                                            Inert="{StaticResource InertCellTemplate}"/>
        <DataTemplate x:Key="WeekdayTemplate" x:DataType="x:String">
            <TextBlock Style="{StaticResource WeekdayTextStyle}" Text="{x:Bind}"/>
        </DataTemplate>
    </UserControl.Resources>

    <Button x:Name="Face" Height="32" Padding="10,0"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- E787 Calendar — NOT verified on screen. -->
            <FontIcon Glyph="&#xE787;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14"
                      VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="FaceText" Grid.Column="1" VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis"/>
            <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12"
                      VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <Button.Flyout>
            <Flyout x:Name="PickerFlyout" ShouldConstrainToRootBounds="False"
                    Placement="BottomEdgeAlignedLeft" Opening="OnFlyoutOpening">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"/>
                        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}"/>
                        <Setter Property="Padding" Value="12"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled"/>
                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled"/>
                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                    </Style>
                </Flyout.FlyoutPresenterStyle>

                <!-- ⚠️ 256 × 368 = TimeButtonPicker's panel. The two flyouts are one size (the user's call). -->
                <Grid Width="256" Height="368" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Month ˅ · Year ˅ -->
                        <RowDefinition Height="*"/>    <!-- days | months | years -->
                        <RowDefinition Height="Auto"/> <!-- typed -->
                        <RowDefinition Height="Auto"/> <!-- Set -->
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="84"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MonthButton" Height="30" Padding="10,0" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" Click="OnMonthHeaderClick">
                            <Grid>
                                <TextBlock x:Name="MonthLabel" FontSize="12" VerticalAlignment="Center"/>
                                <FontIcon Glyph="&#xE70D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="10"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Button>
                        <Button x:Name="YearButton" Grid.Column="1" Height="30" Padding="10,0" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" Click="OnYearHeaderClick">
                            <Grid>
                                <TextBlock x:Name="YearLabel" FontSize="12" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular"/>
                                <FontIcon Glyph="&#xE70D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="10"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- THE BODY: one page shown at a time (Render). -->
                    <Grid x:Name="Body" Grid.Row="1">
                        <!-- DAYS: the weekday letters (22 tall), then six weeks. -->
                        <Grid x:Name="DaysPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ItemsControl x:Name="WeekdayCells" IsTabStop="False" ItemTemplate="{StaticResource WeekdayTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <layout:UniformCellsPanel Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl x:Name="DayCells" Grid.Row="1" IsTabStop="False"
                                          ItemTemplateSelector="{StaticResource CellSelector}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <layout:UniformCellsPanel Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                        <!-- MONTHS: 4 × 3. -->
                        <ItemsControl x:Name="MonthCells" IsTabStop="False" Visibility="Collapsed"
                                      ItemTemplateSelector="{StaticResource CellSelector}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <layout:UniformCellsPanel Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- YEARS: MinDate..MaxDate, 4 across. -->
                        <ItemsControl x:Name="YearCells" IsTabStop="False" Visibility="Collapsed"
                                      ItemTemplateSelector="{StaticResource CellSelector}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <layout:UniformCellsPanel Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Typed" MinHeight="30" FontSize="12" MaxLength="10"
                                 Typography.NumeralAlignment="Tabular" PlaceholderText="MM/DD/YYYY"
                                 TextChanged="OnTypedChanged"/>
                        <TextBlock Grid.Column="1" Text="MM/DD/YYYY" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </Grid>

                    <Button Grid.Row="3" Content="Set" Height="32" HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}" Click="OnSetClick"/>
                </Grid>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
