<?xml version="1.0" encoding="utf-8"?>
<!-- LiveDataSettingsConsoleWeatherWire — Settings → Live Data's "Weather Wire account" section, on a Primitives/SettingsConsolePlate:
     the NOAA Weather Wire (NWWS-OI) sign-in.

       Weather Wire account                                                       (no Restore defaults, no DEFAULT)
       User name  [firstname.lastname                     ]   From the NWS · one computer at a time
       Password   [Saved — type to replace                ]   Kept in Windows Credential Manager
                  [Save account] [Test connection]             Signed in. The account works.   ← the account message
       96         420                                          hint (one line; the message runs on into Default)

     ⚠️ Every row is a Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText by AboutKey). GREYED unless the
     source is NOAA Weather Wire — each CONTROL greys (not the rows), so a greyed row can still be picked to read its About.
     An account is YOURS: no DEFAULT, no Restore defaults, and Reset all keeps it.
     ⚠️ The password lives ONLY in Credential Manager (ICredentialStore), never AppSettings: the PasswordBox hands it to the VM
     from code-behind (SetPendingPassword), never through a binding. Sign-in confirmed live 2026-11-18. -->
<UserControl x:Class="Anvil.Controls.LiveDataSettingsConsoles.LiveDataSettingsConsoleWeatherWire"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="LiveDataSettingsConsoleWeatherWirePlate" Title="Weather Wire account">
        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <prim:SettingsConsoleRow Label="User name" AboutKey="wire.user">
                <TextBox x:Name="NwwsUsernameTextBox" PlaceholderText="firstname.lastname"
                         IsEnabled="{x:Bind ViewModel.IsNwws, Mode=OneWay}"
                         Text="{x:Bind ViewModel.NwwsUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Password" AboutKey="wire.password">
                <PasswordBox x:Name="NwwsPasswordBox"
                             IsEnabled="{x:Bind ViewModel.IsNwws, Mode=OneWay}"
                             PlaceholderText="{x:Bind ViewModel.PasswordPlaceholder, Mode=OneWay}"
                             PasswordChanged="OnPasswordChanged"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow AboutKey="wire.account" HintSpansDefault="True"
                                     Hint="{x:Bind AccountHint(ViewModel.IsNwws, ViewModel.AccountMessage), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="NwwsSaveAccountButton" Content="Save account" Click="OnSaveAccountClick"
                            IsEnabled="{x:Bind ViewModel.IsNwws, Mode=OneWay}"
                            ToolTipService.ToolTip="Saves the password in Windows Credential Manager and connects"/>
                    <Button x:Name="NwwsTestConnectionButton" Content="Test connection" Click="OnTestConnectionClick"
                            IsEnabled="{x:Bind TestEnabled(ViewModel.IsNwws, ViewModel.CanTest), Mode=OneWay}"
                            ToolTipService.ToolTip="Signs in to NOAA Weather Wire and straight back out"/>
                </StackPanel>
            </prim:SettingsConsoleRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
