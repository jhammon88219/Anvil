<?xml version="1.0" encoding="utf-8"?>
<!-- DragMoveLayerExpanderAlertsBody — the controls for ONE convective-alert overlay: a card, one row per phenomenon
     (Tornado / Severe thunderstorm), and overlay opacity. Used TWICE in the NowCast window — once for the
     watch boxes, once for the storm-based warnings — bound to a PhenomOverlayViewModel each time.

     ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓   the card (DragMoveLayerExpanderHeaderCard, FLUSH
     ▓  9 active warnings                               ▓   under the header, same grey, text on the body's
     ▓  1 tornado emergency · 1 PDS tornado             ▓   left edge): the total in effect, the ELEVATED tags
     ▓  Updated 12:04 PM · checking every 15s           ▓   (CardThreats, warnings only, collapses when none),
     ──────────────────────────────────────────────────────  when it was last confirmed, and a footer ONLY on a
                                                             failure — ⚠️ never a line about the ticked rows
       [ ] ■ Tornado               2                    ← one row per phenomenon: the toggle, the
       [x] ■ Severe thunderstorm   5                      map colour, the name, that type's count — counts
       [x] ■ Flash flood           2                    ← right-aligned against the LONGEST name; the flood row: "Flash flood" (warnings, FF) or
                                                          "Flood" (watches, FA/FL/FF, sea green) —
                                                          FloodLabel/FloodColor from the VM

     ⚠️ OPACITY IS NOT HERE — it lives in the host's section header (DragMoveLayerExpander ShowOpacity), so it can be
     set with the section closed.

     ⚠️ IT IS THE STORM-REPORT ROWS, DELIBERATELY. DragMoveLayerExpanderStormReportsBody draws the same card over the same
     kind of type rows one section below, so the two read as one control used three times rather than as
     three separate forms. The one visual difference is the SWATCH SHAPE: alerts are SQUARE (they are
     areas on the map), reports are ROUND (they are dots). That is the only thing keeping five near
     identical rows apart, so do not square the dots or round these.

     ⚠️ THERE IS NO MASTER SHOW/HIDE ROW. It used to be one checkbox reading "Tornado / Severe
     Thunderstorm" with the counts stranded on a separate "Active" line below it; splitting the checkbox
     in two put the count on the line that switches it and left nothing for a master to do. The layer is
     on when either type is on AND its mode runs (PhenomOverlayViewModel.AnyShown + IsModeActive). The
     select-all lives in the HOST's section header (TemporalWindowNowCastContent), not here.

     ⚠️ The swatch colours are the phenom colours the map draws (watches.js / warnings.js, both TO red /
     SV yellow; warnings.js FF green; watches.js FA sea green = WatchFlood.Color). They are literals in both
     places — change one, change the other.

     ⚠️ THE SECTION HEADING IS NOT HERE — the host draws its own above this control (TemporalWindowNowCastContent writes
     "Watches" over one instance and "Warnings" over the other). The window owns its section structure;
     this is content. Same rule as DragMoveLayerExpanderStormReportsBody, and the reason there is no divider in here either.

     ⚠️ The two instances are IDENTICAL on screen — same two names, same two colours, one section apart —
     so the headings carry the whole distinction between them. That is exactly why the old shared
     "Watches and warnings" heading had to become two. -->
<UserControl x:Class="Anvil.Controls.TemporalWindows.DragMoveLayerExpanders.DragMoveLayerExpanderAlertsBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tw="using:Anvil.Controls.TemporalWindows"
             xmlns:dragMoveLayerExpanders="using:Anvil.Controls.TemporalWindows.DragMoveLayerExpanders"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- the card (its bottom edge is the rule) -->
            <RowDefinition Height="Auto"/> <!-- the type rows -->
        </Grid.RowDefinitions>

        <!-- THE CARD, flush under the section header (DragMoveLayerExpanderHeaderCard — every expander's top
             card; its bottom edge is the rule). Like the storm
             reports' and the outlook's it is a RESULT — the polygons appear as you switch types on — so
             it carries no button. -->
        <dragMoveLayerExpanders:DragMoveLayerExpanderHeaderCard Grid.Row="0"
                Headline="{x:Bind ViewModel.CardHeadline, Mode=OneWay}"
                Threats="{x:Bind ViewModel.CardThreats, Mode=OneWay}"
                Context="{x:Bind ViewModel.CardContext, Mode=OneWay}"
                Footer="{x:Bind ViewModel.CardFooter, Mode=OneWay}"/>

        <!-- THE TYPE ROWS: ONE grid, so the NAME column is as wide as the LONGEST name and every count sits
             right-aligned just past it (a count used to sit at the far right edge, a long way from its name).
             ⚠️ Each CheckBox SPANS the whole row with no content of its own; the swatch, name and count sit OVER
             it in the shared columns, IsHitTestVisible False — so a click anywhere on the row still toggles,
             exactly as when they were the CheckBox's content. (WinUI has no SharedSizeGroup — one grid is the
             only way separate rows share a column width.)
             ⚠️ Column 0 + ColumnSpacing = 28, the stock CheckBox's box + content padding, so the swatch lands
             where the CheckBox's own content used to start.
             ⚠️ Rows are spaced by a top Margin, NOT RowSpacing: RowSpacing still spaces a COLLAPSED row, which
             would leave a gap under the watches instance where its (absent) flood row would be. -->
        <Grid Grid.Row="1" ColumnSpacing="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="19"/>   <!-- the CheckBox's own box -->
                <ColumnDefinition Width="Auto"/> <!-- swatch -->
                <ColumnDefinition Width="Auto"/> <!-- name: as wide as the longest -->
                <ColumnDefinition Width="Auto"/> <!-- count, right-aligned against the names -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Tornado -->
                <RowDefinition Height="Auto"/> <!-- Severe thunderstorm -->
                <RowDefinition Height="Auto"/> <!-- the flood row -->
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0" Grid.ColumnSpan="5" MinWidth="0" HorizontalAlignment="Stretch"
                      IsChecked="{x:Bind ViewModel.ShowTornado, Mode=TwoWay}"
                      ToolTipService.ToolTip="{x:Bind TornadoTooltip(AlertNoun), Mode=OneWay}"/>
            <Border Grid.Row="0" Grid.Column="1" Width="11" Height="11" CornerRadius="2" IsHitTestVisible="False"
                    Background="#FF2A2A" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Tornado" FontSize="13" IsHitTestVisible="False"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Bind Fmt(ViewModel.TornadoCount), Mode=OneWay}"
                       FontSize="13" FontWeight="SemiBold" Margin="12,0,0,0" IsHitTestVisible="False"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

            <CheckBox Grid.Row="1" Grid.ColumnSpan="5" MinWidth="0" HorizontalAlignment="Stretch" Margin="0,9,0,0"
                      IsChecked="{x:Bind ViewModel.ShowSevere, Mode=TwoWay}"
                      ToolTipService.ToolTip="{x:Bind SevereTooltip(AlertNoun), Mode=OneWay}"/>
            <Border Grid.Row="1" Grid.Column="1" Width="11" Height="11" CornerRadius="2" IsHitTestVisible="False"
                    Background="#FFD21A" VerticalAlignment="Center" Margin="0,9,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Severe thunderstorm" FontSize="13" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="0,9,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{x:Bind Fmt(ViewModel.SevereCount), Mode=OneWay}"
                       FontSize="13" FontWeight="SemiBold" Margin="12,9,0,0" IsHitTestVisible="False"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

            <!-- The flood row: "Flash flood" on warnings, "Flood" on watches — name + swatch from the VM
                 (FloodLabel / FloodColor). All four parts collapse on an overlay without the type (SupportsFlashFlood). -->
            <CheckBox Grid.Row="2" Grid.ColumnSpan="5" MinWidth="0" HorizontalAlignment="Stretch" Margin="0,9,0,0"
                      Visibility="{x:Bind Shown(ViewModel.SupportsFlashFlood), Mode=OneWay}"
                      IsChecked="{x:Bind ViewModel.ShowFlashFlood, Mode=TwoWay}"
                      ToolTipService.ToolTip="{x:Bind FloodTooltip(ViewModel.FloodLabel, AlertNoun), Mode=OneWay}"/>
            <Border Grid.Row="2" Grid.Column="1" Width="11" Height="11" CornerRadius="2" IsHitTestVisible="False"
                    Visibility="{x:Bind Shown(ViewModel.SupportsFlashFlood), Mode=OneWay}"
                    Background="{x:Bind Swatch(ViewModel.FloodColor), Mode=OneWay}" VerticalAlignment="Center" Margin="0,9,0,0"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{x:Bind ViewModel.FloodLabel, Mode=OneWay}" FontSize="13"
                       Visibility="{x:Bind Shown(ViewModel.SupportsFlashFlood), Mode=OneWay}"
                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,9,0,0"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Text="{x:Bind Fmt(ViewModel.FlashFloodCount), Mode=OneWay}"
                       Visibility="{x:Bind Shown(ViewModel.SupportsFlashFlood), Mode=OneWay}"
                       FontSize="13" FontWeight="SemiBold" Margin="12,9,0,0" IsHitTestVisible="False"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
