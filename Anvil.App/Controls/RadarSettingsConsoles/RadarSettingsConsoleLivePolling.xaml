<?xml version="1.0" encoding="utf-8"?>
<!-- RadarSettingsConsoleLivePolling — Settings → Radar's "Live polling" section (was "NowCast live polling"), on a
     Primitives/SettingsConsolePlate. When the NowCast live poll checks for a new scan (docs/regime-aware-polling.md).

       Live polling  [Restore defaults]                                                            DEFAULT
       Check      [   Regime-aware   |    Fixed time    ]   On the radar's own scan plan       Regime-aware
       Every      [ 20 s | 30 s | 45 s | 60 s ]  ← GREYED unless Fixed time   Only with Fixed time     30 s
       96         420                                     hint (follows the pick)              150, right

     ⚠️ Every row is a Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText; the two hints that follow
     the pick are ModeHint / EveryHint, worded in that catalog).
     ⚠️ The pickers bind RadarViewModel's live-poll members (sealed engine): this only reads/writes them; Restore defaults is
     MapViewModel.ResetLivePolling. Both PERSISTED (AppSettings.RegimeAwarePolling / LivePollSeconds), applied next check. -->
<UserControl x:Class="Anvil.Controls.RadarSettingsConsoles.RadarSettingsConsoleLivePolling"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="RadarSettingsConsoleLivePollingPlate" Title="Live polling" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="LivePollingRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    ToolTipService.ToolTip="Put live polling back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <prim:SettingsConsoleRow Label="Check" AboutKey="poll.check" Default="{x:Bind ViewModel.DefaultLivePollingModeText}"
                                     Hint="{x:Bind ModeHint(ViewModel.Radar.IsFixedTimePolling), Mode=OneWay}">
                <prim:SegmentedPicker x:Name="LivePollingModePicker"
                                      ItemsSource="{x:Bind ViewModel.Radar.LivePollingModeLabels}"
                                      SelectedIndex="{x:Bind ViewModel.Radar.LivePollingModeIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Every" AboutKey="poll.every" Default="{x:Bind ViewModel.DefaultLivePollIntervalText}"
                                     Hint="{x:Bind EveryHint(ViewModel.Radar.IsFixedTimePolling), Mode=OneWay}">
                <prim:SegmentedPicker x:Name="LivePollIntervalPicker"
                                      IsEnabled="{x:Bind ViewModel.Radar.IsFixedTimePolling, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.Radar.LivePollIntervalLabels}"
                                      SelectedIndex="{x:Bind ViewModel.Radar.RefreshIntervalIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
