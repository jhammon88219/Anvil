<?xml version="1.0" encoding="utf-8"?>
<!-- RadarSettingsConsoleMemory — Settings → Radar's "Memory" section (was "Radar memory"), on a Primitives/SettingsConsolePlate.
     The RAM a PastCast loop may hold (Radar.Memory = RadarMemoryViewModel ← Models/RadarMemoryBudget).

       Memory  [Restore defaults]  ← greyed at the recommended value (was "Use recommended")                DEFAULT
       This PC        16 GB of RAM
       Radar may use  ─────●──────────────────────  4 GB    1 pane: 58+  2 panes: 46+  4 panes: 33+    4 GB (¼ of RAM)
                                                            High — over half your RAM …  ← CAUTION, only High / Low
       96             420 (slider * · value 56)             hint (one line)                         150, right

     ⚠️ THE COLUMNS (96 · 420 · * · 150) are the page's. PERSISTED (AppSettings.RadarMemoryGb; null = a quarter of RAM); it
     sizes the PastCast frame cap at each Load, NowCast is untouched. The caution line is its own TextBlock in the caution
     brush (never a brush in C#). The frame counts are WORST case: every pane a different dual-pol product. -->
<UserControl x:Class="Anvil.Controls.RadarSettingsConsoles.RadarSettingsConsoleMemory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="RadarSettingsConsoleMemoryPlate" Title="Memory" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="MemoryRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    IsEnabled="{x:Bind Not(ViewModel.Radar.Memory.IsRecommended), Mode=OneWay}"
                    ToolTipService.ToolTip="Back to the recommended quarter of your RAM (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <Grid ColumnSpacing="12" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock VerticalAlignment="Center" Text="This PC"/>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource TabularNumberTextStyle}"
                       Text="{x:Bind ViewModel.Radar.Memory.RamText}"/>

            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Radar may use"/>
            <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                <Slider x:Name="RadarMemorySlider" VerticalAlignment="Center"
                        Minimum="{x:Bind ViewModel.Radar.Memory.MinGb}" Maximum="{x:Bind ViewModel.Radar.Memory.MaxGb}"
                        StepFrequency="0.5" SmallChange="0.5" LargeChange="1" IsThumbToolTipEnabled="False"
                        Value="{x:Bind ViewModel.Radar.Memory.BudgetGb, Mode=TwoWay}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Style="{StaticResource TabularNumberTextStyle}"
                           Text="{x:Bind ViewModel.Radar.Memory.BudgetText, Mode=OneWay}"/>
            </Grid>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                        ToolTipService.ToolTip="The longest PastCast loop this allows, with every pane a different dual-pol product. NowCast loops always fit.">
                <TextBlock Style="{StaticResource SettingsConsoleHintTextStyle}" Text="{x:Bind ViewModel.Radar.Memory.OnePaneText, Mode=OneWay}"/>
                <TextBlock Style="{StaticResource SettingsConsoleHintTextStyle}" Text="{x:Bind ViewModel.Radar.Memory.TwoPaneText, Mode=OneWay}"/>
                <TextBlock Style="{StaticResource SettingsConsoleHintTextStyle}" Text="{x:Bind ViewModel.Radar.Memory.FourPaneText, Mode=OneWay}"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.DefaultRadarMemoryText}"/>

            <!-- Only while High (over half of RAM) or Low (4-pane loops on the frame floor): the caution line, in the HINT column. -->
            <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="12"
                       Foreground="{ThemeResource SettingsCautionForegroundBrush}"
                       Visibility="{x:Bind Shown(ViewModel.Radar.Memory.IsWarning), Mode=OneWay}"
                       Text="{x:Bind ViewModel.Radar.Memory.NoteText, Mode=OneWay}"/>
        </Grid>
    </prim:SettingsConsolePlate>
</UserControl>
