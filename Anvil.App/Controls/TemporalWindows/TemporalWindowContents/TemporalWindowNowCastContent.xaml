<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalWindowNowCastContent — the CONTENT of the NowCast window: storm cells, storm reports, warnings, watches and the radar layer, one
     LAYER SECTION each. One of three mode Contents (see Controls/TemporalWindows/TemporalWindow, registered once per
     mode); the window supplies the surface, the title and the pin, so this is content only.
     Named as the tree reads (TemporalWindow → TemporalWindowNowCastContent). Bound to the coordinator MapViewModel.

       ┌──────────────────────────────────────────────────────────────┐
       │  ┌──┐  NowCast                          │                   │  ← THE HEADER: FIXED, no section
       │  │██│                                   │  5:42 PM          │    header, can't collapse. Clock =
       │  └──┘  Monday Sep 28                    │  (console clock)  │    the MACHINE's time, no seconds
       │         ↑ the window's ONLY "NowCast" (TemporalWindow has no title row); date LEFT under it
       │   ↑ STATUS square (22 × row height): worst warning in effect, TO red → SV yellow → FF green; blue = none
       │  ┌▓▓▓▓▓▓▓▓▓▓▓▓▓┐ ┌▓▓▓▓▓▓▓▓▓▓▓▓▓┐ ┌▓▓▓▓▓▓▓▓▓▓▓▓▓┐           │  ← THE BAND (variant B, 2026-10-07): a DEEP
       │  │▓Tornado  ‹ ›▓│ │▓Severe   ‹ ›▓│ │▓Flash fl ‹ ›▓│           │    shade of the warning colour, the name +
       │  │ 5           │ │ 27          │ │ 8           │           │    ‹ › in the BRIGHT colour (risk-card style)
       │  │ ─────────── │ │ ─────────── │ │ ─────────── │           │  ← every warning IN EFFECT, not what the
       │  │▒Oklahoma▒▒3▒│ │ Texas     9 │ │ Mississip 6 │           │    Warnings rows show; a zero tile DIMS
       │  │ Kansas    2 │ │ Oklahoma  7 │ │ Louisiana 2 │           │  ← STATE LINES (*Stepper.States), 13 px
       │  │ 2 of 5 · Cle│ │ Kansas    5 │ │ 1 emergency │           │    whole-row buttons: most first; a
       │  │             │ │ …every state│ │             │           │    warning counts ONCE, in its first
       │  │             │ │ 4 destruct. │ │             │           │    county's state, so lines sum to the
       │  └─────────────┘ └─────────────┘ └─────────────┘           │    count. NO CAP — tiles grow.
       │   ↑ while its ‹ › have you on a warning the tag line reads   │  ‹ › = WarningStepper: › flies to the
       │     "2 of 3 · place · PDS" in accent (NO outline — removed)   │    next (worst first, wraps); ‹ = back
       │   ▒ = LIT line (accent wash + text): the state of that       │    stack, off until › used; the COUNT
       │     warning, or a CLICKED line — which frames + flashes ALL  │    resets. Flash even if unticked.
       │     its warnings ("All 3 in Oklahoma"); not on the ‹ stack,  │
       │     doesn't narrow the arrows                                │
       │ [x] Show ForeCast ghost rows                                 │  ← persisted, default off; doesn't scroll
       │ ⠿ › [x] Storm cells     ─────────────────●   100%            │  ← TOP of the list = TOP of the map
       │ ⠿ › [x] Storm reports   ─────────────────●   100%            │
       │ ⠿ ⌄ [x] Warnings        ─────────────────●   100%            │
       │   ┌──────────────────────────────────────────┐               │
       │   │ 7 active warnings                        │               │
       │   │ Updated 12:04 PM · checking every 15s    │               │
       │   └──────────────────────────────────────────┘               │
       │   [x] ■ Tornado                            0                 │
       │   [x] ■ Severe thunderstorm                7                 │
       │ ⠿ › [-] Watches         ─────────────────●   100%            │  [-] = some types ticked
       │ ⠿ › [x] Tropical        ─────────────────●   100%            │  hurricane / TS / surge / extreme-wind ZONES, NWS colours (DragMoveLayerExpanderTropicalBody)
       │ ⠿ › [x] Mesoscale discussions ───────────●   100%            │  MDs + MPDs: areas + what's in effect (reader = MD window)
       │ ⠿   ░░ ░SPC outlook · ForeCast░░░░░░░░░░░░░░░░░░░░           │  ← GHOST (IsGhost): ForeCast's layer, 25%,
       │                                                              │    drag-only; only while the box is on AND
       │                                                              │    ForeCast runs. Now + Fore = ONE order
       │ ⠿   [x] Radar           ──────────────●──     85%            │  ← no body: nothing to open
       └──────────────────────────────────────────────────────────────┘
         ↑ the sections sit in PanelScroller: a 16 px gutter on the right is ALWAYS claimed; its thumb
           draws only once they overflow. The header above does not scroll.

     ⚠️ THE ORDER OF THIS LIST IS THE MAP'S Z-ORDER, and the user owns it: drag a section by its grip ⠿ (or
     Alt+Up/Down) and OnLayersReordered hands the new order to MapViewModel.SetLayerOrder, which saves it
     (AppSettings.NowCastLayerOrder — separate from PastCast's) and restacks the map. The order below is the
     DEFAULT, matching layers.js DEFAULT_ORDER; a saved order is applied over it once, on first load.
     ⚠️ Each LayerId is a Models/Map/LayerOrder id, mirrored in layers.js GROUPS — change all three.

     ⚠️ THE HEADER CHECKBOX IS A SELECT-ALL for its section (VM ToggleAll / AllShown): all ticked → clears
     them, otherwise ticks them all (a partial [-] goes to all on). IsChecked is ONE-WAY and the click calls
     the VM. Radar has no type rows, so its box is the layer show/hide (RadarViewModel.ShowRadarLayer).
     ⚠️ EVERY BOX STARTS TICKED, and the map still launches clean: a tick means "draw while the mode runs"
     (IsModeActive, set in MapViewModel.OnTemporalModesChanged). Turning NowCast on brings them all up.

     ⚠️ OPACITY LIVES IN THE HEADER (DragMoveLayerExpander ShowOpacity), live while the section is closed, and
     disabled while the layer draws nothing (AnyShown / ShowRadarLayer).
     ⚠️ THE RADAR VALUE IS GLOBAL — one radar layer, shared by live and replay. PastCast shows the same
     slider; that is survivable only because Past and Now are mutually exclusive (their windows can't both
     be open).

     Warnings is the only section open on a FIRST run. Every section's open/closed state is then PERSISTED
     (DragMoveLayerExpanderHost.PersistExpansion → AppSettings.SectionExpanded, keys "now/<LayerId>"), and so is every
     tick and opacity here (ViewModels/Map/TemporalWindowPersistence).
     ⚠️ The window opens at a FIXED full height (WindowManager's Left anchor), not sized to this body, so the
     SECTIONS scroll inside Primitives/PanelScroller (the header stays put) — PastCast's arrangement.

     Both alert sections are the SAME control (TemporalWindows/DragMoveLayerExpanders/DragMoveLayerExpanderAlertsBody) bound to a different view
     model, exactly as watches.js and warnings.js are the same JS factory with a different config. Storm
     reports stay their own control — the PastCast window shows that same block, so it is content of TWO
     hosts.

     ⚠️ This tab does NOT arm or clear NowCast; that is the NowCast key in the bottom bar's centre cluster.
     A tab body configures a mode, the key runs it.

     THE HEADER is NowCast's twin of PastCast's Timeframe block: fixed above the sections, same padding, same
     height (Styles.xaml TemporalHeaderMinHeight, on both — the tiles row is STAR and takes the slack).
       • Name row — the status bar, "NowCast" over the date (weekday spelled out), then behind a hairline the
         clock, styled as a copy of the radar console's (the user's call, 2026-10-01). Zone + UTC + age moved
         into TOOLTIPS (clock / bar).
       • Clock — the machine's local time, ticked by a DispatcherTimer that runs only while this body is loaded
         (code-behind). The zone label is built from Windows' zone NAME ("Central Daylight Time" → "CDT").
       • STATUS SQUARE = the WORST warning in effect (user's call, 2026-10-19 — ForeCast's highest-risk theory):
         Tornado red → Severe yellow → Flash flood green, the tiles' Ink colours, counting every active warning;
         none = PastCast's blue. Feed freshness is the activity expander's job (it was this square's, until now).
       • Tiles — TemporalWindows/TemporalWindowNowCastWarningTile ×3. Warnings.TornadoCount/SevereCount/FlashFloodCount count EVERY active warning in the
         fetch, never the ticked rows (user's call). Tag lines = WarningThreatCounts, split per type. Stripe
         colours are DATA (the same literals as DragMoveLayerExpanderAlertsBody's swatches) — never themed. -->
<UserControl x:Class="Anvil.Controls.TemporalWindows.TemporalWindowContents.TemporalWindowNowCastContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tw="using:Anvil.Controls.TemporalWindows"
             xmlns:temporalWindowHeaderReadouts="using:Anvil.Controls.TemporalWindows.TemporalWindowHeaderReadouts"
             xmlns:temporalWindowContents="using:Anvil.Controls.TemporalWindows.TemporalWindowContents"
             xmlns:dragMoveLayerExpanders="using:Anvil.Controls.TemporalWindows.DragMoveLayerExpanders"
             xmlns:comp="using:Anvil.Controls.Composites"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:layout="using:Anvil.Layout"
             xmlns:conv="using:Anvil.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- the header: clock + warning tiles, always there -->
            <RowDefinition Height="Auto"/> <!-- "Show ForeCast ghost rows" -->
            <RowDefinition Height="*"/>    <!-- the sections, in the scroller -->
        </Grid.RowDefinitions>

        <!-- ===================== HEADER: clock, then the three warning tiles ===================== -->
        <!-- Bottom 12 + the ghost box's row = the gap before the first section header (it was a bare 24 before
             that row arrived).
             ⚠️ LEFT 0 / RIGHT 4 = the section STACK's own edges (the user's call, 2026-10-02 — it was inset 12 to the
             section bodies): PanelScroller.GutterWidth (16) − the scroller's 12 px bleed = 4 short of the right.
             PastCast's Timeframe rule exactly. Change them together. -->
        <Grid Grid.Row="0" Padding="0,12,4,12" MinHeight="{StaticResource TemporalHeaderMinHeight}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- status bar · NowCast │ time over date -->
                <RowDefinition Height="*"/>    <!-- the tiles (take the slack) -->
            </Grid.RowDefinitions>

            <!-- THE NAME ROW: TemporalWindows/TemporalWindowHeader (one control, all three windows; it owns its
                 height). The square = the WORST warning in effect (WarningsViewModel.HeaderSquareFill — ForeCast's
                 highest-risk square, matched); the date is written by the clock tick (code-behind); the clock
                 itself is TemporalWindowHeaderNowCastReadout. -->
            <tw:TemporalWindowHeader x:Name="TemporalWindowHeader" Grid.Row="0" Title="NowCast"
                                     StatusFill="{x:Bind ViewModel.Warnings.HeaderSquareFill, Mode=OneWay, Converter={StaticResource HexToBrush}}"
                                     StatusToolTip="{x:Bind ViewModel.Warnings.HeaderSquareTip, Mode=OneWay}">
                <temporalWindowHeaderReadouts:TemporalWindowHeaderNowCastReadout x:Name="TemporalWindowHeaderNowCastReadout"/>
            </tw:TemporalWindowHeader>

            <Grid Grid.Row="1" Margin="0,14,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- THE THREE TILES: TemporalWindows/TemporalWindowNowCastWarningTile, one control used three times
                     (x:Name = type name + hazard). Band colours are DATA literals (DragMoveLayerExpanderAlertsBody's swatches'
                     hues), never themed: DEEP band + BRIGHT ink per hazard. ⚠️ The Inks are MIRRORED as
                     WarningsViewModel.TornadoFill/SevereFill/FlashFloodFill (the header square) — change both. -->
                <tw:TemporalWindowNowCastWarningTile x:Name="TemporalWindowNowCastWarningTileTornado" Grid.Column="0"
                                                       Label="Tornado" Hazard="tornado"
                                                       BandFill="#611010" Ink="#FF2A2A"
                                                       ViewModel="{x:Bind ViewModel.Warnings.TornadoStepper, Mode=OneWay}"
                                                       Count="{x:Bind ViewModel.Warnings.TornadoCount, Mode=OneWay}"
                                                       Threats="{x:Bind ViewModel.Warnings.TornadoThreats, Mode=OneWay}"/>
                <tw:TemporalWindowNowCastWarningTile x:Name="TemporalWindowNowCastWarningTileSevere" Grid.Column="1"
                                                       Label="Severe" Hazard="severe thunderstorm"
                                                       BandFill="#61500A" Ink="#FFD21A"
                                                       ViewModel="{x:Bind ViewModel.Warnings.SevereStepper, Mode=OneWay}"
                                                       Count="{x:Bind ViewModel.Warnings.SevereCount, Mode=OneWay}"
                                                       Threats="{x:Bind ViewModel.Warnings.SevereThreats, Mode=OneWay}"/>
                <tw:TemporalWindowNowCastWarningTile x:Name="TemporalWindowNowCastWarningTileFlashFlood" Grid.Column="2"
                                                       Label="Flash flood" Hazard="flash flood"
                                                       BandFill="#115522" Ink="#2EE05A"
                                                       ViewModel="{x:Bind ViewModel.Warnings.FlashFloodStepper, Mode=OneWay}"
                                                       Count="{x:Bind ViewModel.Warnings.FlashFloodCount, Mode=OneWay}"
                                                       Threats="{x:Bind ViewModel.Warnings.FlashFloodThreats, Mode=OneWay}"/>
            </Grid>
        </Grid>

    <!-- THE SECTIONS SCROLL; the header above them doesn't. Primitives/PanelScroller — present whether or not
         the sections overflow yet (the user's call, 2026-09-30): its gutter is always claimed, the thumb only
         draws on overflow. ⚠️ Margin right -12 BLEEDS the gutter into the window's 16 px body margin (see the
         PanelScroller header): the gutter ends 4 px from the window edge, as in PastCast. -->
    <!-- GHOST ROWS box: ForeCast's layers (the outlook) as dimmed, drag-only rows among these, so you can say
         where the outlook draws. Persisted, default off; the rows show only while ForeCast runs too
         (MapViewModel's GHOST ROWS block). Above the sections — it isn't one of them, so it doesn't scroll. -->
    <CheckBox x:Name="ShowForeCastGhostRowsCheckBox" Grid.Row="1" Margin="0,0,0,8" Content="Show ForeCast ghost rows"
              IsChecked="{x:Bind ViewModel.ShowForeCastGhostRows, Mode=TwoWay}"
              ToolTipService.ToolTip="List ForeCast's layers here, dimmed, so you can drag NowCast's around them (shown while ForeCast is on)"/>

    <prim:PanelScroller Grid.Row="2" Margin="0,0,-12,0">
    <!-- ⚠️ TemporalWindows/DragMoveLayerExpanders/DragMoveLayerExpanderHost: its CHILD ORDER is the display order AND the map's z-order; it
         owns the drag, the saved order and the open/closed state. It holds ONLY DragMoveLayerExpanders. -->
    <dragMoveLayerExpanders:DragMoveLayerExpanderHost x:Name="DragMoveLayerExpanderHost" VerticalAlignment="Top" Spacing="8" Margin="{StaticResource TemporalListEndClearance}" Reordered="OnLayersReordered">

        <dragMoveLayerExpanders:DragMoveLayerExpander Header="Storm cells" LayerId="cells"
                           ShowCheckBox="True"
                           IsChecked="{x:Bind ViewModel.StormCells.AllShown, Mode=OneWay}"
                           CheckBoxClick="OnStormCellsHeaderClick"
                           CheckBoxToolTip="Show or hide every storm-cell mark"
                           ShowOpacity="True"
                           OpacityValue="{x:Bind ViewModel.StormCells.Opacity, Mode=TwoWay}"
                           IsOpacityEnabled="{x:Bind ViewModel.StormCells.AnyShown, Mode=OneWay}"
                           OpacityToolTip="Opacity of the storm-cell marks and tracks">
            <dragMoveLayerExpanders:DragMoveLayerExpanderStormCellsBody x:Name="DragMoveLayerExpanderStormCellsBody" ViewModel="{x:Bind ViewModel.StormCells, Mode=OneWay}"/>
        </dragMoveLayerExpanders:DragMoveLayerExpander>

        <dragMoveLayerExpanders:DragMoveLayerExpander Header="Storm reports" LayerId="reports"
                           ShowCheckBox="True"
                           IsChecked="{x:Bind ViewModel.StormReports.AllShown, Mode=OneWay}"
                           CheckBoxClick="OnStormReportsHeaderClick"
                           CheckBoxToolTip="Show or hide every report type"
                           ShowOpacity="True"
                           OpacityValue="{x:Bind ViewModel.StormReports.Opacity, Mode=TwoWay}"
                           IsOpacityEnabled="{x:Bind ViewModel.StormReports.AnyShown, Mode=OneWay}"
                           OpacityToolTip="Opacity of the storm-report dots">
            <dragMoveLayerExpanders:DragMoveLayerExpanderStormReportsBody x:Name="DragMoveLayerExpanderStormReportsBody" ViewModel="{x:Bind ViewModel.StormReports, Mode=OneWay}"/>
        </dragMoveLayerExpanders:DragMoveLayerExpander>

        <dragMoveLayerExpanders:DragMoveLayerExpander Header="Warnings" LayerId="warnings"
                           IsExpanded="True"
                           ShowCheckBox="True"
                           IsChecked="{x:Bind ViewModel.Warnings.AllShown, Mode=OneWay}"
                           CheckBoxClick="OnWarningsHeaderClick"
                           CheckBoxToolTip="Show or hide every warning type"
                           ShowOpacity="True"
                           OpacityValue="{x:Bind ViewModel.Warnings.Opacity, Mode=TwoWay}"
                           IsOpacityEnabled="{x:Bind ViewModel.Warnings.AnyShown, Mode=OneWay}"
                           OpacityToolTip="Opacity of the warning polygons (fill and outline together)">
            <dragMoveLayerExpanders:DragMoveLayerExpanderAlertsBody x:Name="DragMoveLayerExpanderAlertsBodyWarnings" AlertNoun="warnings"
                                     ViewModel="{x:Bind ViewModel.Warnings, Mode=OneWay}"/>
        </dragMoveLayerExpanders:DragMoveLayerExpander>

        <dragMoveLayerExpanders:DragMoveLayerExpander Header="Watches" LayerId="watches"
                           ShowCheckBox="True"
                           IsChecked="{x:Bind ViewModel.Watches.AllShown, Mode=OneWay}"
                           CheckBoxClick="OnWatchesHeaderClick"
                           CheckBoxToolTip="Show or hide every watch type"
                           ShowOpacity="True"
                           OpacityValue="{x:Bind ViewModel.Watches.Opacity, Mode=TwoWay}"
                           IsOpacityEnabled="{x:Bind ViewModel.Watches.AnyShown, Mode=OneWay}"
                           OpacityToolTip="Opacity of the watch boxes (fill and outline together)">
            <dragMoveLayerExpanders:DragMoveLayerExpanderAlertsBody x:Name="DragMoveLayerExpanderAlertsBodyWatches" AlertNoun="watches"
                                     ViewModel="{x:Bind ViewModel.Watches, Mode=OneWay}"/>
        </dragMoveLayerExpanders:DragMoveLayerExpander>

        <!-- Tropical: hurricane / tropical storm / storm surge / extreme wind watches + warnings as ZONES in the NWS
             colours, live. Shared control with the Past window (TropicalViewModel). -->
        <dragMoveLayerExpanders:DragMoveLayerExpander x:Name="TropicalSection" Header="Tropical" LayerId="tropical"
                           ShowCheckBox="True"
                           IsChecked="{x:Bind ViewModel.Tropical.AllShown, Mode=OneWay}"
                           CheckBoxClick="OnTropicalHeaderClick"
                           CheckBoxToolTip="Show or hide every tropical watch and warning"
                           ShowOpacity="True"
                           OpacityValue="{x:Bind ViewModel.Tropical.Opacity, Mode=TwoWay}"
                           IsOpacityEnabled="{x:Bind ViewModel.Tropical.AnyShown, Mode=OneWay}"
                           OpacityToolTip="Opacity of the tropical zones">
            <dragMoveLayerExpanders:DragMoveLayerExpanderTropicalBody x:Name="DragMoveLayerExpanderTropicalBody" ViewModel="{x:Bind ViewModel.Tropical, Mode=OneWay}"/>
        </dragMoveLayerExpanders:DragMoveLayerExpander>

        <!-- Mesoscale discussions: SPC MDs + WPC MPDs, drawn as in effect now, the last 24 h listed to read.
             Shared control with the Past window. A click on an MD's area opens THIS section (code-behind). -->
        <dragMoveLayerExpanders:DragMoveLayerExpander x:Name="DiscussionsSection" Header="Mesoscale discussions" LayerId="mds"
                           ShowCheckBox="True"
                           IsChecked="{x:Bind ViewModel.Discussions.AllShown, Mode=OneWay}"
                           CheckBoxClick="OnDiscussionsHeaderClick"
                           CheckBoxToolTip="Show or hide every discussion kind"
                           ShowOpacity="True"
                           OpacityValue="{x:Bind ViewModel.Discussions.Opacity, Mode=TwoWay}"
                           IsOpacityEnabled="{x:Bind ViewModel.Discussions.AnyShown, Mode=OneWay}"
                           OpacityToolTip="Opacity of the discussion areas and labels">
            <dragMoveLayerExpanders:DragMoveLayerExpanderMesoDiscussionsBody x:Name="DragMoveLayerExpanderMesoDiscussionsBody" ViewModel="{x:Bind ViewModel.Discussions, Mode=OneWay}"/>
        </dragMoveLayerExpanders:DragMoveLayerExpander>

        <!-- GHOST: ForeCast's outlook, placed in this shared stack. Drag-only (IsGhost); its box mirrors the real
             show/hide, inert. Collapsed = still in the run, so the saved order keeps its place. Default spot =
             the map's (above radar). -->
        <dragMoveLayerExpanders:DragMoveLayerExpander Header="SPC outlook · ForeCast" LayerId="outlook"
                           IsGhost="True" ShowCheckBox="True"
                           IsChecked="{x:Bind ViewModel.Outlook.IsShown, Mode=OneWay}"
                           Visibility="{x:Bind GhostVisibility(ViewModel.AreForeCastGhostsShown), Mode=OneWay}"
                           ToolTipService.ToolTip="ForeCast's layer — drag to set where it draws among NowCast's"/>

        <!-- Header only: the layer's show/hide and its opacity are all it has. -->
        <dragMoveLayerExpanders:DragMoveLayerExpander Header="Radar" LayerId="radar"
                           ShowCheckBox="True"
                           IsChecked="{x:Bind ViewModel.Radar.ShowRadarLayer, Mode=OneWay}"
                           CheckBoxClick="OnRadarHeaderClick"
                           CheckBoxToolTip="Show the radar layer"
                           ShowOpacity="True"
                           OpacityValue="{x:Bind ViewModel.Radar.RadarOpacity, Mode=TwoWay}"
                           IsOpacityEnabled="{x:Bind ViewModel.Radar.ShowRadarLayer, Mode=OneWay}"
                           OpacityToolTip="Opacity of the radar layer — turn it down to read what is under it"/>
    </dragMoveLayerExpanders:DragMoveLayerExpanderHost>
    </prim:PanelScroller>
    </Grid>
</UserControl>
