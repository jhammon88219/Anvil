<?xml version="1.0" encoding="utf-8"?>
<!-- ProductComboBox — the radar Product selector. Just the selector: a short name and a chevron.

       CLOSED     Ref  ˅

                  ┌──────────────────────────────┐
       OPEN       │ Ref   Reflectivity           │   one row per product: the short name the
                  │ Vel   Velocity               │   closed state shows, then the full name,
                  │ SRV   Storm-Relative Vel.    │   so a row teaches what the abbreviation
                  │ CC    Correlation Coeff.     │   means instead of hiding it in a tooltip
                  └──────────────────────────────┘

     ⚠️ IT NO LONGER DRAWS COLOR RAMPS — not in the closed state, not in the rows. It used to be
     ProductColorRampComboBox, a deliberately COMBINED control: the selector doubled as the legend so a
     160px chip in the bottom bar could be a pane's selector, scale and inspect readout all at once. That
     combination existed because the bar had no room for two controls per pane. The pane notch has room,
     so the two came apart: ProductColorRamp is the legend, on its own, right beside this — and two ramps
     a few pixels apart is exactly what un-combining was meant to avoid. Don't put one back here.

     Losing the ramps is what let the rows carry the FULL product name. In the combined control the name
     was a tooltip, because the ramp had the width; a row is now a plain two-column label, which is the
     one place a person can find out what "KDP" stands for without hovering.

     It is a UserControl rather than a templated ComboBox on purpose: a loose ResourceDictionary has no
     code-behind, so a ControlTemplate can't use x:Bind and state had to be smuggled in through attached
     properties. Here everything is a plain x:Bind against this control's own DPs. It still READS as a
     combo box (click to open, click a row to pick, light-dismiss, arrow keys + Enter via the ListView);
     what a real ComboBox would add over this is type-ahead, which a six-item list doesn't need. -->
<UserControl
    x:Class="Anvil.Controls.Primitives.ProductComboBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Anvil.ViewModels"
    mc:Ignorable="d"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    KeyDown="OnKeyDown"
    IsEnabledChanged="OnIsEnabledChanged">

    <Grid x:Name="Root"
          Background="Transparent"
          Tapped="OnTapped"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited"
          PointerPressed="OnPointerPressed"
          PointerReleased="OnPointerReleased"
          PointerCaptureLost="OnPointerExited">

        <!-- Rest is fully transparent, so hover carries the whole "this is interactable" cue: the surface
             fills with the SAME hover brush the notch's own pull-tab uses (one hover look across the
             chrome), a hairline stroke appears — the fill alone is near-invisible on the notch's dark
             surface — and the content lifts 1px. Pressed keeps fill + stroke but drops the lift, so a click
             reads as pushing it back down. Only Disabled mutes the text + chevron. (The stroke costs no
             layout: HoverSurface is an empty backdrop pane, not the content's parent, so its
             BorderThickness can't shift anything.) -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="HoverSurface.Background" Value="{ThemeResource OverlayBarSurfaceHoverBrush}"/>
                        <Setter Target="HoverSurface.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                        <Setter Target="HoverSurface.BorderThickness" Value="1"/>
                        <Setter Target="Lift.Y" Value="-1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Target="HoverSurface.Background" Value="{ThemeResource OverlayBarSurfaceHoverBrush}"/>
                        <Setter Target="HoverSurface.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                        <Setter Target="HoverSurface.BorderThickness" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                        <Setter Target="ShortLabelText.Foreground" Value="{ThemeResource ComboBoxForegroundDisabled}"/>
                        <Setter Target="DropDownGlyph.Foreground" Value="{ThemeResource ComboBoxDropDownGlyphForegroundDisabled}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="ContentRoot" ColumnSpacing="6">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Lift"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- short name -->
                <ColumnDefinition Width="Auto"/> <!-- chevron -->
            </Grid.ColumnDefinitions>

            <Border x:Name="HoverSurface"
                    Grid.ColumnSpan="2"
                    Margin="-8,-4"
                    MinHeight="28"
                    CornerRadius="6"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"/>

            <!-- MinWidth, not Width: the closed state is content-sized now, and the product short names
                 differ in width ("CC" vs "SRV"). Without a floor the notch would twitch sideways every
                 time the product changed, since the ramp beside it holds the row's centre. The floor is
                 the widest short name, so nothing moves. -->
            <TextBlock x:Name="ShortLabelText"
                       Grid.Column="0"
                       MinWidth="30"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource ComboBoxForeground}"
                       Text="{x:Bind SelectedItem.ShortLabel, Mode=OneWay}"/>

            <FontIcon x:Name="DropDownGlyph"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      FontSize="12"
                      Glyph="&#xE70D;"
                      Foreground="{ThemeResource ComboBoxDropDownGlyphForeground}"
                      IsHitTestVisible="False"/>
        </Grid>

        <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="DropDown" Placement="Bottom" Opening="OnDropDownOpening">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"/>
                        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}"/>
                        <Setter Property="Padding" Value="0,4,0,4"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="MaxWidth" Value="1000"/>
                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled"/>
                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                    </Style>
                </Flyout.FlyoutPresenterStyle>

                <!-- ⚠️ The dropdown is NOT matched to the closed control's width any more. It was, so the
                     rows' ramps would line up with the ramp in the closed area; with no ramps on either
                     side there is nothing to line up, and the closed state is now far too narrow to hold a
                     full product name. So the flyout sizes to its own content. -->
                <ListView x:Name="ProductList"
                          MinWidth="260"
                          MaxHeight="504"
                          SelectionMode="Single"
                          ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                          SelectionChanged="OnProductListSelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="32"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RadarProductOption">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind ShortLabel}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Label}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Flyout>
        </FlyoutBase.AttachedFlyout>
    </Grid>
</UserControl>
