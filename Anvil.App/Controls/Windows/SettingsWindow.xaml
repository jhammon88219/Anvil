<?xml version="1.0" encoding="utf-8"?>
<!-- SettingsWindow — ONE window for every setting, its pages picked from a LEFT NAV RAIL. Hosted in its own OS
     window by WindowManager (content extends into the caption), so there is no panel frame: the root is the
     dark surface, stretched to fill the window. Laid out like the Anvil Atlas on purpose (the user's call,
     2026-11-11): a raised title BAND, then the raised rail | the body.

       ┌──────────────────────────────────────────────────────────────────────────────────────┐
       │ [logo] Anvil Settings ←35→ VERSION │ BUILD   LICENSE   SOURCE    ░░░ lock pin ─ □ ✕ ░│ ← THE BAND (raised):
       │ (slot)                     1.0.0.0 │ Debug   AGPL-3.0  GitHub    ░ reserved 220 px ░ │   about-Anvil facts,
       │░░░░░░░░░░░░░░░░░░╭───────────────────────────────────────────────────────────────────┤   label OVER value
       │   ⏻  General    ░│  (first in the rail — page 6, the old Startup slot)
       │╭─────────────────╯                                                                    │   ← THE JOIN: the selected entry
       ││  ◐ Appearance       ┌ Theme ───────────────────────────────────────────────────────┐ │     is cut from the page's own
       │╰─────────────────╮  │ …                                                    DEFAULT │ │     ground, the line runs round it
       │   ◎  Radar       │  │ …                                                            │ │   ← band + rail = ONE grey L;
       │                  │  │ …                                                            │ │     the only line = the BODY's
       │   ⊙  Radar Range │  └──────────────────────────────────────────────────────────────┘ │     outline (left + top, 10 px
       │   ▤  Storage     │     12 px of the darker ground between sections                    │     inside curve) = PlateOutline
       │   …              │  ┌ Edges  [Restore defaults] ──────────────────────────────────┐ │     IsInsetCorner
       │ ──────────────── │  │ …                                                            │ │   ← the page: sections FULL
       │   ⚒  Dev         │  └──────────────────────────────────────────────────────────────┘ │     WIDTH, one UserControl per
       └──────────────────┴───────────────────────────────────────────────────────────────────┘     page (Composites)
        ↑ Primitives/TabStrip, 220 wide, raised (its edge line is the body outline's, not its own)
     ⭐ FIND A SETTING (2026-11-17, canvas artboards 14–15): the rail's FIRST item, above the entries:
          [ Find a setting        🔍 ] ← AutoSuggestBox, width = a rail row's full width + 10, left edge on the rows'
          ⏻ General                      typing → the best 6 (name, matched word bold, over "Page › Console") + "Enter — all N";
          ◐ Appearance                   a pick LANDS (page opens, row selected + scrolled to + accent ring flash);
                                         Enter → the RESULTS page (Controls/SettingsSearch/SettingsSearchResults): header
                                         "Results for “q”", page bodies + About box + Reset all hidden, NO rail entry selected.
        Words = Services/Settings/SettingsSearch over the SettingsText catalog. Leaving: Esc, clearing it, a rail click.
     ⭐ THE JOIN (the user's pick "A", 2026-11-17): the selected rail entry has NO face or accent bar of its own (TabStrip
        JoinsBody); the body outline (PlateOutline.SetJoin, measured in UpdateRailJoin) reaches out round it, filled with
        the ROOT's Background — so it is always whatever the page sits on. 8 px fillets where it meets the body's edge; the
        first entry's top becomes one S-curve into the body's top. Layer order: rail face → outline + join → rail entries.
     ⭐ SECTIONS (2026-11-16, page by page): each section is its OWN named control on a Primitives/SettingsConsolePlate
        (titled card, never collapses), 12 apart — Appearance + Storage so far; the rest still use SettingsExpander until
        redone (Dev keeps its expanders). The rail's DISPLAY order is free (each TabEntry names its page by PageIndex);
        a MERGED page keeps its enum slot but has no rail entry: Edges → Appearance; Units + Window Mode → General.
        (The live map preview beside Map + Range Ring was removed 2026-11-16.)
     ⭐ THE BODY opens with a PINNED page header (title · description · a FIXED-height About box for the selected
        Primitives/SettingsConsoleRow, 2026-11-17); the consoles scroll under it. This window is the rows' ISettingsRowHost.

     The top bar's Settings menu lists the SAME pages (MainWindow.xaml's SETTINGS MENU, one declared item per
     page, Tag = its index) — clicking one opens this window on it.

     A NEW GROUP OF SETTINGS IS A PAGE, NOT A WINDOW: add a SettingsTab enum member (never reorder — the ordinal
     is the persisted index — and add it BEFORE Dev, which must stay last), a TabEntry in BuildTabs (before the
     #if DEBUG block), a body UserControl in Composites at that index, AND its item in the top bar's Settings
     menu (same mark, same name).

     ⚠️ THE SELECTED PAGE IS NOT VIEW STATE. It lives on MapViewModel.SettingsTabIndex so it survives close/
     reopen, persists across launches, and can be targeted from anywhere via MapViewModel.OpenSettings(tab).

     ⚠️ VISIBILITY, NOT x:Load, for the shipping pages (x:Load bound to a bool UNLOADS again when it goes false).
     The dev page is the deliberate exception: it must NEVER be constructed in Release (its engine VMs are null
     there), and x:Load is exactly the tool for "do not build this at all".

     (The rail used to be a TOP strip with a right-click "Tabs on top / on the side" switch — removed 2026-11-11.) -->

<UserControl x:Class="Anvil.Controls.Windows.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Anvil.Controls.Primitives"
             xmlns:cmp="using:Anvil.Controls.Composites"
             xmlns:settingsSearch="using:Anvil.Controls.SettingsSearch"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- Dark surface fills the whole window. -->
    <!-- ⚠️ This Background IS the page ground: the body outline's JOIN binds to it, so the selected rail entry always wears
         whatever the page sits on. Change the ground HERE and the join follows. -->
    <Grid x:Name="SettingsWindowRoot" Background="{ThemeResource OverlayBarSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- the title band -->
            <RowDefinition Height="*"/>    <!-- rail | body -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/> <!-- the rail -->
            <ColumnDefinition Width="*"/>   <!-- the body -->
        </Grid.ColumnDefinitions>

        <!-- THE BAND — raised, full width, NO line of its own (the body's inset-corner outline below draws the only line).
             The SAME grammar as the Atlas's band: logo slot, name, then each fact as its LABEL over its VALUE,
             left-aligned. ⚠️ Its right 220 px are RESERVED for the lock, pin and caption buttons over that corner. -->
        <Border x:Name="SettingsBand" Grid.ColumnSpan="2"
                Background="{ThemeResource OverlayBarSurfaceRaisedBrush}">
            <Grid Padding="16,12,0,12" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- logo slot -->
                    <ColumnDefinition Width="Auto"/> <!-- name -->
                    <ColumnDefinition Width="Auto"/> <!-- facts -->
                    <ColumnDefinition Width="*"/>    <!-- empty -->
                    <ColumnDefinition Width="220"/>  <!-- lock / pin / caption corner -->
                </Grid.ColumnDefinitions>

                <!-- LOGO SLOT — a placeholder until the app has a logo (the Atlas's, the same size). -->
                <Grid Width="40" Height="40" VerticalAlignment="Center">
                    <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="1" StrokeDashArray="3,3"
                               Stroke="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <FontIcon Glyph="&#xE713;" FontSize="16"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>

                <TextBlock Grid.Column="1" Text="Anvil Settings" VerticalAlignment="Center"
                           FontSize="{StaticResource SubtitleFontSize}" FontWeight="SemiBold"/>

                <!-- ABOUT ANVIL: version first, rule, then the rest. -->
                <StackPanel x:Name="SettingsBandAbout" Grid.Column="2" Orientation="Horizontal" Spacing="20"
                            VerticalAlignment="Center" Margin="21,0,0,0">
                    <StackPanel>
                        <TextBlock Text="VERSION" Style="{StaticResource AtlasFieldLabelStyle}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{x:Bind AppVersion}" FontSize="{StaticResource SubtitleFontSize}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Border Width="1" Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                    <StackPanel>
                        <TextBlock Text="BUILD" Style="{StaticResource AtlasFieldLabelStyle}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{x:Bind BuildKind}" FontSize="{StaticResource SubtitleFontSize}" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="LICENSE" Style="{StaticResource AtlasFieldLabelStyle}" HorizontalAlignment="Left"/>
                        <TextBlock Text="AGPL-3.0" FontSize="{StaticResource SubtitleFontSize}" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="SOURCE" Style="{StaticResource AtlasFieldLabelStyle}" HorizontalAlignment="Left"/>
                        <HyperlinkButton x:Name="SettingsBandSourceLink" Content="GitHub" Padding="0" Margin="0,2,0,0"
                                         NavigateUri="https://github.com/jhammon88219/Anvil"
                                         ToolTipService.ToolTip="Anvil's source code on GitHub"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- THE RAIL'S FACE — raised, NO line of its own (see the body outline). Its own element, UNDER the body outline,
             because the outline's JOIN paints over the rail (the selected entry) and the entries must paint over the join. -->
        <Border x:Name="SettingsRailFace" Grid.Row="1" Background="{ThemeResource OverlayBarSurfaceRaisedBrush}"/>

        <!-- THE BODY OUTLINE — Primitives/PlateOutline, inset-corner mode: the hairline up the body's left edge, round a 10 px
             curve, along its top; the raised wedge outside the curve, so the band's grey flows into the rail's with no line
             between them. ⭐ THE JOIN (the user's pick "A", 2026-11-17): the body reaches out over the rail round the
             SELECTED entry, filled with the page's ground (JoinFill = the root's Background) and the hairline runs round it —
             the page flows into its entry. Its box comes from code (UpdateRailJoin: the entry's measured bounds). Behind the
             body, never hit-testable. Rounded chrome = one outline (docs/bugs.md S30/S31) — never Borders meeting at a corner. -->
        <ctl:PlateOutline x:Name="SettingsBodyOutline" Grid.Row="1" Grid.Column="1"
                          IsInsetCorner="True" IsRaised="True" ShowShadow="False" IsHitTestVisible="False"
                          JoinFill="{x:Bind SettingsWindowRoot.Background, Mode=OneWay}"
                          SizeChanged="OnRailJoinMoved"/>

        <!-- THE RAIL — its entries, over the join. The entries are BuildTabs'; JoinsBody = the selected one draws no face or
             bar (the join is its face). -->
        <Grid x:Name="SettingsRail" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Find a setting -->
                <RowDefinition Height="*"/>    <!-- the pages -->
            </Grid.RowDefinitions>

            <!-- FIND A SETTING (canvas artboards 14–15, 2026-11-17) — the rail's FIRST item, Windows Settings' way. Its width =
                 a rail ROW's full width + 10 (SearchBoxWidth ← the strip's width, OnStripSizeChanged), left edge on the rows'. Typing lists
                 SettingsSearch's best 6 (+ an "Enter — all N" line); a pick LANDS on the row, Enter shows the RESULTS page.
                 UpdateTextOnSelect off: arrowing through the list never rewrites what you typed. Esc clears. -->
            <AutoSuggestBox x:Name="SettingsSearchBox" Margin="6,8,0,4" HorizontalAlignment="Left"
                            Width="{x:Bind SearchBoxWidth, Mode=OneWay}"
                            PlaceholderText="Find a setting" QueryIcon="Find" UpdateTextOnSelect="False"
                            TextChanged="OnSearchTextChanged" QuerySubmitted="OnSearchQuerySubmitted" PreviewKeyDown="OnSearchKeyDown">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="settingsSearch:SettingsSearchItem">
                        <Grid Padding="0,6">
                            <!-- A MATCH: the name (matched word bold) over its place — nothing else (the user's call). -->
                            <StackPanel Visibility="{x:Bind MatchVisibility}">
                                <TextBlock Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind TitleBefore}"/><Run Text="{x:Bind TitleMatch}" FontWeight="SemiBold"/><Run Text="{x:Bind TitleAfter}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Breadcrumb}"/>
                            </StackPanel>
                            <!-- THE FOOTER: Enter's results page. -->
                            <TextBlock Visibility="{x:Bind FooterVisibility}" Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind FooterText}"/>
                        </Grid>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>

            <!-- ⚠️ NEVER WinUI's overlay bar (the user's hard rule): our PanelScroller, its 16 px gutter ALWAYS claimed on the
                 right — it is the rows' right margin (was 6), so the rows never slide under a bar. The JOIN runs on over
                 that gutter to meet the body. -->
            <ctl:PanelScroller x:Name="SettingsRailScroller" Grid.Row="1" Scrolled="OnRailJoinMoved">
                <ctl:TabStrip x:Name="Strip" Margin="6,8,0,8" JoinsBody="True" LabelFontSize="{StaticResource BodyLargeFontSize}" SizeChanged="OnStripSizeChanged"
                              SuppressSelection="{x:Bind IsSearchShown, Mode=OneWay}"
                              RowClicked="OnRailRowClicked"
                              ItemsSource="{x:Bind Tabs}"
                              SelectedIndex="{x:Bind ViewModel.SettingsTabIndex, Mode=TwoWay}"/>
            </ctl:PanelScroller>
        </Grid>

        <!-- The body: the sections column FILLS it (every section stretches edge to edge — option A, the user's call
             2026-11-11). The rows INSIDE a section keep their own widths. (The live map preview that split some pages
             half-and-half was removed 2026-11-16.) -->
        <Grid x:Name="BodyHost" Grid.Row="1" Grid.Column="1" Margin="24,18,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- the page header (pinned) -->
                <RowDefinition Height="*"/>    <!-- the consoles (scroll) -->
            </Grid.RowDefinitions>

            <!-- THE PAGE HEADER (Option B 2026-11-17; title line = artboard 11) — PINNED above the scrolling consoles:
                   General   How Anvil starts and your home s…   [ Reset all General settings ]   ← title 34 SemiBold · the rail
                                                                                                    entry's tooltip 15, on the
                                                                                                    title's baseline, trims ·
                                                                                                    the caution key, centred on
                                                                                                    the title's capitals
                   ABOUT · LOAD HOME SITE ON LAUNCH                                     ← Overline; the SELECTED row
                   When Anvil opens, it starts the live radar loop for …                ← Body large 16/22, 3 max, FIXED 88 px box
                   … your home site is set in the Radar Atlas.               DEFAULT    ← DEFAULT + value pinned BOTTOM-right
                                                                              Off          (clear of the Reset all key above)
                   ──────────────────────────────────────────────────────────────────── hairline; the consoles scroll under it
                 Sizes are TYPE-SCALE roles (Styles.xaml): title Page title, description Body large, captions Overline.
                 ⚠️ The About box is ONE fixed height (Overline 16 + 6 + three Body-large 22 px lines = 88) whatever is selected, or nothing
                 (SettingsText.NothingSelected), so picking a row never moves the page. Its words are the catalog's
                 (Services/Settings/SettingsText); the selection is kept PER PAGE (SettingsWindow.OnRowPicked).
                 Right margin 4 = the cards' right edge (the scroller below bleeds -12 into BodyHost's 16). -->
            <StackPanel x:Name="SettingsPageHeader" Margin="0,0,4,14">
                <!-- THE TITLE LINE (artboard 11, 2026-11-17): title · description · Reset all.
                     ⚠️ CENTRING: both texts use TextLineBounds="Tight" — a TextBlock's box is then the CAP HEIGHT to the BASELINE,
                     with no line-gap padding above or descender room below. So:
                       · the description, bottom-aligned in the same Auto row as the title, shares the title's BASELINE;
                       · that pair, centred against the 36 px Reset all key, puts the key's middle on the middle of the title's
                         capitals — the optical centre — instead of the line box's (which sat ~4 px low).
                     Descenders ("Appearance") draw below the box; nothing here clips them. -->
                <Grid x:Name="SettingsPageTitleLine" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>    <!-- title + description (the description trims) -->
                        <ColumnDefinition Width="Auto"/> <!-- Reset all, its right edge = the plates' -->
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="SettingsPageTitleText" VerticalAlignment="Center" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SettingsPageTitle" FontSize="{StaticResource PageTitleFontSize}" FontWeight="SemiBold" TextLineBounds="Tight"
                                   VerticalAlignment="Bottom" Text="{x:Bind PageTitle, Mode=OneWay}"/>
                        <TextBlock x:Name="SettingsPageDescription" Grid.Column="1" FontSize="{StaticResource BodyLargeFontSize}" TextLineBounds="Tight"
                                   VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   ToolTipService.ToolTip="{x:Bind PageDescription, Mode=OneWay}"
                                   Text="{x:Bind PageDescription, Mode=OneWay}"/>
                    </Grid>
                    <!-- The SHOWN page's Reset all (ISettingsPage.ResetAll — it asks first). Hidden on Dev (nothing to reset). -->
                    <ctl:CautionResetButton x:Name="SettingsPageResetAllButton" Grid.Column="1" VerticalAlignment="Center"
                                            Visibility="{x:Bind HasResetAll, Mode=OneWay}"
                                            Text="{x:Bind ResetAllText, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ResetAllToolTip, Mode=OneWay}"
                                            Click="OnResetAllClick"/>
                </Grid>
                <Grid x:Name="SettingsAboutBox" MinHeight="88" Margin="0,14,0,0" ColumnSpacing="16"
                      Visibility="{x:Bind PageOnly(IsSearchShown), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource SettingsDefaultColumnWidth}"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SettingsAboutCaption" FontSize="{StaticResource OverlineFontSize}" CharacterSpacing="{StaticResource OverlineCharacterSpacing}" LineHeight="{StaticResource OverlineLineHeight}"
                                   LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind AboutCaption, Mode=OneWay}"/>
                        <TextBlock x:Name="SettingsAboutText" Margin="0,6,0,0" MaxWidth="800" HorizontalAlignment="Left"
                                   FontSize="{StaticResource BodyLargeFontSize}" LineHeight="{StaticResource BodyLargeLineHeight}" LineStackingStrategy="BlockLineHeight"
                                   TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind AboutText, Mode=OneWay}"/>
                    </StackPanel>
                    <!-- BOTTOM-right of the box (2026-11-17): at the top it sat right under the title line's Reset all key. -->
                    <StackPanel x:Name="SettingsAboutDefault" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Visibility="{x:Bind HasAboutDefault, Mode=OneWay}">
                        <TextBlock Text="DEFAULT" FontSize="{StaticResource OverlineFontSize}" CharacterSpacing="{StaticResource OverlineCharacterSpacing}" LineHeight="{StaticResource OverlineLineHeight}" LineStackingStrategy="BlockLineHeight"
                                   HorizontalAlignment="Right" Foreground="{ThemeResource SettingsCautionForegroundBrush}"/>
                        <TextBlock Margin="0,6,0,0" FontSize="{StaticResource BodyLargeFontSize}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"
                                   MaxLines="2" Style="{StaticResource TabularNumberTextStyle}" Text="{x:Bind AboutDefault, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
            <Border x:Name="SettingsPageHeaderRule" Height="1" VerticalAlignment="Bottom" Margin="0,0,4,0" IsHitTestVisible="False"
                    Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>

            <!-- Bodies. Exactly one is visible; the rest keep their state because they stay loaded.
                 ⚠️ NEVER WinUI's overlay bar (the user's hard rule): Primitives/PanelScroller, its 16 px gutter ALWAYS claimed
                 (a lane of its own, never over the cards). Margin right -12 bleeds it into BodyHost's 16 px right margin, so
                 the cards keep their width and the thumb sits 4 px from the cards AND 4 px from the window edge. -->
            <ctl:PanelScroller x:Name="Body" Grid.Row="1" Margin="0,14,-12,0">
                <Grid>
                    <!-- FIND A SETTING's results page (Enter in the rail box). While it shows, every page body hides. -->
                    <settingsSearch:SettingsSearchResults x:Name="SettingsSearchResultsPage"
                                                          Visibility="{x:Bind SearchOnly(IsSearchShown), Mode=OneWay}"
                                                          HitPicked="OnSearchHitPicked"/>

                    <!-- Slot 0 (SettingsTab.Map) = APPEARANCE: theme + basemap + the edge hatch (Edges merged in). -->
                    <cmp:AppearanceSettingsTab x:Name="AppearanceTab" ViewModel="{x:Bind ViewModel}"
                                               Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, IsSearchShown, 0), Mode=OneWay}"/>

                    <!-- x:Name'd (all of them) so PersistSectionExpansion can key each page's sections by page. -->
                    <cmp:RadarSettingsTab x:Name="RadarTab" ViewModel="{x:Bind ViewModel}"
                                          Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, IsSearchShown, 1), Mode=OneWay}"/>

                    <cmp:RangeRingSettingsTab x:Name="RangeRingTab" ViewModel="{x:Bind ViewModel}"
                                              Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, IsSearchShown, 2), Mode=OneWay}"/>

                    <cmp:StorageSettingsTab x:Name="StorageTab" ViewModel="{x:Bind ViewModel}"
                                            Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, IsSearchShown, 3), Mode=OneWay}"/>

                    <!-- Slot 4 (WindowMode) has NO body: retired into General. -->

                    <!-- Slot 5 (RadarConsole) has NO body: retired into Radar (2026-11-16). -->

                    <!-- Slot 6 (SettingsTab.Startup) = GENERAL: Startup + Units + Window (Units, WindowMode merged in). -->
                    <cmp:GeneralSettingsTab x:Name="GeneralTab" ViewModel="{x:Bind ViewModel}"
                                            Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, IsSearchShown, 6), Mode=OneWay}"/>

                    <cmp:LiveDataSettingsTab x:Name="LiveDataTab" ViewModel="{x:Bind ViewModel.LiveData}"
                                             Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, IsSearchShown, 7), Mode=OneWay}"/>

                    <!-- Slot 8 (Basemap) has NO body: retired into Storage (2026-11-16). -->

                    <!-- Slot 9 (Units) has NO body: retired into General. -->

                    <!-- Slot 10 (Edges) has NO body: retired into Appearance; SettingsTabIndex never lands on it. -->

                    <!-- ⚠️ x:Load, not Visibility — see the header. LoadDevTab is hard-false in Release, so
                         this body is never constructed there and its null engine VMs are never bound. -->
                    <cmp:DevSettingsTab x:Name="DevTab"
                                        x:Load="{x:Bind LoadDevTab(ViewModel.SettingsTabIndex), Mode=OneWay}"
                                        Visibility="{x:Bind PageOnly(IsSearchShown), Mode=OneWay}"
                                        ViewModel="{x:Bind ViewModel}"
                                        SweepVm="{x:Bind SweepVm}"
                                        ValidationVm="{x:Bind ValidationVm}"
                                        SeedVm="{x:Bind SeedVm}"
                                        Loaded="OnDevTabLoaded"/>
                </Grid>
            </ctl:PanelScroller>
        </Grid>

        <!-- Lock (no move/resize) + pin (keep on top), over the band's reserved corner. -->
        <ctl:LockToggle Grid.ColumnSpan="2" IsChecked="{x:Bind ViewModel.IsSettingsWindowLocked, Mode=TwoWay}"/>
        <ctl:PinToggle Grid.ColumnSpan="2" IsChecked="{x:Bind ViewModel.IsSettingsWindowOnTop, Mode=TwoWay}"/>
    </Grid>
</UserControl>
