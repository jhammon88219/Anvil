<?xml version="1.0" encoding="utf-8"?>
<!-- TiltComboBox — the radar Tilt (elevation) selector: a minimal, background-LESS dropdown that blends into
     whatever surface hosts it.

       CLOSED     0.5°                    ˅      at rest: no box, no fill, no border — just label + chevron
                 ╭────────────────────────╮
       HOVER     │ 0.5°                 ˅ │      ProductComboBox's hover: raised-hover fill + CardStroke
                 ╰────────────────────────╯      hairline + the content lifts 1px (pressed drops the lift)
                  ┌───────────────────────┐
       OPEN       │ Base (0.5°)           │      an OPAQUE flyout + ListView (the default acrylic
                  │ 0.9°                  │      washes out over the map)
                  │ 1.3°                  │
                  └───────────────────────┘

     Transparent at rest; hover/pressed wear the SAME look as ProductComboBox and the console's site picker
     (SectionedComboBox's box face) — the three pickers answer the pointer alike, the user's call 2026-11-11.
     ⚠️ Change the three together. Disabled mutes the label + chevron. The hover outline lives on Box, an empty
     backdrop sibling, so its BorderThickness costs no layout. The dropdown is given an explicit fully-OPAQUE
     theme-aware surface, since the default flyout brush is acrylic and washes out over the map.

     (Was a HandCursorComboBox wearing NoBackgroundComboBoxStyle; both are gone now. Same reasoning as
     ProductComboBox — see that file.) -->
<UserControl
    x:Class="Anvil.Controls.Primitives.TiltComboBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Anvil.ViewModels"
    mc:Ignorable="d"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    HorizontalAlignment="Stretch"
    KeyDown="OnKeyDown"
    IsEnabledChanged="OnIsEnabledChanged">

    <Grid x:Name="Root"
          Background="Transparent"
          Tapped="OnTapped"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited"
          PointerPressed="OnPointerPressed"
          PointerReleased="OnPointerReleased"
          PointerCaptureLost="OnPointerExited">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="Box.Background" Value="{ThemeResource OverlayBarSurfaceRaisedHoverBrush}"/>
                        <Setter Target="Box.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                        <Setter Target="Box.BorderThickness" Value="1"/>
                        <Setter Target="LabelLift.Y" Value="-1"/>
                        <Setter Target="GlyphLift.Y" Value="-1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Target="Box.Background" Value="{ThemeResource OverlayBarSurfaceRaisedHoverBrush}"/>
                        <Setter Target="Box.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                        <Setter Target="Box.BorderThickness" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                        <Setter Target="SelectedLabel.Foreground" Value="{ThemeResource ComboBoxForegroundDisabled}"/>
                        <Setter Target="DropDownGlyph.Foreground" Value="{ThemeResource ComboBoxDropDownGlyphForegroundDisabled}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- The box: the focus target AND the hover backdrop (fill + hairline land here in PointerOver/Pressed).
             Transparent and borderless at rest. -->
        <Border x:Name="Box"
                Grid.ColumnSpan="2"
                MinHeight="32"
                CornerRadius="6"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Control.IsTemplateFocusTarget="True"/>

        <TextBlock x:Name="SelectedLabel"
                   Grid.Column="0"
                   Margin="11,5,0,6"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource ComboBoxForeground}"
                   Text="{x:Bind LabelText(SelectedItem), Mode=OneWay}">
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="LabelLift"/>
            </TextBlock.RenderTransform>
        </TextBlock>

        <FontIcon x:Name="DropDownGlyph"
                  Grid.Column="1"
                  Margin="8,0,10,0"
                  VerticalAlignment="Center"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  FontSize="12"
                  Glyph="&#xE70D;"
                  Foreground="{ThemeResource ComboBoxDropDownGlyphForeground}"
                  IsHitTestVisible="False">
            <FontIcon.RenderTransform>
                <TranslateTransform x:Name="GlyphLift"/>
            </FontIcon.RenderTransform>
        </FontIcon>

        <FlyoutBase.AttachedFlyout>
            <!-- ⚠️ Windowed popup, or an owned panel window paints over it (see SectionedComboBox). -->
            <Flyout x:Name="DropDown" Placement="Bottom" ShouldConstrainToRootBounds="False" Opening="OnDropDownOpening">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"/>
                        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}"/>
                        <Setter Property="Padding" Value="0,4,0,4"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled"/>
                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                    </Style>
                </Flyout.FlyoutPresenterStyle>

                <ListView x:Name="TiltList"
                          MaxHeight="504"
                          SelectionMode="Single"
                          ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                          SelectionChanged="OnTiltListSelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="32"/>
                            <Setter Property="Padding" Value="11,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RadarTiltOption">
                            <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Flyout>
        </FlyoutBase.AttachedFlyout>
    </Grid>
</UserControl>
