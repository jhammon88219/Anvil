<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     RadarConsoleSiteTab — the radar SITE PICKER (home + favorites) as a TAB centred on top of the floating radar console
     (the user's call, 2026-11-03; it was the tools strip's centre, centred on play).

                       ░╭──────────────────────────────╮░      ← its own ROUNDED halo, top + sides only:
                       ░│  ⌂ KTLX  Oklahoma City     ˅ │░        the rings stop at the tab's foot, so none
         ░╭────────────┴──────────────────────────────┴────────────╮░   ever paints on the console below
         ░│ 1:07 PM ═══ scrubber ═══  ◀ ▶ ▶ ↺        VCP: 212        │░  ← the console (MainWindow ConsoleIsland)
         ░╰──────────────────────────────────────────────────────────╯░

     ⚠️ The tab overlaps the console's top hairline by 1 px (the host's -1 bottom margin) and draws no bottom line, so
     tab and console read as ONE plate. It is declared AFTER the console in the host so it paints over that hairline.
     Same face as the console (OverlayBarSurfaceBrush, the ground) and the same hairline brush.
     Centred on the console = on its play button = the window's midpoint (RadarControls.CentreOnPlay).

     It is ALSO the "which radar is selected" readout: the FACE is the site on the map now (⌂ home, ★ favorite, bare
     otherwise), and the PINNED top row is that same site (SelectedSites). Below the rule: home first, then the favorites
     (PinnedSites), so the list never reshuffles on a switch.
     ⚠️ A pick ACTS through ItemPicked, NOT SelectedItem: picking the site already loaded must still fly back to it, and
     that changes no property. SelectedItem is ONE-WAY from LoadedSite and re-asserted after the pick.
     ⚠️ DISABLED in PastCast (a pick would re-target the replay); the tooltip sits on a WRAPPER so it still explains itself.
     ⚠️ FIXED width so a long name never resizes the tab; the name trims. Glyphs E80F / E735 are NOT verified.
     ⚠️ It is a SectionedComboBox (commits only on ItemClick), never a ComboBox — a ComboBox cycles on the wheel.
     Host contract: ViewModel (MapViewModel).
     ============================================================================ -->
<UserControl x:Class="Anvil.Controls.Composites.RadarConsoleSiteTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:conv="using:Anvil.Converters"
             xmlns:comp="using:Anvil.Controls.Composites"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:SiteAvailabilityToBrushConverter x:Key="AvailabilityToBrush"/>

        <!-- One site-picker ROW (both sections): pin mark, id, name, availability dot. -->
        <DataTemplate x:Key="SiteRowTemplate" x:DataType="vm:RadarSiteRow">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="{x:Bind comp:RadarConsoleSiteTab.PinGlyph(IsHome, IsFavorite), Mode=OneWay}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Id}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{x:Bind Name}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <Ellipse Grid.Column="3" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{x:Bind Availability, Converter={StaticResource AvailabilityToBrush}, Mode=OneWay}"/>
            </Grid>
        </DataTemplate>

        <!-- The FACE: the pin mark (collapsed for a site that is neither), id and name — no dot. No foregrounds set: the
             text inherits the picker's, so it greys with it in PastCast. -->
        <DataTemplate x:Key="SiteFaceTemplate" x:DataType="vm:RadarSiteRow">
            <!-- A Grid, not a horizontal StackPanel: only a * column gives the name a width to trim to.
                 Gaps are MARGINS, not ColumnSpacing, so a collapsed mark leaves no gap behind. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Margin="0,0,8,0"
                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"
                          Glyph="{x:Bind comp:RadarConsoleSiteTab.PinGlyph(IsHome, IsFavorite), Mode=OneWay}"
                          Visibility="{x:Bind comp:RadarConsoleSiteTab.PinVisibility(IsHome, IsFavorite), Mode=OneWay}"/>
                <TextBlock Grid.Column="1" Margin="0,0,8,0" Text="{x:Bind Id}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- THE TAB'S HALO — the floating console's rounded rings (OverlayBar FloatHalo), cut off at the tab's FOOT: each
             ring's bottom margin is 0 and its bottom corners square, so the shade wraps the top and sides only and never
             lands on the console below. -->
        <Grid x:Name="RadarConsoleSiteTabHalo"
              Margin="0,-2,0,0"
              Opacity="{ThemeResource OverlayBarShadowOpacity}"
              IsHitTestVisible="False">
            <Border Margin="-10,-10,-10,0" CornerRadius="18,18,0,0" Background="Black" Opacity="0.08"/>
            <Border Margin="-8,-8,-8,0" CornerRadius="16,16,0,0" Background="Black" Opacity="0.10"/>
            <Border Margin="-6,-6,-6,0" CornerRadius="14,14,0,0" Background="Black" Opacity="0.12"/>
            <Border Margin="-4,-4,-4,0" CornerRadius="12,12,0,0" Background="Black" Opacity="0.16"/>
            <Border Margin="-2,-2,-2,0" CornerRadius="10,10,0,0" Background="Black" Opacity="0.22"/>
        </Grid>

        <!-- THE TAB — the console's face and hairline, top corners rounded, NO bottom line (it opens into the console). -->
        <Border x:Name="RadarConsoleSiteTabBody"
                Background="{ThemeResource OverlayBarSurfaceBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="8,8,0,0"
                Padding="8,6,8,4">
            <!-- The wrapper carries the tooltip (a disabled control shows none); Transparent so it hit-tests. -->
            <Grid Background="Transparent"
                  ToolTipService.ToolTip="{x:Bind ViewModel.SiteFavorites.PickerToolTip, Mode=OneWay}">
                <prim:SectionedComboBox x:Name="SitePicker"
                                        Width="260"
                                        PlaceholderText="Radar site"
                                        PinnedItemsSource="{x:Bind ViewModel.SiteFavorites.SelectedSites, Mode=OneWay}"
                                        ItemsSource="{x:Bind ViewModel.SiteFavorites.PinnedSites, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SiteFavorites.LoadedSite, Mode=OneWay}"
                                        ItemTemplate="{StaticResource SiteRowTemplate}"
                                        FaceTemplate="{StaticResource SiteFaceTemplate}"
                                        IsEnabled="{x:Bind ViewModel.SiteFavorites.CanPickSites, Mode=OneWay}"
                                        ItemPicked="OnSitePicked">
                    <prim:SectionedComboBox.FooterContent>
                        <StackPanel Spacing="4">
                            <TextBlock Margin="11,2,11,2"
                                       Text="Set a home site or star favorites in the Atlas to list them here."
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind ViewModel.SiteFavorites.IsEmpty, Mode=OneWay}"/>
                            <!-- FAVORITES ONLY — the SAME property as Settings → Radar → Radar site keys (two switches,
                                 one value). Here because this list IS home + favorites: "these" needs no explaining. -->
                            <CheckBox Margin="11,0,11,0"
                                      Content="Show only these on the map"
                                      IsChecked="{x:Bind ViewModel.SiteFavorites.ShowOnlyFavoritesOnMap, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Hide every other radar site on the map. The loaded site always shows."/>
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" Padding="11,6"
                                    Content="Open Atlas"
                                    Click="OnOpenAtlasClick"/>
                        </StackPanel>
                    </prim:SectionedComboBox.FooterContent>
                </prim:SectionedComboBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
