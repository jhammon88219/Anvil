<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     MapControlsStripNetworkPicker — WHICH radar networks' site keys show on the map, as ONE square key on the tools
     tier (the user's mock-up, 2026-10-20). It replaced three side-by-side toggles (NEXRAD / TDWR / research) to give
     the tier its width back: 32 px instead of three keys and their gaps.

           ┌───────────────────────┐
           │ ☑ ◗  Show NEXRAD       │   ← the list opens UP (TopEdgeAlignedLeft), its left edge on the key's
           │ ☑ ✈  Show TDWR airport │     each row = a CheckBox: box · the network's on-map glyph · name
           │ ☐ ⚗  Show research     │     the glyph wears its NETWORK HUE; an unticked row's glyph fades
           └───────────────────────┘
           ┌───▴┐
           │ ◗  │  ← the face: the NEXRAD sweep + a small ▴ (the way it opens) in the top-right corner
           └────┘     primary ink while ANY network shows, secondary while none (ShownStates)
                      Elevated face while the list is open (FlyoutStates)

     ⚠️ NOT a ComboBox: a closed ComboBox cycles its selection on the mousewheel over the map (the site picker's
     trap). It is a Button + a windowed Flyout (ShouldConstrainToRootBounds=False — else the owned panel windows paint
     over it, like every flyout on the tier), and the list STAYS OPEN while you tick, so several can change in one go.
     ⚠️ The three bools are TWO-WAY DPs; the host binds them to Radar.ShowNexradSites / ShowTdwrs / ShowResearchRadars.
     MAP KEYS ONLY — they never remove a site from the Atlas or the site picker. No master: all three off = no keys.
     ⚠️ The hues are DATA (same in both themes) and MIRROR radar-sites.js's k-ink (.radar-site-btn.nexrad / .tdwr /
     .research) — change both. The glyphs are the on-map keys' (radar-sites.js CLASS_GLYPH), redrawn FILLED in the
     18-unit box (a PathIcon only fills).
     ⚠️ The face's look copies MapControlsStrip's StripToolButtonStyle (32 × 32, raised hover pair) — that style is
     local to the strip, so a tune there should come here too.
     ============================================================================ -->
<UserControl x:Class="Anvil.Controls.Primitives.MapControlsStripNetworkPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Network hues — DATA, mirrored from radar-sites.js (see the header). -->
            <SolidColorBrush x:Key="NexradHueBrush" Color="#FF6FDB7F"/>
            <SolidColorBrush x:Key="TdwrHueBrush" Color="#FF7AABFA"/>
            <SolidColorBrush x:Key="ResearchHueBrush" Color="#FFA893F5"/>

            <!-- Every drawn mark gets its full 18 × 18 design box, so it centres as drawn (MapControlsStrip's rule). -->
            <Style TargetType="PathIcon">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
            </Style>

            <!-- The face: StripToolButtonStyle's template (see the header). Foreground is set by ShownStates. -->
            <Style x:Key="NetworkPickerFaceStyle" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource OverlayBarSurfaceRaisedHoverBrush}"/>
                                                <Setter Target="Root.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                                                <Setter Target="Glyph.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource OverlayBarSurfaceElevatedBrush}"/>
                                                <Setter Target="Root.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                                                <Setter Target="Glyph.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Glyph.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Glyph"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One list row's mark: the network glyph at 16, faded while unticked (Opacity, so the hue stays DATA). -->
            <Style x:Key="NetworkRowGlyphBox" TargetType="Viewbox">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="NetworkPickerRoot">
        <VisualStateManager.VisualStateGroups>
            <!-- ANY network showing → primary ink; none → secondary (the toggles' off ink). -->
            <VisualStateGroup x:Name="ShownStates">
                <VisualState x:Name="SomeShown"/>
                <VisualState x:Name="NoneShown">
                    <VisualState.Setters>
                        <Setter Target="NetworkPickerFace.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <!-- The face holds the Elevated look while its list is open. -->
            <VisualStateGroup x:Name="FlyoutStates">
                <VisualState x:Name="FlyoutClosed"/>
                <VisualState x:Name="FlyoutOpen">
                    <VisualState.Setters>
                        <Setter Target="NetworkPickerFace.Background" Value="{ThemeResource OverlayBarSurfaceElevatedBrush}"/>
                        <Setter Target="NetworkPickerFace.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Button x:Name="NetworkPickerFace"
                Style="{StaticResource NetworkPickerFaceStyle}"
                AutomationProperties.Name="Radar sites on the map"
                ToolTipService.ToolTip="Radar sites on the map">
            <Grid>
                <!-- The NEXRAD sweep, at the tier's glyph size (MapControlsStrip StripGlyphSize = 22). -->
                <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <PathIcon Data="M2.9,13.5 A1.6,1.6 0 1 1 6.1,13.5 A1.6,1.6 0 1 1 2.9,13.5 Z M4.5,8 A5.5,5.5 0 0 1 10,13.5 A1,1 0 0 1 8,13.5 A3.5,3.5 0 0 0 4.5,10 A1,1 0 0 1 4.5,8 Z M4.5,3 A10.5,10.5 0 0 1 15,13.5 A1,1 0 0 1 13,13.5 A8.5,8.5 0 0 0 4.5,5 A1,1 0 0 1 4.5,3 Z"/>
                </Viewbox>
                <!-- ▴ = the list opens UP. The map-layers car's caret (10-unit box), shrunk into the top-right corner. -->
                <Viewbox Width="6" Height="6" Margin="0,3,3,0"
                         HorizontalAlignment="Right" VerticalAlignment="Top">
                    <PathIcon Data="M1,7 L5,3 L9,7 Z" Width="10" Height="10"/>
                </Viewbox>
            </Grid>
            <Button.Flyout>
                <Flyout x:Name="NetworkPickerFlyout"
                        Placement="TopEdgeAlignedLeft" ShouldConstrainToRootBounds="False"
                        Opened="OnFlyoutOpened" Closed="OnFlyoutClosed">
                    <StackPanel Width="200" Spacing="2">
                        <CheckBox x:Name="NetworkPickerNexradCheckBox" MinHeight="32"
                                  IsChecked="{x:Bind ShowNexrad, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Style="{StaticResource NetworkRowGlyphBox}" Opacity="{x:Bind GlyphOpacity(ShowNexrad), Mode=OneWay}">
                                    <PathIcon Foreground="{StaticResource NexradHueBrush}"
                                              Data="M2.9,13.5 A1.6,1.6 0 1 1 6.1,13.5 A1.6,1.6 0 1 1 2.9,13.5 Z M4.5,8 A5.5,5.5 0 0 1 10,13.5 A1,1 0 0 1 8,13.5 A3.5,3.5 0 0 0 4.5,10 A1,1 0 0 1 4.5,8 Z M4.5,3 A10.5,10.5 0 0 1 15,13.5 A1,1 0 0 1 13,13.5 A8.5,8.5 0 0 0 4.5,5 A1,1 0 0 1 4.5,3 Z"/>
                                </Viewbox>
                                <TextBlock Text="Show NEXRAD" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="NetworkPickerTdwrCheckBox" MinHeight="32"
                                  IsChecked="{x:Bind ShowTdwr, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Style="{StaticResource NetworkRowGlyphBox}" Opacity="{x:Bind GlyphOpacity(ShowTdwr), Mode=OneWay}">
                                    <PathIcon Foreground="{StaticResource TdwrHueBrush}"
                                              Data="M9,0.9 C9.54,0.9 9.9,1.71 9.9,2.7 V7.38 L16.2,10.98 V12.69 L9.9,10.89 V14.4 L11.7,15.75 V17.1 L9,16.2 L6.3,17.1 V15.75 L8.1,14.4 V10.89 L1.8,12.69 V10.98 L8.1,7.38 V2.7 C8.1,1.71 8.46,0.9 9,0.9 Z"/>
                                </Viewbox>
                                <TextBlock Text="Show TDWR airport" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="NetworkPickerResearchCheckBox" MinHeight="32"
                                  IsChecked="{x:Bind ShowResearch, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <!-- F1 = nonzero fill, so the flask's neck bar and body don't cancel. -->
                                <Viewbox Style="{StaticResource NetworkRowGlyphBox}" Opacity="{x:Bind GlyphOpacity(ShowResearch), Mode=OneWay}">
                                    <PathIcon Foreground="{StaticResource ResearchHueBrush}"
                                              Data="F1 M6.75,2.25 A0.75,0.75 0 0 0 6.75,3.75 H11.25 A0.75,0.75 0 0 0 11.25,2.25 Z M6.75,3 V6.5625 L3.537,12.6225 A2.175,2.175 0 0 0 5.475,15.75 H12.525 A2.175,2.175 0 0 0 14.463,12.6225 L11.25,6.5625 V3 Z M8.25,3.75 H9.75 V6.9375 L13.137,13.3275 A0.675,0.675 0 0 1 12.525,14.25 H5.475 A0.675,0.675 0 0 1 4.863,13.3275 L8.25,6.9375 Z"/>
                                </Viewbox>
                                <TextBlock Text="Show research" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>
