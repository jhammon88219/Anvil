<?xml version="1.0" encoding="utf-8"?>
<!-- RadarSettingsConsoleLivePolling — Settings → Radar's "Live polling" section (was "NowCast live polling"), on a
     Primitives/SettingsConsolePlate. When the NowCast live poll checks for a new scan (docs/regime-aware-polling.md).

       Live polling  [Restore defaults]                                                            DEFAULT
       Check      [   Regime-aware   |    Fixed time    ]   On the radar's own scan plan       Regime-aware
       Every      [ 20 s | 30 s | 45 s | 60 s ]  ← GREYED (lifted-grey pick) unless Fixed time         30 s
       96         420                                     hint (one line)                      150, right

     ⚠️ THE COLUMNS (96 · 420 · * · 150) are the page's — every Radar section uses the same. Change them together.
     ⚠️ The pickers bind RadarViewModel's live-poll members (sealed engine): this only reads/writes them; Restore defaults is
     MapViewModel.ResetLivePolling. Both PERSISTED (AppSettings.RegimeAwarePolling / LivePollSeconds), applied next check. -->
<UserControl x:Class="Anvil.Controls.RadarSettingsConsoles.RadarSettingsConsoleLivePolling"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="RadarSettingsConsoleLivePollingPlate" Title="Live polling" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="LivePollingRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    ToolTipService.ToolTip="Put live polling back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <Grid ColumnSpacing="12" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Check"/>
            <prim:SegmentedPicker x:Name="LivePollingModePicker" Grid.Column="1"
                                  ItemsSource="{x:Bind ViewModel.Radar.LivePollingModeLabels}"
                                  SelectedIndex="{x:Bind ViewModel.Radar.LivePollingModeIndex, Mode=TwoWay}"/>
            <TextBlock Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}"
                       Text="{x:Bind ModeHint(ViewModel.Radar.IsFixedTimePolling), Mode=OneWay}"/>
            <TextBlock Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.DefaultLivePollingModeText}"/>

            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Every"/>
            <prim:SegmentedPicker x:Name="LivePollIntervalPicker" Grid.Row="1" Grid.Column="1"
                                  IsEnabled="{x:Bind ViewModel.Radar.IsFixedTimePolling, Mode=OneWay}"
                                  ItemsSource="{x:Bind ViewModel.Radar.LivePollIntervalLabels}"
                                  SelectedIndex="{x:Bind ViewModel.Radar.RefreshIntervalIndex, Mode=TwoWay}"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.DefaultLivePollIntervalText}"/>
        </Grid>
    </prim:SettingsConsolePlate>
</UserControl>
