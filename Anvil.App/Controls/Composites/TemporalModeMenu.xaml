<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalModeMenu — the BODY of the top bar's Temporal Mode menu (MainWindow.xaml, a windowed Flyout). The user's
     call, 2026-11-11 (mock-up 6A, one line per mode): each row is TWO click targets, 16 px apart, that light up apart.

       ┌───────────────────────────────────────────┐
       │ ✓ NowCast             │ 👁  Pane   Ctrl+2 │   LEFT  = the MODE: on/off (MapViewModel.ToggleTemporalMode)
       │ ✓ ForeCast            │ ◡  Pane   Ctrl+3 │   RIGHT = its PANE: open eye shown / shut eye hidden
       │ ───────────────────────────────────────── │           (MapViewModel.TogglePane — the SAME value View's pane
       │   PastCast  (dimmed)  │ ◡  Pane   Ctrl+1 │            items tick, so either one updates the other)
       │   Turns NowCast and ForeCast off          │   the greyed hint: what a click on the dimmed side turns off
       └───────────────────────────────────────────┘
     The rule: Now + Fore together, Past ALONE. The side that's OFF dims (45%) while the other runs — it warns, never
     blocks — and LIFTS to full strength under the pointer / keyboard focus so it reads as clickable.
     A Pane target is greyed by the SAME gate as View's item (CanPick*Pane: Past needs Past on; Now/Fore need Now OR
     Fore on, and then turn that mode on). The shortcuts belong to View's items — shown here as a reminder only.
     ⚠️ Not a MenuFlyout: a menu row is ONE click target, so the rows are Buttons dressed as menu rows (lightweight
     styling below). Every click raises Acted, and the host closes the flyout — a menu's behaviour.
     ⚠️ Glyphs: E73E CheckMark, E890 View (open eye), ED1A Hide — ED1A is UNVERIFIED, check it renders.
     Host contract: ViewModel (MapViewModel); handle Acted. -->
<UserControl x:Class="Anvil.Controls.Composites.TemporalModeMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- LIGHTWEIGHT STYLING: the rows' Buttons wear a menu row's faces (transparent at rest, the subtle fills on
             hover / press, no border) instead of a Button's. -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush"/>
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush"/>
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush"/>
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush"/>
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush"/>
                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush"/>
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush"/>
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush"/>
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush"/>
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush"/>
                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- A MODE target: ✓ (only while on) + the mode's name. -->
            <Style x:Key="TemporalModeMenuModeButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="32"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
            <!-- A PANE target: eye + "Pane" + the shortcut, fixed width so the three line up. -->
            <Style x:Key="TemporalModeMenuPaneButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Width" Value="140"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Width="300" Spacing="2">
        <!-- ── NowCast ── -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="TemporalModeMenuNowCastButton" Style="{StaticResource TemporalModeMenuModeButtonStyle}"
                    Opacity="{x:Bind DimWhen(ViewModel.IsPastCast), Mode=OneWay}"
                    Click="OnNowCastClick"
                    PointerEntered="OnModeLift" PointerExited="OnModeSettle" GotFocus="OnModeLift" LostFocus="OnModeSettle">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Width="16"
                              Opacity="{x:Bind TickOpacity(ViewModel.IsNowCast), Mode=OneWay}"/>
                    <TextBlock Text="NowCast"/>
                </StackPanel>
            </Button>
            <Button x:Name="TemporalModeMenuNowCastPaneButton" Grid.Column="1" Style="{StaticResource TemporalModeMenuPaneButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanPickNowPane, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind PaneTip(ViewModel.IsNowPaneOpen), Mode=OneWay}"
                    Click="OnNowPaneClick">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind EyeGlyph(ViewModel.IsNowPaneOpen), Mode=OneWay}" FontSize="16"/>
                    <TextBlock Grid.Column="1" Text="Pane" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Ctrl+2" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </Button>
        </Grid>

        <!-- ── ForeCast ── -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="TemporalModeMenuForeCastButton" Style="{StaticResource TemporalModeMenuModeButtonStyle}"
                    Opacity="{x:Bind DimWhen(ViewModel.IsPastCast), Mode=OneWay}"
                    Click="OnForeCastClick"
                    PointerEntered="OnModeLift" PointerExited="OnModeSettle" GotFocus="OnModeLift" LostFocus="OnModeSettle">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Width="16"
                              Opacity="{x:Bind TickOpacity(ViewModel.IsForeCast), Mode=OneWay}"/>
                    <TextBlock Text="ForeCast"/>
                </StackPanel>
            </Button>
            <Button x:Name="TemporalModeMenuForeCastPaneButton" Grid.Column="1" Style="{StaticResource TemporalModeMenuPaneButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanPickForePane, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind PaneTip(ViewModel.IsForePaneOpen), Mode=OneWay}"
                    Click="OnForePaneClick">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind EyeGlyph(ViewModel.IsForePaneOpen), Mode=OneWay}" FontSize="16"/>
                    <TextBlock Grid.Column="1" Text="Pane" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Ctrl+3" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </Button>
        </Grid>

        <!-- The rule: Now + Fore together, Past ALONE. -->
        <Rectangle x:Name="TemporalModeMenuRule" Height="1" Margin="-4,2,-4,2"
                   Fill="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>

        <!-- ── PastCast ── -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="TemporalModeMenuPastCastButton" Style="{StaticResource TemporalModeMenuModeButtonStyle}"
                    Opacity="{x:Bind DimWhenEither(ViewModel.IsNowCast, ViewModel.IsForeCast), Mode=OneWay}"
                    Click="OnPastCastClick"
                    PointerEntered="OnModeLift" PointerExited="OnModeSettle" GotFocus="OnModeLift" LostFocus="OnModeSettle">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Width="16"
                              Opacity="{x:Bind TickOpacity(ViewModel.IsPastCast), Mode=OneWay}"/>
                    <TextBlock Text="PastCast"/>
                </StackPanel>
            </Button>
            <Button x:Name="TemporalModeMenuPastCastPaneButton" Grid.Column="1" Style="{StaticResource TemporalModeMenuPaneButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanPickPastPane, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind PaneTip(ViewModel.IsPastPaneOpen), Mode=OneWay}"
                    Click="OnPastPaneClick">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind EyeGlyph(ViewModel.IsPastPaneOpen), Mode=OneWay}" FontSize="16"/>
                    <TextBlock Grid.Column="1" Text="Pane" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Ctrl+1" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </Button>
        </Grid>

        <!-- The greyed hint: what a click on the dimmed side turns off. -->
        <TextBlock x:Name="TemporalModeMenuHint" Margin="40,2,12,4" FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="{x:Bind Hint(ViewModel.IsNowCast, ViewModel.IsForeCast, ViewModel.IsPastCast), Mode=OneWay}"
                   Visibility="{x:Bind HintVisibility(ViewModel.IsNowCast, ViewModel.IsForeCast, ViewModel.IsPastCast), Mode=OneWay}"/>
    </StackPanel>
</UserControl>
