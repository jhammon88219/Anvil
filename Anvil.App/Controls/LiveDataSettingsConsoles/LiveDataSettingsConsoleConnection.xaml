<?xml version="1.0" encoding="utf-8"?>
<!-- LiveDataSettingsConsoleConnection — Settings → Live Data's "Connection" section, on a Primitives/SettingsConsolePlate: how the
     live link stands. READ-ONLY — no Restore defaults, no DEFAULT.

       Connection
       Status        ● IEM · connected since 11:02:14 AM
       Last product  12:04:31 PM · Severe thunderstorm warning, OUN
       Missed        None this session
       96            the rest of the row (Control + Hint columns)

     ⚠️ Every row is a Primitives/SettingsConsoleRow (lifts; its About = Services/Settings/SettingsText by AboutKey); the value
     sits in the Control column and may wrap. ⚠️ The status dot's colors are DATA literals (code-behind), like the activity
     rows' — never a theme brush in C#. -->
<UserControl x:Class="Anvil.Controls.LiveDataSettingsConsoles.LiveDataSettingsConsoleConnection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="LiveDataSettingsConsoleConnectionPlate" Title="Connection">
        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <prim:SettingsConsoleRow Label="Status" AboutKey="conn.status">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind StateBrush(ViewModel.LinkState), Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Style="{StaticResource TabularNumberTextStyle}"/>
                </StackPanel>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Last product" AboutKey="conn.last">
                <TextBlock Text="{x:Bind ViewModel.LastProductText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Style="{StaticResource TabularNumberTextStyle}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Missed" AboutKey="conn.missed">
                <TextBlock Text="{x:Bind ViewModel.MissedText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </prim:SettingsConsoleRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
