<?xml version="1.0" encoding="utf-8"?>
<!-- AboutSettingsConsoleLicense — Settings → About → License (artboard 27): the license, the source, where to report.

       ┌ License ──────────────────────────────────────────────────────┐
       │ License            AGPL-3.0                     [ Read it ↗ ] │
       │                    Use, change and share Anvil freely; …      │   ← quiet line, clear of the key column
       │ Source             github.com/jhammon88219/Anvil  [ Open ↗ ]  │   ← rows 6 apart, so the keys never touch
       │ Report a problem   GitHub issues                  [ Open ↗ ]  │
       └───────────────────────────────────────────────────────────────┘
     Every key = AboutKeyWidth (112), one column at the right edge. ↗ (E8A7) = it leaves Anvil: AboutAnvil.OpenLink asks
     first (Dialogs/LeaveAnvilDialog) unless "Don't ask again" was ticked. -->
<UserControl x:Class="Anvil.Controls.AboutSettingsConsoles.AboutSettingsConsoleLicense"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:local="using:Anvil.Controls.AboutSettingsConsoles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="AboutSettingsConsoleLicensePlate" Title="License">
        <StackPanel Spacing="6">
            <StackPanel>
                <local:AboutSettingsConsoleInfoRow x:Name="AboutSettingsConsoleLicenseLicense" Label="License" Value="AGPL-3.0">
                    <local:AboutSettingsConsoleInfoRow.Action>
                        <Button Click="OnLicenseClick" Width="{StaticResource AboutKeyWidth}" ToolTipService.ToolTip="Opens the license text on GitHub">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Read it"/>
                                <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </local:AboutSettingsConsoleInfoRow.Action>
                </local:AboutSettingsConsoleInfoRow>
                <TextBlock x:Name="AboutSettingsConsoleLicenseMeaning" Margin="172,2,124,0" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Use, change and share Anvil freely; anything built from it must be released under the same license."/>
            </StackPanel>
            <local:AboutSettingsConsoleInfoRow x:Name="AboutSettingsConsoleLicenseSource" Label="Source" Value="github.com/jhammon88219/Anvil" IsQuiet="True">
                <local:AboutSettingsConsoleInfoRow.Action>
                    <Button Click="OnSourceClick" Width="{StaticResource AboutKeyWidth}" ToolTipService.ToolTip="Opens Anvil's source code on GitHub">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Open"/>
                            <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </local:AboutSettingsConsoleInfoRow.Action>
            </local:AboutSettingsConsoleInfoRow>
            <local:AboutSettingsConsoleInfoRow x:Name="AboutSettingsConsoleLicenseIssues" Label="Report a problem" Value="GitHub issues" IsQuiet="True">
                <local:AboutSettingsConsoleInfoRow.Action>
                    <Button Click="OnIssuesClick" Width="{StaticResource AboutKeyWidth}" ToolTipService.ToolTip="Opens Anvil's issue list on GitHub">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Open"/>
                            <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </local:AboutSettingsConsoleInfoRow.Action>
            </local:AboutSettingsConsoleInfoRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
