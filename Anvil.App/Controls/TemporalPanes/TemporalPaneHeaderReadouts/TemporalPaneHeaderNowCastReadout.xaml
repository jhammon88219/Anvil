<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalPaneHeaderNowCastReadout — the NowCast header's Readout: the CLOCK (the machine's time, no seconds).

       3:42 PM          ← digits 40 SemiLight TABULAR on a 42 line · AM/PM 16 secondary on their bottom edge
                          tooltip: "CDT · 20:42 UTC"

     ⚠️ A COPY of the radar console's clock (Composites/RadarControls "THE CLOCK"). The AM/PM slot is as wide as
     the WIDER designator (two invisible samples), so the clock's width changes only with the digit COUNT
     (9:59 → 10:00). Retune both clocks together.
     ⚠️ It keeps NO timer: TemporalPaneNowCastContent's clock tick pushes Time (once per shown second). -->

<UserControl x:Class="Anvil.Controls.TemporalPanes.TemporalPaneHeaderReadouts.TemporalPaneHeaderNowCastReadout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tp="using:Anvil.Controls.TemporalPanes"
             xmlns:temporalPaneHeaderReadouts="using:Anvil.Controls.TemporalPanes.TemporalPaneHeaderReadouts"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsTabStop="False">

    <Grid x:Name="ClockTime" ColumnSpacing="4" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ClockDigits" Grid.Column="0"
                   Typography.NumeralAlignment="Tabular"
                   FontSize="40" FontWeight="SemiLight"
                   LineHeight="42" LineStackingStrategy="BlockLineHeight"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,5">
            <TextBlock x:Name="AmSample" FontSize="16" Opacity="0" IsHitTestVisible="False"/>
            <TextBlock x:Name="PmSample" FontSize="16" Opacity="0" IsHitTestVisible="False"/>
            <TextBlock x:Name="ClockSuffix" FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Grid>
</UserControl>
