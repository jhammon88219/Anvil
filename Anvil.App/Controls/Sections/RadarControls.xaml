<?xml version="1.0" encoding="utf-8"?>
<!-- RadarControls — the radar half of the bottom bar, laid out entirely with Grids (no StackPanels):

       PANE CHIPS  |  GLOBAL TIME MODULE
       [product]   |  [————— scrubber —————]
                   |  [tilt · transport · frame · site readout]

     THE ORGANIZING RULE (settled before multi-pane): the bar is split into what repeats per pane and
     what does not. A pane differs from its siblings ONLY by product (and, later, tilt), so the pane
     chips are the only thing that multiplies — in quad-pane the single chip becomes a 2x2 cluster whose
     arrangement MIRRORS the pane grid, so the existing chip stays put and three appear right / below /
     below-right. Everything else here is global: one site, one camera, one time cursor shared by every
     pane, which is why the scrubber does NOT repeat.

     SCRUBBER WIDTH is deliberately NOT the full bar: the time module is auto-width, so the scrubber
     stretches to exactly the control row beneath it and stops at the end of the site readout. Every
     variable-length readout in that row (frame count, time, ICAO, age, scan) carries a RESERVED fixed
     width, so the module's width — and therefore the scrubber's — is a constant. Without that the
     scrubber would resize (and reflow all its cells) every time the age ticked over.

     The global controls that flank this (temporal toggles, window buttons) are composed by MainWindow
     to the right; site-marker visibility and Inspect live in the Map Controls window. All bound to one
     RadarViewModel. -->
<UserControl x:Class="Anvil.Controls.Sections.RadarControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Anvil.Controls"
             xmlns:vm="using:Anvil.ViewModels"
             mc:Ignorable="d">

    <UserControl.Resources>
        <x:Double x:Key="ReadoutFontSize">13</x:Double>
        <!-- Thin vertical rule between clusters. -->
        <Style x:Key="BarDividerStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- Left-aligned: MainWindow right-aligns the global cluster in the same bar row, and the gap between
         them is empty bar. -->
    <Grid HorizontalAlignment="Left" VerticalAlignment="Center" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/> <!-- pane chips -->
            <ColumnDefinition Width="Auto"/> <!-- divider -->
            <ColumnDefinition Width="Auto"/> <!-- global time module -->
        </Grid.ColumnDefinitions>

        <!-- ============================ PANE CHIPS ============================
             The per-pane cluster: one chip per pane, and today there is exactly one pane. A chip is the
             Product combo, which draws each product's COLOR RAMP next to its short name — so the chip is
             simultaneously the selector, the legend, and (via the inspect tick riding the ramp) that
             pane's live inspect readout. Multi-pane grows this into a 2x2; nothing else in the bar
             multiplies with it. -->
        <Grid x:Name="PaneChips" Grid.Column="0" VerticalAlignment="Center">
            <controls:ProductColorRampComboBox
                      Width="200"
                      IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.RadarProductOptions}"
                      SelectedIndex="{x:Bind ViewModel.RadarProductIndex, Mode=TwoWay}"
                      InspectFraction="{x:Bind ViewModel.InspectFraction, Mode=OneWay}"
                      IsInspectVisible="{x:Bind ViewModel.IsInspectMarkerVisible, Mode=OneWay}"/>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource BarDividerStyle}"/>

        <!-- ============================ GLOBAL TIME MODULE ============================
             Everything time-related, in two rows. The grid is auto-width, so row 1 (all fixed widths)
             sets the module width and row 0's scrubber stretches to match it exactly. -->
        <Grid Grid.Column="2" VerticalAlignment="Center" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- segmented scrubber -->
                <RowDefinition Height="Auto"/> <!-- tilt · transport · frame · site readout -->
            </Grid.RowDefinitions>

            <!-- Segmented scrubber: one cell per frame (ViewModel.Segments), each lighting up as its frame
                 decodes — the load indicator for the whole loop. The playhead is repositioned in
                 code-behind over the current segment; pointer press/drag seeks. It measures to zero width
                 on its own (UniformHorizontalPanel returns 0 under infinite width), which is what lets the
                 control row below define the module width. -->
            <Grid x:Name="ScrubberHost"
                  Grid.Row="0"
                  Height="16"
                  Background="Transparent"
                  IsHitTestVisible="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                  Opacity="{x:Bind ScrubberOpacity(ViewModel.IsTransportEnabled), Mode=OneWay}"
                  SizeChanged="OnScrubberSizeChanged"
                  PointerPressed="OnScrubberPointerPressed"
                  PointerMoved="OnScrubberPointerMoved"
                  PointerReleased="OnScrubberPointerReleased"
                  PointerCaptureLost="OnScrubberPointerReleased"
                  PointerCanceled="OnScrubberPointerReleased">
                <!-- Always-present track so the scrubber occupies the same footprint whether or not a loop
                     is loaded (the cells render on top as frames decode). -->
                <Border Height="6"
                        VerticalAlignment="Center"
                        CornerRadius="3"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"/>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Segments, Mode=OneWay}"
                              IsHitTestVisible="False"
                              VerticalAlignment="Center"
                              Height="8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:UniformHorizontalPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RadarFrameSegment">
                            <Border Margin="1,0"
                                    CornerRadius="2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="{x:Bind ReadyOpacity, Mode=OneWay}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="Playhead"
                        Width="3"
                        Height="16"
                        CornerRadius="1.5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{ThemeResource TextFillColorPrimaryBrush}"
                        IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PlayheadTransform"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <!-- Control row. EVERY text column has a reserved fixed width (see the header note) so the
                 module — and the scrubber above it — never changes width as the readouts update. -->
            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- tilt -->
                    <ColumnDefinition Width="Auto"/> <!-- prev -->
                    <ColumnDefinition Width="Auto"/> <!-- play/stop -->
                    <ColumnDefinition Width="Auto"/> <!-- next -->
                    <ColumnDefinition Width="52"/>   <!-- frame N / M -->
                    <ColumnDefinition Width="64"/>   <!-- displayed frame time -->
                    <ColumnDefinition Width="Auto"/> <!-- divider -->
                    <ColumnDefinition Width="48"/>   <!-- site ICAO -->
                    <ColumnDefinition Width="Auto"/>   <!-- age of newest -->
                    <ColumnDefinition Width="200"/>  <!-- scan strategy -->
                </Grid.ColumnDefinitions>

                <!-- Tilt (elevation). Data-driven from ViewModel.RadarTiltOptions, read from the VCP's
                     elevation table carried in every cached tilt — so the choices are what this radar
                     actually scans right now, and they follow a VCP change. GLOBAL for v1: every pane
                     shows the same elevation, because a different tilt is a different VOLUME (a second
                     frame set), not just a different build of the same frame. When per-pane tilt lands
                     this control moves into the chip. -->
                <controls:TiltComboBox Grid.Column="0"
                          ItemsSource="{x:Bind ViewModel.RadarTiltOptions}"
                          SelectedIndex="{x:Bind ViewModel.RadarTiltIndex, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.CanSelectTilt, Mode=OneWay}"
                          ToolTipService.ToolTip="Elevation angle (tilt)"/>

                <Button Grid.Column="1"
                        Style="{StaticResource TransportButtonStyle}"
                        Width="30"
                        Height="30"
                        Click="OnPrevClick"
                        IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                        ToolTipService.ToolTip="Previous frame">
                    <FontIcon Glyph="&#xE892;" FontSize="13"/>
                </Button>
                <Button Grid.Column="2"
                        Style="{StaticResource TransportButtonStyle}"
                        Width="38"
                        Height="38"
                        Click="OnPlayStopClick"
                        IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                        ToolTipService.ToolTip="Play / stop (stop returns to the newest frame)">
                    <FontIcon Glyph="{x:Bind PlayStopGlyph(ViewModel.IsPlaying), Mode=OneWay}" FontSize="17"/>
                </Button>
                <Button Grid.Column="3"
                        Style="{StaticResource TransportButtonStyle}"
                        Width="30"
                        Height="30"
                        Click="OnNextClick"
                        IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                        ToolTipService.ToolTip="Next frame">
                    <FontIcon Glyph="&#xE893;" FontSize="13"/>
                </Button>

                <!-- Frame N/M (current / total). -->
                <TextBlock Grid.Column="4"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="{x:Bind FrameCountText(ViewModel.CurrentFrameIndex, ViewModel.MaxFrameIndex), Mode=OneWay}"
                           FontSize="{StaticResource ReadoutFontSize}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           ToolTipService.ToolTip="Which frame of the loop is on screen"/>
                <!-- The DISPLAYED frame's time (the one you scrubbed to), not the newest. -->
                <TextBlock Grid.Column="5"
                           VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.CurrentFrameTimeText, Mode=OneWay}"
                           FontSize="{StaticResource ReadoutFontSize}"
                           ToolTipService.ToolTip="When the frame on screen was scanned"/>

                <Border Grid.Column="6" Style="{StaticResource BarDividerStyle}" Height="20"/>

                <!-- Site readout: ICAO, freshness of the NEWEST frame, and the volume's scan strategy.
                     One line — the location name is the ICAO's tooltip (the ICAO is the real label), the
                     scanned time now rides the transport, and the rendered elevation is the Tilt combo. -->
                <TextBlock Grid.Column="7"
                           VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.RadarSiteId, Mode=OneWay}"
                           FontWeight="SemiBold"
                           FontSize="{StaticResource ReadoutFontSize}"
                           ToolTipService.ToolTip="{x:Bind ViewModel.RadarSiteName, Mode=OneWay}"/>
                <!-- Age of the freshest frame, color-ramped fresh(green) to stale(red) by AgeBrush so
                     freshness reads at a glance. -->
                <TextBlock Grid.Column="8"
                           VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.RadarAgeText, Mode=OneWay}"
                           FontSize="{StaticResource ReadoutFontSize}"
                           Foreground="{x:Bind AgeBrush(ViewModel.RadarAgeMinutes), Mode=OneWay}"
                           ToolTipService.ToolTip="How long ago the newest available frame was scanned. Green = fresh, red = stale."/>
                <!-- Scan strategy for the whole volume; see RadarVcpText for why SAILS belongs here. -->
                <TextBlock Grid.Column="9"
                           VerticalAlignment="Center"
                           Text="{x:Bind RadarVcpText(ViewModel.RadarModeText), Mode=OneWay}"
                           FontSize="{StaticResource ReadoutFontSize}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           ToolTipService.ToolTip="The radar's scan strategy for the whole volume. VCP = Volume Coverage Pattern, a number chosen by the operator: 'precip' patterns scan faster and more often for rain/storms; 'clear-air' patterns scan slower for better sensitivity in dry weather. SAILS/MRLE ×N means the radar squeezes in N extra scans of the lowest tilt per volume, giving fresher data near the ground during fast-changing weather."/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
