<?xml version="1.0" encoding="utf-8"?>
<!-- LoopLoadProgressBar — one row of the PastCast loading screen (LoopHoldingGate uses two: Downloaded, Built). Layout
     C+E (the user's call, 2026-10-04): a big count on the left, one CELL PER FRAME on the right, each cell filled from
     the bottom by how far THAT frame has got, and a caption line under the cells.

       ┌─ 120 ──────┐   ┌─────────────────────── cells (*) ───────────────────────┐
       │            │   ▐█▌▐█▌▐█▌▐█▌▐▄▌▐▃▌▐ ▌▐▂▌▐ ▌▐ ▌▐ ▌▐ ▌▐ ▌▐ ▌▐ ▌▐ ▌▐ ▌▐ ▌   ← 30 tall, 3 apart,
       │ 22 / 28    │   ▐█▌▐█▌▐█▌▐█▌▐█▌▐█▌▐▄▌▐█▌▐▃▌▐ ▌▐ ▌▐ ▌▐ ▌▐ ▌▐ ▌▐ ▌▐ ▌▐ ▌      2 px corners
       │ downloaded │   6:35 PM scan · 2.1 of 4.3 MB              12 at once · 61 MB  ← Caption · Detail (11)
       └────────────┘
        ↑ count 34 semibold + " / 28" 16 muted, label 12 under it. The count block is centred VERTICALLY ON THE CELLS
          (row 0 is the taller of the two and both centre in it), not on cells + caption — the user's call.

     A cell: full colour = done; part-filled and 60% bright = in progress; empty track = not started. What "how far"
     means is the caller's (LoopHoldingGateViewModel.DownloadCells / BuildCells) — this control only draws fractions.
     No cells yet (the volumes aren't listed) → one empty track the width of the row.

     ⚠️ Colours are LITERALS on purpose, like the whole gate: it always sits on a darkened map, never themed. The fill
     colour is a DP (Fill) so the two rows differ — grey for downloads, the scrubber's blue for builds.
     ⚠️ Cells are built in code-behind (UpdateCells), not an ItemsControl: they re-fill several times a second during a
     load, and only the changed heights are touched. -->
<UserControl x:Class="Anvil.Controls.Primitives.LoopLoadProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- THE BIG COUNT, centred on the cells' row. -->
        <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="34" FontWeight="SemiBold" LineHeight="38" Foreground="#FFE8EAED"
                       Typography.NumeralAlignment="Tabular">
                <Run Text="{x:Bind CountText(Count), Mode=OneWay}"/>
                <Run Text="{x:Bind TotalText(Total), Mode=OneWay}" FontSize="16" FontWeight="Normal" Foreground="#FF8C96A3"/>
            </TextBlock>
            <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="12" Margin="0,5,0,0" Foreground="#FFA6AEB8"/>
        </StackPanel>

        <!-- THE CELLS, one per frame (UpdateCells). -->
        <Grid x:Name="CellsGrid" Grid.Column="1" Height="30" VerticalAlignment="Center" ColumnSpacing="3"/>

        <!-- Caption · Detail, under the cells only. -->
        <Grid Grid.Column="1" Grid.Row="1" Margin="0,6,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Caption, Mode=OneWay}" FontSize="11" Foreground="#FFA6AEB8"
                       TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
            <TextBlock Grid.Column="1" Text="{x:Bind Detail, Mode=OneWay}" FontSize="11" Foreground="#FFA6AEB8"
                       Typography.NumeralAlignment="Tabular"/>
        </Grid>
    </Grid>
</UserControl>
