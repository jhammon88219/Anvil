<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalPane — ONE mode's pane, an OVERLAY on the map in MainWindow's map band (no OS window, no chrome). It sits
     flush to its screen edge (Past + Now left, Fore right), flush to the top of the window and flush to the top of the
     bottom chrome's opaque tiers; it never resizes or pushes the map.

       ┌────────────────────────────────────────────────┐
       │  ┌──┐ ForeCast                    │ MDT 4/5     │  ← NO title row: each CONTENT opens with
       │  └──┘ Day 1 · Wed Sep 2           │ next ~9 min │    a TemporalPanes/TemporalPaneHeader
       │  (480 wide × full height; the CONTENT scrolls itself)
       │  ┌──────────────────────────────────────────┐   │
       │  │                                          │   │
       │  │   that mode's CONTENT — all three        │   │
       │  │   declared below, only Mode's one        │   │
       │  │   x:Load'ed:                             │   │
       │  │   TemporalPaneNowCastContent             │   │
       │  │   TemporalPanePastCastContent            │   │
       │  │   TemporalPaneForeCastContent            │   │
       │  └──────────────────────────────────────────┘   │
       ░░░░░░░░░░░░░░░░░░╭─ ˄ More ─╮░░░░░░░░░░░░░░░░░░░░  ← shadow + the one pull tab
       ├──────────────────┘          └───────────────────┤
       │▓ Next check in 0:18        Scan due ~1:47:12 PM ▓│  ← TemporalPaneActivityExpander: this MODE's
       │▓ Last frame: on screen 3.0 s after due          ▓│    activity, Hidden / Full
       └──────────────────────────────────────────────────┘
       ▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔  ← the tools tier's top (MainWindow sets the bottom inset)

     ⚠️ ONE CLASS, THREE PANES, all declared in MainWindow.xaml (TemporalPanePastCast / …NowCast / …ForeCast), each with
     its Mode set there ONCE. Three near-identical classes would be three copies of one layout waiting to drift apart.
     NAMES READ AS THE TREE: TemporalPane → TemporalPane<Mode>Content → TemporalPaneHeader →
     TemporalPaneHeader<Mode>Readout; each x:Name equals its type name.

     ⚠️ BUILT ON FIRST SHOW, then KEPT. TemporalPaneBody is behind x:Load bound to IsRealized, which turns true the
     first time the pane becomes Visible and never goes back — so a mode that never runs costs nothing, and hiding a
     pane keeps every section's live state (it is Collapsed, not unloaded). Building + first-laying-out a pane froze
     the UI ~1-2 s at launch, which is why MapViewModel's LAUNCH WINDOWS shows them one at a time, each after the
     previous one's Shown (raised here once the body has loaded). The bind is OneTime: RealizeIfShown's
     Bindings.Update() is what re-reads it (and every other OneTime bind here — Mode and ViewModel are final by then).
     Inside the body the three Contents keep OneTime x:Load on Mode — Mode is set in XAML before the body realizes
     and never changes. Don't make the body's x:Load go false (it would throw the live widgets away).

     ⚠️ THIS PANE CANNOT OUTLIVE ITS MODE: MapViewModel.OnTemporalModesChanged hides it when the mode stops, so nothing
     in these Contents needs to check whether its mode runs. ⚠️ A CONTENT NEVER STARTS ITS MODE — that is the bar key's job. -->
<UserControl x:Class="Anvil.Controls.TemporalPanes.TemporalPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tp="using:Anvil.Controls.TemporalPanes"
             xmlns:temporalPaneContents="using:Anvil.Controls.TemporalPanes.TemporalPaneContents"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- Dark surface fills the whole pane. -->
    <Grid Background="{ThemeResource OverlayBarSurfaceBrush}">
        <Grid x:Name="TemporalPaneBody" x:Load="{x:Bind IsRealized}" Loaded="OnBodyLoaded">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    <!-- the Content: NO bottom margin — its list scrolls under the expander's shade -->
                <RowDefinition Height="Auto"/> <!-- TemporalPaneActivityExpander: full width, its height by state -->
            </Grid.RowDefinitions>

            <!-- ⚠️ NO ScrollViewer HERE. The pane is the FULL height above the bottom chrome, so a Content shorter than
                 that just shows surface below it. A Content scrolls ITSELF with Primitives/PanelScroller (all three have
                 it), because only the Content knows what stays fixed — PastCast's Timeframe and NowCast's clock + tiles
                 don't scroll, their sections do. Each Content stretches to the full row height. -->
            <temporalPaneContents:TemporalPanePastCastContent x:Name="TemporalPanePastCastContent" x:Load="{x:Bind IsPast}" Margin="16,14,16,0"
                              ViewModel="{x:Bind ViewModel}"/>
            <temporalPaneContents:TemporalPaneNowCastContent x:Name="TemporalPaneNowCastContent" x:Load="{x:Bind IsNow}" Margin="16,14,16,0"
                             ViewModel="{x:Bind ViewModel}"/>
            <temporalPaneContents:TemporalPaneForeCastContent x:Name="TemporalPaneForeCastContent" x:Load="{x:Bind IsFore}" Margin="16,14,16,0"
                              ViewModel="{x:Bind ViewModel}"/>

            <!-- THE ACTIVITY EXPANDER: this mode's activity (MapViewModel.ActivityFor(Mode)). ONE declaration for all three
                 modes, outside the Content, so it spans the pane edge to edge; declared after the Content so its shadow
                 and tab paint over the list. -->
            <tp:TemporalPaneActivityExpander x:Name="TemporalPaneActivityExpander" Grid.Row="1" Activity="{x:Bind PaneActivity}"/>
        </Grid>

        <!-- EDGE-HATCH (experimental bolt-on): the hatch on the pane's MAP side, hung OUTSIDE the pane on a negative margin
             (Past/Now: off the right edge, running right; Fore: off the left edge, running left). Click-through, full pane
             height; Settings → Edges ("Hatch the panes' map-side edges"). -->
        <prim:EdgeHatch x:Name="EdgeHatchPaneEdge"
                        HorizontalAlignment="{x:Bind HatchAlignment(IsFore)}"
                        Direction="{x:Bind HatchDirection(IsFore)}"
                        Width="{x:Bind ViewModel.EdgeHatch.Width, Mode=OneWay}"
                        Margin="{x:Bind HatchMargin(IsFore, ViewModel.EdgeHatch.Width), Mode=OneWay}"
                        Spacing="{x:Bind ViewModel.EdgeHatch.Spacing, Mode=OneWay}"
                        Weight="{x:Bind ViewModel.EdgeHatch.Weight, Mode=OneWay}"
                        Thin="{x:Bind ViewModel.EdgeHatch.Thins, Mode=OneWay}"
                        Fade="{x:Bind ViewModel.EdgeHatch.Fades, Mode=OneWay}"
                        Ink="{x:Bind ViewModel.EdgeHatch.ColorToken, Mode=OneWay}"
                        Visibility="{x:Bind HatchVisibility(ViewModel.EdgeHatch.IsPaneHatch), Mode=OneWay}"/>
    </Grid>
</UserControl>
