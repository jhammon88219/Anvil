<?xml version="1.0" encoding="utf-8"?>
<!-- StorageSettingsConsoleMap — Settings → Storage's "Which map to use" section, on a Primitives/SettingsConsolePlate: ONLY the two
     choices, Online map | Offline map (2026-11-19, canvas "Storage page — fewer plates" layout C). The map files live in
     Dialogs/MapFilesDialog (Map files…, which also holds the download form); the key in Dialogs/OnlineMapDialog (Set up…).
     Over BasemapSetupViewModel (MapViewModel.BasemapSetup) — the SAME instance the map setup window uses.

       Which map to use                                                       (no reset, no DEFAULT — files are yours)
       ( ) Online map                                     [Full]                       [  Set up…  ]
           Protomaps · streams as you move · needs the internet
       (•) Offline map                                    [Standard]                   [Map files…]   ← "Get a map…" with no file
           Lower 48 + Alaska · 5.0 GB on this PC · works with no internet                               ← NAMES the file it draws
           Step 4 of 5 · Download · 1.9 GB of 4.6 GB · about 1 minute left                              ← only while downloading
           ▓▓▓▓▓░░░░░░░                                                                                  (Cancel / Retry: the dialog)
       ↑ starts at the plate's left edge (NO label column, the user's call 2026-11-19)
       radio + name * · tag 84 · button 132 (both buttons the same width)

     ⚠️ Picking = a RADIO: Online → UseSavedOnline (no key saved yet → the Set up dialog), Offline → UseOffline (the file last used,
     else the first). Each radio sits in its own parent, so they never group-uncheck each other; IsChecked comes from the VM on
     every Refresh. The online map is ALWAYS full detail (its Full tag is fixed); Offline's tag is its file's detail.
     ⚠️ Column widths are GridLength resources — never x:Double (docs/bugs.md S36; XamlResourceTypeTests). -->
<UserControl x:Class="Anvil.Controls.StorageSettingsConsoles.StorageSettingsConsoleMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- The two CHOICE rows: radio + name * · tag 84 · button 132. -->
        <GridLength x:Key="MapChoiceTagWidth">84</GridLength>
        <GridLength x:Key="MapChoiceButtonWidth">132</GridLength>

        <Style x:Key="MapChoiceTagStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="MapChoiceButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <prim:SettingsConsolePlate x:Name="StorageSettingsConsoleMapPlate" Title="Which map to use">
        <StackPanel>
            <!-- ONLINE: always full detail. No key yet → picking it opens Set up… -->
            <Grid x:Name="MapChoiceOnline" MinHeight="56" ColumnSpacing="12" BorderThickness="0,1,0,0"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource MapChoiceTagWidth}"/>
                    <ColumnDefinition Width="{StaticResource MapChoiceButtonWidth}"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="MapChoiceOnlineRadio" VerticalAlignment="Center" MinWidth="0"
                             IsChecked="{x:Bind ViewModel.IsOnlineInUse, Mode=OneWay}"
                             Click="OnUseOnlineClick" AutomationProperties.Name="Online map">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" Text="Online map"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.OnlineRowText, Mode=OneWay}"/>
                    </StackPanel>
                </RadioButton>
                <Border Grid.Column="1" Style="{StaticResource MapChoiceTagStyle}">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Full" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
                <Button x:Name="MapChoiceOnlineSetUpButton" Grid.Column="2" Style="{StaticResource MapChoiceButtonStyle}" Content="Set up…"
                        Click="OnSetUpOnlineClick" ToolTipService.ToolTip="Paste and test your free map key"/>
            </Grid>

            <!-- OFFLINE: names the file it draws; Map files… switches, adds, downloads, deletes. -->
            <Grid x:Name="MapChoiceOffline" MinHeight="56" ColumnSpacing="12" BorderThickness="0,1,0,0"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource MapChoiceTagWidth}"/>
                    <ColumnDefinition Width="{StaticResource MapChoiceButtonWidth}"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="4" Padding="0,6">
                    <RadioButton x:Name="MapChoiceOfflineRadio" MinWidth="0"
                                 IsChecked="{x:Bind ViewModel.IsOfflineInUse, Mode=OneWay}"
                                 IsEnabled="{x:Bind ViewModel.CanUseOffline, Mode=OneWay}"
                                 Click="OnUseOfflineClick" AutomationProperties.Name="Offline map">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Text="Offline map"/>
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.OfflineRowText, Mode=OneWay}"/>
                        </StackPanel>
                    </RadioButton>
                    <!-- While a download runs: one line + a thin bar, so it shows without opening anything. -->
                    <StackPanel x:Name="MapChoiceOfflineDownload" Spacing="4" Margin="28,0,0,0" MaxWidth="460" HorizontalAlignment="Left"
                                Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay}">
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.DownloadLineText, Mode=OneWay}"/>
                        <ProgressBar Width="420" HorizontalAlignment="Left" Maximum="100" Value="{x:Bind ViewModel.DownloadPercent, Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource MapChoiceTagStyle}" Visibility="{x:Bind ViewModel.HasOfflineDetail, Mode=OneWay}">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind ViewModel.OfflineDetail, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
                <Button x:Name="MapChoiceOfflineFilesButton" Grid.Column="2" Style="{StaticResource MapChoiceButtonStyle}"
                        Content="{x:Bind ViewModel.MapFilesButtonText, Mode=OneWay}" Click="OnMapFilesClick"
                        ToolTipService.ToolTip="Switch, add, download and delete map files"/>
            </Grid>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
