<?xml version="1.0" encoding="utf-8"?>
<!-- AppearanceSettingsTab — Settings → Appearance (SettingsTab.Map's slot, renamed 2026-11-16): how Anvil LOOKS.

       ┌ Theme ──────────────────────────────────────────────────────────────── DEFAULT ┐
       │ Theme    [Anvil Dark      ⌄]  The app's chrome and basemap theme      Anvil Dark │  AppearanceSettingsConsoleTheme
       │ Basemap  [Data Viz Black  ⌄]  Overrides the theme aware map colors  The theme's │
       └─────────────────────────────────────────────────────────────────────────────────┘
          12 px of the body's darker ground
       ┌ Edges  [Restore defaults] ────────────────────────────────────────── DEFAULT ┐
       │ Pattern · Style · Line colour · 4 sliders · panes' edges                  …   │  AppearanceSettingsConsoleEdges
       └─────────────────────────────────────────────────────────────────────────────────┘

     WHAT BELONGS HERE: the app's LOOK. The old Map page's offline folder + online tiles rows are GONE — the same
     choices live on Settings → Basemap (one control in one place). The old Edges page is the Edges section
     (Edges' enum slot is a hidden rail entry; MapViewModel.SettingsTabIndex sends it here).
     ⚠️ Do NOT re-add the camera controls (Fit to view, Reset north, isolation) — they are map GESTURES on the rail. -->
<UserControl x:Class="Anvil.Controls.Composites.AppearanceSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:appearanceSettingsConsoles="using:Anvil.Controls.AppearanceSettingsConsoles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel Spacing="12" VerticalAlignment="Top">
        <appearanceSettingsConsoles:AppearanceSettingsConsoleTheme x:Name="AppearanceSettingsConsoleTheme"
                                                                   ViewModel="{x:Bind ViewModel}"/>
        <appearanceSettingsConsoles:AppearanceSettingsConsoleEdges x:Name="AppearanceSettingsConsoleEdges"
                                                                   ViewModel="{x:Bind ViewModel.EdgeHatch}"/>
    </StackPanel>
</UserControl>
