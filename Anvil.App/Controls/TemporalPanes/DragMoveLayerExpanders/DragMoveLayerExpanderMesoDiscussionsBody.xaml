<?xml version="1.0" encoding="utf-8"?>
<!-- DragMoveLayerExpanderMesoDiscussionsBody — mesoscale discussions (MesoDiscussionsViewModel): SPC MDs and WPC MPDs as map areas, and
     a GLANCE at them. Shown in BOTH temporal panes: live in Now (the last 24 h, the ones in effect drawn), the
     loaded window in Past (drawn as in effect at the displayed frame). READING happens in the Mesoscale
     Discussions WINDOW (Windows/MesoDiscussionWindow).

     ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓   the card (DragMoveLayerExpanderHeaderCard, FLUSH
     ▓  2 in effect                     5 in the last 24 h ▓   under the header, ONE line): how many are drawn
     ──────────────────────────────────────────────────────   now · how many listed (Past: "At 4:51 PM · 9 listed")
       [x] ■ SPC mesoscale                         2     ← one DragMoveLayerExpanderCountRow PER KIND, generated from
       [x] ■ WPC precipitation                     0       DiscussionKinds (a new kind needs no XAML); count = in
       ────────────────────────────────────────────────    effect, at the FAR RIGHT
       IN EFFECT AT 4:51 PM                               ← only what's in effect at the map's moment;
       ▌ 0647                       95%  2:10–3:45 PM     a row FLIES the map to it and outlines it (the window
       ▌ 1505                            1:52–7:50 PM     does NOT open); number only — the bar's colour says MD /
       [          View all Discussions                 ]  MPD; no description (its tooltip); range far right
                                                         ← the window, on the selection (else the first in
                                                           effect); a click on an area on the map opens it too

     ⚠️ THE READER LEFT THIS SECTION (2026-10-07, the user's version B): the list + a long reader in a 480 px
     column, each bounded in its own scroller, was what made it hard to use. Don't put a reader back here.
     ⚠️ Swatches are the kinds' own colours (DiscussionKinds.Fill ⇄ discussions.js KIND_COLORS). Data colours.
     ⚠️ Opacity and the heading are the HOST's DragMoveLayerExpander, as for every overlay control. -->
<UserControl x:Class="Anvil.Controls.TemporalPanes.DragMoveLayerExpanders.DragMoveLayerExpanderMesoDiscussionsBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tp="using:Anvil.Controls.TemporalPanes"
             xmlns:dragMoveLayerExpanders="using:Anvil.Controls.TemporalPanes.DragMoveLayerExpanders"
             xmlns:conv="using:Anvil.Converters"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:local="using:Anvil.Controls.Composites"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>

        <!-- One kind: toggle, colour, name, how many are in effect (DragMoveLayerExpanderCountRow — every expander's
             row: count at the far right, hover lift). Item type: DiscussionKindRow. -->
        <DataTemplate x:Key="KindRowTemplate" x:DataType="vm:DiscussionKindRow">
            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="{x:Bind Label}"
                    IsChecked="{x:Bind IsShown, Mode=TwoWay}"
                    Count="{x:Bind dragMoveLayerExpanders:DragMoveLayerExpanderMesoDiscussionsBody.Fmt(Count), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ToolTip}">
                <Border Width="11" Height="11" CornerRadius="2"
                        Background="{x:Bind Fill, Converter={StaticResource HexToBrush}}"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>
        </DataTemplate>
        <!-- The rows' spacing (4, halved 2026-10-21) — the row control carries none. -->
        <ItemsPanelTemplate x:Key="KindRowsPanel">
            <StackPanel Spacing="4"/>
        </ItemsPanelTemplate>

        <!-- One discussion in effect: a flat button that FLIES the map to it (and outlines it). The number alone —
             the colour bar says MD / MPD; NO description (dropped 2026-10-21 — the middle is left blank; the
             tooltip carries it); the watch % and the effective range on the far right. -->
        <DataTemplate x:Key="InEffectRowTemplate" x:DataType="vm:DiscussionRow">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="Transparent" BorderThickness="0" Padding="0,4"
                    Click="OnRowClick" Tag="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind Headline}">
                <Grid ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="18" CornerRadius="1.5"
                            Background="{x:Bind Fill, Converter={StaticResource HexToBrush}}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource TabularNumberTextStyle}" Text="{x:Bind NumberText}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource TabularNumberTextStyle}" Text="{x:Bind WatchText}"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" ToolTipService.ToolTip="Probability of watch issuance"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource TabularNumberTextStyle}" Text="{x:Bind RangeText}"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               ToolTipService.ToolTip="In effect from – to"/>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Top">
        <!-- THE CARD, flush under the section header (DragMoveLayerExpanderHeaderCard; its bottom edge is the rule). -->
        <dragMoveLayerExpanders:DragMoveLayerExpanderHeaderCard
                Headline="{x:Bind ViewModel.CardHeadline, Mode=OneWay}"
                Context="{x:Bind ViewModel.CardContext, Mode=OneWay}"
                Footer="{x:Bind ViewModel.CardFooter, Mode=OneWay}"/>

        <!-- THE KINDS: generated, one row each. -->
        <ItemsControl ItemsSource="{x:Bind ViewModel.Kinds}" ItemTemplate="{StaticResource KindRowTemplate}"
                      ItemsPanel="{StaticResource KindRowsPanel}"/>

        <Border Height="1" Margin="0,12,0,8" Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>

        <!-- IN EFFECT: only the ones in effect at the map's moment; the rest are in the window. -->
        <TextBlock Text="{x:Bind ViewModel.InEffectHeading, Mode=OneWay}" Style="{StaticResource AtlasFieldLabelStyle}"
                   Margin="0,0,0,4" Visibility="{x:Bind Shown(ViewModel.HasInEffect), Mode=OneWay}"/>
        <ItemsControl ItemsSource="{x:Bind ViewModel.InEffect}" ItemTemplate="{StaticResource InEffectRowTemplate}"/>

        <Button Margin="0,8,0,0" HorizontalAlignment="Stretch"
                Content="View all Discussions"
                IsEnabled="{x:Bind ViewModel.HasDiscussions, Mode=OneWay}"
                Click="OnOpenReaderClick"
                ToolTipService.ToolTip="Read every discussion of this window in the Mesoscale Discussions window"/>
    </StackPanel>
</UserControl>
