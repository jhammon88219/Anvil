<?xml version="1.0" encoding="utf-8"?>
<!-- StorageManagerSettingsConsoleDataTableRow — ONE kind of data in Settings → Storage's table (declared ×5 in
     StorageManagerSettingsConsoleDataTable, in StorageKind order).

       ──────────────────────────────────────────────────────────────────────────────────────────────── ← hairline (top)
       ■  Radar volumes        Loops you've loaded    1.8 GB  [  Clear  ]  [📁]  [ 5 GB   ⌄]  [ 5 days ⌄]   5 GB · 5 days
       ■  Maps                 Offline map files     33.8 GB              [📁]   ─────────    ─────────   (no Clear, no limits)
       16 NAME (= widest name)  * grey hint (trims)   80 ←R   96          36    104          112           150 DEFAULT, right
       ■ = 14 × 14 (the usage bar's height) · NAME 16 Medium · hint 12 regular, secondary
                                                      ↑ Low = normal text · Medium = caution · High = critical (bold)

     ⭐ PICKABLE like every Settings row (2026-11-17): HOVER + SELECTED lifts (SettingsRowHoverBrush / …SelectedBrush, bled
     8 px past the cells), picked by a click anywhere on the row (its buttons and dropdowns too) or by focus moving in; the
     page's About box then shows the kind: title = its name, text = Services/Settings/SettingsText by AboutKey
     ("storage.<kind>"), default = its DEFAULT limits. It is an ISettingsPickableRow, not a SettingsConsoleRow — its nine
     columns are the table's.
     ⚠️ THE COLUMNS ARE THE TABLE'S — the same nine columns + ColumnSpacing 10 as the header row in
     StorageManagerSettingsConsoleDataTable. Change both, or the controls stop lining up down the table.
     ⚠️ NAME is Auto until the table measures every row's name (NaturalNameWidth) and hands the WIDEST back
     (SetNameColumnWidth) — so the grey hints all start on one edge. The names never change, so it runs once.
     ⚠️ Every value with a changing width sits in a FIXED slot (Size 80 right-aligned, tabular digits; the button 96;
     each dropdown fills its column), so a new size or choice never moves anything.
     ⚠️ The Size colour is a VisualState (FillStates ← Item.Fill) with {ThemeResource} brushes — never a brush picked in C#.
     A kind with no Max size shows a hairline across that column (12 px in each side); usage history's Keep for is
     "Always kept", its text starting where the dropdowns' text does. A dropdown greys only when its item
     has no setter (IsMaxEditable / IsKeepEditable — none today). Usage history's button asks first (a flyout); the rest clear at once. -->
<UserControl x:Class="Anvil.Controls.StorageManagers.StorageManagerSettingsConsoleDataTableRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- The ROW HOST: bled 8 px each side (like Primitives/SettingsConsoleRow) so the lifts reach past the cells; the cells keep
         the table's columns exactly (Margin 8 back in). ALL the visual states live here (GoToState reads the root's groups). -->
    <Grid x:Name="DataTableRowRoot" Margin="-8,0" Background="Transparent"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" PointerCanceled="OnPointerExited">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="FillStates">
                <VisualState x:Name="Low"/>
                <VisualState x:Name="Medium">
                    <VisualState.Setters>
                        <Setter Target="SizeText.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}"/>
                        <Setter Target="SizeText.FontWeight" Value="SemiBold"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="High">
                    <VisualState.Setters>
                        <Setter Target="SizeText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
                        <Setter Target="SizeText.FontWeight" Value="SemiBold"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="NotHovered"/>
                <VisualState x:Name="Hovered">
                    <VisualState.Setters>
                        <Setter Target="DataTableRowHoverLift.Opacity" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected"/>
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="DataTableRowSelectedLift.Opacity" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- The lifts: the SAME brushes as every Settings row; 1 px down so the row's top hairline stays a line. -->
        <Border x:Name="DataTableRowHoverLift" Margin="0,1,0,0" CornerRadius="4" Opacity="0" IsHitTestVisible="False"
                Background="{ThemeResource SettingsRowHoverBrush}"/>
        <Border x:Name="DataTableRowSelectedLift" Margin="0,1,0,0" CornerRadius="4" Opacity="0" IsHitTestVisible="False"
                Background="{ThemeResource SettingsRowSelectedBrush}"/>

    <Grid x:Name="DataTableRowCells" Height="44" Margin="8,0" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16"/>  <!-- swatch -->
            <ColumnDefinition x:Name="NameColumn" Width="Auto"/> <!-- name: the TABLE sets every row to the widest name -->
            <ColumnDefinition Width="*"/>   <!-- grey description -->
            <ColumnDefinition Width="80"/>  <!-- Size -->
            <ColumnDefinition Width="96"/>  <!-- Clear -->
            <ColumnDefinition Width="36"/>  <!-- folder -->
            <ColumnDefinition Width="104"/> <!-- Max size -->
            <ColumnDefinition Width="112"/> <!-- Keep for -->
            <ColumnDefinition Width="{StaticResource SettingsDefaultColumnWidth}"/> <!-- DEFAULT (the card's column, right-aligned) -->
        </Grid.ColumnDefinitions>

        <Rectangle x:Name="RowRule" Grid.ColumnSpan="9" Height="1" VerticalAlignment="Top"
                   Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>

        <!-- 14 × 14 = the usage bar's height (StorageManagerSettingsConsoleUsageBar's segments) — change both. -->
        <Rectangle x:Name="KindSwatch" Grid.Column="0" Width="14" Height="14" RadiusX="2" RadiusY="2"
                   HorizontalAlignment="Left" Fill="{x:Bind Swatch, Mode=OneWay}"/>

        <!-- The name stands well above its grey hint: 16 Medium vs the hint's 12 regular, secondary colour. -->
        <TextBlock x:Name="KindName" Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource BodyLargeFontSize}" FontWeight="Medium"
                   Text="{x:Bind Item.Name, Mode=OneWay}"/>
        <TextBlock x:Name="KindHint" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   FontSize="{StaticResource CaptionFontSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind Item.Hint, Mode=OneWay}"/>

        <TextBlock x:Name="SizeText" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Style="{StaticResource TabularNumberTextStyle}"
                   Text="{x:Bind Item.SizeText, Mode=OneWay}"/>

        <!-- Clear: at once, or (usage history) after a yes. Both declared; Item.ConfirmClear picks. -->
        <Button x:Name="ClearButton" Grid.Column="4" Width="96" Content="Clear"
                Visibility="{x:Bind ShowClear(Item.HasClear, Item.ConfirmClear, x:False), Mode=OneWay}"
                IsEnabled="{x:Bind Item.CanClear, Mode=OneWay}" Click="OnClearClick"/>
        <Button x:Name="ClearConfirmButton" Grid.Column="4" Width="96" Content="Clear…"
                Visibility="{x:Bind ShowClear(Item.HasClear, Item.ConfirmClear, x:True), Mode=OneWay}"
                IsEnabled="{x:Bind Item.CanClear, Mode=OneWay}">
            <Button.Flyout>
                <Flyout x:Name="ClearConfirmFlyout" Placement="Bottom">
                    <StackPanel Width="260" Spacing="12">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Clear your usage history? The Atlas's &quot;Your use&quot; and the loop-load record start over. This can't be undone."/>
                        <Button x:Name="ClearConfirmYesButton" Content="Clear" HorizontalAlignment="Right"
                                Style="{StaticResource AccentButtonStyle}" Click="OnClearConfirmedClick"/>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

        <!-- Open this kind's folder. The mark is a drawn Path (no unverified glyph). -->
        <Button x:Name="OpenFolderButton" Grid.Column="5" Width="36" Height="30" Padding="0"
                ToolTipService.ToolTip="{x:Bind Item.FolderToolTip, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind Item.FolderToolTip, Mode=OneWay}"
                Click="OnOpenFolderClick">
            <Path Width="16" Height="16" Stretch="None" StrokeThickness="1.2" StrokeLineJoin="Round"
                  Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                  Data="M1.5,4.5 L1.5,12.5 A1,1 0 0 0 2.5,13.5 L13.5,13.5 A1,1 0 0 0 14.5,12.5 L14.5,6.5 A1,1 0 0 0 13.5,5.5 L8,5.5 L6.5,3.5 L2.5,3.5 A1,1 0 0 0 1.5,4.5 Z"/>
        </Button>

        <!-- Max size -->
        <!-- ⚠️ VerticalAlignment="Center" on BOTH dropdowns: WinUI's ComboBox style defaults to Top (buttons to Center),
             so without it the dropdowns sit higher than the Size text and the buttons. -->
        <ComboBox x:Name="MaxSizeComboBox" Grid.Column="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  Visibility="{x:Bind Show(Item.HasMax, x:True), Mode=OneWay}"
                  IsEnabled="{x:Bind Item.IsMaxEditable, Mode=OneWay}"
                  ItemsSource="{x:Bind Item.MaxChoices, Mode=OneWay}"
                  SelectedItem="{x:Bind Item.SelectedMax, Mode=TwoWay}"/>
        <!-- No Max size: a rule across the whole column (12 in from each side), not a lone dash. -->
        <Rectangle x:Name="MaxSizeNoneRule" Grid.Column="6" Height="1" Margin="12,0" VerticalAlignment="Center"
                   HorizontalAlignment="Stretch" Fill="{ThemeResource TextFillColorTertiaryBrush}"
                   Visibility="{x:Bind Show(Item.HasMax, x:False), Mode=OneWay}"/>

        <!-- Keep for -->
        <ComboBox x:Name="KeepForComboBox" Grid.Column="7" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  Visibility="{x:Bind Show(Item.HasKeep, x:True), Mode=OneWay}"
                  IsEnabled="{x:Bind Item.IsKeepEditable, Mode=OneWay}"
                  ItemsSource="{x:Bind Item.KeepChoices, Mode=OneWay}"
                  SelectedItem="{x:Bind Item.SelectedKeep, Mode=TwoWay}"/>
        <!-- Lines up with the dropdown text above: the ComboBox's own padding (ComboBoxPadding) + its 1 px border. -->
        <TextBlock x:Name="KeepForAlwaysText" Grid.Column="7" Text="{x:Bind Item.NoKeepText, Mode=OneWay}" VerticalAlignment="Center"
                   Margin="1,0,0,0" Padding="{ThemeResource ComboBoxPadding}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{x:Bind ShowNoKeep(Item.HasKeep, Item.NoKeepText, x:True), Mode=OneWay}"/>
        <!-- No Keep for and no words for it (Maps): the same hairline as an absent Max size. -->
        <Rectangle x:Name="KeepForNoneRule" Grid.Column="7" Height="1" Margin="12,0" VerticalAlignment="Center"
                   HorizontalAlignment="Stretch" Fill="{ThemeResource TextFillColorTertiaryBrush}"
                   Visibility="{x:Bind ShowNoKeep(Item.HasKeep, Item.NoKeepText, x:False), Mode=OneWay}"/>

        <!-- DEFAULT: the limits a first run gets ("5 GB · 5 days"), right-aligned under the card's DEFAULT title. -->
        <TextBlock x:Name="DefaultLimitsText" Grid.Column="8" Style="{StaticResource SettingsConsoleDefaultTextStyle}"
                   Text="{x:Bind Item.DefaultText, Mode=OneWay}"/>
    </Grid>
    </Grid>
</UserControl>
