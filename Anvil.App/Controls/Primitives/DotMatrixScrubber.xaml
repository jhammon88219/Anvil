<?xml version="1.0" encoding="utf-8"?>
<!-- DotMatrixScrubber — the loop scrubber drawn in the tools tier's DOT language (MapControlsStripSeparator's dot
     size and pitch): ONE UNBROKEN RUN of dots, like a separator — each frame owns an equal run of its columns, with NO
     gap between frames; a frame shows only by its colour (filling as it loads, the frame on screen lit whole).

       ┌─ a FIXED field: every column the width holds (420 → 105 × 5), centred — the frame count NEVER moves it ┐
       │ ● ● ● ● ● ● ● ● ● ● ● ● ● ● ○ ○ ○ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌                                         │
       │ ● ● ● ● ● ● ● ● ● ● ● ● ● ● ○ ○ ○ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌   ● READY  (built + revealed, Rule 2)    │
       │ ● ● ● ● ● ◆ ◆ ◆ ◆ ◆ ● ● ● ● ● ○ ○ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌   ◆ CURRENT (the frame on screen, whole) │
       │ ● ● ● ● ● ◆ ◆ ◆ ◆ ◆ ● ● ● ● ● ○ ○ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌   ○ FILLING (Segment.Fill: bytes + build) │
       │ ● ● ● ● ● ◆ ◆ ◆ ◆ ◆ ● ● ● ● ● ○ ○ ○ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌ ◌   ◌ EMPTY  (a touch above the separators) │
       └──────────────────────────────────────────────────────────────────────────────────────────────────────┘
          └ frame 0 ┘└ frame 1 ┘└ frame 2 ┘ … column c belongs to frame floor(c × frames ÷ columns): shares differ
            by at most ONE column, the spares spread evenly through the loop, NO blank dots. No loop = the bare field.
          ↑ Rows (5), DotSize 1.5 · DotGap 2.5 (pitch 4, the separators') — the pitch never breaks between frames.
          ↑ FillOrder: LeftToRight (column by column, each from the bottom — the default) | BottomToTop (row by row).

     ⚠️ THE EDGES NEVER MOVE: the field depends on the WIDTH alone; the frame count only re-assigns columns. PastCast
     caps a loop at 40 frames (2–3 columns each); past one frame per column, frames share columns.
     ⚠️ The host's seek asks IndexAt(x) — the SAME column→frame table — so a click lands on the frame drawn under it.
     It does NOT align to anything above it.
     ⚠️ Dot looks are STYLES (EmptyDot / FillingDot / ReadyDot / CurrentDot), set from code — never a theme brush
     resolved in C#. A dot's style is re-set only when its STATE changes (a load ticks every 150 ms).
     ⚠️ Not hit-testable: the host (RadarControls.ScrubberHost) owns the pointer. -->
<UserControl x:Class="Anvil.Controls.Primitives.DotMatrixScrubber"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsTabStop="False"
             IsHitTestVisible="False"
             VerticalAlignment="Center">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="DotMatrixEmptyBrush" Color="#42FFFFFF"/>   <!-- ~26% white: the separators' 16%, a touch up -->
                    <SolidColorBrush x:Key="DotMatrixFillingBrush" Color="#80FFFFFF"/> <!-- 50% -->
                    <SolidColorBrush x:Key="DotMatrixReadyBrush" Color="#D1FFFFFF"/>   <!-- ~82% -->
                    <SolidColorBrush x:Key="DotMatrixCurrentBrush" Color="#FFF2B544"/> <!-- amber -->
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DotMatrixEmptyBrush" Color="#42000000"/>
                    <SolidColorBrush x:Key="DotMatrixFillingBrush" Color="#80000000"/>
                    <SolidColorBrush x:Key="DotMatrixReadyBrush" Color="#D1000000"/>
                    <SolidColorBrush x:Key="DotMatrixCurrentBrush" Color="#FFB7791F"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="EmptyDot" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource DotMatrixEmptyBrush}"/>
            </Style>
            <Style x:Key="FillingDot" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource DotMatrixFillingBrush}"/>
            </Style>
            <Style x:Key="ReadyDot" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource DotMatrixReadyBrush}"/>
            </Style>
            <Style x:Key="CurrentDot" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource DotMatrixCurrentBrush}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The dots, placed in code (Layout): one block per frame. Height = Rows at the dot pitch. -->
    <Canvas x:Name="Dots"/>
</UserControl>
