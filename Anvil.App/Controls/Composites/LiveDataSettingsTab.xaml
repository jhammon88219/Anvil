<?xml version="1.0" encoding="utf-8"?>
<!-- LiveDataSettingsTab — Settings → Live Data (redone on the section casing 2026-11-16): WHERE the NowCast feeds' live updates
     come from, the NOAA Weather Wire account, how often each feed polls when no live source carries it, and how the link stands.
     Over LiveDataViewModel ← LiveFeedHub.

       ┌ Source  [Restore defaults] ───────────────────────────────── DEFAULT ┐  LiveDataSettingsConsoleSource
       │ Updates from [IEM live feed | NOAA Weather Wire | Polling only]        │
       └────────────────────────────────────────────────────────────────────────┘
          12 px of the body's darker ground
       ┌ Weather Wire account ──────────────────────────────────────────────── ┐  LiveDataSettingsConsoleWeatherWire (greyed
       │ User name · Password · Save account / Test connection                  │  unless NOAA Weather Wire; no reset)
       └────────────────────────────────────────────────────────────────────────┘
       ┌ Polling  [Restore defaults] ──────────────────────────────── DEFAULT ┐  LiveDataSettingsConsolePolling
       │ one row per feed · Radar (follows its scan pattern)                    │
       └────────────────────────────────────────────────────────────────────────┘
       ┌ Connection ────────────────────────────────────────────────────────── ┐  LiveDataSettingsConsoleConnection (read-only)
       │ Status · Last product · Missed                                         │
       └────────────────────────────────────────────────────────────────────────┘
       [                Reset all Live Data settings  (caution amber)            ]  Primitives/CautionResetButton

     ⚠️ Every reset ASKS first (Dialogs/ConfirmResetDialog). Reset all = Source + Polling; the Weather Wire account is KEPT.
     ⚠️ Wording lives in LiveDataViewModel / Models.LiveFeedKinds, not here (docs/live-data.md). -->
<UserControl x:Class="Anvil.Controls.Composites.LiveDataSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:liveDataSettingsConsoles="using:Anvil.Controls.LiveDataSettingsConsoles"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel Spacing="12" VerticalAlignment="Top">
        <liveDataSettingsConsoles:LiveDataSettingsConsoleSource x:Name="LiveDataSettingsConsoleSource" ViewModel="{x:Bind ViewModel}"/>
        <liveDataSettingsConsoles:LiveDataSettingsConsoleWeatherWire x:Name="LiveDataSettingsConsoleWeatherWire" ViewModel="{x:Bind ViewModel}"/>
        <liveDataSettingsConsoles:LiveDataSettingsConsolePolling x:Name="LiveDataSettingsConsolePolling" ViewModel="{x:Bind ViewModel}"/>
        <liveDataSettingsConsoles:LiveDataSettingsConsoleConnection x:Name="LiveDataSettingsConsoleConnection" ViewModel="{x:Bind ViewModel}"/>
        <prim:CautionResetButton x:Name="LiveDataResetAllButton"
                                 Text="Reset all Live Data settings" Click="OnResetAll"
                                 ToolTipService.ToolTip="Source and every polling interval back to their DEFAULT columns (asks first). Your Weather Wire account is kept"/>
    </StackPanel>
</UserControl>
