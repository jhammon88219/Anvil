<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Deliberately PLAIN net8.0 — no `net8.0-windows`, no UseWinUI. Two things depend on that:
         tools/TiltCheck (a net8.0 console) references this project directly, and the test project can
         run as fast plain xunit instead of a deployed WinUI test app. The only Windows-bound service
         (LocationService) lives in Anvil.App behind its interface, and view-models reach the UI thread
         through IDispatcher rather than DispatcherQueue. Keeping this TFM is what makes the compiler
         enforce all of that. (SettingsService used to be Windows-bound via LocalSettings; it's now a
         plain JSON-backed Core service — see Services/Settings/.) -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- RootNamespace is `Anvil`, NOT `Anvil.Core`, so types keep the namespaces they had in the
         single-project layout (Anvil.Models, Anvil.Services, Anvil.ViewModels). That's what let the
         extraction be pure file moves with zero namespace edits. -->
    <RootNamespace>Anvil</RootNamespace>
    <AssemblyName>Anvil.Core</AssemblyName>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- bzip2 for the Level II volume decompression (Level2Format / Level2RadarService). -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <!-- ObservableObject base for the view-models (INotifyPropertyChanged plumbing + SetProperty). -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- ILogger<T> abstractions (netstandard, no Windows dep) so Core services/VMs can log through the
         App's Serilog pipeline via the DI container. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core's ONLY bundled asset: the official SPC risk/colour catalog, generated by
         tools/make_spc_catalog.py from NOAA's published layer symbology and read by SpcRiskCatalog.
         EMBEDDED rather than Content/PreserveNewest (the Assets/Radar/*.json pattern) on purpose: a
         missing site list degrades to a small built-in fallback and is a file someone might legitimately
         regenerate, but a missing colour catalog makes every legend and every past-outlook colour wrong
         with no sane fallback, and nobody hand-edits it. Embedding removes the AppContext.BaseDirectory
         probe entirely, so Anvil.Tests and TiltCheck get it for free.
         ⚠️ RootNamespace is `Anvil`, so the manifest name is `Anvil.Assets.spc-risk-catalog.json` —
         SpcRiskCatalog.ResourceName must track this path. -->
    <EmbeddedResource Include="Assets\spc-risk-catalog.json" />
    <!-- The curated BUILT-IN PastCast saved events, read by SavedEventLibrary (manifest name
         `Anvil.Assets.saved-events.json`). Embedded for the same reason as the catalog: read-only by
         design, and a user's own events live in %LocalAppData%\Anvil\SavedEvents.json instead.
         Verify every leg against the archive with tools/check_saved_events.py before shipping an edit. -->
    <EmbeddedResource Include="Assets\saved-events.json" />
    <!-- The offline place-search gazetteer (manifest name `Anvil.Assets.places-us.json`), GENERATED by
         tools/make_places_catalog.py from GeoNames cities500 (CC BY 4.0) — regenerate, never edit.
         ⚠️ CONDITIONAL on purpose, unlike the two above: search has a real fallback (online), so a checkout
         that never ran the generator should still build; PlaceSearchService logs and goes online-only. -->
    <EmbeddedResource Include="Assets\places-us.json" Condition="Exists('Assets\places-us.json')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Level2Format's `internal` members. TiltCheck used to see them by compiling the .cs INTO its own
         assembly; now it references this project, so the visibility has to be granted explicitly. -->
    <InternalsVisibleTo Include="TiltCheck" />
    <InternalsVisibleTo Include="Anvil.Tests" />
  </ItemGroup>

</Project>
