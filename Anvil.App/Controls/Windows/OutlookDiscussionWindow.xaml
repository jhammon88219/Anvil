<?xml version="1.0" encoding="utf-8"?>
<!-- OutlookDiscussionWindow — SPC's forecast discussion for the outlook ON THE MAP, in its own OS window
     (WindowManager, Center anchor). Opened by the "Discussion." button on the Product row of BOTH outlook
     sections (ForeCast + PastCast); Past excludes Fore, so ONE window serves both and reads whichever runs.

       ┌─────────────────────────────────────────────────────[lock][pin]  –  □  ✕ ┐
       │ Day 1 Convective Outlook                                                  │ ← the BAND (raised)
       │                                          ↕ 28                             │
       │ (?) ISSUED        1958Z · 2:58 PM CDT Fri Mar 14, 2025                    │   every part = its "?" hint
       │ (?) VALID         20Z (3:00 PM CDT) Fri Mar 14 → 12Z (7:00 AM CDT) Sat …  │   (OutlookGlossary) LEFT of a
       │ (?) FORECASTER    Lyons                                                   │   DIMMED LABEL, then the value.
       │ (?) NEXT OUTLOOK  by 01Z (8:00 PM CDT)                                    │   EVERY time = Zulu, then AM/PM
       │ (?) SOURCE        Read on SPC's website ↗  · spc.noaa.gov · archive copy  │ ← the page it was read from
       ├───────────────────────────────────────────────────────────────────────────┤   in SPC's own zone (CDT/CST)
       │ (?) RISK          ▌MODERATE RISK                                         ┃│ ← bar = the category's SPC
       │                   ▌THE LOWER/MID MISSISSIPPI VALLEY INTO …               ┃│   colour (DATA); headlines
       │ (?) ALERT         (only when SPC issues one)                             ┃│   stacked as SPC ordered them
       │ (?) SUMMARY       A regional outbreak of severe thunderstorms is …       ┃│ ← the largest, brightest text
       │ ─────────────────────────────────────────────────                        ┃│
       │ (?) 20Z UPDATE    Widespread significant severe weather remains …        ┃│ ← one row per section:
       │ (?) REGION        Lower Mississippi Valley   ← heading (SPC's own title)  ┃│   UPDATE/SYNOPSIS/DISCUSSION/
       │                   Large-scale forcing for ascent appears …               ┃│   DAYS 4-6/REGION
       │ (?) PREVIOUS      ┌ › Previous discussion  issued 1630Z · 11:30 AM CDT · 3 sections┐ ← ALWAYS there;
       │                   └──────────────────────────────────────────────────────┘│   collapsed; "None in this
       │                                                                           │   issuance" on a full issuance
       └───────────────────────────────────────────────────────────────────────────┘
         a STATUS text ("Loading forecast discussion…") shows alone in the body instead of the parts.

     ⚠️ Every part comes from MapViewModel.OutlookDiscussion (ViewModels/Spc/OutlookDiscussionViewModel ←
     Services/Spc/OutlookDiscussionParser, rules + corpus tests in OutlookDiscussionParserTests). The parser
     drops on purpose: the wire header, product id, legacy points paragraph + NOTICE, and the link line.
     ⚠️ Headline text stays AS SPC WROTE IT (all caps) — the user's call, 2026-10-02: re-casing would garble
     place abbreviations. Paragraphs are re-flowed, never reworded.
     ⚠️ SPC's raw text is KEPT (OutlookDiscussion.Raw) but NOT SHOWN — the user's call, 2026-10-02.
     ⚠️ The hint sentences live in Services/Spc/OutlookGlossary, never here.
     PastCast reads the DRAWN issuance's discussion from SPC's per-issuance archive (PastOutlookViewModel.NarrativeText,
     cached forever); MapViewModel.OutlookDiscussionText picks live vs past. Closed by MapViewModel when neither
     outlook mode runs. -->
<UserControl x:Class="Anvil.Controls.Windows.OutlookDiscussionWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Anvil.Controls.Primitives"
             xmlns:conv="using:Anvil.Converters"
             xmlns:local="using:Anvil.Controls.Windows"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>

        <!-- One paragraph of SPC's text: re-flowed, selectable so a line can be copied out. -->
        <DataTemplate x:Key="ParagraphTemplate" x:DataType="x:String">
            <TextBlock Text="{x:Bind}" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,8"
                       IsTextSelectionEnabled="True"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </DataTemplate>

        <!-- One risk headline: the category's SPC colour as a bar (DATA, never themed), the category, the place. -->
        <DataTemplate x:Key="HeadlineTemplate" x:DataType="vm:OutlookHeadlineRow">
            <Grid ColumnSpacing="10" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="3" Background="{x:Bind Fill, Converter={StaticResource HexToBrush}}"/>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Category}" FontSize="12" FontWeight="SemiBold" CharacterSpacing="40"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{x:Bind Text}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Visibility="{x:Bind local:OutlookDiscussionWindow.Vis(HasText)}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- One body section: dimmed label + hint | heading (only when it says more than the label) + paragraphs. -->
        <DataTemplate x:Key="SectionTemplate" x:DataType="vm:OutlookSectionRow">
            <Grid ColumnSpacing="12" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Top">
                    <ctl:GlossaryHint Card="{x:Bind Hint}" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" Style="{StaticResource AtlasFieldLabelStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Heading}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               Margin="0,0,0,4" IsTextSelectionEnabled="True"
                               Visibility="{x:Bind local:OutlookDiscussionWindow.Vis(HasHeading)}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{x:Bind Paragraphs}" ItemTemplate="{StaticResource ParagraphTemplate}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Dark surface fills the whole window (custom chrome, like the temporal windows). -->
    <!-- ⚠️ ONE label column width, 128, in the band, every body row AND SectionTemplate — so every value starts
         on the same line. Change all of them together. -->
    <Grid Background="{ThemeResource OverlayBarSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- the band -->
            <RowDefinition Height="*"/>    <!-- the parts, scrolling -->
        </Grid.RowDefinitions>

        <!-- THE BAND (raised): the product, then its labelled heading facts. -->
        <Border Grid.Row="0" Padding="16,12,16,12" Background="{ThemeResource OverlayBarSurfaceRaisedBrush}">
            <StackPanel Spacing="8">
                <!-- ⚠️ Right 220 = the lock + pin + caption corner (the Atlas band's rule). -->
                <!-- Bottom 20 + the panel's Spacing 8 = 28 under the title (the user's call, 2026-10-02). -->
                <TextBlock Text="{x:Bind ViewModel.OutlookDiscussion.Title, Mode=OneWay}" Margin="0,0,220,20"
                           FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Grid ColumnSpacing="12" RowSpacing="4"
                      Visibility="{x:Bind local:OutlookDiscussionWindow.Vis(ViewModel.OutlookDiscussion.IsDiscussion), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <!-- SOURCE -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="5">
                        <ctl:GlossaryHint Card="{x:Bind ViewModel.OutlookDiscussion.IssuedHint}" VerticalAlignment="Center"/>
                        <TextBlock Text="ISSUED" VerticalAlignment="Center" Style="{StaticResource AtlasFieldLabelStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                               Typography.NumeralAlignment="Tabular"
                               Text="{x:Bind ViewModel.OutlookDiscussion.Issued, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5">
                        <ctl:GlossaryHint Card="{x:Bind ViewModel.OutlookDiscussion.ValidHint}" VerticalAlignment="Center"/>
                        <TextBlock Text="VALID" VerticalAlignment="Center" Style="{StaticResource AtlasFieldLabelStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                               Typography.NumeralAlignment="Tabular"
                               Text="{x:Bind ViewModel.OutlookDiscussion.Valid, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5"
                                Visibility="{x:Bind local:OutlookDiscussionWindow.Vis(ViewModel.OutlookDiscussion.HasForecaster), Mode=OneWay}">
                        <ctl:GlossaryHint Card="{x:Bind ViewModel.OutlookDiscussion.ForecasterHint}" VerticalAlignment="Center"/>
                        <TextBlock Text="FORECASTER" VerticalAlignment="Center" Style="{StaticResource AtlasFieldLabelStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                               Text="{x:Bind ViewModel.OutlookDiscussion.Forecaster, Mode=OneWay}"
                               Visibility="{x:Bind local:OutlookDiscussionWindow.Vis(ViewModel.OutlookDiscussion.HasForecaster), Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="5"
                                Visibility="{x:Bind local:OutlookDiscussionWindow.Vis(ViewModel.OutlookDiscussion.HasNextOutlook), Mode=OneWay}">
                        <ctl:GlossaryHint Card="{x:Bind ViewModel.OutlookDiscussion.NextOutlookHint}" VerticalAlignment="Center"/>
                        <TextBlock Text="NEXT OUTLOOK" VerticalAlignment="Center" Style="{StaticResource AtlasFieldLabelStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                               Text="{x:Bind ViewModel.OutlookDiscussion.NextOutlook, Mode=OneWay}"
                               Visibility="{x:Bind local:OutlookDiscussionWindow.Vis(ViewModel.OutlookDiscussion.HasNextOutlook), Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- SOURCE (the band's LAST row; option B, the user's call 2026-10-02): a short link to the SPC page
                         the text was read from — the full address is its tooltip — then the site + live/archive, dimmed.
                         HyperlinkButton's NavigateUri opens the default browser. -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="5"
                                Visibility="{x:Bind local:OutlookDiscussionWindow.Vis(ViewModel.OutlookDiscussion.HasSource), Mode=OneWay}">
                        <ctl:GlossaryHint Card="{x:Bind ViewModel.OutlookDiscussion.SourceHint}" VerticalAlignment="Center"/>
                        <TextBlock Text="SOURCE" VerticalAlignment="Center" Style="{StaticResource AtlasFieldLabelStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                Visibility="{x:Bind local:OutlookDiscussionWindow.Vis(ViewModel.OutlookDiscussion.HasSource), Mode=OneWay}">
                        <HyperlinkButton Padding="0" MinHeight="0" FontSize="13"
                                         NavigateUri="{x:Bind local:OutlookDiscussionWindow.ToUri(ViewModel.OutlookDiscussion.SourceUrl), Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind ViewModel.OutlookDiscussion.SourceUrl, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="Read on SPC's website" VerticalAlignment="Center"/>
                                <!-- E8A7 OpenInNewWindow — NOT verified on screen. -->
                                <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </HyperlinkButton>
                        <TextBlock VerticalAlignment="Center" FontSize="13"
                                   Text="{x:Bind ViewModel.OutlookDiscussion.SourceNote, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- THE PARTS. Margin right 4 = 16 − the scroller's 12 px gutter bleed (the PanelScroller rule). -->
        <ctl:PanelScroller Grid.Row="1" Margin="16,14,4,14">
            <StackPanel>
                <!-- A status line ("Loading forecast discussion…") in place of the parts. -->
                <TextBlock Text="{x:Bind ViewModel.OutlookDiscussion.Message, Mode=OneWay}"
                           FontSize="13" TextWrapping="Wrap"
                           Visibility="{x:Bind local:OutlookDiscussionWindow.Vis(ViewModel.OutlookDiscussion.IsMessage), Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <StackPanel Visibility="{x:Bind local:OutlookDiscussionWindow.Vis(ViewModel.OutlookDiscussion.IsDiscussion), Mode=OneWay}">
                    <!-- RISK -->
                    <Grid ColumnSpacing="12" Margin="0,0,0,6"
                          Visibility="{x:Bind local:OutlookDiscussionWindow.Vis(ViewModel.OutlookDiscussion.HasHeadlines), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Top">
                            <ctl:GlossaryHint Card="{x:Bind ViewModel.OutlookDiscussion.RiskHint}" VerticalAlignment="Center"/>
                            <TextBlock Text="RISK" VerticalAlignment="Center" Style="{StaticResource AtlasFieldLabelStyle}"/>
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemTemplate="{StaticResource HeadlineTemplate}"
                                      ItemsSource="{x:Bind ViewModel.OutlookDiscussion.Headlines, Mode=OneWay}"/>
                    </Grid>

                    <!-- ALERT: only when SPC issues one. -->
                    <Grid ColumnSpacing="12" Margin="0,0,0,14"
                          Visibility="{x:Bind local:OutlookDiscussionWindow.Vis(ViewModel.OutlookDiscussion.HasAlert), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Top">
                            <ctl:GlossaryHint Card="{x:Bind ViewModel.OutlookDiscussion.AlertHint}" VerticalAlignment="Center"/>
                            <TextBlock Text="ALERT" VerticalAlignment="Center" Style="{StaticResource AtlasFieldLabelStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind ViewModel.OutlookDiscussion.Alert, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Grid>

                    <!-- SUMMARY: the plain-language answer, so the largest, brightest text in the window. -->
                    <Grid ColumnSpacing="12" Margin="0,0,0,14"
                          Visibility="{x:Bind local:OutlookDiscussionWindow.Vis(ViewModel.OutlookDiscussion.HasSummary), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Top">
                            <ctl:GlossaryHint Card="{x:Bind ViewModel.OutlookDiscussion.SummaryHint}" VerticalAlignment="Center"/>
                            <TextBlock Text="SUMMARY" VerticalAlignment="Center" Style="{StaticResource AtlasFieldLabelStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="15" LineHeight="23" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind ViewModel.OutlookDiscussion.Summary, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Grid>

                    <Border Height="1" Margin="140,0,0,14" Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>

                    <!-- THE SECTIONS of this issuance (an update first, when there is one). -->
                    <ItemsControl ItemTemplate="{StaticResource SectionTemplate}"
                                  ItemsSource="{x:Bind ViewModel.OutlookDiscussion.Rows, Mode=OneWay}"/>

                    <!-- PREVIOUS: the earlier issuance an update repeats. COLLAPSED by default; opens to the same rows.
                         ⚠️ ALWAYS SHOWN (the user's call, 2026-10-02): a full issuance (06Z/13Z/1630Z) has none, and the
                         box says "None in this issuance" with its toggle disabled rather than the row vanishing. -->
                    <Grid ColumnSpacing="12" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Top" Margin="0,8,0,0">
                            <ctl:GlossaryHint Card="{x:Bind ViewModel.OutlookDiscussion.PreviousHint}" VerticalAlignment="Center"/>
                            <TextBlock Text="PREVIOUS" VerticalAlignment="Center" Style="{StaticResource AtlasFieldLabelStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}">
                            <StackPanel>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="10,8"
                                        IsEnabled="{x:Bind ViewModel.OutlookDiscussion.HasPrevious, Mode=OneWay}"
                                        Click="OnPreviousToggleClick">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="11"
                                                  Glyph="{x:Bind local:OutlookDiscussionWindow.Chevron(ViewModel.OutlookDiscussion.IsPreviousExpanded), Mode=OneWay}"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="Previous discussion" FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontSize="12"
                                                   Text="{x:Bind ViewModel.OutlookDiscussion.PreviousCaption, Mode=OneWay}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </Grid>
                                </Button>
                                <ItemsControl Margin="12,6,12,4" ItemTemplate="{StaticResource SectionTemplate}"
                                              ItemsSource="{x:Bind ViewModel.OutlookDiscussion.PreviousRows, Mode=OneWay}"
                                              Visibility="{x:Bind local:OutlookDiscussionWindow.Vis(ViewModel.OutlookDiscussion.IsPreviousExpanded), Mode=OneWay}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ctl:PanelScroller>

        <!-- Lock + pin; both self-position top-right, clearing the caption. -->
        <ctl:LockToggle Grid.RowSpan="2" IsChecked="{x:Bind ViewModel.IsOutlookDiscussionLocked, Mode=TwoWay}"/>
        <ctl:PinToggle Grid.RowSpan="2" IsChecked="{x:Bind ViewModel.IsOutlookDiscussionOnTop, Mode=TwoWay}"/>
    </Grid>
</UserControl>
