<?xml version="1.0" encoding="utf-8"?>
<!-- GeneralSettingsConsoleUnits — Settings → General's "Units" section (was the whole Units page: five expanders → one
     card), on a Primitives/SettingsConsolePlate. ONE place for every unit the app shows: each picker writes a TOKEN to
     AppSettings; MapViewModel hands the set to Models/Map/UnitFormat (every C# readout) and the page (js/units.js).

       Units  [Restore defaults]                                                                   DEFAULT
       Start from  [US] [Metric] [Forecaster]           Sets several units at once
       Clock       [12-hour|24-hour]                    Shows as 5:04 PM · until 5:30 PM            12-hour
       Time zone   [Local|UTC]                                                                       Local
       Distance    [Kilometers|Miles|Nautical miles]    Shows as 151 km · ring 230 km             Kilometers
       Speed       [kt|mph|km/h|m/s]                    Shows as …                                     mph
       Height      [km|kft|ft]                          Shows as 44 kft storm top                      kft
       Hail size   [in|cm]                              Shows as 1.75 in hail                           in
       96          420 (pickers keep their own widths, left)   hint = the live sample             150, right

     ⚠️ THE COLUMNS (96 · 420 · * · 150) are the page's — every General section uses the same. Change them together.
     ⚠️ 12-hour greys while UTC (UTC is always "17:04Z"). A preset is an action, not a kept choice — plain buttons.
     ⚠️ No temperature / rainfall row: nothing in the app shows either yet. Add the row with the first field that draws one. -->
<UserControl x:Class="Anvil.Controls.GeneralSettingsConsoles.GeneralSettingsConsoleUnits"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="GeneralSettingsConsoleUnitsPlate" Title="Units" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="UnitsRestoreDefaultsButton" Content="Restore defaults"
                    Click="{x:Bind ViewModel.ResetUnits}"
                    ToolTipService.ToolTip="Put every unit back to the DEFAULT column"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <Grid ColumnSpacing="12" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Start from"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="UnitsPresetUsButton" Content="US" Click="OnPresetUs"
                        ToolTipService.ToolTip="12-hour local time, miles, mph, kft, inches"/>
                <Button x:Name="UnitsPresetMetricButton" Content="Metric" Click="OnPresetMetric"
                        ToolTipService.ToolTip="24-hour local time, kilometres, km/h, km, centimetres"/>
                <Button x:Name="UnitsPresetForecasterButton" Content="Forecaster" Click="OnPresetForecaster"
                        ToolTipService.ToolTip="UTC (Z) time, nautical miles, knots, kft, inches — as in SPC / NWS products"/>
            </StackPanel>
            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="Sets several units at once"/>

            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Clock"/>
            <prim:SegmentedPicker x:Name="UnitsClockPicker" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Width="200"
                                  ItemsSource="{x:Bind ViewModel.ClockFormatLabels}"
                                  DisabledIndex="{x:Bind ViewModel.ClockFormatDisabledIndex, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.ClockFormatIndex, Mode=TwoWay}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="{x:Bind ViewModel.ClockSample, Mode=OneWay}"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.DefaultClockText}"/>

            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Time zone"/>
            <prim:SegmentedPicker x:Name="UnitsTimeZonePicker" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="200"
                                  ItemsSource="{x:Bind ViewModel.TimeZoneLabels}"
                                  SelectedIndex="{x:Bind ViewModel.TimeZoneIndex, Mode=TwoWay}"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.DefaultTimeZoneText}"/>

            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Distance"/>
            <prim:SegmentedPicker x:Name="UnitsDistancePicker" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Width="300"
                                  ItemsSource="{x:Bind ViewModel.DistanceUnitLabels}"
                                  SelectedIndex="{x:Bind ViewModel.DistanceUnitIndex, Mode=TwoWay}"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="{x:Bind ViewModel.DistanceSample, Mode=OneWay}"/>
            <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.DefaultDistanceText}"/>

            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Speed"/>
            <prim:SegmentedPicker x:Name="UnitsSpeedPicker" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Width="280"
                                  ItemsSource="{x:Bind ViewModel.SpeedUnitLabels}"
                                  SelectedIndex="{x:Bind ViewModel.SpeedUnitIndex, Mode=TwoWay}"/>
            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="{x:Bind ViewModel.SpeedSample, Mode=OneWay}"/>
            <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.DefaultSpeedText}"/>

            <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Height"/>
            <prim:SegmentedPicker x:Name="UnitsHeightPicker" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" Width="210"
                                  ItemsSource="{x:Bind ViewModel.HeightUnitLabels}"
                                  SelectedIndex="{x:Bind ViewModel.HeightUnitIndex, Mode=TwoWay}"/>
            <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="{x:Bind ViewModel.HeightSample, Mode=OneWay}"/>
            <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.DefaultHeightText}"/>

            <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Hail size"/>
            <prim:SegmentedPicker x:Name="UnitsHailPicker" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" Width="140"
                                  ItemsSource="{x:Bind ViewModel.HailUnitLabels}"
                                  SelectedIndex="{x:Bind ViewModel.HailUnitIndex, Mode=TwoWay}"/>
            <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="{x:Bind ViewModel.HailSample, Mode=OneWay}"/>
            <TextBlock Grid.Row="6" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.DefaultHailText}"/>
        </Grid>
    </prim:SettingsConsolePlate>
</UserControl>
