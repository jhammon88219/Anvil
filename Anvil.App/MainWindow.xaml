<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Anvil.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anvil"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:Anvil.Models"
    xmlns:vm="using:Anvil.ViewModels"
    xmlns:ctl="using:Anvil.Controls"
    xmlns:sections="using:Anvil.Controls.Sections"
    mc:Ignorable="d"
    Title="Anvil">

    <!-- The map fills the whole window; UI (the two bars + the floating windows) sits on top as an overlay,
         so showing/hiding either bar never changes the map's size.

         Three overlay rows, and the split is what keeps every floating window aligned:
           Row 0 — the GLOBAL TOP BAR. Controls that must NOT repeat per map pane (in the coming multi-pane
                   mode): the temporal mode toggles + the app-wide buttons (Sites, Settings, dev tools).
                   An OverlayBar with Edge=Top, so its pull-tab hangs BELOW it.
           Row 1 — the FLOATING LAYER. Every window that pops over the map lives here, TOP-aligned with the
                   shared FloatingWindowMargin so each drops from just under the top bar (its triggers live
                   there). One margin buys each window the same inset from the window edges AND the same gap
                   below the bar — no window hardcodes a guess at the bar's height.
           Row 2 — the PER-PANE BOTTOM BAR: the radar console (RadarControls). This is the bar that repeats
                   once per map pane in multi-pane mode, so ONLY the radar controls live here.
         The map spans all three rows, so the layer boundaries are invisible and cost the map nothing. -->
    <Grid Background="#FF0A0A0A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- global top bar (tab + bar), pinned to the top -->
            <RowDefinition Height="*"/>    <!-- floating layer: the windows that pop over the map -->
            <RowDefinition Height="Auto"/> <!-- per-pane bottom bar (tab + bar), pinned to the bottom -->
        </Grid.RowDefinitions>

        <!-- Full-window map (bottom layer; all UI overlays float on top of it). -->
        <controls:WebView2 x:Name="MainMapWebView" Grid.Row="0" Grid.RowSpan="3"/>

        <!-- ===== Row 0: the GLOBAL top bar. BarContent holds the app-level controls that don't repeat per
             pane — left: temporal split-toggles; right: Sites + Settings (+ dev Sweep/Validate). ===== -->
        <ctl:OverlayBar Grid.Row="0" Edge="Top">
            <ctl:OverlayBar.BarContent>
                <!-- Single overlay cell: temporal toggles float on the left edge, the app-wide buttons on the
                     right edge. No center content — the per-pane radar console lives in the bottom bar. -->
                <Grid>
                    <!-- Left: temporal split-toggles (feature + settings cog). -->
                    <sections:TemporalToggles HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              ViewModel="{x:Bind ViewModel}"/>
                    <!-- Right: the Radar Site Explorer button + the app-wide settings cog (+ dev buttons).
                         Sites sits LEFT of Settings. Each latches while its panel/card is open. -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                Orientation="Horizontal" Spacing="10">
                        <!-- DEV-ONLY: opens the site-sweep card. Collapsed in Release via DevVisibility;
                             IsChecked mirrors the card's own open state. -->
                        <StackPanel Orientation="Vertical" Spacing="5" Visibility="{x:Bind DevVisibility}">
                            <TextBlock Text="Sweep" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="60" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <ToggleButton Width="40" Height="40" MinWidth="0" MinHeight="0" Padding="0"
                                          CornerRadius="6"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="18"
                                          Content="&#xE9F5;"
                                          ToolTipService.ToolTip="Dev: automated site sweep"
                                          IsChecked="{x:Bind SweepCard.IsCardOpen, Mode=TwoWay}"/>
                        </StackPanel>
                        <!-- DEV-ONLY: opens the dealias-validation card (fixed-corpus regression scorer). -->
                        <StackPanel Orientation="Vertical" Spacing="5" Visibility="{x:Bind DevVisibility}">
                            <TextBlock Text="Validate" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="60" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <ToggleButton Width="40" Height="40" MinWidth="0" MinHeight="0" Padding="0"
                                          CornerRadius="6"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="18"
                                          Content="&#xE9D9;"
                                          ToolTipService.ToolTip="Dev: velocity-dealias validation (fixed corpus)"
                                          IsChecked="{x:Bind ValidationCard.IsCardOpen, Mode=TwoWay}"/>
                        </StackPanel>
                        <!-- Map Controls card: basemap style + state isolation. Opens the card (latches while
                             open); the actual arm/pick controls live inside it. App-wide, so it sits here. -->
                        <StackPanel Orientation="Vertical" Spacing="5">
                            <TextBlock Text="Map" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="60" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <ToggleButton Width="40" Height="40" MinWidth="0" MinHeight="0" Padding="0"
                                          CornerRadius="6"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="18"
                                          Content="&#xE774;"
                                          ToolTipService.ToolTip="Map controls — basemap &amp; state isolation"
                                          IsChecked="{x:Bind ViewModel.IsMapControlsCardOpen, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Spacing="5">
                            <TextBlock Text="Sites" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="60" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <ToggleButton Width="40" Height="40" MinWidth="0" MinHeight="0" Padding="0"
                                          CornerRadius="6"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="18"
                                          Content="&#xE81E;"
                                          ToolTipService.ToolTip="Radar site explorer"
                                          IsChecked="{x:Bind ViewModel.IsSiteExplorerOpen, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Spacing="5">
                            <TextBlock Text="Settings" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="60" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <ToggleButton Width="40" Height="40" MinWidth="0" MinHeight="0" Padding="0"
                                          CornerRadius="6"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="18"
                                          Content="&#xE713;"
                                          ToolTipService.ToolTip="App settings"
                                          IsChecked="{x:Bind ViewModel.IsSettingsCardOpen, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ctl:OverlayBar.BarContent>
        </ctl:OverlayBar>

        <!-- ===== Row 1: the floating windows. All TOP-aligned (they drop from the top bar, whose triggers
             open them), all on the shared FloatingWindowMargin. ===== -->

        <!-- Temporal settings cards (Past / Now / Fore), shown when a toggle's cog is clicked. Left,
             so each card drops near the cog that opened it. -->
        <sections:TemporalCards Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left"
                                Margin="{StaticResource FloatingWindowMargin}"
                                ViewModel="{x:Bind ViewModel}"/>

        <!-- Map Controls card (basemap style + state isolation); opened by the top bar's "Map" button.
             Right-aligned like the other app-wide cards. -->
        <sections:MapControlsCard Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right"
                                  Margin="{StaticResource FloatingWindowMargin}"
                                  ViewModel="{x:Bind ViewModel}"/>

        <!-- App-wide settings card, the mirror of the temporal cards; opened by the top bar's right-edge cog. -->
        <sections:AppSettingsCard Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right"
                                  Margin="{StaticResource FloatingWindowMargin}"
                                  ViewModel="{x:Bind ViewModel}"/>

        <!-- Radar Site Explorer: a non-modal panel over the map (the map stays live). A larger free panel
             rather than a small cog-anchored card, but it floats on the same layer + margin as the cards.
             Its own visibility follows ViewModel.IsSiteExplorerOpen. -->
        <sections:RadarSiteExplorer Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right"
                                    Margin="{StaticResource FloatingWindowMargin}"
                                    ViewModel="{x:Bind ViewModel}"/>

        <!-- DEV-ONLY site-sweep card. Same floating layer/margin; open state is the card's own IsCardOpen
             (toggled by the dev Sweep button above). Collapsed entirely in Release via DevVisibility. -->
        <sections:DevSweepCard x:Name="SweepCard" Grid.Row="1"
                               VerticalAlignment="Top" HorizontalAlignment="Right"
                               Margin="{StaticResource FloatingWindowMargin}"
                               Visibility="{x:Bind DevVisibility}"
                               SweepVm="{x:Bind SweepVm}"
                               ReportRequested="OnSweepReportRequested"/>

        <!-- DEV-ONLY dealias-validation card (fixed-corpus regression scorer). Same floating layer/margin;
             open state is the card's own IsCardOpen (toggled by the dev Validate button above). Collapsed
             entirely in Release via DevVisibility. -->
        <sections:DevValidationCard x:Name="ValidationCard" Grid.Row="1"
                                    VerticalAlignment="Top" HorizontalAlignment="Right"
                                    Margin="{StaticResource FloatingWindowMargin}"
                                    Visibility="{x:Bind DevVisibility}"
                                    ViewModel="{x:Bind ValidationVm}"
                                    ReportRequested="OnValidationReportRequested"/>

        <!-- ===== Row 2: the PER-PANE bottom bar. Only the radar console lives here — it repeats once per
             map pane in multi-pane mode. It STRETCHES to full bar width and centers its own transport at
             window-center (its internal * | Auto | * grid does the centering). ===== -->
        <ctl:OverlayBar Grid.Row="2">
            <ctl:OverlayBar.BarContent>
                <sections:RadarControls HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        ViewModel="{x:Bind ViewModel.Radar}"/>
            </ctl:OverlayBar.BarContent>
        </ctl:OverlayBar>
    </Grid>
</Window>
