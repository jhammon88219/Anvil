<?xml version="1.0" encoding="utf-8"?>
<!-- RingsSettingsConsoleLabels — Settings → Rings & Ruler's "Distance labels" section ("100 mi", "200 mi"…), on a
     Primitives/SettingsConsolePlate. Text has a font, size and halo, not a line pattern — so its own rows, not a ring card.

       Distance labels  [Restore defaults]                                                         DEFAULT
       Colour       (A)(■)…(+)                                A = the distance rings' colour        Rings'
       Opacity      ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━●  100%                                         100%
       Font         [ Regular | Medium | Italic ]                                                 Medium
       Size         ━━━●━━━━━━━━━━━━━━━━━━━━━━━━━━━  10 px                                          10 px
       Spacing      ●━━━━━━━━━━━━━━━━━━━━━━━━━━━━━  0.00 em  Between the letters                0.00 em
       Halo         ━━━━━━●━━━━━━━━━━━━━━━━━━━━━━━━  1.2 px  Keeps it readable over returns       1.2 px
       Halo colour  (A)(■)…(+)                                A = the theme's dark casing           Theme
       Placement    [ Above | On the ring | Below ]                                                 Above
       Lines        [ 1 | 2 | 4 ]                             Label lines round the site               1
       Position     ●━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━  000°     Or drag the knob on the ring   000° (North)
       ☑ Show the unit                                        100 mi, not 100                         On
       ☑ Show the drag knob on the map                                                                On
       96           420 (slider * · value 56)                 hint (one line)                  150, right

     ⚠️ THE COLUMNS (96 · 420 · * · 150) are the page's. The WHOLE card greys while the distance rings are off (its
     ContentControl carries IsEnabled — a Panel has none). The old "North" button is gone: Restore defaults covers it.
     ⚠️ The map's label knob writes Position too (RangeRingsViewModel.OnLabelBearingDragged, no echo). -->
<UserControl x:Class="Anvil.Controls.RingsSettingsConsoles.RingsSettingsConsoleLabels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="RingsSettingsConsoleLabelsPlate" Title="Distance labels" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="LabelsRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}"
                    ToolTipService.ToolTip="Put the distance labels back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <ContentControl HorizontalContentAlignment="Stretch" IsTabStop="False"
                        IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}">
            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0 colour -->
                    <RowDefinition Height="Auto"/> <!-- 1 opacity -->
                    <RowDefinition Height="Auto"/> <!-- 2 font -->
                    <RowDefinition Height="Auto"/> <!-- 3 size -->
                    <RowDefinition Height="Auto"/> <!-- 4 letter spacing -->
                    <RowDefinition Height="Auto"/> <!-- 5 halo -->
                    <RowDefinition Height="Auto"/> <!-- 6 halo colour -->
                    <RowDefinition Height="Auto"/> <!-- 7 placement -->
                    <RowDefinition Height="Auto"/> <!-- 8 lines -->
                    <RowDefinition Height="Auto"/> <!-- 9 position -->
                    <RowDefinition Height="Auto"/> <!-- 10 show unit -->
                    <RowDefinition Height="Auto"/> <!-- 11 knob -->
                </Grid.RowDefinitions>

                <TextBlock VerticalAlignment="Center" Text="Colour"/>
                <prim:ColorSwatchPicker x:Name="LabelColorPicker" Grid.Column="1" HorizontalAlignment="Left" AllowCustom="True"
                                        ItemsSource="{x:Bind ViewModel.Radar.RangeRings.LabelColorSwatches}"
                                        ToolTips="{x:Bind ViewModel.Radar.RangeRings.LabelColorNames}"
                                        SelectedIndex="{x:Bind ViewModel.Radar.RangeRings.LabelColorIndex, Mode=TwoWay}"
                                        CustomHex="{x:Bind ViewModel.Radar.RangeRings.LabelColorHex, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}"
                           Text="{x:Bind LockedOr(ViewModel.Radar.RangeRings.ShowDistanceRings, 'A = the distance rings&#x2019; colour'), Mode=OneWay}"/>
                <TextBlock Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelColorText}"/>

                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Opacity"/>
                <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Slider x:Name="LabelOpacitySlider" VerticalAlignment="Center" Minimum="5" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10"
                            IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.Radar.RangeRings.LabelOpacity, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                               Text="{x:Bind Pct(ViewModel.Radar.RangeRings.LabelOpacity), Mode=OneWay}"/>
                </Grid>
                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelOpacityText}"/>

                <!-- Only the three stacks the bundled glyph host serves; any other renders nothing. -->
                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Font"/>
                <prim:SegmentedPicker x:Name="LabelFontPicker" Grid.Row="2" Grid.Column="1"
                                      ItemsSource="{x:Bind ViewModel.Radar.RangeRings.LabelFontLabels}"
                                      SelectedIndex="{x:Bind ViewModel.Radar.RangeRings.LabelFontIndex, Mode=TwoWay}"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelFontText}"/>

                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Size"/>
                <Grid Grid.Row="3" Grid.Column="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Slider x:Name="LabelSizeSlider" VerticalAlignment="Center" Minimum="8" Maximum="24" StepFrequency="1" SmallChange="1" LargeChange="2"
                            IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.Radar.RangeRings.LabelSize, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                               Text="{x:Bind Px0(ViewModel.Radar.RangeRings.LabelSize), Mode=OneWay}"/>
                </Grid>
                <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelSizeText}"/>

                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Spacing"/>
                <Grid Grid.Row="4" Grid.Column="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Slider x:Name="LabelSpacingSlider" VerticalAlignment="Center" Minimum="0" Maximum="0.5" StepFrequency="0.01" SmallChange="0.01" LargeChange="0.05"
                            IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.Radar.RangeRings.LabelSpacing, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                               Text="{x:Bind Em(ViewModel.Radar.RangeRings.LabelSpacing), Mode=OneWay}"/>
                </Grid>
                <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="Between the letters"/>
                <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelSpacingText}"/>

                <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Halo"/>
                <Grid Grid.Row="5" Grid.Column="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Slider x:Name="LabelHaloSlider" VerticalAlignment="Center" Minimum="0" Maximum="4" StepFrequency="0.1" SmallChange="0.1" LargeChange="0.5"
                            IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.Radar.RangeRings.LabelHalo, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                               Text="{x:Bind Px(ViewModel.Radar.RangeRings.LabelHalo), Mode=OneWay}"/>
                </Grid>
                <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="Keeps it readable over returns"/>
                <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelHaloText}"/>

                <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Halo colour"/>
                <prim:ColorSwatchPicker x:Name="HaloColorPicker" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" AllowCustom="True"
                                        ItemsSource="{x:Bind ViewModel.Radar.RangeRings.HaloColorSwatches}"
                                        ToolTips="{x:Bind ViewModel.Radar.RangeRings.HaloColorNames}"
                                        SelectedIndex="{x:Bind ViewModel.Radar.RangeRings.HaloColorIndex, Mode=TwoWay}"
                                        CustomHex="{x:Bind ViewModel.Radar.RangeRings.HaloColorHex, Mode=TwoWay}"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="A = the theme's dark casing"/>
                <TextBlock Grid.Row="6" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.Radar.RangeRings.DefaultHaloColorText}"/>

                <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="Placement"/>
                <prim:SegmentedPicker x:Name="LabelPlacementPicker" Grid.Row="7" Grid.Column="1"
                                      ItemsSource="{x:Bind ViewModel.Radar.RangeRings.LabelPlacementLabels}"
                                      SelectedIndex="{x:Bind ViewModel.Radar.RangeRings.LabelPlacementIndex, Mode=TwoWay}"/>
                <TextBlock Grid.Row="7" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.Radar.RangeRings.DefaultPlacementText}"/>

                <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="Lines"/>
                <prim:SegmentedPicker x:Name="LabelLinesPicker" Grid.Row="8" Grid.Column="1"
                                      ItemsSource="{x:Bind ViewModel.Radar.RangeRings.LabelAxesLabels}"
                                      SelectedIndex="{x:Bind ViewModel.Radar.RangeRings.LabelAxesIndex, Mode=TwoWay}"/>
                <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="Label lines round the site"/>
                <TextBlock Grid.Row="8" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelLinesText}"/>

                <TextBlock Grid.Row="9" VerticalAlignment="Center" Text="Position"/>
                <Grid Grid.Row="9" Grid.Column="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Slider x:Name="LabelPositionSlider" VerticalAlignment="Center" Minimum="0" Maximum="359" StepFrequency="1" SmallChange="1" LargeChange="15"
                            IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.Radar.RangeRings.LabelBearing, Mode=TwoWay}"
                            ToolTipService.ToolTip="The bearing the labels sit on, clockwise from north"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                               Text="{x:Bind Deg(ViewModel.Radar.RangeRings.LabelBearing), Mode=OneWay}"/>
                </Grid>
                <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="Or drag the knob on the ring"/>
                <TextBlock Grid.Row="9" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelBearingText}"/>

                <CheckBox x:Name="LabelShowUnitsCheckBox" Grid.Row="10" Grid.ColumnSpan="2" VerticalAlignment="Center" Content="Show the unit"
                          IsChecked="{x:Bind ViewModel.Radar.RangeRings.LabelShowUnits, Mode=TwoWay}"/>
                <TextBlock Grid.Row="10" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="100 mi, not 100"/>
                <TextBlock Grid.Row="10" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.Radar.RangeRings.DefaultShowUnitsText}"/>

                <CheckBox x:Name="LabelKnobCheckBox" Grid.Row="11" Grid.ColumnSpan="2" VerticalAlignment="Center" Content="Show the drag knob on the map"
                          IsChecked="{x:Bind ViewModel.Radar.RangeRings.ShowLabelHandle, Mode=TwoWay}"
                          ToolTipService.ToolTip="The knob on the outer range ring. Drag it around to move every label; hide it once they're where you want them"/>
                <TextBlock Grid.Row="11" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelHandleText}"/>
            </Grid>
        </ContentControl>
    </prim:SettingsConsolePlate>
</UserControl>
