<?xml version="1.0" encoding="utf-8"?>
<!-- EdgeHatch — EDGE-HATCH (experimental bolt-on, grep EDGE-HATCH): a cross-hatch band where the chrome meets the map, in
     place of the black cast shadow. Click-through; drawn over the map.

       Direction = Up (above the bottom tiers)          Direction = Right (a left pane's map side; Left mirrors it)
       ╱╲  ╱╲      ╱    ╲      ╱╲          ╱╲           │╲╱╲╱ ╲╱  ╲
       ╱╲╱╲╱╲╱╲  ╱╲╱╲  ╱╲╱╲  ╱╲╱╲╱╲╱╲  ╱╲╱╲            │╱╲╱╲ ╱╲    ← the lines THIN out (1 in 2 stops at ¼, 1 in 4
       ╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱             │╲╱╲╱ ╲╱  ╲     at ½ …) and/or FADE toward the map
       ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀  ← edge   │╱╲╱╲ ╱╲
                                                       ↑ edge

     ⚠️ THE LINES ARE COMPUTED GEOMETRY — the one thing XAML can't declare (WinUI 3 has no tiling pattern brush): the
     Path below is DECLARED here; code-behind fills its Data from Models/Map/EdgeHatchGeometry (pure, tested) whenever the
     band's size or a setting changes — never per frame. The geometry is always laid out in the UP orientation (edge at
     the bottom) and turned by a RenderTransform for Right / Left, so ONE set of brushes fades the right way in all three.
     ⚠️ THE INK is a VisualState (InkStates: surface ground / surface raised / black / white × fade / solid) — the
     surface colours are THEME colours (Styles.xaml OverlayBarSurface*Color + their clear twins), and a theme brush is
     never resolved in C#. Strength = Styles.xaml EdgeHatchOpacity (0 in high contrast). -->
<UserControl x:Class="Anvil.Controls.Primitives.EdgeHatch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsHitTestVisible="False"
             IsTabStop="False">

    <Canvas x:Name="EdgeHatchCanvas" Opacity="{ThemeResource EdgeHatchOpacity}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="InkStates">
                <VisualState x:Name="SurfaceFade">
                    <VisualState.Setters>
                        <Setter Target="EdgeHatchPath.Stroke">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Offset="0" Color="{ThemeResource OverlayBarSurfaceColor}"/>
                                    <GradientStop Offset="1" Color="{ThemeResource OverlayBarSurfaceClearColor}"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SurfaceSolid">
                    <VisualState.Setters>
                        <Setter Target="EdgeHatchPath.Stroke" Value="{ThemeResource OverlayBarSurfaceBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RaisedFade">
                    <VisualState.Setters>
                        <Setter Target="EdgeHatchPath.Stroke">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Offset="0" Color="{ThemeResource OverlayBarSurfaceRaisedColor}"/>
                                    <GradientStop Offset="1" Color="{ThemeResource OverlayBarSurfaceRaisedClearColor}"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RaisedSolid">
                    <VisualState.Setters>
                        <Setter Target="EdgeHatchPath.Stroke" Value="{ThemeResource OverlayBarSurfaceRaisedBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- Black and white are literal in every theme (like the cast shadows) — white at 35%. -->
                <VisualState x:Name="BlackFade">
                    <VisualState.Setters>
                        <Setter Target="EdgeHatchPath.Stroke">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Offset="0" Color="#FF000000"/>
                                    <GradientStop Offset="1" Color="#00000000"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="BlackSolid">
                    <VisualState.Setters>
                        <Setter Target="EdgeHatchPath.Stroke" Value="#FF000000"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WhiteFade">
                    <VisualState.Setters>
                        <Setter Target="EdgeHatchPath.Stroke">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Offset="0" Color="#59FFFFFF"/>
                                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WhiteSolid">
                    <VisualState.Setters>
                        <Setter Target="EdgeHatchPath.Stroke" Value="#59FFFFFF"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Data + RenderTransform set in code (computed geometry — see the header). -->
        <Path x:Name="EdgeHatchPath" StrokeThickness="{x:Bind Weight, Mode=OneWay}"/>
    </Canvas>
</UserControl>
