<?xml version="1.0" encoding="utf-8"?>
<!-- PanelScroller — the app's hand-rolled vertical scroller for panel windows. Built in the PastCast window
     first; the other panel windows get it next. Wrap a body in it: <prim:PanelScroller> …content… </prim:PanelScroller>.

       ┌─────────────────────────────────────┬──────┐
       │                                     │  ████│  ← THE THUMB: 12 of 16, 4 px in from the left,
       │  content (a ScrollViewer whose own  │  ████│    flush right, rounded ends. Height =
       │  bars are HIDDEN — the wheel, touch │  ████│    viewport / extent of the track (min 32);
       │  and keyboard still scroll it)      │      │    rests faint, firms on hover/drag
       │                                     │      │  ← click the empty track = page up / down
       │                                     │      │
       └─────────────────────────────────────┴──────┘
                                              GUTTER (GutterWidth = 16): ALWAYS CLAIMED

     ⚠️ THE HOST SHOULD BLEED IT INTO ITS OWN RIGHT MARGIN. A panel body sits 16 px in from the window edge
     (TemporalWindow's BodyHost), and a gutter left inside that margin reads as a thin thumb beside a wider
     empty strip. PastCastTab gives the scroller Margin right -12, so the gutter ends 4 px from the window
     edge; the thumb sits flush right in the gutter with 4 px on its left, so it is EQUALLY far (4) from the
     sections and from the window edge. A new host does the same bleed, or the gaps go uneven.

     ⚠️ THE GUTTER NEVER COLLAPSES (the user's rule). When the content fits there is no thumb, but the column
     keeps its width, so opening/closing a section never re-flows the body sideways by a scrollbar's width.
     ⚠️ IT NEVER CHANGES THE WINDOW'S WIDTH: the gutter comes out of the content's width inside the window.
     Anything laid out OUTSIDE the scroller that must line up with the content beside it (PastCast's fixed
     Timeframe block) reserves the same GutterWidth on its right.
     ⚠️ A LIST BODY (ListView/GridView) is NOT wrapped in the scroller's viewer — it sits beside it and the thumb
     drives the list's own ScrollViewer, so virtualization and ScrollIntoView keep working (the Atlas lists).
     ⚠️ WHY NOT WinUI's OWN BAR: it is an OVERLAY (the auto-hiding "conscious" scroll indicator) — it claims no
     space, sits on top of the content's right edge and expands over sliders and % labels on hover. The rule
     here is the opposite: a fixed lane of its own.
     ⚠️ The thumb is drawn from THEME brushes in XAML only; code touches geometry and Opacity, never a brush
     (CLAUDE.md: never resolve a theme brush in C#). -->
<UserControl x:Class="Anvil.Controls.Primitives.PanelScroller"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="GutterColumn" Width="16"/> <!-- set from GutterWidth in code -->
        </Grid.ColumnDefinitions>

        <!-- Hidden (not Disabled) keeps wheel / touch / keyboard scrolling; only the built-in bar goes.
             Content is set in CODE (ApplyBody): a plain body goes in here… -->
        <ScrollViewer x:Name="Viewer" Grid.Column="0"
                      VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <ContentPresenter x:Name="Presenter"
                              HorizontalContentAlignment="Stretch" VerticalAlignment="Top"
                              SizeChanged="OnGeometryChanged"/>
        </ScrollViewer>

        <!-- …a ListView/GridView body goes HERE instead, OUTSIDE the viewer, and the thumb drives the list's OWN
             ScrollViewer (its bar hidden the same way). ⚠️ Never nest a list in the viewer above: it measures
             unbounded, un-virtualizes every row, and ScrollIntoView scrolls a viewer that can't move. -->
        <ContentPresenter x:Name="ListPresenter" Grid.Column="0" Visibility="Collapsed"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

        <!-- THE TRACK: transparent, but hit-testable so a click on it pages. The whole gutter is the track. -->
        <Grid x:Name="Track" Grid.Column="1" Background="Transparent"
              PointerPressed="OnTrackPressed" SizeChanged="OnGeometryChanged">
            <!-- Stretch + Margin 4,0,0,0: 12 of the 16, flush RIGHT in the gutter. ⚠️ The asymmetry is the
                 point: the host bleeds the gutter to 4 px from the window edge, so 4 left (to the sections) and
                 4 right (to the window edge) are EQUAL on screen. Change with the host's bleed. -->
            <Border x:Name="Thumb" Margin="4,0,0,0" CornerRadius="6" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                    Opacity="0.45" Visibility="Collapsed"
                    PointerEntered="OnThumbEntered" PointerExited="OnThumbExited"
                    PointerPressed="OnThumbPressed" PointerMoved="OnThumbMoved"
                    PointerReleased="OnThumbReleased" PointerCaptureLost="OnThumbCaptureLost">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ThumbOffset"/>
                </Border.RenderTransform>
            </Border>
        </Grid>
    </Grid>
</UserControl>
