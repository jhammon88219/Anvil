<?xml version="1.0" encoding="utf-8"?>
<!-- RadarSettingsConsoleScrubber — Settings → Radar's "Scrubber" section (was the Radar Console page's three option cards),
     on a Primitives/SettingsConsolePlate. Which loop scrubber the radar console draws.

       Scrubber  [Restore defaults]                                                                DEFAULT
       Style      [ Classic cells | Dot matrix | Hatch ]          How the console draws the loop's frames   Dot matrix
       Preview    ⁙⁙ ⁙⁙ ⁙⁙ ◆◆ ⁙⁙ ⁚⁚ ·· ·· ··   (the CHOSEN style, 420 wide)   The loop on the map
       96         420                                            hint (one line)                150, right

     ⚠️ Every row is a Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText by AboutKey). The Preview
     row's hint follows the loop (ScrubberPreviewRow.Hint, set in Feed from the catalog's choices).
     ⚠️ The choice = RadarViewModel.ScrubberStyleIndex (AppSettings.ScrubberStyle).
     ⚠️ REAL PREVIEW: the console's OWN scrubber controls, all three declared, the chosen one shown (Is…Scrubber), fed the
     console's Segments + frame index from code — a fixed SAMPLE while no loop is loaded, so it is never blank. -->
<UserControl x:Class="Anvil.Controls.RadarSettingsConsoles.RadarSettingsConsoleScrubber"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="RadarSettingsConsoleScrubberPlate" Title="Scrubber" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="ScrubberRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    ToolTipService.ToolTip="Put the scrubber style back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <prim:SettingsConsoleRow Label="Style" AboutKey="scrubber.style" Default="{x:Bind ViewModel.DefaultScrubberStyleText}">
                <prim:SegmentedPicker x:Name="ScrubberStylePicker"
                                      ItemsSource="{x:Bind ViewModel.Radar.ScrubberStyleLabels}"
                                      SelectedIndex="{x:Bind ViewModel.Radar.ScrubberStyleIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow x:Name="ScrubberPreviewRow" Label="Preview" AboutKey="scrubber.preview" Hint="">
                <!-- 24 tall: the hatch bleeds 4 px above its 20 px host (as in the console). -->
                <Grid x:Name="ScrubberPreviewHost" Height="24">
                    <prim:ClassicScrubber x:Name="ClassicPreview" Height="20" VerticalAlignment="Bottom"
                                          Visibility="{x:Bind Show(ViewModel.Radar.IsClassicScrubber), Mode=OneWay}"/>
                    <prim:DotMatrixScrubber x:Name="DotMatrixPreview" Height="20" VerticalAlignment="Bottom" FillOrder="LeftToRight"
                                            Visibility="{x:Bind Show(ViewModel.Radar.IsDotMatrixScrubber), Mode=OneWay}"/>
                    <prim:HatchScrubber x:Name="HatchPreview" Height="20" VerticalAlignment="Bottom"
                                        Visibility="{x:Bind Show(ViewModel.Radar.IsHatchScrubber), Mode=OneWay}"
                                        Spacing="{x:Bind ViewModel.Radar.HatchLook.Spacing, Mode=OneWay}"
                                        Weight="{x:Bind ViewModel.Radar.HatchLook.Weight, Mode=OneWay}"
                                        Ink="{x:Bind ViewModel.Radar.HatchLook.ColorHex, Mode=OneWay}"
                                        LineOpacity="{x:Bind ViewModel.Radar.HatchLook.LineOpacity, Mode=OneWay}"/>
                </Grid>
            </prim:SettingsConsoleRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
