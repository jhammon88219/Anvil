<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalWindowActivityExpander — the bottom band of a temporal window: what Anvil is WORKING ON for THAT mode
     (TemporalActivityViewModel), in THREE states moved by ONE pull tab. Declared ONCE in TemporalWindow, under whichever
     Content is loaded. It replaced the main bar's activity slot (2026-10-16) and then TemporalWindowFooter (2026-10-17).

       …the Content's last expander…
       ░░░░░░░░░░░░░░░░░░░░░░░░░░╭─ ˄ More ─╮░░░░░░░░░░░░░░░░░░░░░░░   ← 14 px SHADOW cast up over the list (the main
       ──────────────────────────┘          └───────────────────────     bar's ShadowFadeUp); the TAB laps the band's
                                                                          top hairline 2 px (OverlayBarTab), no foot line
     HIDDEN (thin, radar only — two lines, the same height idle or busy):
       Next check in 0:18                           Scan due ~1:47:12 PM
       Last frame: on screen 3.0 s after due        ← busy: "New scan" | "1:47:12 PM scan · painting" over a thin bar
     MINIMAL (˄ More on the way up, ˅ Less on the way down):
       New scan                                1:47:12 PM scan · painting
       ████████████████████████░░░░░░░░░░░░░░░░░   ← the radar block as the bar had it
       ─────────────────────────────────────────
       ● Warnings                              12:04:31 PM      in 0:09     ← one row per feed, the window's layer
       ● Watches                               12:03:50 PM      in 0:48       order: state dot · name · last pulled
       ● Storm reports                            Checking                    data · next check (fixed columns)
     FULL (˅ Less):
       …the radar block, then its IDLE lines even while busy (Next check / Scan due / Last frame)…
       FEEDS
       ● Warnings · every 15 s                 12:04:31 PM      in 0:09
       ● Tropical · every 2 min             Failed 12:00 PM   retry 1:12

     The band is the RAISED tier face (OverlayBarSurfaceRaisedBrush) so the tab — Raised, the main rail's tabs' face —
     blends into it with no seam. Top hairline turns the TONE colour while the radar is loud (blue = working · green =
     done · red = failed). PastCast / ForeCast have no activity yet (Activity.HasContent false): a bare band, no tab.

     ⚠️ Click order: Hidden → Minimal → Full → Minimal → Hidden (Models/Map/ActivityExpanderStates); persisted per window.
     ⚠️ TABULAR DIGITS on every number (TabularNumberTextStyle) + FIXED time columns: a ticking line never changes width.
     ⚠️ Reserved rows: within a state the band's height never changes as lines come and go (bars hide by Opacity).
     ⚠️ The tone / state colours are LITERALS (code-behind), like the gate's: never resolve a theme brush in C#.
     ⚠️ Wording lives in the view models (BarActivityViewModel, FeedStatus), not here. -->
<UserControl x:Class="Anvil.Controls.TemporalWindows.TemporalWindowActivityExpander"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tw="using:Anvil.Controls.TemporalWindows"
             xmlns:ctl="using:Anvil.Controls.Primitives"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsTabStop="False">

    <UserControl.Resources>
        <!-- MINIMAL feed row: state dot · name · last updated · next check. -->
        <DataTemplate x:Key="FeedRowTemplate" x:DataType="vm:FeedStatus">
            <Grid ColumnSpacing="8" Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="66"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                         Fill="{x:Bind tw:TemporalWindowActivityExpander.StateBrush(State), Mode=OneWay}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{x:Bind UpdatedText, Mode=OneWay}" FontSize="12" TextAlignment="Right"
                           VerticalAlignment="Center" Style="{StaticResource TabularNumberTextStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="3" Text="{x:Bind CountdownText, Mode=OneWay}" FontSize="12" TextAlignment="Right"
                           VerticalAlignment="Center" Style="{StaticResource TabularNumberTextStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </DataTemplate>

        <!-- FULL feed row: the same, the name followed by how often the feed checks. -->
        <DataTemplate x:Key="FeedRowFullTemplate" x:DataType="vm:FeedStatus">
            <Grid ColumnSpacing="8" Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="66"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                         Fill="{x:Bind tw:TemporalWindowActivityExpander.StateBrush(State), Mode=OneWay}"/>
                <!-- Two TextBlocks, not Runs: a Run can't take {ThemeResource}. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" FontSize="12"/>
                    <TextBlock Text="{x:Bind tw:TemporalWindowActivityExpander.CadenceSuffix(Cadence), Mode=OneWay}" FontSize="12"
                               TextTrimming="CharacterEllipsis" Style="{StaticResource TabularNumberTextStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind UpdatedText, Mode=OneWay}" FontSize="12" TextAlignment="Right"
                           VerticalAlignment="Center" Style="{StaticResource TabularNumberTextStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="3" Text="{x:Bind CountdownText, Mode=OneWay}" FontSize="12" TextAlignment="Right"
                           VerticalAlignment="Center" Style="{StaticResource TabularNumberTextStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- THE BAND. -->
        <Grid x:Name="Band" Background="{ThemeResource OverlayBarSurfaceRaisedBrush}">
            <!-- The top hairline (themed), then THE TONE EDGE over it: code-behind sets its literal brush and fades its
                 opacity (ApplyTone) — a quiet tone fades it out WITHOUT changing the brush, so a green flash fades green.
                 Two elements, not a Border + child: a child can't paint over its parent's own border. -->
            <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False"
                    Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
            <Border x:Name="ToneEdge" Height="1" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.3"/>
                </Border.OpacityTransition>
            </Border>

            <StackPanel Margin="16,9,16,10">

                <!-- ===== HIDDEN: two lines, the same height idle or busy. ===== -->
                <Grid x:Name="HiddenLines" Height="34" RowSpacing="2"
                      Visibility="{x:Bind Shown(Activity.IsHidden), Mode=OneWay}"
                      Opacity="{x:Bind LinesOpacity(Activity.Radar.IsShown), Mode=OneWay}">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.25"/>
                    </Grid.OpacityTransition>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="16"/>
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Activity.Radar.Title, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Style="{StaticResource TabularNumberTextStyle}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Activity.Radar.Detail, Mode=OneWay}" FontSize="12"
                                   Style="{StaticResource TabularNumberTextStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <!-- Row 2: the last-frame line when idle, a thin bar of the build when busy. -->
                    <TextBlock Grid.Row="1" Text="{x:Bind Activity.Radar.LastFrameLine, Mode=OneWay}" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" Style="{StaticResource TabularNumberTextStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid Grid.Row="1" Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                          Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                          Opacity="{x:Bind BarOpacity(Activity.Radar.HasProgress), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Filled(Activity.Radar.Progress), Mode=OneWay}"/>
                            <ColumnDefinition Width="{x:Bind Rest(Activity.Radar.Progress), Mode=OneWay}"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="1.5" Background="{x:Bind ToneBrush(Activity.Radar.Tone), Mode=OneWay}"/>
                    </Grid>
                </Grid>

                <!-- ===== MINIMAL + FULL: the radar block (as the bar had it). ===== -->
                <StackPanel x:Name="RadarBlock"
                            Visibility="{x:Bind ShownUnlessHidden(Activity.IsHidden, Activity.HasRadar), Mode=OneWay}"
                            Opacity="{x:Bind LinesOpacity(Activity.Radar.IsShown), Mode=OneWay}">
                    <StackPanel.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.25"/>
                    </StackPanel.OpacityTransition>
                    <Grid ColumnSpacing="8" Height="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Activity.Radar.Title, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Style="{StaticResource TabularNumberTextStyle}"/>
                            <Border Padding="5,0" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind HasText(Activity.Radar.QueuedText), Mode=OneWay}">
                                <TextBlock Text="{x:Bind Activity.Radar.QueuedText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                           Style="{StaticResource TabularNumberTextStyle}"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind Activity.Radar.Detail, Mode=OneWay}" FontSize="12"
                                   VerticalAlignment="Center" Style="{StaticResource TabularNumberTextStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <!-- Main bar + thin line: always laid out, hidden by Opacity, so the block's height holds. -->
                    <Grid Height="5" CornerRadius="2.5" Margin="0,6,0,0"
                          Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                          Opacity="{x:Bind BarOpacity(Activity.Radar.HasProgress), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Filled(Activity.Radar.Progress), Mode=OneWay}"/>
                            <ColumnDefinition Width="{x:Bind Rest(Activity.Radar.Progress), Mode=OneWay}"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="2.5" Background="{x:Bind ToneBrush(Activity.Radar.Tone), Mode=OneWay}"/>
                    </Grid>
                    <Grid Height="2" CornerRadius="1" Margin="0,2,0,0"
                          Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                          Opacity="{x:Bind BarOpacity(Activity.Radar.HasSecondary), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Filled(Activity.Radar.Secondary), Mode=OneWay}"/>
                            <ColumnDefinition Width="{x:Bind Rest(Activity.Radar.Secondary), Mode=OneWay}"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="1" Background="#FF8A8F98"/>
                    </Grid>

                    <!-- FULL ONLY: the radar's idle lines, kept current even while a scan is busy. -->
                    <StackPanel Margin="0,6,0,0" Spacing="2"
                                Visibility="{x:Bind Shown(Activity.IsFull), Mode=OneWay}">
                        <Grid ColumnSpacing="8" Height="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Activity.Radar.IdleTitle, Mode=OneWay}" FontSize="11.5"
                                       Style="{StaticResource TabularNumberTextStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Activity.Radar.IdleDetail, Mode=OneWay}" FontSize="11.5"
                                       Style="{StaticResource TabularNumberTextStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <TextBlock Text="{x:Bind Activity.Radar.IdleLastFrame, Mode=OneWay}" FontSize="11.5" Height="16"
                                   TextTrimming="CharacterEllipsis" Style="{StaticResource TabularNumberTextStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ===== MINIMAL + FULL: the feeds. ===== -->
                <StackPanel x:Name="FeedsBlock"
                            Visibility="{x:Bind ShownUnlessHidden(Activity.IsHidden, Activity.HasFeeds), Mode=OneWay}">
                    <Border Height="1" Margin="0,9,0,4" Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                            Visibility="{x:Bind Shown(Activity.IsMinimal), Mode=OneWay}"/>
                    <TextBlock Text="FEEDS" Style="{StaticResource AtlasFieldLabelStyle}" Margin="0,10,0,2"
                               Visibility="{x:Bind Shown(Activity.IsFull), Mode=OneWay}"/>
                    <ItemsControl ItemsSource="{x:Bind Activity.Feeds, Mode=OneWay}"
                                  ItemTemplate="{StaticResource FeedRowTemplate}"
                                  Visibility="{x:Bind Shown(Activity.IsMinimal), Mode=OneWay}"/>
                    <ItemsControl ItemsSource="{x:Bind Activity.Feeds, Mode=OneWay}"
                                  ItemTemplate="{StaticResource FeedRowFullTemplate}"
                                  Visibility="{x:Bind Shown(Activity.IsFull), Mode=OneWay}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- THE SHADOW cast up over the Content's list — the main bar's ShadowFadeUp, its strength themed
             (OverlayBarShadowOpacity). Never takes the pointer. -->
        <Border Height="14" VerticalAlignment="Top" Margin="0,-14,0,0" IsHitTestVisible="False"
                Background="{StaticResource ShadowFadeUp}"
                Opacity="{ThemeResource OverlayBarShadowOpacity}"/>

        <!-- THE TAB: the main rail's pull tab (Primitives/OverlayBarTab), Raised to wear the band's face, lapping the
             band's hairline 2 px (its own -2 foot margin; -26 here = its 28 less that lap). ManualToggle: a click
             Advances the state; IsShown is only the chevron (down = the click closes), Label the word. -->
        <ctl:OverlayBarTab x:Name="ActivityTab"
                           VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-26,0,0"
                           Raised="True" ManualToggle="True"
                           Visibility="{x:Bind Shown(Activity.HasContent), Mode=OneWay}"
                           IsShown="{x:Bind Not(Activity.OpensMore), Mode=OneWay}"
                           Label="{x:Bind Activity.TabLabel, Mode=OneWay}"
                           Hint="{x:Bind TabHint(Activity.OpensMore), Mode=OneWay}"
                           Clicked="OnTabClicked"/>
    </Grid>
</UserControl>
