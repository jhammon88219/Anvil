<?xml version="1.0" encoding="utf-8"?>
<!-- RadarSettingsConsoleSiteKeys — Settings → Radar's "Site keys" section (was "Radar site keys"), on a
     Primitives/SettingsConsolePlate. Set-once PREFERENCES about the radar site keys on the map.

       Site keys  [Restore defaults]                                                               DEFAULT
                  ☑ Hide the other sites while one is loaded   Click the loaded site again to unload it   On
                  ☐ Show only my home and favorite sites       Star sites in the Atlas to add them       Off
                  ☐ Show only the sites near the cursor        Experimental · a 230 km ring follows …    Off
       96 (empty) 420 (the box)                                hint (one line)                  150, right

     ⚠️ Every row is a Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText by AboutKey); checkboxes
     sit in the Control column. Each box = ONE rule in radar-sites.js's VISIBILITY RULES table (`focus`, `favorites`,
     `reveal`); a new way to hide keys = a rule there + a row here. The network toggles (NEXRAD / TDWR / research) are
     gestures on the map-tools rail, not here.
     ⚠️ "Show only my home and favorite sites" is the SAME property the site picker's footer binds — two switches, one value.
     ⚠️ The cursor row is the SITE-REVEAL bolt-on (grep SITE-REVEAL to excise). -->
<UserControl x:Class="Anvil.Controls.RadarSettingsConsoles.RadarSettingsConsoleSiteKeys"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="RadarSettingsConsoleSiteKeysPlate" Title="Site keys" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="SiteKeysRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    ToolTipService.ToolTip="Put the site-key switches back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <prim:SettingsConsoleRow AboutKey="sites.hideOthers" Default="{x:Bind ViewModel.DefaultHideOtherSitesText}">
                <CheckBox x:Name="HideOtherSitesCheckBox" VerticalAlignment="Center"
                          Content="Hide the other sites while one is loaded"
                          IsChecked="{x:Bind ViewModel.Radar.HideOtherSitesWhileLoaded, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow AboutKey="sites.favorites" Default="{x:Bind ViewModel.DefaultFavoritesOnlyText}">
                <CheckBox x:Name="FavoritesOnlyCheckBox" VerticalAlignment="Center"
                          Content="Show only my home and favorite sites"
                          IsChecked="{x:Bind ViewModel.SiteFavorites.ShowOnlyFavoritesOnMap, Mode=TwoWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SiteFavorites.FavoritesOnlyNote, Mode=OneWay}"/>
            </prim:SettingsConsoleRow>

            <!-- SITE-REVEAL (experimental bolt-on; grep SITE-REVEAL to excise). -->
            <prim:SettingsConsoleRow AboutKey="sites.reveal" Default="{x:Bind ViewModel.DefaultRevealSitesText}">
                <CheckBox x:Name="RevealSitesCheckBox" VerticalAlignment="Center"
                          Content="Show only the sites near the cursor"
                          IsChecked="{x:Bind ViewModel.Radar.RevealSitesNearCursor, Mode=TwoWay}"
                          ToolTipService.ToolTip="A 230 km ring follows the cursor; only the sites inside it show, plus the loaded site."/>
            </prim:SettingsConsoleRow>
            <!-- end SITE-REVEAL -->
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
