<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalToggles — the Past / Now / Fore temporal features as three compact labelled pills. A click
     activates that time-frame AND opens its settings WINDOW (see PastCastWindow / NowCastWindow /
     ForeCastWindow — three independent OS windows); clicking the already-active mode flips its window
     open/closed while the mode stays on. You LEAVE a mode by choosing another (Past is exclusive with
     Now/Fore; Now and Fore coexist). The click routes through MapViewModel.ToggleTemporalMode; the pill's
     lit state binds OneWay to MapViewModel.IsPastCast/IsNowCast/IsForeCast (projections of the subsystems).

     These are TEXT pills, not the old icon-over-label stacks: they live in the bottom bar's global cluster
     now (the top bar is gone), stacked above the window buttons, so the whole cluster has to fit the
     module's two-row height. The words also read better than the placeholder glyphs did.
     Bound to the coordinator MapViewModel. -->
<UserControl
    x:Class="Anvil.Controls.Sections.TemporalToggles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One mode pill. A click activates the mode and opens its window; clicking again flips the
             window; you leave a mode by choosing another. -->
        <Style x:Key="TemporalPillStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" ColumnSpacing="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ToggleButton Grid.Column="0" Style="{StaticResource TemporalPillStyle}" Content="Past"
                      ToolTipService.ToolTip="PastCast — replay a historical radar window (click again to show/hide its panel)"
                      IsChecked="{x:Bind ViewModel.IsPastCast, Mode=OneWay}"
                      Click="OnPastClick"/>

        <ToggleButton Grid.Column="1" Style="{StaticResource TemporalPillStyle}" Content="Now"
                      ToolTipService.ToolTip="NowCast — live radar / current conditions (click again to show/hide its panel)"
                      IsChecked="{x:Bind ViewModel.IsNowCast, Mode=OneWay}"
                      Click="OnNowClick"/>

        <ToggleButton Grid.Column="2" Style="{StaticResource TemporalPillStyle}" Content="Fore"
                      ToolTipService.ToolTip="ForeCast — SPC outlooks (click again to show/hide its panel)"
                      IsChecked="{x:Bind ViewModel.IsForeCast, Mode=OneWay}"
                      Click="OnForeClick"/>
    </Grid>
</UserControl>
