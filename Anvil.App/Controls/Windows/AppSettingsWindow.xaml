<?xml version="1.0" encoding="utf-8"?>
<!-- AppSettingsWindow — the app-wide settings content. Hosted in its OWN OS window by WindowManager (the
     native window title bar is the only chrome), so there is no panel frame: the root is the dark surface,
     stretched to fill the window, with the settings sections laid out top-left. Bound to the coordinator
     MapViewModel.

       ┌─ App settings ─────────────────────────────────[pin]─┐
       │  STORAGE                                             │
       │    Radar cache          4.2 GB      ( Clear now )    │  ← live size, re-read on each open
       │    Cache limit             [5 ▾] GB                  │  ← PERSISTED; the startup sweep's cap
       └──────────────────────────────────────────────────────┘

     App BEHAVIOR only, and the rule has now cost this window two sections. Map CONTENT (the radar-site
     marker toggles) moved to the Map Controls window; a setting that changes what the map draws does not
     belong here. The ADVANCED section — a lone Pipeline Console switch — moved to the Dev Tools window;
     dev instrumentation is not app behavior either, and it was only ever parked here because there was
     nowhere else for it. Add a section = a row in the body; make it persist = one property on
     AppSettings. -->


<UserControl x:Class="Anvil.Controls.Windows.AppSettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Section header inside the settings body (e.g. "Radar Settings"). -->
        <Style x:Key="SettingsSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="40"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- Dark surface fills the whole window; content sits top-left. -->
    <Grid Background="{ThemeResource OverlayBarSurfaceBrush}">
        <!-- Body: one section per group, [label] over its controls. Grid rows (no StackPanels). -->
        <Grid Margin="16" RowSpacing="8" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Storage (cache size + clear + limit) -->
            </Grid.RowDefinitions>

            <!-- The radar-site marker toggles (Show TDWRs / Show research radars) moved to the Map
                 Controls window: marker visibility is map content, not app behavior, and it belongs with
                 the master site toggle. This window keeps only app-level settings. -->

            <!-- STORAGE — the settings service's first real consumer. Live radar-cache size + a
                 "Clear now" action (Level2RadarService), and a PERSISTED size cap
                 (AppSettings.RadarCacheMaxGb, enforced by the startup sweep). -->
            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Text="Storage"
                           Style="{StaticResource SettingsSectionLabelStyle}"/>

                <!-- Radar cache size + Clear now -->
                <Grid ColumnSpacing="8" Margin="4,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Radar cache"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Margin="0,0,4,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.Storage.CacheSizeText, Mode=OneWay}"/>
                    <Button Grid.Column="2" Content="Clear now"
                            IsEnabled="{x:Bind ViewModel.Storage.CanClear, Mode=OneWay}"
                            Click="OnClearCacheClick"
                            ToolTipService.ToolTip="Delete all cached radar volumes now (the app re-downloads what it needs)"/>
                </Grid>

                <!-- Cache size cap (persisted via the settings service) -->
                <Grid ColumnSpacing="8" Margin="4,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Cache limit"/>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Right" MinWidth="72"
                              ItemsSource="{x:Bind ViewModel.Storage.CacheLimitOptions}"
                              SelectedItem="{x:Bind ViewModel.Storage.CacheLimitGb, Mode=TwoWay}"
                              ToolTipService.ToolTip="Maximum on-disk radar cache; enforced at the next launch"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="GB"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Pin: keep this window on top. -->
        <ctl:PinToggle IsChecked="{x:Bind ViewModel.IsSettingsWindowOnTop, Mode=TwoWay}"/>
    </Grid>
</UserControl>
