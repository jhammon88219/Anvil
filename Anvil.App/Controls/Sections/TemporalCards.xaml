<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalCards — the temporal settings content (Past / Now / Fore). Hosted in ONE OS window by
     CardWindowManager (open while OpenCard != None); the three panels overlap and only the open one shows
     (driven by MapViewModel.OpenCard via the IsXCardOpen facets). The root is the dark surface stretched to
     fill the window; each panel carries a small title since the native caption is static ("Timeline").
     Bound to the coordinator MapViewModel. -->
<UserControl x:Class="Anvil.Controls.Sections.TemporalCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="using:Anvil.Controls.Sections"
             xmlns:ctl="using:Anvil.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Panel title (which temporal mode's settings these are). -->
        <Style x:Key="TemporalTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="40"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- Dark surface fills the whole window; the three panels overlap, only the open one shows. -->
    <Grid Background="{ThemeResource OverlayBarSurfaceBrush}">

        <!-- Past Event: date / start / window + historical SPC outlook + storm reports. -->
        <Grid Margin="16" VerticalAlignment="Top" RowSpacing="12"
              Visibility="{x:Bind VisibleWhen(ViewModel.IsPastCardOpen), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- title -->
                <RowDefinition Height="Auto"/> <!-- radar: date / start / window -->
                <RowDefinition Height="Auto"/> <!-- divider -->
                <RowDefinition Height="Auto"/> <!-- historical SPC outlook -->
                <RowDefinition Height="Auto"/> <!-- divider -->
                <RowDefinition Height="Auto"/> <!-- storm reports (verification) -->
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Past Event" Style="{StaticResource TemporalTitleStyle}"/>
            <sections:PastEventInput Grid.Row="1" ViewModel="{x:Bind ViewModel.Radar, Mode=OneWay}"/>
            <Border Grid.Row="2" Height="1" Margin="0,2"
                    Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
            <sections:PastOutlookInput Grid.Row="3" ViewModel="{x:Bind ViewModel.PastOutlook, Mode=OneWay}"/>
            <Border Grid.Row="4" Height="1" Margin="0,2"
                    Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
            <sections:StormReportsInput Grid.Row="5" ViewModel="{x:Bind ViewModel.StormReports, Mode=OneWay}"/>
        </Grid>

        <!-- Now: live radar options (watches + warnings) + today's storm reports. -->
        <Grid Margin="16" VerticalAlignment="Top" RowSpacing="12"
              Visibility="{x:Bind VisibleWhen(ViewModel.IsNowCardOpen), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- title -->
                <RowDefinition Height="Auto"/> <!-- watches + warnings -->
                <RowDefinition Height="Auto"/> <!-- divider -->
                <RowDefinition Height="Auto"/> <!-- storm reports (today) -->
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Live Radar" Style="{StaticResource TemporalTitleStyle}"/>
            <sections:NowCastInput Grid.Row="1" ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>
            <Border Grid.Row="2" Height="1" Margin="0,2"
                    Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
            <sections:StormReportsInput Grid.Row="3" ViewModel="{x:Bind ViewModel.StormReports, Mode=OneWay}"/>
        </Grid>

        <!-- Fore: SPC outlook selectors + legend. -->
        <Grid Margin="16" VerticalAlignment="Top" RowSpacing="12"
              Visibility="{x:Bind VisibleWhen(ViewModel.IsForeCardOpen), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- title -->
                <RowDefinition Height="Auto"/> <!-- outlook selectors + legend -->
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="SPC Outlooks" Style="{StaticResource TemporalTitleStyle}"/>
            <sections:OutlookInput Grid.Row="1" ViewModel="{x:Bind ViewModel.Outlook, Mode=OneWay}"/>
        </Grid>

        <!-- Pin: keep this window on top. -->
        <ctl:PinToggle IsChecked="{x:Bind ViewModel.IsTimelineOnTop, Mode=TwoWay}"/>
    </Grid>
</UserControl>
