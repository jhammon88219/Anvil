<?xml version="1.0" encoding="utf-8"?>
<!-- RadarControls — the GLOBAL time module, and only that: ONE ROW inside the TIME STRIP (MainWindow's L with the
     map-tools rail, 2026-11-20 — canvas "Pane headers + L strip", scan option 1).

       ← strip's left edge                    window midpoint ┊                                 strip's right edge →
       │  1:07 PM · 2 min ago │ ▮▮▮▮▮▮▮▮▮▮▮ scrubber 420 ▮▮▮▮▮▮▮▮▮▮ │ ◀ ▶ ▶  22 / 30  ⟳      VCP 212 · precip · SAILS ×1 │
         └─ CLOCK BLOCK, a FIXED   └─ the SCRUBBER is the window's    └─ transport · frame   └─ the SCAN LINE, right-
            width, right-aligned      centre (the column is centred      count · check now      aligned on the strip's
            against the scrubber      on the WHOLE window)                                      right end; reserved
                                                                                                ScanLineWidth, trims

     ⚠️ THE SCRUBBER IS THE CENTRE (the user's call, 2026-11-20 — it replaced "play = the window midpoint" and the
     CentreOnPlay padding). This control is laid out over the WHOLE window width by its host, so its [*, 420, *] grid puts
     the scrubber on the window's midpoint whatever the strip's ends do; SideInsets (set by MainWindow.LayoutRadarStrip)
     pull the side blocks in to the strip's ends when a temporal pane covers that side.
     ⚠️ NOTHING HERE MAY CHANGE ITS NEEDED WIDTH: MainWindow decides from LeftNeed / RightNeed whether a side fits beside
     a temporal pane (else the strip runs under the pane and the pane stops above it). So the clock block is a FIXED width
     (its text trims) and the scan line a RESERVED width — a width that followed the text would make the panes jump.
     ⚠️ ONE SCAN LINE (was three labelled lines): "VCP 212 · precip · MESO-SAILS ×2", each part cut by ScanValue from the
     ONE rule's string (RadarViewModel.ScanStrategyText, shared with the Atlas); a missing part is its placeholder (—, none,
     n/a, off, pre-SAILS). The glossary tooltip (RadarGlossary) explains it on hover.

     THE ORGANIZING RULE: the strip holds what does NOT repeat per pane — one site, one camera, one time cursor. Per-pane
     controls (product, ramp, tilt) are each pane's HEADER (Composites/PaneHeader), not here.
     ⚠️ EVERY TextBlock here is IsTextScaleFactorEnabled="False" (docs/text-scaling-audit.md): the blocks are FIXED
     widths, so Windows' Text size must not grow them. A new TextBlock here opts out too (ModelConsole same). -->
<UserControl x:Class="Anvil.Controls.Composites.RadarControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prim="using:Anvil.Controls.Primitives"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Glyph-only transport: no resting plate, the shared hover/pressed look still shows on pointer. -->
        <Style x:Key="GlyphTransportStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Assembly" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>    <!-- the clock block, right-aligned against the scrubber -->
            <ColumnDefinition Width="Auto"/> <!-- the scrubber: a fixed 420, on the window's midpoint -->
            <ColumnDefinition Width="*"/>    <!-- transport · count · check now ······ scan line -->
        </Grid.ColumnDefinitions>

        <!-- ===== THE CLOCK BLOCK: the DISPLAYED frame's time · its age, ONE line =====
             FIXED width (ClockBlockWidth), right-aligned: the time sits against the scrubber, the age before it trims.
             Age = how long ago the radar started scanning the frame ON SCREEN (RadarViewModel.AgeWords), ramped
             green → amber (12 min) → red (30 min) by AgeBrush, knees matching RadarSiteStatus.
             ⚠️ The NowCast header's clock (TemporalPaneNowCastContent) is a COPY of the OLD clock's look — not this one. -->
        <Grid x:Name="ClockBlock"
              Grid.Column="0"
              Width="{x:Bind ClockBlockWidth}"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Margin="0,0,16,0"
              Background="Transparent"
              ToolTipService.ToolTip="When the frame on screen was scanned, and how long ago. Green = fresh, red = stale.">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>    <!-- age, trims -->
                <ColumnDefinition Width="Auto"/> <!-- time -->
            </Grid.ColumnDefinitions>
            <TextBlock IsTextScaleFactorEnabled="False" Grid.Column="0"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                       Text="{x:Bind ViewModel.RadarAgeText, Mode=OneWay}"
                       Style="{StaticResource BodyTextStyle}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{x:Bind AgeBrush(ViewModel.RadarAgeMinutes), Mode=OneWay}"/>
            <!-- ⚠️ TABULAR digits: proportional ones change width every frame. -->
            <TextBlock IsTextScaleFactorEnabled="False" Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.CurrentFrameTimeText, Mode=OneWay}"
                       Typography.NumeralAlignment="Tabular"
                       FontSize="{StaticResource BodyLargeFontSize}"
                       LineHeight="{StaticResource BodyLargeLineHeight}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Grid>

        <!-- ===== THE SCRUBBER =====
             ⚠️ THE Width="420" IS LOAD-BEARING: in an Auto column EqualCellsPanel measures with infinity and returns 0.
             One cell per frame (ViewModel.Segments), each lighting as its frame builds (Rule 2). THREE looks, picked in
             Settings → Radar (Is{Classic,DotMatrix,Hatch}Scrubber); all draw only — THIS host is the 20 px hit strip and
             maps the pointer (classic + hatch: equal slots; dots: DotScrubber.IndexAt). -->
        <Grid x:Name="ScrubberHost"
              Grid.Column="1"
              Width="420"
              Height="20"
              VerticalAlignment="Center"
              Background="Transparent"
              IsHitTestVisible="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
              Opacity="{x:Bind ScrubberOpacity(ViewModel.IsTransportEnabled), Mode=OneWay}"
              PointerPressed="OnScrubberPointerPressed"
              PointerMoved="OnScrubberPointerMoved"
              PointerReleased="OnScrubberPointerReleased"
              PointerCaptureLost="OnScrubberPointerReleased"
              PointerCanceled="OnScrubberPointerReleased">
            <prim:ClassicScrubber Segments="{x:Bind ViewModel.Segments, Mode=OneWay}"
                                  CurrentIndex="{x:Bind ViewModel.CurrentFrameIndex, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsClassicScrubber, Mode=OneWay}"/>
            <prim:DotMatrixScrubber x:Name="DotScrubber"
                                    Segments="{x:Bind ViewModel.Segments, Mode=OneWay}"
                                    CurrentIndex="{x:Bind ViewModel.CurrentFrameIndex, Mode=OneWay}"
                                    FillOrder="LeftToRight"
                                    Visibility="{x:Bind ViewModel.IsDotMatrixScrubber, Mode=OneWay}"/>
            <prim:HatchScrubber Segments="{x:Bind ViewModel.Segments, Mode=OneWay}"
                                CurrentIndex="{x:Bind ViewModel.CurrentFrameIndex, Mode=OneWay}"
                                Spacing="{x:Bind ViewModel.HatchLook.Spacing, Mode=OneWay}"
                                Weight="{x:Bind ViewModel.HatchLook.Weight, Mode=OneWay}"
                                Ink="{x:Bind ViewModel.HatchLook.ColorHex, Mode=OneWay}"
                                LineOpacity="{x:Bind ViewModel.HatchLook.LineOpacity, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsHatchScrubber, Mode=OneWay}"/>
        </Grid>

        <!-- ===== RIGHT: transport · frame count · check now ······ the scan line ===== -->
        <Grid Grid.Column="2" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- transport + count + check -->
                <ColumnDefinition Width="*"/>    <!-- the gap -->
                <ColumnDefinition Width="Auto"/> <!-- scan line -->
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TransportBlock" Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource GlyphTransportStyle}"
                        Click="OnPrevClick"
                        IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                        ToolTipService.ToolTip="Previous frame">
                    <FontIcon Glyph="&#xE892;" FontSize="13"/>
                </Button>
                <!-- Play is the one transport glyph at full strength: it's the one you reach for. -->
                <Button x:Name="PlayStopButton"
                        Style="{StaticResource GlyphTransportStyle}"
                        Width="32"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Click="OnPlayStopClick"
                        IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                        ToolTipService.ToolTip="Play / stop (stop returns to the newest frame)">
                    <FontIcon Glyph="{x:Bind PlayStopGlyph(ViewModel.IsPlaying), Mode=OneWay}" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource GlyphTransportStyle}"
                        Click="OnNextClick"
                        IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                        ToolTipService.ToolTip="Next frame">
                    <FontIcon Glyph="&#xE893;" FontSize="13"/>
                </Button>
                <!-- RESERVED width (FrameCountWidth): "30 / 30" must not move what follows. -->
                <TextBlock IsTextScaleFactorEnabled="False"
                           Width="{x:Bind FrameCountWidth}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Text="{x:Bind FrameCountText(ViewModel.CurrentFrameIndex, ViewModel.MaxFrameIndex), Mode=OneWay}"
                           Typography.NumeralAlignment="Tabular"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           ToolTipService.ToolTip="Which frame of the loop is on screen"/>
                <!-- One live poll now instead of waiting for the timer; the VM debounces it (disabled while running + 2 s
                     after), and the disabled look IS the cooldown cue. -->
                <Button Style="{StaticResource GlyphTransportStyle}"
                        Width="24"
                        Height="24"
                        VerticalAlignment="Center"
                        Click="OnForceLiveCheckClick"
                        IsEnabled="{x:Bind ViewModel.CanForceLiveCheck, Mode=OneWay}"
                        ToolTipService.ToolTip="Check for a newer frame now (skips the poll timer)">
                    <FontIcon Glyph="&#xE72C;" FontSize="11"/>
                </Button>
            </StackPanel>

            <!-- ===== THE SCAN LINE: VCP · mode · rescans, ONE line (scan option 1, 2026-11-20) =====
                 RESERVED ScanLineWidth, right-aligned on the strip's right end (SideInsets.Right + 16), trims. -->
            <Grid x:Name="ScanLine" Grid.Column="2"
                  Width="{x:Bind ScanLineWidth}"
                  Margin="{x:Bind RightBlockMargin(SideInsets), Mode=OneWay}"
                  VerticalAlignment="Center"
                  Background="Transparent"
                  ToolTipService.ToolTip="{x:Bind ScanTooltip(ViewModel.RadarModeText), Mode=OneWay}">
                <TextBlock IsTextScaleFactorEnabled="False"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="VCP " Foreground="{ThemeResource TextFillColorTertiaryBrush}"/><Run Text="{x:Bind ScanValue(ViewModel.RadarModeText, 0), Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/><Run Text=" · " Foreground="{ThemeResource TextFillColorTertiaryBrush}"/><Run Text="{x:Bind ScanValue(ViewModel.RadarModeText, 1), Mode=OneWay}"/><Run Text=" · " Foreground="{ThemeResource TextFillColorTertiaryBrush}"/><Run Text="{x:Bind ScanValue(ViewModel.RadarModeText, 2), Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
