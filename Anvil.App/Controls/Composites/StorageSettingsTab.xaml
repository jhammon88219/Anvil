<?xml version="1.0" encoding="utf-8"?>
<!-- StorageSettingsTab — the Storage page of the Settings window: what Anvil keeps on disk, and its limits.

                                                                      ( Open Anvil's folder )   ← right edge = the console's
       ┌──────────────────────────────────────────────────────────────────────────────────────┐
       │ 2.2 GB  used by Anvil                                                                 │
       │ ████████████████████████████████████████████▌▌▏▏                                      │
       │ DATA                       SIZE ?                     MAX SIZE ?  KEEP FOR ?          │   Controls/StorageManagers/
       │ ■ Radar volumes …          1.8 GB  [ Clear ] [📁]  [5 GB ⌄]  [5 days ⌄]              │   StorageManagerSettingsConsole
       │ …                                                                                     │
       └──────────────────────────────────────────────────────────────────────────────────────┘

     No expander (the console IS the page). Everything inside is StorageManagerSettingsConsole over MapViewModel.Storage.

     ⚠️ The sizes are only re-measured when this tab becomes VISIBLE (MapViewModel.RefreshForSettingsTab, fired when the
     window opens and when the tab changes) — it walks several folders, so it must not run on every Settings open.
     ⚠️ The basemap folder picker does NOT belong here yet — it lives on the MAP tab, beside the online-tiles URL. (A later
     step moves the offline-map controls here; until then no hint to it either.) -->
<UserControl x:Class="Anvil.Controls.Composites.StorageSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:storageManagers="using:Anvil.Controls.StorageManagers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel Spacing="8" VerticalAlignment="Top">
        <Button x:Name="OpenAnvilFolderButton" Content="Open Anvil's folder" HorizontalAlignment="Right"
                ToolTipService.ToolTip="Open the folder where Anvil keeps everything on this list"
                Click="OnOpenAnvilFolderClick"/>
        <storageManagers:StorageManagerSettingsConsole x:Name="StorageManagerSettingsConsole"
                                                      ViewModel="{x:Bind ViewModel.Storage, Mode=OneWay}"/>
    </StackPanel>
</UserControl>
