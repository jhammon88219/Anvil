<?xml version="1.0" encoding="utf-8"?>
<!-- LiveDataSettingsConsoleWeatherWire — Settings → Live Data's "Weather Wire account" section, on a Primitives/SettingsConsolePlate:
     the NOAA Weather Wire (NWWS-OI) sign-in. Mock-up: the "Weather Wire plate — signed in" Design canvas (2026-11-18).

     NO ACCOUNT SAVED (boxes live, no Edit keys):
       Weather Wire account                                                       (no Restore defaults, no DEFAULT)
                  Don't have one?  Request a Weather Wire account ↗           Email request to the NWS · can take 10 days or more
       User name  [firstname.lastname                         ]               From the NWS · one computer at a time
       Password   [Password                                   ]               Kept in Windows Credential Manager
                                        [Test connection][Save account]       Fill in both to test or save   ← runs into Default

     SAVED (LOCKED — both boxes grey; Edit INSIDE each box, right, full height, the buttons' width):
       User name  [firstname.lastname          |     Edit     ]
       Password   [●●●●●●●●●●                  |     Edit     ]               Edit unlocks THAT box and becomes Cancel
                  [Account details][Test connection][Save account]            Signed in as … · nothing to save
                  ┌ Account   firstname.lastname ──────────────┐               ← only while Account details is open
                  │ Password  Saved · never shown in Anvil     │
                  │ Stored in / Server / Connection            │
                  │ Open Credential Manager   [Forget account…]│
                  └────────────────────────────────────────────┘
       96         420 (buttons right-aligned, each WireButtonWidth = the Edit key's width)

     ⚠️ Every row is a Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText by AboutKey). GREYED unless the
     source is NOAA Weather Wire — each CONTROL greys (not the rows), so a greyed row can still be picked to read its About.
     An account is YOURS: no DEFAULT, no Restore defaults, and Reset all keeps it.
     ⚠️ The password lives ONLY in Credential Manager (ICredentialStore), never AppSettings: the PasswordBox hands it to the VM
     from code-behind (SetPendingPassword), never through a binding. The password is NEVER shown in Anvil — the details say
     where Windows keeps it (Credential Manager asks for the Windows sign-in to show it).
     ⚠️ The user name box is a DRAFT (LiveDataViewModel) — settings change only on Save; Save lights only on a change.
     The Edit key OVERLAYS the box's right end; the box's right Padding (EditPadding) keeps text out from under it, and the
     PasswordBox's reveal eye is off while the Edit key sits there. -->
<UserControl x:Class="Anvil.Controls.LiveDataSettingsConsoles.LiveDataSettingsConsoleWeatherWire"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One width for the Edit keys AND the three buttons ("Test connection" sets it). -->
        <x:Double x:Key="WireButtonWidth">132</x:Double>
    </UserControl.Resources>

    <prim:SettingsConsolePlate x:Name="LiveDataSettingsConsoleWeatherWirePlate" Title="Weather Wire account">
        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <!-- Only before an account is saved: the step before typing anything. -->
            <prim:SettingsConsoleRow AboutKey="wire.request"
                                     Visibility="{x:Bind Shown(ViewModel.HasSavedAccount, x:False), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Text="Don't have one?"/>
                    <HyperlinkButton x:Name="NwwsRequestAccountLink" Content="Request a Weather Wire account ↗"
                                     Click="OnRequestAccountClick"
                                     ToolTipService.ToolTip="The NWS page for an NWWS-OI account (asks before leaving Anvil)"/>
                </StackPanel>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="User name" AboutKey="wire.user">
                <Grid>
                    <TextBox x:Name="NwwsUsernameTextBox" PlaceholderText="firstname.lastname"
                             IsEnabled="{x:Bind Both(ViewModel.IsNwws, ViewModel.IsUserOpen), Mode=OneWay}"
                             Padding="{x:Bind EditPadding(ViewModel.HasSavedAccount), Mode=OneWay}"
                             Text="{x:Bind ViewModel.NwwsUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button x:Name="NwwsUsernameEditButton" Width="{StaticResource WireButtonWidth}"
                            HorizontalAlignment="Right" VerticalAlignment="Stretch" CornerRadius="0,4,4,0"
                            Content="{x:Bind ViewModel.UserEditLabel, Mode=OneWay}" Click="OnEditUserClick"
                            IsEnabled="{x:Bind ViewModel.IsNwws, Mode=OneWay}"
                            Visibility="{x:Bind Shown(ViewModel.HasSavedAccount, x:True), Mode=OneWay}"/>
                </Grid>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Password" AboutKey="wire.password">
                <Grid>
                    <PasswordBox x:Name="NwwsPasswordBox"
                                 IsEnabled="{x:Bind Both(ViewModel.IsNwws, ViewModel.IsPasswordOpen), Mode=OneWay}"
                                 Padding="{x:Bind EditPadding(ViewModel.HasSavedAccount), Mode=OneWay}"
                                 PasswordRevealMode="{x:Bind RevealMode(ViewModel.HasSavedAccount), Mode=OneWay}"
                                 PlaceholderText="{x:Bind ViewModel.PasswordPlaceholder, Mode=OneWay}"
                                 PasswordChanged="OnPasswordChanged"/>
                    <Button x:Name="NwwsPasswordEditButton" Width="{StaticResource WireButtonWidth}"
                            HorizontalAlignment="Right" VerticalAlignment="Stretch" CornerRadius="0,4,4,0"
                            Content="{x:Bind ViewModel.PasswordEditLabel, Mode=OneWay}" Click="OnEditPasswordClick"
                            IsEnabled="{x:Bind ViewModel.IsNwws, Mode=OneWay}"
                            Visibility="{x:Bind Shown(ViewModel.HasSavedAccount, x:True), Mode=OneWay}"/>
                </Grid>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow AboutKey="wire.account" HintSpansDefault="True"
                                     Hint="{x:Bind AccountHint(ViewModel.IsNwws, ViewModel.AccountHint), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="NwwsAccountDetailsButton" Width="{StaticResource WireButtonWidth}"
                            Content="{x:Bind ViewModel.DetailsButtonLabel, Mode=OneWay}" Click="OnDetailsClick"
                            Visibility="{x:Bind Shown(ViewModel.HasSavedAccount, x:True), Mode=OneWay}"
                            ToolTipService.ToolTip="What's saved and where — never the password"/>
                    <Button x:Name="NwwsTestConnectionButton" Width="{StaticResource WireButtonWidth}"
                            Content="Test connection" Click="OnTestConnectionClick"
                            IsEnabled="{x:Bind Both(ViewModel.IsNwws, ViewModel.CanTest), Mode=OneWay}"
                            ToolTipService.ToolTip="Signs in to NOAA Weather Wire and straight back out — changes nothing"/>
                    <Button x:Name="NwwsSaveAccountButton" Width="{StaticResource WireButtonWidth}"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Save account" Click="OnSaveAccountClick"
                            IsEnabled="{x:Bind Both(ViewModel.IsNwws, ViewModel.CanSave), Mode=OneWay}"
                            ToolTipService.ToolTip="Saves the password in Windows Credential Manager and connects"/>
                </StackPanel>
            </prim:SettingsConsoleRow>

            <!-- Account details: facts, never the password. -->
            <prim:SettingsConsoleRow AboutKey="wire.details" TextVerticalAlignment="Top"
                                     Visibility="{x:Bind Shown(ViewModel.IsDetailsOpen, x:True), Mode=OneWay}">
                <Border x:Name="NwwsAccountDetailsWell" Padding="14,12" CornerRadius="6" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SettingsConsoleHintTextStyle}" Text="Account"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}" IsTextSelectionEnabled="True"
                                   Text="{x:Bind ViewModel.SavedUsername, Mode=OneWay}"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="Password"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyTextStyle}" Text="Saved · never shown in Anvil"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="Stored in"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                                   Text="{x:Bind ViewModel.DetailsStoredIn, Mode=OneWay}"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="Server"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource BodyTextStyle}" Text="{x:Bind ViewModel.DetailsServer, Mode=OneWay}"/>
                        <TextBlock Grid.Row="4" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="Connection"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                                   Text="{x:Bind ViewModel.DetailsConnection, Mode=OneWay}"/>
                        <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,4,0,0">
                            <HyperlinkButton x:Name="NwwsOpenCredentialManagerLink" Padding="0" Content="Open Credential Manager"
                                             Click="OnOpenCredentialManagerClick"
                                             ToolTipService.ToolTip="Windows shows the password there, after your Windows sign-in"/>
                            <Button x:Name="NwwsForgetAccountButton" HorizontalAlignment="Right"
                                    Style="{StaticResource CautionResetButtonStyle}" Content="Forget account…"
                                    Click="OnForgetAccountClick"
                                    ToolTipService.ToolTip="Removes the password and user name, and signs out"/>
                        </Grid>
                    </Grid>
                </Border>
            </prim:SettingsConsoleRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
