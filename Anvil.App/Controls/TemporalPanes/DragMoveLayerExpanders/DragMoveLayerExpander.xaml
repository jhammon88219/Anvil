<?xml version="1.0" encoding="utf-8"?>
<!-- DragMoveLayerExpander — ONE MAP LAYER in a temporal window (Now / Past / Fore): a 28 px header over a
     collapsible body, dragged by its grip to re-order. Its place in the window's LAYER STACK is the layer's
     place in the map's z-order (top of list = top of map). The temporal windows use ONLY this; the Settings
     tabs use Primitives/SettingsExpander (same header metrics, no grip, no opacity, never re-orders).

      ┌──────────────────────────────────────────────────────────────┐
      │ ⠿  ›  [x]  Warnings        ────────────●──────────   100%    │  ← 28 px header, raised face
      ├──────────────────────────────────────────────────────────────┤
      │   …Body…                                                     │  ← body on the window's ground
      └──────────────────────────────────────────────────────────────┘
        │  │   │    │                │                       │
        │  │   │    │                │                       └ readout, 44 px reserved (never resizes)
        │  │   │    │                └ ShowOpacity: the layer's opacity, IN THE HEADER — live while closed
        │  │   │    └ title: FIXED 118 px when a slider follows, so sliders line up down the window
        │  │   └ ShowCheckBox: the layer's show/hide or select-all (IsChecked ONE-WAY, CheckBoxClick → VM)
        │  └ chevron: expand / collapse (hidden when there is no Body; the column stays)
        └ grip: drag to re-order — ALWAYS there (LayerId is required)

       ⚠️ NO SUBTITLE (removed 2026-10-21): it made that row's slider shorter. Every slider is the same length; a
       section's own note goes in its BODY — its card's right side (Short Range's "Next 18 hr · CAM").

       GHOST ROW (IsGhost: another window's layer, for ordering this window's around it — NowCast ⇄ ForeCast)
      ┌──────────────────────────────────────────────────────────────┐
      │ ⠿     ░░  ░SPC outlook · ForeCast░  ░░░░░░░░░░░░░░░░░░  ░░░  │  ← everything but the GRIP at 25%,
      └──────────────────────────────────────────────────────────────┘    inert; no Body. Drag is all it does.

     ⚠️ ONE GRID, EVERY CELL VerticalAlignment=Center. No cell may carry a vertical margin or a minimum height
     (the stock CheckBox's 32 and Slider's 32 are both overridden below). Height = Styles.xaml
     SectionHeaderHeight, app-wide — SettingsExpander reads the same key.
     ⚠️ LIVES ONLY IN A TemporalPanes/DragMoveLayerExpanders/DragMoveLayerExpanderHost — the host owns the drag (bounds, slots, the final
     move), Reordered, the saved order and the open/closed persistence; the grip only reports press / move /
     release to it. Outside a host the grip does nothing.
     ⚠️ THE GRIP IS THE ONLY DRAG HANDLE. The header already takes three gestures (click = expand, the box,
     the slider); a whole-header drag would fight all of them. Keyboard: Alt+Up/Down anywhere in the expander.
     ⚠️ Clicking the header toggles, but NOT when the click lands on the grip, box, slider or chevron.
     ⚠️ Header brushes are {ThemeResource} in VISUAL STATES (Normal / PointerOver / Lifted), never resolved
     in code — see CLAUDE.md.
     ⚠️ LAZY BODY: a never-opened expander's body is NOT in the live tree (it attaches on the first expand and
     stays). Code that needs a body's elements loaded must expand it first. -->

<UserControl x:Class="Anvil.Controls.TemporalPanes.DragMoveLayerExpanders.DragMoveLayerExpander"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tp="using:Anvil.Controls.TemporalPanes"
             xmlns:dragMoveLayerExpanders="using:Anvil.Controls.TemporalPanes.DragMoveLayerExpanders"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch"
             IsTabStop="False">

    <Border x:Name="Frame"
            CornerRadius="4" BorderThickness="1"
            BorderBrush="{ThemeResource SectionBorderBrush}"
            Background="{ThemeResource SectionBodyBackground}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeaderStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="HeaderRow.Background" Value="{ThemeResource SectionHeaderPointerOverBackground}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Lifted">
                    <VisualState.Setters>
                        <Setter Target="HeaderRow.Background" Value="{ThemeResource SectionHeaderLiftedBackground}"/>
                        <Setter Target="Frame.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- header -->
                <RowDefinition Height="Auto"/> <!-- body -->
            </Grid.RowDefinitions>

            <!-- Padding 2 left: the grip column brings its own left air. -->
            <Grid x:Name="HeaderRow" Grid.Row="0"
                  Height="{StaticResource SectionHeaderHeight}"
                  Padding="2,0,10,0"
                  CornerRadius="{x:Bind HeaderCorners(IsExpanded, Body), Mode=OneWay}"
                  Background="{ThemeResource SectionHeaderBackground}"
                  PointerEntered="OnHeaderPointerEntered"
                  PointerExited="OnHeaderPointerExited"
                  Tapped="OnHeaderTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/> <!-- grip -->
                    <ColumnDefinition Width="24"/> <!-- chevron -->
                    <ColumnDefinition Width="{x:Bind BoxWidth(ShowCheckBox), Mode=OneWay}"/>
                    <ColumnDefinition Width="{x:Bind TitleWidth(ShowOpacity), Mode=OneWay}"/>
                    <ColumnDefinition Width="{x:Bind SliderWidth(ShowOpacity), Mode=OneWay}"/>
                    <ColumnDefinition Width="{x:Bind PercentWidth(ShowOpacity), Mode=OneWay}"/>
                </Grid.ColumnDefinitions>

                <!-- The grip: six dots, drawn rather than a glyph so it can't come out as a missing-glyph box. -->
                <Grid x:Name="Grip" Grid.Column="0"
                      Background="Transparent"
                      PointerEntered="OnGripPointerEntered"
                      PointerExited="OnGripPointerExited"
                      PointerPressed="OnGripPressed"
                      PointerMoved="OnGripMoved"
                      PointerReleased="OnGripReleased"
                      PointerCaptureLost="OnGripCaptureLost"
                      ToolTipService.ToolTip="Drag to re-order (Alt+Up / Alt+Down)">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                          ColumnSpacing="3" RowSpacing="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="3"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="3"/>
                        </Grid.RowDefinitions>
                        <Ellipse Grid.Row="0" Grid.Column="0" Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <Ellipse Grid.Row="0" Grid.Column="1" Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <Ellipse Grid.Row="1" Grid.Column="0" Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <Ellipse Grid.Row="1" Grid.Column="1" Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <Ellipse Grid.Row="2" Grid.Column="0" Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <Ellipse Grid.Row="2" Grid.Column="1" Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </Grid>
                </Grid>

                <Button x:Name="ChevronButton" Grid.Column="1"
                        Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" CornerRadius="4"
                        Visibility="{x:Bind ChevronVisibility(Body), Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ChevronName(Header, IsExpanded), Mode=OneWay}"
                        Click="OnChevronClick">
                    <FontIcon Glyph="&#xE76C;" FontSize="10"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="{x:Bind ChevronAngle(IsExpanded), Mode=OneWay}"/>
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Button>

                <!-- ⚠️ Width/Height 20 and MinWidth/MinHeight 0: the stock CheckBox is 120 x 32. -->
                <CheckBox x:Name="HeaderBox" Grid.Column="2"
                          Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Visibility="{x:Bind BoolVisibility(ShowCheckBox), Mode=OneWay}"
                          Opacity="{x:Bind GhostDim(IsGhost), Mode=OneWay}"
                          IsHitTestVisible="{x:Bind NotGhost(IsGhost), Mode=OneWay}"
                          IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                          IsEnabled="{x:Bind IsCheckBoxEnabled, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind CheckBoxName(Header), Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind CheckBoxToolTip, Mode=OneWay}"
                          Click="OnHeaderBoxClick"/>

                <!-- Title only (no subtitle: it shortened that row's slider — removed 2026-10-21; a section's
                     own note goes in its body, under the card). -->
                <TextBlock Grid.Column="3" Text="{x:Bind Header, Mode=OneWay}"
                           FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Opacity="{x:Bind GhostDimUnless(IsEnabled, IsGhost), Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                <!-- ⚠️ The three keys below take the stock Slider from 32 px tall to its 18 px thumb, so it
                     centres in the header like everything else. They are read by the Slider's own template
                     through {ThemeResource}, which finds them here first. -->
                <Slider x:Name="OpacitySlider" Grid.Column="4"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        Minimum="0" Maximum="1"
                        StepFrequency="0.05" SmallChange="0.05" LargeChange="0.1"
                        IsThumbToolTipEnabled="False"
                        Visibility="{x:Bind BoolVisibility(ShowOpacity), Mode=OneWay}"
                        Opacity="{x:Bind GhostDim(IsGhost), Mode=OneWay}"
                        IsHitTestVisible="{x:Bind NotGhost(IsGhost), Mode=OneWay}"
                        IsEnabled="{x:Bind IsOpacityEnabled, Mode=OneWay}"
                        Value="{x:Bind OpacityValue, Mode=TwoWay}"
                        AutomationProperties.Name="{x:Bind OpacityName(Header), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind OpacityToolTip, Mode=OneWay}">
                    <Slider.Resources>
                        <x:Double x:Key="SliderHorizontalHeight">18</x:Double>
                        <x:Double x:Key="SliderPreContentMargin">7</x:Double>
                        <x:Double x:Key="SliderPostContentMargin">7</x:Double>
                    </Slider.Resources>
                </Slider>

                <!-- The readout formats OpacityValue — the VIEW MODEL's number, the one on the map. -->
                <TextBlock Grid.Column="5" Style="{StaticResource TabularNumberTextStyle}"
                           Text="{x:Bind Percent(OpacityValue), Mode=OneWay}"
                           Opacity="{x:Bind GhostDimUnless(IsOpacityEnabled, IsGhost), Mode=OneWay}"
                           Visibility="{x:Bind BoolVisibility(ShowOpacity), Mode=OneWay}"
                           FontSize="12" TextAlignment="Right" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>

            <Border Grid.Row="1"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource SectionBorderBrush}"
                    Padding="12"
                    Visibility="{x:Bind BodyVisibility(IsExpanded, Body), Mode=OneWay}">
                <!-- ⚠️ Stretch: ContentPresenter's default style is Left/Top, which would shrink every card,
                     slider and combo in the body to its own width.
                     ⚠️ LAZY BODY: the body joins the live tree on the FIRST expand and stays (PresentedBody) — a
                     never-opened expander's controls don't load or set up (the launch-window freeze, 2026-10-10). -->

                <ContentPresenter Content="{x:Bind PresentedBody(IsExpanded, Body), Mode=OneWay}"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                  HorizontalContentAlignment="Stretch"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
