<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Anvil.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anvil"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:Anvil.Models"
    xmlns:vm="using:Anvil.ViewModels"
    xmlns:ctl="using:Anvil.Controls"
    xmlns:sections="using:Anvil.Controls.Sections"
    mc:Ignorable="d"
    Title="Anvil">

    <!-- The map fills the whole window; UI (the two bars + the floating windows) sits on top as an overlay,
         so showing/hiding either bar never changes the map's size.

         Three overlay rows:
           Row 0 — the GLOBAL TOP BAR. Controls that must NOT repeat per map pane (in the coming multi-pane
                   mode): the temporal mode toggles + the app-wide buttons (Sites, Settings, dev tools).
                   An OverlayBar with Edge=Top, so its pull-tab hangs BELOW it.
           Row 1 — EMPTY (the map shows through). Every panel that pops over the map is now a real top-level
                   OS window owned by WindowManager, so nothing floats in-window any more. The row remains
                   as the map's middle band, keeping the two bars pinned to the top and bottom edges.
           Row 2 — the PER-PANE BOTTOM BAR: the radar console (RadarControls). This is the bar that repeats
                   once per map pane in multi-pane mode, so ONLY the radar controls live here.
         The map spans all three rows, so the layer boundaries are invisible and cost the map nothing. -->
    <Grid Background="#FF0A0A0A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- global top bar (tab + bar), pinned to the top -->
            <RowDefinition Height="*"/>    <!-- empty middle band (the map shows through) -->
            <RowDefinition Height="Auto"/> <!-- per-pane bottom bar (tab + bar), pinned to the bottom -->
        </Grid.RowDefinitions>

        <!-- Full-window map (bottom layer; all UI overlays float on top of it). -->
        <controls:WebView2 x:Name="MainMapWebView" Grid.Row="0" Grid.RowSpan="3"/>

        <!-- ===== Row 0: the GLOBAL top bar. BarContent holds the app-level controls that don't repeat per
             pane — left: temporal split-toggles; right: Sites + Settings (+ dev tools). ===== -->
        <ctl:OverlayBar Grid.Row="0" Edge="Top">
            <ctl:OverlayBar.BarContent>
                <!-- Single overlay cell: temporal toggles float on the left edge, the app-wide buttons on the
                     right edge. No center content — the per-pane radar console lives in the bottom bar. -->
                <Grid>
                    <!-- Left: temporal split-toggles (feature + settings cog). -->
                    <sections:TemporalToggles HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              ViewModel="{x:Bind ViewModel}"/>
                    <!-- Right: the Radar Site Explorer button + the app-wide settings cog (+ dev buttons).
                         Sites sits LEFT of Settings. Each latches while its window is open. -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                Orientation="Horizontal" Spacing="10">
                        <!-- DEV-ONLY: opens the combined dev-tools window (site sweep + dealias validation).
                             Collapsed in Release via DevVisibility. -->
                        <StackPanel Orientation="Vertical" Spacing="5" Visibility="{x:Bind DevVisibility}">
                            <TextBlock Text="Dev" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="60" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <ToggleButton Width="40" Height="40" MinWidth="0" MinHeight="0" Padding="0"
                                          CornerRadius="6"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="18"
                                          Content="&#xE9F5;"
                                          ToolTipService.ToolTip="Dev tools — site sweep &amp; dealias validation"
                                          IsChecked="{x:Bind ViewModel.IsDevToolsWindowOpen, Mode=TwoWay}"/>
                        </StackPanel>
                        <!-- Map Controls window: basemap style + state isolation. Opens the window (latches
                             while open); the actual arm/pick controls live inside it. App-wide, so it sits here. -->
                        <StackPanel Orientation="Vertical" Spacing="5">
                            <TextBlock Text="Map" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="60" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <ToggleButton Width="40" Height="40" MinWidth="0" MinHeight="0" Padding="0"
                                          CornerRadius="6"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="18"
                                          Content="&#xE774;"
                                          ToolTipService.ToolTip="Map controls — basemap &amp; state isolation"
                                          IsChecked="{x:Bind ViewModel.IsMapControlsWindowOpen, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Spacing="5">
                            <TextBlock Text="Sites" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="60" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <ToggleButton Width="40" Height="40" MinWidth="0" MinHeight="0" Padding="0"
                                          CornerRadius="6"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="18"
                                          Content="&#xE81E;"
                                          ToolTipService.ToolTip="Radar site explorer"
                                          IsChecked="{x:Bind ViewModel.IsSiteExplorerOpen, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Spacing="5">
                            <TextBlock Text="Settings" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="60" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <ToggleButton Width="40" Height="40" MinWidth="0" MinHeight="0" Padding="0"
                                          CornerRadius="6"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="18"
                                          Content="&#xE713;"
                                          ToolTipService.ToolTip="App settings"
                                          IsChecked="{x:Bind ViewModel.IsSettingsWindowOpen, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ctl:OverlayBar.BarContent>
        </ctl:OverlayBar>

        <!-- ===== Row 1: EMPTY. Every panel that pops over the map (Past Event / Live Radar / SPC Outlooks /
             Map Controls / App Settings / Radar Site Explorer / Pipeline Console / dev tools) is hosted in
             its OWN top-level OS window by WindowManager (see MainWindow.xaml.cs), so a multi-monitor user
             can park them on a second screen. The top-bar toggles just flip the open flags; the manager
             opens/closes the windows. The row stays so the map (which RowSpans all three) keeps its
             full-window extent and the two bars stay pinned to the edges. ===== -->

        <!-- ===== Row 2: the PER-PANE bottom bar. Only the radar console lives here — it repeats once per
             map pane in multi-pane mode. It STRETCHES to full bar width and centers its own transport at
             window-center (its internal * | Auto | * grid does the centering). ===== -->
        <ctl:OverlayBar Grid.Row="2">
            <ctl:OverlayBar.BarContent>
                <sections:RadarControls HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        ViewModel="{x:Bind ViewModel.Radar}"/>
            </ctl:OverlayBar.BarContent>
        </ctl:OverlayBar>
    </Grid>
</Window>
