<?xml version="1.0" encoding="utf-8"?>
<!-- SettingsConsolePlate — the CASING every Settings section wears (2026-11-16, replacing SettingsExpander on each page as it
     is redone; Dev keeps its expanders). It draws only the outside; each section's rows are its OWN named control
     (e.g. AppearanceSettingsConsoles/AppearanceSettingsConsoleEdges) that wraps itself in one of these.

       ┌─────────────────────────────────────────────────────────────────────────────┐
       │ Edges   [Restore defaults]                                                   │ ← Title 28 SemiBold (line 34 — the Storage
       │                                                                     DEFAULT  │   total's size) · 15 px · HeaderContent
       │ Pattern   [Hatch|Dots]                                                 Hatch │ ← ShowDefaultHeader: the column title, ONCE,
       │ …                                                                       …    │   right-aligned over the rows' default column
       └─────────────────────────────────────────────────────────────────────────────┘
        face CardBackgroundFillColorDefaultBrush · hairline SectionBorderBrush · radius 6 · padding 14,12,14,14

     ⚠️ Pages space plates 12 apart on the body's darker ground — the gap IS the separator (no dividers, no expanders).
     ⚠️ Never collapses. A section's row grid is ITS OWN (label 96 · control ≤ 420 · default 150, right-aligned) — the
     plate only right-aligns "DEFAULT" to the same right edge, so it lines up whatever the rows' columns. -->
<UserControl x:Class="Anvil.Controls.Primitives.SettingsConsolePlate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Border x:Name="SettingsConsolePlateSurface" CornerRadius="6" BorderThickness="1" Padding="14,12,14,14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SectionBorderBrush}">
        <StackPanel>
            <StackPanel x:Name="SettingsConsolePlateTitleLine" Orientation="Horizontal" Spacing="15" Margin="0,0,0,12">
                <TextBlock x:Name="SettingsConsolePlateTitle" FontSize="28" FontWeight="SemiBold"
                           LineHeight="34" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"
                           Text="{x:Bind Title, Mode=OneWay}"/>
                <ContentPresenter x:Name="SettingsConsolePlateHeaderContent" VerticalAlignment="Center"
                                  Content="{x:Bind HeaderContent, Mode=OneWay}"/>
            </StackPanel>

            <TextBlock x:Name="SettingsConsolePlateDefaultHeader" Text="DEFAULT" HorizontalAlignment="Right"
                       FontSize="11" CharacterSpacing="60" Margin="0,0,0,4"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind Show(ShowDefaultHeader), Mode=OneWay}"/>

            <ContentPresenter x:Name="SettingsConsolePlateBody" Content="{x:Bind Body, Mode=OneWay}"/>
        </StackPanel>
    </Border>
</UserControl>
