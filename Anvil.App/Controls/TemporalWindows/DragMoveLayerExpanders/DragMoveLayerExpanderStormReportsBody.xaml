<?xml version="1.0" encoding="utf-8"?>
<!-- DragMoveLayerExpanderStormReportsBody — the SPC storm-reports verification controls: a card, one row per report type, and
     fill opacity. Reused in BOTH temporal windows: in the Past window it shows the replay day's reports, in
     the Now window today's — the VM keys the overlay to the active convective day, so the same controls
     serve both.

     ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓   the card (DragMoveLayerExpanderHeaderCard, FLUSH
     ▓  448 reports              May 20, 2013 · 12Z-12Z ▓   under the header, ONE line): total left, which
                                                            convective day right (loading/failure take that slot)
     ──────────────────────────────────────────────────────
       [x] ■ Tornado                                42  ← one DragMoveLayerExpanderCountRow per type: the toggle,
       [x] ■ Wind                                  310    the SPC colour (a rounded square, like the warnings'),
       [x] ■ Hail                                   96    the name and that type's count at the FAR RIGHT
       ────────────────────────────────────────────────
       ● 20:49Z  3 SSW Ash Valley, KS            EF2    ← THE LIST: the TICKED types' reports, newest
       ● 18:12Z  Wichita, KS                  65 mph      first; click a row → fly there + open the
       ● 16:00Z  2 SW Rock Harbor, FL                     dot's popup. Capped at 240 px, scrolls.

     ⚠️ OPACITY IS NOT HERE — it lives in the host's section header (DragMoveLayerExpander ShowOpacity), so it can be
     set with the section closed.

     ⚠️ THE SWATCHES USED TO BE DRAWN TWICE. There was a toggle row (three checkboxes, each with a coloured
     dot and a name) and a separate Count row that repeated all three dots with numbers beside them — the
     same three colours and the same three types, listed twice, one row apart. Merging them is most of what
     this layout is: a type is one line, and its count sits on the line that switches it.

     ⚠️ THE CARD'S HEADLINE IS A TOTAL THE ROWS BELOW ALSO BREAK DOWN, which is a genuine redundancy and was
     chosen anyway — see the ⚠️ on the card region in StormReportsViewModel. If it ever reads as noise the
     honest fix is to drop the card, not to invent a different number for it.

     ⚠️ THE SECTION HEADING IS NOT HERE — each host window draws its own (TemporalWindowPastCastContent / TemporalWindowNowCastContent) above
     this control. The window owns its section structure; this is content. That is also why there is no
     divider in here.

     ⚠️ THE COUNTS POPULATE WITH EVERY BOX UNCHECKED, which is the whole reason the card is worth having.
     The fetch used to be gated on something being shown, so the numbers sat at zero until you ticked a box
     — they read as broken data rather than as an empty filter. They describe the DAY now; the checkboxes
     only decide what is drawn. (The card's "None shown" footer was REMOVED 2026-10-10, the user's call: a
     section's height must not change with what you tick — the unticked boxes say it instead.)

     ⚠️ IN PASTCAST THEY POPULATE AFTER *LOAD*, NOT ON A DATE CHANGE. The VM keys off the LOADED replay
     window, not the pickers — between editing a date and pressing Load the two describe different days, and
     counting the pending one meant the card reported a day that was not on the map.

     A [label | control] grid, one row per field, matching the picker rows in the sections above. Bound to
     StormReportsViewModel. -->
<UserControl x:Class="Anvil.Controls.TemporalWindows.DragMoveLayerExpanders.DragMoveLayerExpanderStormReportsBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tw="using:Anvil.Controls.TemporalWindows"
             xmlns:dragMoveLayerExpanders="using:Anvil.Controls.TemporalWindows.DragMoveLayerExpanders"
             xmlns:local="using:Anvil.Controls.Composites"
             xmlns:models="using:Anvil.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- A report row: tight (the stock 40 px row would show five reports), full-width, left-aligned. -->
        <Style x:Key="ReportRowContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- the card (its bottom edge is the rule) -->
            <RowDefinition Height="Auto"/> <!-- the three type rows -->
            <RowDefinition Height="Auto"/> <!-- the report list -->
        </Grid.RowDefinitions>

        <!-- THE CARD, flush under the section header (DragMoveLayerExpanderHeaderCard — every expander's top
             card; its bottom edge is the rule). Like the outlook's
             it is a RESULT — there is no action here, the dots appear as you switch types on — so it
             carries no button. -->
        <dragMoveLayerExpanders:DragMoveLayerExpanderHeaderCard Grid.Row="0"
                Headline="{x:Bind ViewModel.CardHeadline, Mode=OneWay}"
                Context="{x:Bind ViewModel.CardContext, Mode=OneWay}"
                Footer="{x:Bind ViewModel.CardFooter, Mode=OneWay}"/>

        <!-- One DragMoveLayerExpanderCountRow per type (every expander's row: count at the far right, hover lift).
             The swatch is the warnings' rounded square (the user's call, 2026-10-21 — was a round dot).
             ⚠️ The swatch colours are the SPC report colours the map draws (storm-reports.js): tornado red,
             wind blue, hail green. They are literals in both places — change one, change the other. -->
        <StackPanel Grid.Row="1" Spacing="4">
            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="Tornado"
                    IsChecked="{x:Bind ViewModel.ShowTornado, Mode=TwoWay}"
                    Count="{x:Bind Fmt(ViewModel.TornadoCount), Mode=OneWay}"
                    ToolTipService.ToolTip="Show tornado reports">
                <Border Width="11" Height="11" CornerRadius="2" Background="#E51919"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>
            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="Wind"
                    IsChecked="{x:Bind ViewModel.ShowWind, Mode=TwoWay}"
                    Count="{x:Bind Fmt(ViewModel.WindCount), Mode=OneWay}"
                    ToolTipService.ToolTip="Show wind reports">
                <Border Width="11" Height="11" CornerRadius="2" Background="#1663D8"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>
            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="Hail"
                    IsChecked="{x:Bind ViewModel.ShowHail, Mode=TwoWay}"
                    Count="{x:Bind Fmt(ViewModel.HailCount), Mode=OneWay}"
                    ToolTipService.ToolTip="Show hail reports">
                <Border Width="11" Height="11" CornerRadius="2" Background="#18A020"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>
        </StackPanel>

        <!-- THE REPORT LIST: every report of the TICKED types, newest first (VisibleReports). Click a row → the map
             flies there and opens that dot's popup (ViewModel.FlyTo). Collapses when empty.
             ⚠️ A ListView with a MaxHeight: bounded, so it virtualizes even inside the window's PanelScroller (an
             UNBOUNDED list nested in a ScrollViewer un-virtualizes — a 400-report day would build 400 rows).
             ⚠️ SelectionMode None + ItemClick: a click ACTS (flies), it isn't a selection to keep in step. -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0"
                    Visibility="{x:Bind Shown(ViewModel.HasVisibleReports), Mode=OneWay}">
            <Border Height="1" Margin="0,0,0,8"
                    Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
            <ListView MaxHeight="240"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnReportClick"
                      ItemsSource="{x:Bind ViewModel.VisibleReports, Mode=OneWay}"
                      ItemContainerStyle="{StaticResource ReportRowContainerStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:StormReportItem">
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="Fly to this report">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- the type dot -->
                                <ColumnDefinition Width="46"/>    <!-- 20:49Z -->
                                <ColumnDefinition Width="*"/>     <!-- 3 SSW Ash Valley, KS -->
                                <ColumnDefinition Width="Auto"/>  <!-- EF2 / 65 mph / 1.75 in -->
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{x:Bind dragMoveLayerExpanders:DragMoveLayerExpanderStormReportsBody.KindBrush(Kind)}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind TimeText}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind Place}" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind MagText}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</UserControl>
