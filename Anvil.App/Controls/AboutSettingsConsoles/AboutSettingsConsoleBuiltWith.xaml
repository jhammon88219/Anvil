<?xml version="1.0" encoding="utf-8"?>
<!-- AboutSettingsConsoleBuiltWith — Settings → About → Built with (artboard 27): the open-source work Anvil stands on.

       ┌ Built with ───────────────────────────────────────────────┐
       │ MapLibre GL JS ↗                                   the map │   ← AboutSettingsConsoleLinkRow: the NAME is the
       │ PMTiles ↗                             the offline map file │     link (its GitHub page, where its license
       │ …                                                          │     lives); what it does at the far right
       └────────────────────────────────────────────────────────────┘
     ⚠️ A new dependency adds its row here (and README.md). -->
<UserControl x:Class="Anvil.Controls.AboutSettingsConsoles.AboutSettingsConsoleBuiltWith"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:local="using:Anvil.Controls.AboutSettingsConsoles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="AboutSettingsConsoleBuiltWithPlate" Title="Built with">
        <StackPanel>
            <local:AboutSettingsConsoleLinkRow Title="MapLibre GL JS" What="the map" Url="https://github.com/maplibre/maplibre-gl-js"/>
            <local:AboutSettingsConsoleLinkRow Title="PMTiles" What="the offline map file" Url="https://github.com/protomaps/PMTiles"/>
            <local:AboutSettingsConsoleLinkRow Title="nexrad-level-2-data" What="radar decoding" Url="https://github.com/netbymatt/nexrad-level-2-data"/>
            <local:AboutSettingsConsoleLinkRow Title="Py-ART" What="velocity dealiasing (ported)" Url="https://github.com/ARM-DOE/pyart"/>
            <local:AboutSettingsConsoleLinkRow Title="seek-bzip" What="decompression" Url="https://github.com/cscott/seek-bzip"/>
            <local:AboutSettingsConsoleLinkRow Title="SharpCompress" What="decompression" Url="https://github.com/adamhathcock/sharpcompress"/>
            <local:AboutSettingsConsoleLinkRow Title="CommunityToolkit" What="app plumbing" Url="https://github.com/CommunityToolkit/dotnet"/>
            <local:AboutSettingsConsoleLinkRow Title="Serilog" What="logging" Url="https://github.com/serilog/serilog"/>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
