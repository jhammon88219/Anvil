<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     OverlayBar — a CHROME-ONLY shell: a theme-aware surface with a hairline border along the edge
     it attaches to, an optional show/hide pull-tab, and the collapse behavior. It is a content
     slot: the host fills BarContent with the actual controls, so section content is composed by
     the host, never here.

     TWO SHAPES, ONE CONTROL. Plain DPs move the geometry and the face; nothing else changes.
     Edge (which side the tab hangs off), IsIsland (does it span the host edge to edge, or is it a
     centred island that must draw its own left/right edges), ShowTabLabel (word beside the
     chevron, or chevron alone), ShowTab (does it draw a tab AT ALL), IsRaised (which tier's
     surface it wears). Every combination keeps the same surface, the same hairline rule and the
     same collapse, which is the whole reason there is not a second copy of this file for the
     notch. See the class remarks in the code-behind.

       Edge=Bottom, IsIsland=False — A FULL-WIDTH TIER OF THE BOTTOM CHROME

         …map, full height, showing through…
                              ╭── ˅ Hide ──╮                      ← the pull-tab, centered
       ───────────────────────┘            └───────────────────── ← ONE hairline: it runs along
                                                                    the tier's top edge and wraps
             BarContent — the HOST fills this slot                  AROUND the tab, never across
       ══════════════════════ window bottom ═══════════════════════

       Edge=Top, IsIsland=True — THE PANE NOTCH (one per map pane)

       ═══════════════════════ pane top edge ══════════════════════
                     ┌─────────────────────────┐   ← the island: it stops where its content
                     │  BarContent (the slot)  │     stops, so the map runs edge to edge
                     └──────╮ ˄ Hide ╭─────────┘     behind it. Left/right/bottom hairline,
                            ╰─────────╯              bottom corners rounded, tab BELOW.
            …the pane's map, showing through either side…

     ⚠️ THE TAB IS Primitives/OverlayBarTab, not drawn here, because it has a SECOND host: the
     bottom chrome is TWO of these stacked (map tools over the bar) and a tab drawn in row 0 of the
     lower one would land in the SEAM between them, unreachable. So MainWindow puts both tabs on
     one rail above the stack and both tiers run ShowTab=False. One tab, one definition, two kinds
     of host.
     ⚠️ CONSEQUENCE: with ShowTab=False this control does not own its own show/hide gesture — the
     rail's tab drives IsOverlayBarVisible from outside. The four pane notches are unaffected: they
     each still draw their own tab and own their own state, which is what gives them four
     independent toggles with no view-model plumbing at all.

     Hidden, only the tab remains (it reads "Show") and the bar Border collapses — the map is
     never resized either way, in either shape.

     It renders as an OVERLAY: the host places it over the full-height map, so showing/hiding
     never resizes the map. The control's own backdrop is transparent — only the tab and the
     bar draw — so the map shows through beside them.
     ============================================================================ -->
<UserControl x:Class="Anvil.Controls.Primitives.OverlayBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- Transparent root: only the tab + bar draw, so the map shows through beside the tab.
         This control is ONLY the chrome (tab + bar). Nothing floats above it in-window: every app-wide
         panel (the three temporal windows, App Settings, Site Explorer, the Pipeline Console) is a real
         top-level OS window owned by WindowManager. -->
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <!-- Which tier's surface this bar wears. Driven from code by IsRaised.
                 ⚠️ A {ThemeResource} IN A SETTER, never a C# resource lookup: a lookup resolves against
                 the OS theme rather than the theme the app pinned on its root element, and hands back the
                 other theme's brush. See the theming gotcha in CLAUDE.md. -->
            <VisualStateGroup x:Name="SurfaceStates">
                <VisualState x:Name="GroundSurface"/>
                <VisualState x:Name="RaisedSurface">
                    <VisualState.Setters>
                        <Setter Target="BarBorder.Background" Value="{ThemeResource OverlayBarSurfaceRaisedBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- pull-tab -->
            <RowDefinition Height="Auto"/> <!-- overlay bar (collapses when hidden) -->
        </Grid.RowDefinitions>

        <!-- The bar itself: a content slot the host fills (see BarContent). Collapses when hidden. Its
             hairline and the tab's three-sided border share ONE brush and merge where the two meet, so the
             line runs along the bar's edge and wraps AROUND the tab (never through it). -->
        <Border x:Name="BarBorder"
                Grid.Row="1"
                Background="{ThemeResource OverlayBarSurfaceBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{x:Bind VisibleWhen(IsOverlayBarVisible), Mode=OneWay}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                Padding="16,10">   <!-- overwritten by ApplyChrome; an island is tighter -->
            <ContentPresenter HorizontalAlignment="Stretch"
                              Content="{x:Bind BarContent, Mode=OneWay}"/>
        </Border>

        <!-- The pull-tab. Collapsed entirely when the host owns the tab instead (ShowTab=False, which is
             how the bottom chrome stacks two of these under one shared rail). -->
        <prim:OverlayBarTab x:Name="Tab"
                            Grid.Row="0"
                            IsShown="{x:Bind IsOverlayBarVisible, Mode=TwoWay}"
                            ShowLabel="{x:Bind ShowTabLabel, Mode=OneWay}"/>
    </Grid>
</UserControl>
