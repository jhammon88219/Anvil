<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalToggles — the PastCast / NowCast / ForeCast modes as three PLAIN bar keys: on/off, nothing else.

       ┌ left temporal pane (480) ─────────────────────────────┐
       [ Search places ✕ ⌕ ]  ⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙        (▣) (⊚)┊   ← the tools tier, above: it ends on the same edge
       ┌──────────┐                        ┌──────────┐ ┌──────────┐┊   ┐
       │    ↺     │  ⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙   │   ((•))  │ │    ☁     │┊   │ each key is the bar's shared square
       │ PastCast │  ⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙   │ NowCast  │8│ ForeCast │┊   │ (BarKeySide) on BarKeyToggleStyle — the
       │          │  ⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙⁙   │          │ │          │┊   │ same look as Atlas and Settings
       └──────────┘ ↑ TemporalKeysSpacer   └──────────┘ └──────────┘┊   ┘
                        (stretches)                                ↑ the pane's INNER edge (480)
            ^              ^              ^
            │              │              └── SPC outlooks + forecast models
            │              └── live radar / current alerts
            └── historical replay

     ⚠️ A KEY ONLY TOGGLES ITS MODE (Temporal Panes spec, 2026-10-28): lit = this mode is on the map; click a lit one to
     turn it off. It never opens, closes or resizes a pane — a mode's pane simply follows the mode
     (MapViewModel "The three temporal panes"). Past excludes Now + Fore; Now and Fore coexist.
     ⚠️ THE DOT (2026-11-01):  ┌──────────●┐  a lit key with a dot = the mode RUNS but its pane is HIDDEN (top bar →
                               │  ((•))    │  View). The pane is shown/hidden ONLY from View; the key still only turns
                               │ NowCast   │  the mode on/off (on opens the pane again).
                               └───────────┘
     HISTORY, do not undo: each key used to be SPLIT (Primitives/SplitTemporalToggle, deleted) — a mode square plus a
     3-dot SIDE CAR that latched the mode's window. The panes made the car pointless (a pane comes with its mode), and
     the car made the keys wider and harder to read.
     Don't re-add a second control to these keys.

     A MODE key is a GLYPH OVER A NAME and nothing else — a mode switch, not a readout. (A third line of live status
     was built and removed: it made the keys read as dashboard tiles.) Glyphs were picked by rendering candidates in
     the actual font — a wrong codepoint ships as an empty box, so verify visually before swapping one.

     ⚠️ IsChecked is ONE-WAY to the mode projection and the click goes through MapViewModel.ToggleTemporalMode, which
     re-raises the mode; the handler also re-asserts the key (a ToggleButton flips itself before Click, and a mode
     that declines the change would otherwise leave it lying — the Atlas key's rule).

     SIZING — none here: BarKeyToggleStyle and Styles.xaml's SIZES section (BarKeySide, the glyph and name sizes).
     Bound to the coordinator MapViewModel. -->
<UserControl x:Class="Anvil.Controls.Composites.TemporalToggles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- The HIDDEN-PANE DOT (2026-11-01): the mode runs but its pane is hidden from the top bar's View menu. It sits at
             the content's top-right, out over the key's corner; spans both rows so it never moves the glyph or the name. -->
        <Style x:Key="TemporalKeyHiddenDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Grid.RowSpan" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,-8,-10,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- ⚠️ THE ROW ENDS ON THE LEFT TEMPORAL PANE'S INNER EDGE (the user's call, 2026-10-22): PastCast at the bar's
         left edge, ForeCast's right edge on the pane's inner edge, and TemporalKeysSpacer (a stretching dot grid)
         between PastCast and NowCast takes the slack — PastCast runs alone, Now + Fore run together, so the gap reads.
         Its width is MEASURED (AlignToWindowEdge, from MainWindow); the keys never resize. -->
    <Grid x:Name="PillRow"
          VerticalAlignment="Center"
          ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/> <!-- the spacer -->
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- PASTCAST — glyph E81C, a clock with a counter-clockwise arrow: history/rewind. -->
        <ToggleButton x:Name="PastKey"
                      Grid.Column="0"
                      Style="{StaticResource BarKeyToggleStyle}"
                      ToolTipService.ToolTip="PastCast — replay a historical radar window (click again to turn it off)"
                      IsChecked="{x:Bind ViewModel.IsPastCast, Mode=OneWay}"
                      Click="OnPastClick">
            <Grid Margin="3,0" RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <FontIcon Grid.Row="0" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                          FontSize="{StaticResource BarKeyGlyphSize}" Glyph="&#xE81C;"/>
                <TextBlock Grid.Row="1" FontSize="{StaticResource BarKeyNameSize}" Text="PastCast" HorizontalAlignment="Center"/>
                <Ellipse x:Name="PastKeyHiddenDot" Style="{StaticResource TemporalKeyHiddenDotStyle}"
                         Visibility="{x:Bind VisibleWhen(ViewModel.IsPastPaneHidden), Mode=OneWay}"/>
            </Grid>
        </ToggleButton>

        <!-- The stretching spacer (see above). Width SET IN CODE; 10 is only the pre-layout value. -->
        <prim:MapControlsStripSeparator x:Name="TemporalKeysSpacer"
                                        Grid.Column="1"
                                        Margin="8,0"
                                        FillWidth="True"
                                        Width="10"/>

        <!-- NOWCAST — glyph E93E, a dot radiating signal waves: live. Deliberately NOT the tower (EC05),
             which reads as "a radar site" and would collide with the on-map site markers' language. -->
        <ToggleButton x:Name="NowKey"
                      Grid.Column="2"
                      Style="{StaticResource BarKeyToggleStyle}"
                      ToolTipService.ToolTip="NowCast — live radar / current conditions (click again to turn it off)"
                      IsChecked="{x:Bind ViewModel.IsNowCast, Mode=OneWay}"
                      Click="OnNowClick">
            <Grid Margin="3,0" RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <FontIcon Grid.Row="0" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                          FontSize="{StaticResource BarKeyGlyphSize}" Glyph="&#xE93E;"/>
                <TextBlock Grid.Row="1" FontSize="{StaticResource BarKeyNameSize}" Text="NowCast" HorizontalAlignment="Center"/>
                <Ellipse x:Name="NowKeyHiddenDot" Style="{StaticResource TemporalKeyHiddenDotStyle}"
                         Visibility="{x:Bind VisibleWhen(ViewModel.IsNowPaneHidden), Mode=OneWay}"/>
            </Grid>
        </ToggleButton>

        <!-- FORECAST — glyph E753, a cloud: the weather-outlook idiom. -->
        <ToggleButton x:Name="ForeKey"
                      Grid.Column="3"
                      Style="{StaticResource BarKeyToggleStyle}"
                      ToolTipService.ToolTip="ForeCast — SPC outlooks and forecast models (click again to turn it off)"
                      IsChecked="{x:Bind ViewModel.IsForeCast, Mode=OneWay}"
                      Click="OnForeClick">
            <Grid Margin="3,0" RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <FontIcon Grid.Row="0" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                          FontSize="{StaticResource BarKeyGlyphSize}" Glyph="&#xE753;"/>
                <TextBlock Grid.Row="1" FontSize="{StaticResource BarKeyNameSize}" Text="ForeCast" HorizontalAlignment="Center"/>
                <Ellipse x:Name="ForeKeyHiddenDot" Style="{StaticResource TemporalKeyHiddenDotStyle}"
                         Visibility="{x:Bind VisibleWhen(ViewModel.IsForePaneHidden), Mode=OneWay}"/>
            </Grid>
        </ToggleButton>
    </Grid>
</UserControl>
