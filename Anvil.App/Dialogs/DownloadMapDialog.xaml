<?xml version="1.0" encoding="utf-8"?>
<!-- DownloadMapDialog — Settings → Storage → Which map to use → "Download a map…": EVERY offline-download option, shown only
     when you're about to download (2026-11-19, canvas "Storage page — fewer plates"; it replaced the Offline map plate).

       ┌─ Download an offline map ──────────────────────────────────┐
       │ Pick the areas and the detail. It downloads in the          │
       │ background; your current map stays until you switch.        │
       │ AREAS      [x] Lower 48 states   155 radars …               │ ← Basemaps/BasemapAreaChecklist (shared with setup)
       │ DETAIL     [ Standard | Full ]   Streets at city zoom · …   │ ← SizeSummaryText follows the ticks
       │ SAVE TO    C:\Users\you\Anvil Maps            [Browse…]     │
       │            anvil-l48-ak.pmtiles · 212.3 GB free             │ ← PlannedFileName (+ DuplicateNote)
       │                                  [ Download ] ( Cancel )    │ ← Download greys until an area is ticked
       └─────────────────────────────────────────────────────────────┘

     ⚠️ Download STARTS the job (BasemapSetupViewModel.StartDownload) and the dialog closes — the progress / Cancel / Retry rows
     live on the Which map to use plate, under the files. Cancel changes nothing but the picks (they're the VM's, kept).
     ⚠️ ViewModel is set BEFORE InitializeComponent (x:Bind). A ContentDialog can't open another (Browse… is a picker, fine). -->
<ContentDialog x:Class="Anvil.Dialogs.DownloadMapDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:prim="using:Anvil.Controls.Primitives"
               xmlns:basemaps="using:Anvil.Controls.Basemaps"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d"
               Title="Download an offline map"
               PrimaryButtonText="Download"
               CloseButtonText="Cancel"
               DefaultButton="Primary"
               IsPrimaryButtonEnabled="{x:Bind ViewModel.CanStartDownload, Mode=OneWay}"
               PrimaryButtonClick="OnDownloadClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <StackPanel x:Name="DownloadMapDialogBody" Spacing="6" MinWidth="540">
        <TextBlock Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Pick the areas and the detail. It downloads in the background; your current map stays until you switch."/>

        <TextBlock Style="{StaticResource OverlineTextStyle}" Text="AREAS"/>
        <basemaps:BasemapAreaChecklist x:Name="DownloadMapAreaChecklist" ViewModel="{x:Bind ViewModel}" Margin="0,0,0,8"/>

        <TextBlock Style="{StaticResource OverlineTextStyle}" Text="DETAIL"/>
        <prim:SegmentedPicker x:Name="DownloadMapDetailPicker" HorizontalAlignment="Left"
                              ItemsSource="{x:Bind ViewModel.DetailLabels}"
                              SelectedIndex="{x:Bind ViewModel.DetailIndex, Mode=TwoWay}"/>
        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.SizeSummaryText, Mode=OneWay}"/>

        <TextBlock Style="{StaticResource OverlineTextStyle}" Text="SAVE TO"/>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{x:Bind ViewModel.SaveFolder, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.SaveFolder, Mode=OneWay}"/>
            <Button x:Name="DownloadMapBrowseButton" Grid.Column="1" Content="Browse…" Click="OnBrowseClick"/>
        </Grid>
        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind FileLine(ViewModel.PlannedFileName, ViewModel.FreeSpaceText, ViewModel.DuplicateNote), Mode=OneWay}"/>
    </StackPanel>
</ContentDialog>
