<?xml version="1.0" encoding="utf-8"?>
<!-- SettingsWindow — ONE window for every setting, its pages picked from a LEFT NAV RAIL. Hosted in its own OS
     window by WindowManager (content extends into the caption), so there is no panel frame: the root is the
     dark surface, stretched to fill the window. Laid out like the Anvil Atlas on purpose (the user's call,
     2026-11-11): a raised title BAND, then the raised rail | the body.

       ┌──────────────────────────────────────────────────────────────────────────────────────┐
       │ [logo] Anvil Settings ←35→ VERSION │ BUILD   LICENSE   SOURCE    ░░░ lock pin ─ □ ✕ ░│ ← THE BAND (raised):
       │ (slot)                     1.0.0.0 │ Debug   AGPL-3.0  GitHub    ░ reserved 220 px ░ │   about-Anvil facts,
       ├──────────────────┬───────────────────────────────────────────────────────────────────┤   label OVER value
       │▌▓ ⛰  Map  ▓▓▓▓▓▓▓│  ┌────────────────────┐ ┌──────────────────────────┐              │
       │   ◎  Radar       │  │ the selected page's│ │  LIVE MAP PREVIEW        │              │ ← Composites/MapPreview,
       │   ⊙  Radar Range │  │ body — ONE fixed   │ │      ┌┄┄┄┄┄┄┐            │              │   only on Map + Radar
       │   ▤  Storage     │  │ 400 px column (one │ │     ┆   ╳   ┆    ◉       │              │   Range Ring
       │   …              │  │ UserControl per    │ │      └┄┄┄┄┄┄┘            │              │   (HasSettingsPreview)
       │ ──────────────── │  │ page, Composites)  │ │                          │              │
       │   ⚒  Dev         │  └────────────────────┘ └──────────────────────────┘              │
       └──────────────────┴───────────────────────────────────────────────────────────────────┘
        ↑ Primitives/TabStrip, 220 wide, raised, hairline on its right

     The top bar's Settings menu lists the SAME pages (MainWindow.xaml's SETTINGS MENU, one declared item per
     page, Tag = its index) — clicking one opens this window on it.

     A NEW GROUP OF SETTINGS IS A PAGE, NOT A WINDOW: add a SettingsTab enum member (never reorder — the ordinal
     is the persisted index — and add it BEFORE Dev, which must stay last), a TabEntry in BuildTabs (before the
     #if DEBUG block), a body UserControl in Composites at that index, AND its item in the top bar's Settings
     menu (same mark, same name).

     ⚠️ THE SELECTED PAGE IS NOT VIEW STATE. It lives on MapViewModel.SettingsTabIndex so it survives close/
     reopen, persists across launches, and can be targeted from anywhere via MapViewModel.OpenSettings(tab).

     ⚠️ VISIBILITY, NOT x:Load, for the shipping pages (x:Load bound to a bool UNLOADS again when it goes false).
     The dev page is the deliberate exception: it must NEVER be constructed in Release (its engine VMs are null
     there), and x:Load is exactly the tool for "do not build this at all".

     (The rail used to be a TOP strip with a right-click "Tabs on top / on the side" switch — removed 2026-11-11.) -->

<UserControl x:Class="Anvil.Controls.Windows.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Anvil.Controls.Primitives"
             xmlns:cmp="using:Anvil.Controls.Composites"
             xmlns:basemaps="using:Anvil.Controls.Basemaps"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- Dark surface fills the whole window. -->
    <Grid Background="{ThemeResource OverlayBarSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- the title band -->
            <RowDefinition Height="*"/>    <!-- rail | body -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/> <!-- the rail -->
            <ColumnDefinition Width="*"/>   <!-- the body -->
        </Grid.ColumnDefinitions>

        <!-- THE BAND — raised, full width, a hairline under it. The SAME grammar as the Atlas's band: logo slot,
             name, then each fact as its LABEL over its VALUE, left-aligned. ⚠️ Its right 220 px are RESERVED for
             the lock, pin and caption buttons that sit over that corner. -->
        <Border x:Name="SettingsBand" Grid.ColumnSpan="2"
                Background="{ThemeResource OverlayBarSurfaceRaisedBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="16,12,0,12" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- logo slot -->
                    <ColumnDefinition Width="Auto"/> <!-- name -->
                    <ColumnDefinition Width="Auto"/> <!-- facts -->
                    <ColumnDefinition Width="*"/>    <!-- empty -->
                    <ColumnDefinition Width="220"/>  <!-- lock / pin / caption corner -->
                </Grid.ColumnDefinitions>

                <!-- LOGO SLOT — a placeholder until the app has a logo (the Atlas's, the same size). -->
                <Grid Width="40" Height="40" VerticalAlignment="Center">
                    <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="1" StrokeDashArray="3,3"
                               Stroke="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <FontIcon Glyph="&#xE713;" FontSize="16"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>

                <TextBlock Grid.Column="1" Text="Anvil Settings" VerticalAlignment="Center"
                           FontSize="22" FontWeight="SemiBold"/>

                <!-- ABOUT ANVIL: version first, rule, then the rest. -->
                <StackPanel x:Name="SettingsBandAbout" Grid.Column="2" Orientation="Horizontal" Spacing="20"
                            VerticalAlignment="Center" Margin="21,0,0,0">
                    <StackPanel>
                        <TextBlock Text="VERSION" Style="{StaticResource AtlasFieldLabelStyle}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{x:Bind AppVersion}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Border Width="1" Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                    <StackPanel>
                        <TextBlock Text="BUILD" Style="{StaticResource AtlasFieldLabelStyle}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{x:Bind BuildKind}" FontSize="20" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="LICENSE" Style="{StaticResource AtlasFieldLabelStyle}" HorizontalAlignment="Left"/>
                        <TextBlock Text="AGPL-3.0" FontSize="20" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="SOURCE" Style="{StaticResource AtlasFieldLabelStyle}" HorizontalAlignment="Left"/>
                        <HyperlinkButton x:Name="SettingsBandSourceLink" Content="GitHub" Padding="0" Margin="0,2,0,0"
                                         NavigateUri="https://github.com/jhammon88219/Anvil"
                                         ToolTipService.ToolTip="Anvil's source code on GitHub"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- THE RAIL — raised, a hairline on its right edge. The entries are BuildTabs'. -->
        <Border x:Name="SettingsRail" Grid.Row="1"
                Background="{ThemeResource OverlayBarSurfaceRaisedBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <ctl:TabStrip x:Name="Strip" Margin="6,8,6,8"
                              ItemsSource="{x:Bind Tabs}"
                              SelectedIndex="{x:Bind ViewModel.SettingsTabIndex, Mode=TwoWay}"/>
            </ScrollViewer>
        </Border>

        <!-- The body: a FIXED-width sections column, and the live map preview in the rest. Pages without a preview
             keep the same narrow column — the left edge and the column width never move as you switch pages. -->
        <Grid x:Name="BodyHost" Grid.Row="1" Grid.Column="1" Margin="24,18,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/> <!-- ⚠️ THE sections column; the header sketch's width -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bodies. Exactly one is visible; the rest keep their state because they stay loaded. -->
            <ScrollViewer x:Name="Body" Grid.Column="0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <Grid>
                    <!-- x:Name'd so the code-behind can relay its Browse request: the folder picker needs
                         a window HWND, which neither this UserControl nor the page has. -->
                    <cmp:MapSettingsTab x:Name="MapTab" ViewModel="{x:Bind ViewModel}"
                                        Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, 0), Mode=OneWay}"/>

                    <!-- x:Name'd (all of them) so PersistSectionExpansion can key each page's sections by page. -->
                    <cmp:RadarSettingsTab x:Name="RadarTab" ViewModel="{x:Bind ViewModel}"
                                          Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, 1), Mode=OneWay}"/>

                    <cmp:RangeRingSettingsTab x:Name="RangeRingTab" ViewModel="{x:Bind ViewModel}"
                                              Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, 2), Mode=OneWay}"/>

                    <cmp:StorageSettingsTab x:Name="StorageTab" ViewModel="{x:Bind ViewModel}"
                                            Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, 3), Mode=OneWay}"/>

                    <cmp:WindowModeSettingsTab x:Name="WindowModeTab" ViewModel="{x:Bind ViewModel}"
                                               Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, 4), Mode=OneWay}"/>

                    <cmp:RadarConsoleSettingsTab x:Name="ConsoleTab" ViewModel="{x:Bind ViewModel}"
                                                 Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, 5), Mode=OneWay}"/>

                    <cmp:StartupSettingsTab x:Name="StartupTab" ViewModel="{x:Bind ViewModel}"
                                            Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, 6), Mode=OneWay}"/>

                    <cmp:LiveDataSettingsTab x:Name="LiveDataTab" ViewModel="{x:Bind ViewModel.LiveData}"
                                             Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, 7), Mode=OneWay}"/>

                    <basemaps:BasemapSettingsTab x:Name="BasemapTab" ViewModel="{x:Bind ViewModel.BasemapSetup}"
                                                 Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, 8), Mode=OneWay}"/>

                    <cmp:UnitsSettingsTab x:Name="UnitsTab" ViewModel="{x:Bind ViewModel}"
                                          Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, 9), Mode=OneWay}"/>

                    <!-- EDGE-HATCH (experimental bolt-on): the Edges page. -->
                    <cmp:EdgeHatchSettingsTab x:Name="EdgesTab" ViewModel="{x:Bind ViewModel.EdgeHatch}"
                                              Visibility="{x:Bind TabVisibility(ViewModel.SettingsTabIndex, 10), Mode=OneWay}"/>

                    <!-- ⚠️ x:Load, not Visibility — see the header. LoadDevTab is hard-false in Release, so
                         this body is never constructed there and its null engine VMs are never bound. -->
                    <cmp:DevSettingsTab x:Name="DevTab"
                                        x:Load="{x:Bind LoadDevTab(ViewModel.SettingsTabIndex), Mode=OneWay}"
                                        ViewModel="{x:Bind ViewModel}"
                                        SweepVm="{x:Bind SweepVm}"
                                        ValidationVm="{x:Bind ValidationVm}"
                                        SeedVm="{x:Bind SeedVm}"
                                        Loaded="OnDevTabLoaded"/>
                </Grid>
            </ScrollViewer>

            <!-- The live preview (Map + Radar Range Ring pages). Collapsed, not unloaded, on other pages:
                 its page stays up while the window is open, so switching back is instant. -->
            <Border Grid.Column="1" Margin="16,0,0,0"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                    Visibility="{x:Bind ViewModel.HasSettingsPreview, Mode=OneWay}">
                <cmp:MapPreview ViewModel="{x:Bind ViewModel}"/>
            </Border>
        </Grid>

        <!-- Lock (no move/resize) + pin (keep on top), over the band's reserved corner. -->
        <ctl:LockToggle Grid.ColumnSpan="2" IsChecked="{x:Bind ViewModel.IsSettingsWindowLocked, Mode=TwoWay}"/>
        <ctl:PinToggle Grid.ColumnSpan="2" IsChecked="{x:Bind ViewModel.IsSettingsWindowOnTop, Mode=TwoWay}"/>
    </Grid>
</UserControl>
