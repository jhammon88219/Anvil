<?xml version="1.0" encoding="utf-8"?>
<!-- AppSettingsCard — the app-wide settings card, the RIGHT-side mirror of the temporal cards. Hosted in
     the OverlayBar's SettingsCardHost slot (above the bar, right-aligned) and opened by the settings cog
     on the bar's right edge; hidden by the card's own down-triangle. Uses the SAME ControlCard chrome
     (fixed size, down-triangle) as the temporal cards, so the UX is symmetrical: temporal settings open on
     the left, app settings on the right. This is the app-wide settings area; sections stack in the body as
     [section label] over its controls. Today: a "Radar Settings" section with the Show Research Radars
     toggle (the Show TDWRs toggle lands here later). Bound to the coordinator MapViewModel. -->
<UserControl x:Class="Anvil.Controls.Sections.AppSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Anvil.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Section header inside the settings body (e.g. "Radar Settings"). -->
        <Style x:Key="SettingsSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="40"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ctl:ControlCard Title="Settings"
                         CardHeight="540"
                         CloseRequested="OnCardCloseRequested"
                         Visibility="{x:Bind VisibleWhen(ViewModel.IsSettingsCardOpen), Mode=OneWay}">
            <ctl:ControlCard.CardBody>
                <!-- Body: one section per group, [label] over its controls. Grid rows (no StackPanels). -->
                <Grid RowSpacing="8" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- section label: Radar Settings -->
                        <RowDefinition Height="Auto"/> <!-- Show TDWRs -->
                        <RowDefinition Height="Auto"/> <!-- Show Research Radars -->
                        <RowDefinition Height="Auto"/> <!-- Storage (cache size + clear + limit) -->
                        <RowDefinition Height="Auto"/> <!-- Advanced / Diagnostics (PIPELINE CONSOLE) -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Radar Settings"
                               Style="{StaticResource SettingsSectionLabelStyle}"/>

                    <!-- Opt-in TDWRs (the FAA Terminal Doppler Weather Radar T*** network). -->
                    <CheckBox Grid.Row="1"
                              Margin="4,0,0,0"
                              Content="Show TDWRs"
                              IsChecked="{x:Bind ViewModel.Radar.ShowTdwrs, Mode=TwoWay}"
                              ToolTipService.ToolTip="Show FAA Terminal Doppler Weather Radar markers (e.g. TOKC, TDAL)"/>

                    <!-- Opt-in research/test radars (e.g. the ROC test bed KCRI). Moved here from the radar
                         console so app-wide toggles live in one place. -->
                    <CheckBox Grid.Row="2"
                              Margin="4,0,0,0"
                              Content="Show Research Radars"
                              IsChecked="{x:Bind ViewModel.Radar.ShowResearchRadars, Mode=TwoWay}"
                              ToolTipService.ToolTip="Show research/test radar markers such as KCRI (ROC test bed, Norman OK)"/>

                    <!-- STORAGE — the settings service's first real consumer. Live radar-cache size + a
                         "Clear now" action (Level2RadarService), and a PERSISTED size cap
                         (AppSettings.RadarCacheMaxGb, enforced by the startup sweep). -->
                    <StackPanel Grid.Row="3" Spacing="6" Margin="0,4,0,0">
                        <TextBlock Text="Storage"
                                   Style="{StaticResource SettingsSectionLabelStyle}"/>

                        <!-- Radar cache size + Clear now -->
                        <Grid ColumnSpacing="8" Margin="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Radar cache"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Margin="0,0,4,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.Storage.CacheSizeText, Mode=OneWay}"/>
                            <Button Grid.Column="2" Content="Clear now"
                                    IsEnabled="{x:Bind ViewModel.Storage.CanClear, Mode=OneWay}"
                                    Click="OnClearCacheClick"
                                    ToolTipService.ToolTip="Delete all cached radar volumes now (the app re-downloads what it needs)"/>
                        </Grid>

                        <!-- Cache size cap (persisted via the settings service) -->
                        <Grid ColumnSpacing="8" Margin="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Cache limit"/>
                            <ComboBox Grid.Column="1" HorizontalAlignment="Right" MinWidth="72"
                                      ItemsSource="{x:Bind ViewModel.Storage.CacheLimitOptions}"
                                      SelectedItem="{x:Bind ViewModel.Storage.CacheLimitGb, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Maximum on-disk radar cache; enforced at the next launch"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="GB"/>
                        </Grid>
                    </StackPanel>

                    <!-- PIPELINE CONSOLE (dev/diagnostic — safe to remove as a unit): the non-obvious toggle
                         that opens the read-only pipeline glass-cockpit card. Tucked under an Advanced label
                         so it's discoverable but out of the way. -->
                    <StackPanel Grid.Row="4" Spacing="6" Margin="0,4,0,0">
                        <TextBlock Text="Advanced"
                                   Style="{StaticResource SettingsSectionLabelStyle}"/>
                        <ToggleSwitch Margin="4,0,0,0"
                                      Header="Pipeline Console"
                                      OffContent="Hidden" OnContent="Shown"
                                      IsOn="{x:Bind ViewModel.IsPipelineConsoleOpen, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Show the Level-2 pipeline console: a mini-scrubber per product + storm-motion state (observe-only)"/>
                    </StackPanel>
                </Grid>
            </ctl:ControlCard.CardBody>
        </ctl:ControlCard>
    </Grid>
</UserControl>
