<?xml version="1.0" encoding="utf-8"?>
<!-- AppearanceSettingsConsoleEdges — Settings → Appearance's "Edges" section (EDGE-HATCH, experimental bolt-on — grep
     EDGE-HATCH), on a Primitives/SettingsConsolePlate. Was the whole Settings → Edges page (retired 2026-11-16).

       Edges  [Restore defaults]                                                                  DEFAULT
       Pattern       [Hatch|Dots]                                    Crossing lines or a dot screen     Hatch
       Style         [Thinning | Fading | Both | Black shadow]       Black shadow = the old plain shade  Both
       Line color    (A)● ● ● ● ● (+)                                A = the bar surface      (A) Bar surface
       Band width    ─────●──────────────────────────────  35 px     Off with Black shadow (only then)  35 px
       Line spacing  ──●─────────────────────────────────   5 px                                      5 px
       Line weight   ────────────────────────────────────● 2.0 px                                    2.0 px
       Line opacity  ────────────────────────────────────●  100%                                       100%
                     ☑ Hatch the panes' map-side edges               Where an open pane meets the map     On
       96            420 (slider * + value 56)                       hint (one line)              150, right

     Every control writes ONE AppSettings value through EdgeHatchViewModel; the bands follow live.
     ⚠️ Every row is a Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText by AboutKey).
     ⚠️ THE DEFAULT COLUMN reads EdgeHatchViewModel's Default* texts — the SAME constants Restore defaults writes, so it
     always says what the button will do. Restore defaults ASKS first (OnRestoreDefaults → ConfirmResetDialog).
     Spacing/weight labels follow the pattern ("Dot pitch"/"Dot size" with Dots). -->
<UserControl x:Class="Anvil.Controls.AppearanceSettingsConsoles.AppearanceSettingsConsoleEdges"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:services="using:Anvil.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="AppearanceSettingsConsoleEdgesPlate" Title="Edges" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="EdgeHatchRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    ToolTipService.ToolTip="Put every edge setting back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <!-- Pattern: Hatch = crossing lines; Dots = the dot matrix. Every other row applies to both. -->
            <prim:SettingsConsoleRow Label="Pattern" AboutKey="edges.pattern" Default="{x:Bind ViewModel.DefaultPatternText}">
                <prim:SegmentedPicker x:Name="EdgeHatchPatternPicker" HorizontalAlignment="Left" Width="180"
                                      IsEnabled="{x:Bind ViewModel.IsHatch, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.PatternLabels}"
                                      SelectedIndex="{x:Bind ViewModel.PatternIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <!-- Style: the WIDEST control — it fills the 420 Control column. -->
            <prim:SettingsConsoleRow Label="Style" AboutKey="edges.style" Default="{x:Bind ViewModel.DefaultStyleText}">
                <prim:SegmentedPicker x:Name="EdgeHatchStylePicker"
                                      ItemsSource="{x:Bind ViewModel.StyleLabels}"
                                      SelectedIndex="{x:Bind ViewModel.StyleIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <!-- Swatches + "+" for any color; "A" = the bar surface, which follows the theme. -->
            <prim:SettingsConsoleRow Label="Line color" AboutKey="edges.color" Default="{x:Bind ViewModel.DefaultColorText}">
                <prim:SettingsConsoleRow.DefaultContent>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- the "A" chip, as the picker draws it: the bar surface -->
                        <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1"
                                Background="{ThemeResource OverlayBarSurfaceBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}">
                            <TextBlock Text="A" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.DefaultColorText}"/>
                    </StackPanel>
                </prim:SettingsConsoleRow.DefaultContent>
                <prim:ColorSwatchPicker x:Name="EdgeHatchColorPicker" HorizontalAlignment="Left"
                                        AllowCustom="True"
                                        IsEnabled="{x:Bind ViewModel.IsHatch, Mode=OneWay}"
                                        ItemsSource="{x:Bind ViewModel.ColorSwatches}"
                                        ToolTips="{x:Bind ViewModel.ColorNames}"
                                        SelectedIndex="{x:Bind ViewModel.ColorIndex, Mode=TwoWay}"
                                        CustomHex="{x:Bind ViewModel.ColorHex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <!-- The four sliders grey together under Black shadow; ONE hint says why (on the first of them). -->
            <prim:SettingsConsoleRow Label="Band width" AboutKey="edges.width" Default="{x:Bind ViewModel.DefaultWidthText}"
                                     Hint="{x:Bind services:SettingsText.HintFor('edges.width', ViewModel.IsHatch), Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Slider x:Name="EdgeHatchWidthSlider" Minimum="16" Maximum="72" StepFrequency="1" VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.IsHatch, Mode=OneWay}"
                            Value="{x:Bind ViewModel.Width, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                               Text="{x:Bind ViewModel.WidthText, Mode=OneWay}"/>
                </Grid>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="{x:Bind ViewModel.SpacingLabel, Mode=OneWay}" AboutKey="edges.spacing"
                                     Default="{x:Bind ViewModel.DefaultSpacingText}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Slider x:Name="EdgeHatchSpacingSlider" Minimum="3" Maximum="12" StepFrequency="1" VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.IsHatch, Mode=OneWay}"
                            Value="{x:Bind ViewModel.Spacing, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                               Text="{x:Bind ViewModel.SpacingText, Mode=OneWay}"/>
                </Grid>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="{x:Bind ViewModel.WeightLabel, Mode=OneWay}" AboutKey="edges.weight"
                                     Default="{x:Bind ViewModel.DefaultWeightText}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Slider x:Name="EdgeHatchWeightSlider" Minimum="0.5" Maximum="2" StepFrequency="0.5" VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.IsHatch, Mode=OneWay}"
                            Value="{x:Bind ViewModel.Weight, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                               Text="{x:Bind ViewModel.WeightText, Mode=OneWay}"/>
                </Grid>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Line opacity" AboutKey="edges.opacity" Default="{x:Bind ViewModel.DefaultOpacityText}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Slider x:Name="EdgeHatchOpacitySlider" Minimum="10" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.IsHatch, Mode=OneWay}"
                            Value="{x:Bind ViewModel.Opacity, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                               Text="{x:Bind ViewModel.OpacityText, Mode=OneWay}"/>
                </Grid>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow AboutKey="edges.panes" Default="{x:Bind ViewModel.DefaultOnPanesText}">
                <CheckBox x:Name="EdgeHatchOnPanesCheckBox" VerticalAlignment="Center"
                          Content="Hatch the panes' map-side edges"
                          IsEnabled="{x:Bind ViewModel.IsHatch, Mode=OneWay}"
                          IsChecked="{x:Bind ViewModel.OnPanes, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
