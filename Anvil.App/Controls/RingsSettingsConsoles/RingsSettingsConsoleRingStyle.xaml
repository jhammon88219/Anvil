<?xml version="1.0" encoding="utf-8"?>
<!-- RingsSettingsConsoleRingStyle — ONE range ring's look, on a Primitives/SettingsConsolePlate. Declared THREE times by
     Composites/RangeRingSettingsTab (Reflectivity reach · Velocity reach · Distance rings) over one RingStyleViewModel each
     (replaced the old RingStyleEditor, 2026-11-16). One control on purpose: three hand-written copies would drift.

       Reflectivity reach  [Restore defaults]                                                      DEFAULT
       Colour      (A)(■)(■)(■)(■)(■)(■)(+)                      The range ruler wears it too        Theme
       Opacity     ━━━━━━━━━━━━●━━━━━━━━━━━━━━━━━━━  55%                                             55%
       Thickness   ━━━●━━━━━━━━━━━━━━━━━━━━━━━━━━━━  1.3 px                                       1.3 px
       Line        [ Solid | Dashed | Dotted | Dash-dot ]                                         Solid
       96          420 (slider * · value 56)                     hint (one line)              150, right

     ⚠️ THE COLUMNS (96 · 420 · * · 150) are the page's. A = the theme's colour for this ring; + = any colour.
     ⚠️ IsEditable = false greys every row AND Restore defaults (the Distance rings card while that ring is off); LockedHint
     then replaces ColorHint. Everything applies LIVE to the main map and persists on its own. -->
<UserControl x:Class="Anvil.Controls.RingsSettingsConsoles.RingsSettingsConsoleRingStyle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="RingsSettingsConsoleRingStylePlate" Title="{x:Bind Title, Mode=OneWay}" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="RingStyleRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                    ToolTipService.ToolTip="Put this ring's look back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <Grid Style="{StaticResource SettingsConsoleRowsStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SettingsLabelColumnWidth}"/>
                <ColumnDefinition Width="{StaticResource SettingsControlColumnWidth}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource SettingsDefaultColumnWidth}"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource SettingsConsoleLabelTextStyle}" Text="Colour"/>
            <prim:ColorSwatchPicker x:Name="RingColorPicker" Grid.Column="1" HorizontalAlignment="Left"
                                    IsEnabled="{x:Bind IsEditable, Mode=OneWay}" AllowCustom="True"
                                    ItemsSource="{x:Bind Ring.ColorSwatches, Mode=OneWay}"
                                    ToolTips="{x:Bind Ring.ColorNames, Mode=OneWay}"
                                    SelectedIndex="{x:Bind Ring.ColorIndex, Mode=TwoWay}"
                                    CustomHex="{x:Bind Ring.ColorHex, Mode=TwoWay}"/>
            <TextBlock Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}"
                       Text="{x:Bind HintFor(IsEditable, ColorHint, LockedHint), Mode=OneWay}"/>
            <TextBlock Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind Ring.DefaultColorText, Mode=OneWay}"/>

            <TextBlock Grid.Row="1" Style="{StaticResource SettingsConsoleLabelTextStyle}" Text="Opacity"/>
            <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                <Slider x:Name="RingOpacitySlider" VerticalAlignment="Center" IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                        Minimum="5" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10" IsThumbToolTipEnabled="False"
                        Value="{x:Bind Ring.Opacity, Mode=TwoWay}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                           Text="{x:Bind Pct(Ring.Opacity), Mode=OneWay}"/>
            </Grid>
            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind Ring.DefaultOpacityText, Mode=OneWay}"/>

            <TextBlock Grid.Row="2" Style="{StaticResource SettingsConsoleLabelTextStyle}" Text="Thickness"/>
            <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                <Slider x:Name="RingThicknessSlider" VerticalAlignment="Center" IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                        Minimum="0.5" Maximum="6" StepFrequency="0.1" SmallChange="0.1" LargeChange="0.5" IsThumbToolTipEnabled="False"
                        Value="{x:Bind Ring.Width, Mode=TwoWay}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                           Text="{x:Bind Px(Ring.Width), Mode=OneWay}"/>
            </Grid>
            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind Ring.DefaultWidthText, Mode=OneWay}"/>

            <TextBlock Grid.Row="3" Style="{StaticResource SettingsConsoleLabelTextStyle}" Text="Line"/>
            <prim:SegmentedPicker x:Name="RingLinePicker" Grid.Row="3" Grid.Column="1" IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                                  ItemsSource="{x:Bind Ring.LineLabels, Mode=OneWay}"
                                  SelectedIndex="{x:Bind Ring.LineIndex, Mode=TwoWay}"/>
            <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind Ring.DefaultLineText, Mode=OneWay}"/>
        </Grid>
    </prim:SettingsConsolePlate>
</UserControl>
