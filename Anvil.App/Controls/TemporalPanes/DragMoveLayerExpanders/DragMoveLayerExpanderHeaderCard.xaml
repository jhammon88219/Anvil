<?xml version="1.0" encoding="utf-8"?>
<!-- DragMoveLayerExpanderHeaderCard — the grey summary card at the TOP of a DragMoveLayerExpander's body, drawn
     FLUSH under the header so the header and card read as ONE grey block (same brush, no gap, no line).

      ┌──────────────────────────────────────────────────────────────┐
      │ ⠿  ›  [x]  Warnings        ────────────●──────────   100%    │  ← the expander's header (#1A1A1A)
      │   2 active warnings             Updated 12:04 PM · every 15s │  ← THIS card: ONE line, same grey, no top /
      ├──────────────────────────────────────────────────────────────┤    left / right margin, square corners
      │   [x] ■ Tornado                 2                            │  ← the rest of the body, 14 px below,
      └──────────────────────────────────────────────────────────────┘    on the window's ground
      |←12→| text starts on the BODY's left edge (its Padding) — the same edge as the content below

     ⭐ ONE LINE ONLY (the user's rule, 2026-10-21): Headline (15, primary) on the LEFT, never trimmed · Context (13,
     secondary) on the RIGHT, right-aligned, trimmed with the full text in its tooltip. A Footer (loading / failures /
     "no scan near this frame") TAKES THE RIGHT SLOT in place of Context (tertiary) while it has text — the card never
     grows a second line. Don't add a line back; a new fact goes into the Context string.

     ⚠️ EQUAL space above and below the line (Padding 12 all round — the top was 6 until 2026-10-21, the user's call).

     ⭐ EVERY expander's top card is this control (the user's rule, 2026-10-16) — never a hand-drawn Border.
     ⚠️ It MUST be the body's FIRST element: the negative margin (-12 sides = DragMoveLayerExpander's body Padding;
     -13 top = that Padding + the body's 1 px top border, which the card paints over) assumes it starts at the
     body's top-left. Change the expander's body Padding → change this Margin.
     ⚠️ The bottom margin (14) replaces the separate rule + "Margin 0,14" the cards used to sit over — don't add a
     rule under it. -->
<UserControl x:Class="Anvil.Controls.TemporalWindows.DragMoveLayerExpanders.DragMoveLayerExpanderHeaderCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Margin="-12,-13,-12,14"
             HorizontalAlignment="Stretch"
             IsTabStop="False">

    <Border x:Name="CardFace"
            Padding="12"
            Background="{ThemeResource SectionHeaderBackground}"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource SectionBorderBrush}">
        <!-- Headline Auto (never trimmed — headlines are short), the right slot * (trims). Both Bottom-aligned so the
             15 and 13 px lines sit on (near enough) one baseline. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource TabularNumberTextStyle}" Text="{x:Bind Headline, Mode=OneWay}"
                       FontSize="15" VerticalAlignment="Bottom"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource TabularNumberTextStyle}"
                       Text="{x:Bind Context, Mode=OneWay}"
                       Visibility="{x:Bind ShowContext(Footer), Mode=OneWay}"
                       ToolTipService.ToolTip="{x:Bind Context, Mode=OneWay}"
                       FontSize="13" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource TabularNumberTextStyle}"
                       Text="{x:Bind Footer, Mode=OneWay}"
                       Visibility="{x:Bind HasText(Footer), Mode=OneWay}"
                       ToolTipService.ToolTip="{x:Bind Footer, Mode=OneWay}"
                       FontSize="13" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Grid>
    </Border>
</UserControl>
