<?xml version="1.0" encoding="utf-8"?>
<!-- AboutSettingsTab — Settings → About (SettingsTab.About, the last page before Dev; canvas artboard 27, 2026-11-18).
     Not settings: what's running, the license, where the data comes from, what it's built with.

       (Anvil's description + the operational-use line live in the WINDOW's header, in the About slot — SettingsWindow
        SettingsAboutAnvil — not on a plate.)
       ┌ Your copy ─────────── [Copy details] ┐ ┌ License ──────────────────────────────┐   …YourCopy | …License
       └──────────────────────────────────────┘ └───────────────────────────────────────┘
       ┌ Data sources ────────────────────────┐ ┌ Built with ───────────────────────────┐   …Data | …BuiltWith
       └──────────────────────────────────────┘ └───────────────────────────────────────┘
     Two equal columns, 12 apart (the plates' gap). No Reset all on this page (SettingsWindow.PageFor = null).
     Rows are AboutSettingsConsoleInfoRow / …LinkRow — no lifts, no DEFAULT well. Takes NO view model: facts are AboutAnvil's. -->
<UserControl x:Class="Anvil.Controls.Composites.AboutSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aboutSettingsConsoles="using:Anvil.Controls.AboutSettingsConsoles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid VerticalAlignment="Top" RowSpacing="12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <aboutSettingsConsoles:AboutSettingsConsoleYourCopy x:Name="AboutSettingsConsoleYourCopy"/>
        <aboutSettingsConsoles:AboutSettingsConsoleLicense x:Name="AboutSettingsConsoleLicense" Grid.Column="1"/>
        <aboutSettingsConsoles:AboutSettingsConsoleData x:Name="AboutSettingsConsoleData" Grid.Row="1"/>
        <aboutSettingsConsoles:AboutSettingsConsoleBuiltWith x:Name="AboutSettingsConsoleBuiltWith" Grid.Row="1" Grid.Column="1"/>
    </Grid>
</UserControl>
