<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalWindowHeaderPastCastReadout — the PastCast header's Readout: the LOADED replay window's time range.

       5:00–7:00 PM     ← the console clock's face at 30 (not 40, so a start–end range fits), TABULAR digits,
                          AM/PM 16 secondary on their bottom edge
       No timeframe     ← nothing loaded: a placeholder at 16, dimmed to 40%

     ⚠️ It describes the LOADED window (RadarViewModel's HEADER block), never the pickers. -->

<UserControl x:Class="Anvil.Controls.TemporalWindows.TemporalWindowHeaderReadouts.TemporalWindowHeaderPastCastReadout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tw="using:Anvil.Controls.TemporalWindows"
             xmlns:temporalWindowHeaderReadouts="using:Anvil.Controls.TemporalWindows.TemporalWindowHeaderReadouts"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsTabStop="False">

    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="{x:Bind ViewModel.LoadedReplayRangeDigits, Mode=OneWay}"
                   FontSize="{x:Bind RangeFontSize(ViewModel.HasLoadedReplayWindow), Mode=OneWay}"
                   FontWeight="SemiLight" Typography.NumeralAlignment="Tabular"
                   VerticalAlignment="Center"
                   Opacity="{x:Bind PlaceholderOpacity(ViewModel.HasLoadedReplayWindow), Mode=OneWay}"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        <TextBlock Text="{x:Bind ViewModel.LoadedReplayRangeSuffix, Mode=OneWay}"
                   FontSize="16" VerticalAlignment="Bottom" Margin="0,0,0,5"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
</UserControl>
