<?xml version="1.0" encoding="utf-8"?>
<!-- ModelConsole — the time strip's MODEL MODE: while ForeCast's Short Range draws (NowCast is off then), this sits OVER
     RadarControls in the same strip cell and plays the model run (ModelPlaybackViewModel). SAME ONE-ROW LAYOUT, same fixed
     widths (RadarControls' constants), same places — only what each slot SAYS changes, so nothing moves when it swaps in.

       │ in 5h 15m · Thu  11:00 PM │ ▮▮▮▮▮▮▮▮▮◆▮▮▮▮▯▯▯▯ scrubber 420 ▯▯ │ ◀ ▶ ▶  f05:15 / f18  ⟳     HRRR · 16Z · 18/18 · Composite │
         └─ valid time; how far from   └─ one cell per FRAME, on the       └─ transport · forecast     └─ Model · Run · Product,
            now + the day in the          window's midpoint (a cell lights     hour · check for a newer   ONE line, the reserved
            CAUTION colour (a forecast)   when its frame is built)             run now                    scan-line width

     ⚠️ NOT THE RADAR LOOP: no RadarLoopEngine here (sealed). It reuses only the DRAWING scrubbers; the pointer mapping is
     a copy of RadarControls' (equal slots / DotMatrixScrubber.IndexAt) — change both.
     ⚠️ EVERY TextBlock here is IsTextScaleFactorEnabled="False" — RadarControls' rule (fixed blocks). -->
<UserControl x:Class="Anvil.Controls.Composites.ModelConsole"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prim="using:Anvil.Controls.Primitives"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="GlyphTransportStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Assembly" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== THE CLOCK BLOCK: the playhead's VALID time · how far from now (caution colour) ===== -->
        <Grid Grid.Column="0"
              Width="{x:Bind ClockBlockWidth}"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Margin="0,0,16,0"
              Background="Transparent"
              ToolTipService.ToolTip="When the model frame on screen is valid (a forecast, not a radar scan)">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock IsTextScaleFactorEnabled="False" Grid.Column="0"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                       Text="{x:Bind ViewModel.WhenText, Mode=OneWay}"
                       Style="{StaticResource BodyTextStyle}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
            <TextBlock IsTextScaleFactorEnabled="False" Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.ClockText, Mode=OneWay}"
                       Typography.NumeralAlignment="Tabular"
                       FontSize="{StaticResource BodyLargeFontSize}"
                       LineHeight="{StaticResource BodyLargeLineHeight}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Grid>

        <!-- ===== THE SCRUBBER (Width 420 is load-bearing — see RadarControls) ===== -->
        <Grid x:Name="ScrubberHost" Grid.Column="1" Width="420" Height="20" VerticalAlignment="Center" Background="Transparent"
              IsHitTestVisible="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
              PointerPressed="OnScrubberPointerPressed"
              PointerMoved="OnScrubberPointerMoved"
              PointerReleased="OnScrubberPointerReleased"
              PointerCaptureLost="OnScrubberPointerReleased"
              PointerCanceled="OnScrubberPointerReleased">
            <prim:ClassicScrubber Segments="{x:Bind ViewModel.Segments, Mode=OneWay}"
                                  CurrentIndex="{x:Bind ViewModel.CurrentFrameIndex, Mode=OneWay}"
                                  Visibility="{x:Bind ClassicVisibility(UseDotMatrix, UseHatch), Mode=OneWay}"/>
            <prim:DotMatrixScrubber x:Name="DotScrubber"
                                    Segments="{x:Bind ViewModel.Segments, Mode=OneWay}"
                                    CurrentIndex="{x:Bind ViewModel.CurrentFrameIndex, Mode=OneWay}"
                                    FillOrder="LeftToRight"
                                    Visibility="{x:Bind DotVisibility(UseDotMatrix), Mode=OneWay}"/>
            <prim:HatchScrubber Segments="{x:Bind ViewModel.Segments, Mode=OneWay}"
                                CurrentIndex="{x:Bind ViewModel.CurrentFrameIndex, Mode=OneWay}"
                                Spacing="{x:Bind HatchLook.Spacing, Mode=OneWay}"
                                Weight="{x:Bind HatchLook.Weight, Mode=OneWay}"
                                Ink="{x:Bind HatchLook.ColorHex, Mode=OneWay}"
                                LineOpacity="{x:Bind HatchLook.LineOpacity, Mode=OneWay}"
                                Visibility="{x:Bind DotVisibility(UseHatch), Mode=OneWay}"/>
        </Grid>

        <!-- ===== RIGHT: transport · forecast hour · check now ······ Model · Run · Product ===== -->
        <Grid Grid.Column="2" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="16,0,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource GlyphTransportStyle}" Click="OnPrevClick"
                        IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                        ToolTipService.ToolTip="Previous frame">
                    <FontIcon Glyph="&#xE892;" FontSize="13"/>
                </Button>
                <Button x:Name="PlayStopButton" Style="{StaticResource GlyphTransportStyle}" Width="32"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Click="OnPlayStopClick"
                        IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                        ToolTipService.ToolTip="Play / stop (stop returns to the frame nearest now)">
                    <FontIcon Glyph="{x:Bind PlayStopGlyph(ViewModel.IsPlaying), Mode=OneWay}" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource GlyphTransportStyle}" Click="OnNextClick"
                        IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                        ToolTipService.ToolTip="Next frame">
                    <FontIcon Glyph="&#xE893;" FontSize="13"/>
                </Button>
                <TextBlock IsTextScaleFactorEnabled="False"
                           Width="{x:Bind FrameCountWidth}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.FrameCountText, Mode=OneWay}"
                           Typography.NumeralAlignment="Tabular"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           ToolTipService.ToolTip="Forecast hour on screen / the last one listed"/>
                <Button Style="{StaticResource GlyphTransportStyle}" Width="24" Height="24" VerticalAlignment="Center"
                        Click="OnCheckNowClick"
                        ToolTipService.ToolTip="Check for a newer model run now">
                    <FontIcon Glyph="&#xE72C;" FontSize="11"/>
                </Button>
            </StackPanel>

            <!-- Model · Run · Product — radar's scan-line slot, the model's facts. -->
            <Grid Grid.Column="2"
                  Width="{x:Bind ScanLineWidth}"
                  Margin="{x:Bind RightBlockMargin(SideInsets), Mode=OneWay}"
                  VerticalAlignment="Center">
                <TextBlock IsTextScaleFactorEnabled="False"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="{x:Bind ViewModel.ModelText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/><Run Text=" · " Foreground="{ThemeResource TextFillColorTertiaryBrush}"/><Run Text="{x:Bind ViewModel.RunText, Mode=OneWay}"/><Run Text=" · " Foreground="{ThemeResource TextFillColorTertiaryBrush}"/><Run Text="{x:Bind ViewModel.ProductText, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
