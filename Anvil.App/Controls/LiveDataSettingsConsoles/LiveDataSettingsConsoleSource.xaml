<?xml version="1.0" encoding="utf-8"?>
<!-- LiveDataSettingsConsoleSource — Settings → Live Data's "Source" section, on a Primitives/SettingsConsolePlate: WHERE the
     NowCast feeds' live updates come from. ONE source at a time (NOAA Weather Wire REPLACES IEM, the user's call 2026-10-19).

       Source  [Restore defaults]                                                                  DEFAULT
       Updates from  [ IEM live feed | NOAA Weather Wire | Polling only ]   About 15–20 s after …   IEM live feed
                   │ ● IEM LIVE FEED │ NOAA WEATHER WIRE │ POLLING ONLY     ← heads: overline, TERTIARY grey (never the cell
       How fast    │ 15–20 s …       │ Fastest …         │ Up to each …       colour); the picked source's head = accent + dot
     ┌ Account       None              Free NWS account …  None          ┐  ← each row = LiveDataSettingsConsoleSourceDetailRow,
     └──────────────────────────────────────────────────────────────────────┘    lifted on hover, separators hidden there
       Relies on   │ Iowa State …    │ The NWS itself    │ Only each …        (canvas artboards 31 + 33, 2026-11-18)
       Best for    │ Most people     │ Storm days …      │ Fixing …
       96 label col · three equal columns · │ = a separator before each source, heads to last row
       ⭐ the two columns NOT picked grey to 45% (each row's PickedIndex ← SourceIndex, 2026-11-19)
       ⚠️ Ends 172 short of the right edge: the rows' hover bleeds 8 px, and this keeps it 6 px clear of the DEFAULT well
       (166 + 6 inset). On THIS plate only — other plates' rows lift across the well, by design.

     ⚠️ PICKING HAPPENS ONLY ON THE UPDATES FROM LINE (user's call, 2026-11-18): the details table is reference — no cards, no
     column lift, no clicks. A Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText "live.source":
     Choices = the per-source HINTS, ChoiceAbouts = the per-source ABOUT texts — LiveDataViewModel.SourceHint / .SourceAbout).
     The table's short cells are layout labels, declared here; keep its "How fast" cells in step with the catalog's hints.
     ⚠️ Timings: IEM's 15–20 s is measured; Weather Wire's speed is NOT yet — no number until Dev → Live source timing has run.
     Restore defaults = IEM; the Weather Wire account is KEPT. -->
<UserControl x:Class="Anvil.Controls.LiveDataSettingsConsoles.LiveDataSettingsConsoleSource"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:local="using:Anvil.Controls.LiveDataSettingsConsoles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SourceDetailsHeadStyle" TargetType="TextBlock" BasedOn="{StaticResource OverlineTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <prim:SettingsConsolePlate x:Name="LiveDataSettingsConsoleSourcePlate" Title="Source" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="SourceRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    ToolTipService.ToolTip="Back to the IEM live feed (asks first). Your Weather Wire account is kept"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <prim:SettingsConsoleRow Label="Updates from" AboutKey="live.source" Default="{x:Bind ViewModel.DefaultSourceText}"
                                     Hint="{x:Bind ViewModel.SourceHint, Mode=OneWay}"
                                     About="{x:Bind ViewModel.SourceAbout, Mode=OneWay}">
                <prim:SegmentedPicker x:Name="LiveSourcePicker"
                                      ItemsSource="{x:Bind ViewModel.SourceLabels}"
                                      SelectedIndex="{x:Bind ViewModel.SourceIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <!-- THE DETAILS TABLE (see the header sketch). -->
            <StackPanel x:Name="LiveDataSettingsConsoleSourceDetails" Margin="0,10,172,0">
                <!-- Column heads: grey overline; the picked source's head swaps to the accent copy + dot (opacities follow the
                     pick so the brushes stay ThemeResources). Same columns + bleed + separators as the detail rows. -->
                <Grid x:Name="SourceDetailsHeads" Margin="-8,0" Padding="8,0" ColumnSpacing="12">
                    <Grid.Resources>
                        <Style TargetType="StackPanel">
                            <Setter Property="Orientation" Value="Horizontal"/>
                            <Setter Property="Spacing" Value="6"/>
                            <Setter Property="Margin" Value="0,6,0,8"/>
                        </Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Width" Value="1"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="Margin" Value="-7,0,0,0"/>
                            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource SettingsLabelColumnWidth}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Rectangle x:Name="SourceDetailsHeadSeparatorIem" Grid.Column="1"/>
                    <Rectangle x:Name="SourceDetailsHeadSeparatorNwws" Grid.Column="2"/>
                    <Rectangle x:Name="SourceDetailsHeadSeparatorPolling" Grid.Column="3"/>

                    <StackPanel Grid.Column="1">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                 Visibility="{x:Bind PickedMark(ViewModel.SourceIndex, 0), Mode=OneWay}"/>
                        <Grid>
                            <TextBlock Style="{StaticResource SourceDetailsHeadStyle}" Text="IEM LIVE FEED"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" Opacity="{x:Bind Unpicked(ViewModel.SourceIndex, 0), Mode=OneWay}"/>
                            <TextBlock Style="{StaticResource SourceDetailsHeadStyle}" Text="IEM LIVE FEED"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Opacity="{x:Bind Picked(ViewModel.SourceIndex, 0), Mode=OneWay}"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                 Visibility="{x:Bind PickedMark(ViewModel.SourceIndex, 1), Mode=OneWay}"/>
                        <Grid>
                            <TextBlock Style="{StaticResource SourceDetailsHeadStyle}" Text="NOAA WEATHER WIRE"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" Opacity="{x:Bind Unpicked(ViewModel.SourceIndex, 1), Mode=OneWay}"/>
                            <TextBlock Style="{StaticResource SourceDetailsHeadStyle}" Text="NOAA WEATHER WIRE"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Opacity="{x:Bind Picked(ViewModel.SourceIndex, 1), Mode=OneWay}"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                 Visibility="{x:Bind PickedMark(ViewModel.SourceIndex, 2), Mode=OneWay}"/>
                        <Grid>
                            <TextBlock Style="{StaticResource SourceDetailsHeadStyle}" Text="POLLING ONLY"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" Opacity="{x:Bind Unpicked(ViewModel.SourceIndex, 2), Mode=OneWay}"/>
                            <TextBlock Style="{StaticResource SourceDetailsHeadStyle}" Text="POLLING ONLY"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Opacity="{x:Bind Picked(ViewModel.SourceIndex, 2), Mode=OneWay}"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- "How fast" stays in step with the catalog's hints. -->
                <!-- PickedIndex greys the two sources you didn't pick. -->
                <local:LiveDataSettingsConsoleSourceDetailRow x:Name="SourceDetailHowFast" Label="How fast"
                    PickedIndex="{x:Bind ViewModel.SourceIndex, Mode=OneWay}"
                    Iem="About 15–20 s after issuance" Nwws="Fastest, straight from the NWS" Polling="Up to each layer's polling interval"/>
                <local:LiveDataSettingsConsoleSourceDetailRow x:Name="SourceDetailAccount" Label="Account"
                    PickedIndex="{x:Bind ViewModel.SourceIndex, Mode=OneWay}"
                    Iem="None" Nwws="Free NWS account · one computer" Polling="None"/>
                <local:LiveDataSettingsConsoleSourceDetailRow x:Name="SourceDetailReliesOn" Label="Relies on"
                    PickedIndex="{x:Bind ViewModel.SourceIndex, Mode=OneWay}"
                    Iem="Iowa State's IEM (best effort)" Nwws="The NWS itself" Polling="Only each layer's own data"/>
                <local:LiveDataSettingsConsoleSourceDetailRow x:Name="SourceDetailBestFor" Label="Best for"
                    PickedIndex="{x:Bind ViewModel.SourceIndex, Mode=OneWay}"
                    Iem="Most people" Nwws="Storm days, when every second counts" Polling="Fixing problems · strict networks"/>
            </StackPanel>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
