<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     OverlayBar — a CHROME-ONLY shell: a theme-aware surface, an edge treatment where it meets
     whatever is beyond it, an optional show/hide pull-tab, and the collapse behavior. It is a
     content slot: the host fills BarContent with the actual controls, so section content is
     composed by the host, never here.

     TWO SHAPES, ONE CONTROL. Plain DPs move the geometry, the face and the edge; nothing else
     changes. See the class remarks in the code-behind for the full list.

       Edge=Bottom, IsIsland=False — A FULL-WIDTH TIER OF THE BOTTOM CHROME

         …map, full height, showing through…
              ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░  ← CastShadow: this tier's
              ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓╭── ˅ Hide ──╮▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓   shadow, thrown UP onto the map —
                                                                      DENSE, 36 px, solid black at the
                                                                      plate, starting 10 px above the tab
       ─────────────────────────────────────────────────────────────
             BarContent — the HOST fills this slot
       ══════════════════════ window bottom ═══════════════════════

       Edge=Top, IsIsland=True — THE PANE NOTCH (one per map pane)

       ═══════════════════════ pane top edge ══════════════════════
                    ░┌─────────────────────────┐░   ← an island casts on THREE sides:
                    ░│  BarContent (the slot)  │░     left, right and the outward edge
                    ░└──────╮ ˄ Hide ╭─────────┘░
                     ░░░░░░░╰─────────╯░░░░░░░░░
            …the pane's map, showing through either side…

     ⚠️ THE EDGE IS A SHADOW, NOT A LINE (EdgeStyle). Three values, and which one an instance wants
     depends entirely on WHAT IS BEYOND ITS OUTWARD EDGE — which only the host knows:
       CastShadow   the map is beyond it, so it throws a shadow outward onto the map.
       InsetShadow  another tier is directly above it, so it RECEIVES that tier's shadow as a dark
                    band inside its own top edge. (A cast band here would push the two tiers apart
                    and let the map show through the gap.)
       Hairline     the original 1px rule. Still the default; nothing is forced onto shadows.
     ⚠️ The two are not interchangeable and the difference is not cosmetic: one occupies LAYOUT space
     outside the surface, the other overlays the surface and occupies none.

     ⚠️ THE TAB IS Primitives/OverlayBarTab, not drawn here, because it has a SECOND host: the
     bottom chrome is TWO of these stacked (map tools over the bar) and a tab drawn in row 0 of the
     lower one would land in the SEAM between them, unreachable. So MainWindow puts both tabs on
     one rail above the stack and both tiers run ShowTab=False. One tab, one definition, two kinds
     of host.
     ⚠️ CONSEQUENCE: with ShowTab=False this control does not own its own show/hide gesture — the
     rail's tab drives IsOverlayBarVisible from outside. The four pane notches are unaffected: they
     each still draw their own tab and own their own state, which is what gives them four
     independent toggles with no view-model plumbing at all.

     Hidden, only the tab remains (it reads "Show") and the bar Border collapses — the map is
     never resized either way, in either shape.

     It renders as an OVERLAY: the host places it over the full-height map, so showing/hiding
     never resizes the map. The control's own backdrop is transparent — only the tab, the shadow
     and the bar draw — so the map shows through beside them.
     ============================================================================ -->
<UserControl x:Class="Anvil.Controls.Primitives.OverlayBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- The four ShadowFade* gradients moved to Controls/Styles.xaml (2026-10-17): the temporal window's activity
         expander casts the same shadow, so they are shared now. The EdgeStates below pick between them by edge. -->

    <!-- Transparent root: only the tab, the shadows and the bar draw, so the map shows through beside
         them. This control is ONLY the chrome. Nothing floats above it in-window: every app-wide panel
         (the three temporal windows, App Settings, Radar Atlas, the Pipeline Console) is a real
         top-level OS window owned by WindowManager. -->
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <!-- Which tier's surface this bar wears. Driven from code by IsRaised.
                 ⚠️ A {ThemeResource} IN A SETTER, never a C# resource lookup: a lookup resolves against
                 the OS theme rather than the theme the app pinned on its root element, and hands back the
                 other theme's brush. See the theming gotcha in CLAUDE.md. -->
            <VisualStateGroup x:Name="SurfaceStates">
                <VisualState x:Name="GroundSurface"/>
                <VisualState x:Name="RaisedSurface">
                    <VisualState.Setters>
                        <Setter Target="BarBorder.Background" Value="{ThemeResource OverlayBarSurfaceRaisedBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- THE CHROME — every look ApplyChrome used to set in code, as states it now only PICKS. Five
                 groups because the knobs are not independent (the corners depend on edge AND island, the rule on
                 edge AND island AND edge style); each group owns a disjoint set of properties, so they cannot
                 disagree. The markup defaults are the Bottom + full-width + hairline + ground states. -->

            <!-- EDGE: which row is which (Bottom = tab(0) over bar(1); Top = bar(0) over tab(1)), and which way
                 each shadow band faces. ⚠️ NEITHER BAND RESERVES LAYOUT: the cast band hangs outside the
                 surface's cell on a negative margin of its own height (36 bottom / 14 top); the received one overlays it. -->
            <VisualStateGroup x:Name="EdgeStates">
                <VisualState x:Name="BottomEdge"/>
                <VisualState x:Name="TopEdge">
                    <VisualState.Setters>
                        <Setter Target="BarBorder.(Grid.Row)" Value="0"/>
                        <Setter Target="Tab.(Grid.Row)" Value="1"/>
                        <Setter Target="CastShadow.(Grid.Row)" Value="0"/>
                        <Setter Target="CastShadow.VerticalAlignment" Value="Bottom"/>
                        <Setter Target="CastShadow.Height" Value="14"/>
                        <Setter Target="CastShadow.Margin" Value="0,0,0,-14"/>
                        <Setter Target="CastShadow.Background" Value="{StaticResource ShadowFadeDown}"/>
                        <Setter Target="InsetShadow.(Grid.Row)" Value="0"/>
                        <Setter Target="InsetShadow.VerticalAlignment" Value="Bottom"/>
                        <Setter Target="InsetShadow.Background" Value="{StaticResource ShadowFadeUp}"/>
                        <Setter Target="SideShadowLeft.(Grid.Row)" Value="0"/>
                        <Setter Target="SideShadowRight.(Grid.Row)" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- CORNERS: only an island rounds anything, and only its two INNER corners — the ones away from the
                 edge it is attached to. A full-width bar's corners are off-screen. -->
            <VisualStateGroup x:Name="CornerStates">
                <VisualState x:Name="SquareCorners"/>
                <VisualState x:Name="IslandBottomCorners">
                    <VisualState.Setters>
                        <Setter Target="BarBorder.CornerRadius" Value="8,8,0,0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="IslandTopCorners">
                    <VisualState.Setters>
                        <Setter Target="BarBorder.CornerRadius" Value="0,0,8,8"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- THE RULE: the hairline always runs along the edge FACING THE TAB (still the right edge with no
                 tab — the next tier or the rail sits against it); an island closes its two sides as well.
                 ⚠️ A shadowed edge draws NO line at all: the two are alternatives, not layers. A hairline under
                 a shadow reads as a seam someone forgot to finish. -->
            <VisualStateGroup x:Name="RuleStates">
                <VisualState x:Name="RuleBottomFull"/>
                <VisualState x:Name="RuleBottomIsland">
                    <VisualState.Setters>
                        <Setter Target="BarBorder.BorderThickness" Value="1,1,1,0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RuleTopFull">
                    <VisualState.Setters>
                        <Setter Target="BarBorder.BorderThickness" Value="0,0,0,1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RuleTopIsland">
                    <VisualState.Setters>
                        <Setter Target="BarBorder.BorderThickness" Value="1,0,1,1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NoRule">
                    <VisualState.Setters>
                        <Setter Target="BarBorder.BorderThickness" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- PADDING: three, and each answers a different question. An island sits over the map with a pane's
                 worth of room, not a window's (the bar's 16,10 would make a notch noticeably taller over a quad
                 pane). A RAISED tier is tighter than the bar it rests on because it is SUBORDINATE to it — at
                 equal weight the two stop reading as a bar with a shelf on it and start reading as a bar that
                 doubled in height. -->
            <VisualStateGroup x:Name="PaddingStates">
                <VisualState x:Name="GroundPadding"/>
                <VisualState x:Name="RaisedPadding">
                    <VisualState.Setters>
                        <Setter Target="BarBorder.Padding" Value="16,7,16,7"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="IslandPadding">
                    <VisualState.Setters>
                        <Setter Target="BarBorder.Padding" Value="12,6,12,6"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- SHADOWS: which bands show. ⚠️ A COLLAPSED BAR CASTS NOTHING — the shadow is thrown by the surface,
                 so when the surface is hidden every band goes with it (otherwise hiding a tier leaves its shadow
                 hanging over the map with no plate above it to explain the darkening). An island casts on three
                 sides; a full-width bar's sides run off the window. -->
            <VisualStateGroup x:Name="ShadowStates">
                <VisualState x:Name="NoShadow"/>
                <VisualState x:Name="CastShadowEdge">
                    <VisualState.Setters>
                        <Setter Target="CastShadow.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CastShadowIsland">
                    <VisualState.Setters>
                        <Setter Target="CastShadow.Visibility" Value="Visible"/>
                        <Setter Target="SideShadowLeft.Visibility" Value="Visible"/>
                        <Setter Target="SideShadowRight.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="InsetShadowEdge">
                    <VisualState.Setters>
                        <Setter Target="InsetShadow.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- pull-tab, and the cast shadow behind it -->
            <RowDefinition Height="Auto"/> <!-- overlay bar (collapses when hidden) -->
        </Grid.RowDefinitions>

        <!-- ⚠⚠ THE CAST SHADOW HANGS OUTSIDE THE SURFACE ON A NEGATIVE MARGIN AND RESERVES NO LAYOUT,
             exactly like the side bands below. It shipped in the TAB'S ROW instead, reasoned as "with
             ShowTab=False that row collapses to the band's height, so the shadow reserves its own space
             over the map" - which is only true when the thing standing above the surface is the tab IN
             that row. With the tabs on MainWindow's rail that row held nothing but the band, so 14px of
             empty layout opened between the rail and the plate and the map showed through the slot. The
             shadow then hid its own evidence: 0% to 60% black over a dark basemap is invisible, so it
             read as a hole rather than as a band that was too tall.
             ⚠️ It is the same failure the InsetShadow note below describes, one level up - a band that
             occupies space holds things apart that are supposed to be glued.
             ⚠️ Hanging it means it paints over whatever is beyond that edge, so the HOST must draw
             anything that sits there AFTER this control. MainWindow's bottom Grid declares its rail last
             for exactly that reason. Its DEPTH is both its Height and the negative margin that hangs it
             outside — keep the two equal, here and in the TopEdge state. Row, alignment, depth, margin and fade are
             the EdgeStates'; these defaults are the Bottom edge's.
             ⚠️ TWO DEPTHS (2026-10-19, the user's call): the BOTTOM edge (the bottom chrome's tiers) casts the DENSE
             shade — DenseShadowFadeUp, 36 deep, solid black at the plate, starting 10 px above the rail's tabs; it
             matches TemporalPaneActivityExpander's. The TOP edge (the pane notches) keeps the light 14 px
             ShadowFadeDown, as do the island side bands. -->
        <Border x:Name="CastShadow"
                Grid.Row="1"
                Height="36"
                VerticalAlignment="Top"
                Margin="0,-36,0,0"
                Background="{StaticResource DenseShadowFadeUp}"
                Opacity="{ThemeResource OverlayBarShadowOpacity}"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>

        <!-- The bar itself: a content slot the host fills (see BarContent). Collapses when hidden. -->
        <Border x:Name="BarBorder"
                Grid.Row="1"
                Background="{ThemeResource OverlayBarSurfaceBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{x:Bind VisibleWhen(IsOverlayBarVisible), Mode=OneWay}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                Padding="16,10">   <!-- the ground bar's; the PaddingStates tighten it (an island, a raised tier) -->
            <ContentPresenter HorizontalAlignment="Stretch"
                              Content="{x:Bind BarContent, Mode=OneWay}"/>
        </Border>

        <!-- ⚠️ THE RECEIVED SHADOW OVERLAYS THE SURFACE and takes NO layout space — it shares the
             BarBorder's cell. It has to: a band that occupied space would hold the two tiers apart and
             the map would show through the gap they are supposed to be glued across.
             ⚠️ IsHitTestVisible=False on every shadow, or the band swallows clicks on the row beneath it. -->
        <Border x:Name="InsetShadow"
                Grid.Row="1"
                Height="10"
                VerticalAlignment="Top"
                Background="{StaticResource ShadowFadeDown}"
                Opacity="{ThemeResource OverlayBarShadowOpacity}"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>

        <!-- An ISLAND casts on three sides, so it needs these two as well — a plate lit only along one
             edge reads as half-stuck to the map. They hang OUTSIDE the island on a negative margin, so
             they never narrow it. Collapsed for a full-width bar, whose sides run off the window. -->
        <Border x:Name="SideShadowLeft"
                Grid.Row="1"
                Width="12"
                Margin="-12,0,0,0"
                HorizontalAlignment="Left"
                Background="{StaticResource ShadowFadeRight}"
                Opacity="{ThemeResource OverlayBarShadowOpacity}"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>
        <Border x:Name="SideShadowRight"
                Grid.Row="1"
                Width="12"
                Margin="0,0,-12,0"
                HorizontalAlignment="Right"
                Background="{StaticResource ShadowFadeLeft}"
                Opacity="{ThemeResource OverlayBarShadowOpacity}"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>

        <!-- The pull-tab. Collapsed entirely when the host owns the tab instead (ShowTab=False, which is
             how the bottom chrome stacks two of these under one shared rail). -->
        <prim:OverlayBarTab x:Name="Tab"
                            Grid.Row="0"
                            IsShown="{x:Bind IsOverlayBarVisible, Mode=TwoWay}"
                            ShowLabel="{x:Bind ShowTabLabel, Mode=OneWay}"/>
    </Grid>
</UserControl>
