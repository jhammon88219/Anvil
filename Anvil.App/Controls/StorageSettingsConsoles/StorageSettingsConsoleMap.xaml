<?xml version="1.0" encoding="utf-8"?>
<!-- StorageSettingsConsoleMap — Settings → Storage's "Which map to use" section (was "Map" until 2026-11-19; from the retired
     Basemap page, 2026-11-16), on a Primitives/SettingsConsolePlate: ONE pick-one list of every map Anvil could draw, the
     online one included. Over BasemapSetupViewModel (MapViewModel.BasemapSetup) — the SAME instance the map setup window uses.
     Mock-up: the "Which map to use" Design canvas, boards 2–4 (2026-11-19).

       Which map to use                                                            (no reset, no DEFAULT — files are yours)
       Maps                                      DETAIL     SIZE   SAVED
                 ( ) Online map                                                      ← greys + "Set up a map key in Online
                     Protomaps · needs the internet                                     map below" until a key is saved
                 (•) Lower 48 + 3 more           [Full]   34.1 GB  11/2/2026  [📁][🗑]
                 ( ) Lower 48 + Alaska           [Standard] 5.0 GB 10/20/2026 [📁][🗑]
                 ⚠ Delete Lower 48 + Alaska · frees 5.0 GB             [Keep][Delete] ← the trash ASKS on its own row first
                 ( ) Older USA map               [Full]   28.8 GB  6/8/2026   [📁][🗑]
                 (•) No map  Radar and overlays over a blank background             ← only while nothing draws (inert)
                 [Add a map file…]  212.3 GB free        Added Lower 48 + 3 more · pick it to draw it   ← one short line
       96        * (radio + short name) · 84 · 76 right · 100 · 72

     ⚠️ Picking = clicking a row's RADIO (its name is the radio's content): a file → UseFile, the online row → UseSavedOnline.
     Each radio sits in its own parent, so they never group-uncheck each other; IsChecked comes from the VM every Refresh.
     ⚠️ Short names + DETAIL tags + the file-name rule = Models/Map/BasemapFileNames (BasemapFileOptions.ShortName); the full
     area list and the file's path are the row's TOOLTIP, never a line of their own.
     ⚠️ Every row is a Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText by AboutKey); the list
     spans to the row's end (ControlSpan 3). Every choice here is drawn AT ONCE (MainWindow re-points the map). A delete Windows
     refuses (the file still open) finishes at the next launch (AppSettings.BasemapPendingDeletes). Added files stay where they
     are (AppSettings.BasemapAddedFiles). The SAME file list sizes Disk usage's Maps row (BasemapSetupViewModel.MapFilePaths). -->
<UserControl x:Class="Anvil.Controls.StorageSettingsConsoles.StorageSettingsConsoleMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- The list's columns (header + every row): name * · DETAIL 84 · SIZE 76 · SAVED 100 · buttons 72. Change all together.
             ⚠️ GridLength, NOT x:Double — ColumnDefinition.Width won't take a double (a XamlParseException the moment the
             page loads; docs/bugs.md). -->
        <GridLength x:Key="MapListDetailWidth">84</GridLength>
        <GridLength x:Key="MapListSizeWidth">76</GridLength>
        <GridLength x:Key="MapListDateWidth">100</GridLength>
        <GridLength x:Key="MapListButtonsWidth">72</GridLength>

        <Style x:Key="MapListTagStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
        </Style>

        <!-- One map file. Two faces on one row: the details, or (trash pressed) the delete question. -->
        <DataTemplate x:Key="MapFileRowTemplate" x:DataType="vm:BasemapFileRow">
            <Grid MinHeight="44" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                  ToolTipService.ToolTip="{x:Bind Tooltip}">
                <Grid ColumnSpacing="12" Visibility="{x:Bind IsShowingDetails, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource MapListDetailWidth}"/>
                        <ColumnDefinition Width="{StaticResource MapListSizeWidth}"/>
                        <ColumnDefinition Width="{StaticResource MapListDateWidth}"/>
                        <ColumnDefinition Width="{StaticResource MapListButtonsWidth}"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="MapFileRadio" VerticalAlignment="Center" MinWidth="0" IsChecked="{x:Bind IsInUse}"
                                 Click="OnUseFileClick" AutomationProperties.Name="{x:Bind Name}">
                        <TextBlock Style="{StaticResource BodyTextStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                    </RadioButton>
                    <Border Grid.Column="1" Style="{StaticResource MapListTagStyle}" Visibility="{x:Bind HasDetail}">
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind Detail}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource TabularNumberTextStyle}" Text="{x:Bind SizeText}"/>
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource TabularNumberTextStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind DateText}"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Click="OnShowFileClick" ToolTipService.ToolTip="Show in folder" AutomationProperties.Name="Show in folder">
                            <FontIcon Glyph="&#xE838;" FontSize="14"/>
                        </Button>
                        <Button Click="OnAskDeleteClick" ToolTipService.ToolTip="Delete" AutomationProperties.Name="Delete">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="10" Padding="8,0" CornerRadius="4" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                      Visibility="{x:Bind IsConfirmingDelete, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" VerticalAlignment="Center"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}" Text="{x:Bind DeleteQuestion}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="Keep" Click="OnKeepFileClick"/>
                        <Button Content="Delete" Style="{StaticResource CautionResetButtonStyle}" Click="OnDeleteFileClick"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <prim:SettingsConsolePlate x:Name="StorageSettingsConsoleMapPlate" Title="Which map to use">
        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <!-- THE LIST: online · every file · (no map). Its label sits on the head row's line. -->
            <prim:SettingsConsoleRow Label="Maps" AboutKey="map.files" ControlSpan="3" TextVerticalAlignment="Top">
                <StackPanel>
                    <Grid x:Name="MapListHeads" ColumnSpacing="12" Padding="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource MapListDetailWidth}"/>
                            <ColumnDefinition Width="{StaticResource MapListSizeWidth}"/>
                            <ColumnDefinition Width="{StaticResource MapListDateWidth}"/>
                            <ColumnDefinition Width="{StaticResource MapListButtonsWidth}"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Style="{StaticResource OverlineTextStyle}" Text="DETAIL"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource OverlineTextStyle}" Text="SIZE" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource OverlineTextStyle}" Text="SAVED"/>
                    </Grid>

                    <!-- Online: picks the SAVED online map; greyed until the Online map card has a working key. -->
                    <Grid x:Name="MapListOnlineRow" MinHeight="44" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}">
                        <RadioButton x:Name="MapListOnlineRadio" VerticalAlignment="Center" MinWidth="0"
                                     IsChecked="{x:Bind ViewModel.IsOnlineInUse, Mode=OneWay}"
                                     IsEnabled="{x:Bind ViewModel.CanUseSavedOnline, Mode=OneWay}"
                                     Click="OnUseOnlineClick" AutomationProperties.Name="Online map">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="Online map"/>
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind ViewModel.OnlineRowText, Mode=OneWay}"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <ItemsControl x:Name="MapFileRows" IsTabStop="False" ItemsSource="{x:Bind ViewModel.Files}" ItemTemplate="{StaticResource MapFileRowTemplate}"/>

                    <!-- No map: only while nothing draws — a state, not a choice (checked, inert). -->
                    <Grid x:Name="MapListNoMapRow" MinHeight="44" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                          Visibility="{x:Bind ViewModel.IsNoMap, Mode=OneWay}">
                        <RadioButton x:Name="MapListNoMapRadio" VerticalAlignment="Center" MinWidth="0" IsChecked="True" IsEnabled="False">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="No map"/>
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Radar and overlays draw over a blank background"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </prim:SettingsConsoleRow>

            <!-- Add · free space · what the last Add / Delete did (ONE short line, into the Default column). -->
            <prim:SettingsConsoleRow AboutKey="map.add" HintSpansDefault="True" Hint="{x:Bind ViewModel.FilesMessage, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="AddMapFileButton" Content="Add a map file…" Click="OnAddFileClick"/>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SettingsConsoleHintTextStyle}"
                               Text="{x:Bind ViewModel.FreeSpaceText, Mode=OneWay}"/>
                </StackPanel>
            </prim:SettingsConsoleRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
