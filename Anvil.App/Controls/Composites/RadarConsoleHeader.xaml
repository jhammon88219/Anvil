<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     RadarConsoleHeader — the floating radar console's TOP ROW: WHICH radar (the console row below answers WHEN). The user's
     canvas card A, 2026-11-03: it replaced the site TAB that stood on the console, and took Inspect and the rings/ruler
     picker off the tools strip. The card just grows a row taller.

         ░╭──────────────────────────────────────────────────────────────╮░
         ░│                    [ ⌂ KTLX  Oklahoma City   ˅ ]         (⌕)(◎▴) │░   ← THIS
         ░│  ─────────────────────────────────────────────────────────────  │░   ← the RULE (card A), inset 11 from the card
         ░│    1:07 PM ═══ scrubber ═══  ◀ ▶ ▶ ↺        VCP: 212             │░   ← the console row (MainWindow ConsoleIsland)
         ░╰──────────────────────────────────────────────────────────────╯░
                                                      scan text's end ┤

     ⚠️ EDGE-ALIGNED TO THE CONSOLE ROW (AlignToConsole, from MainWindow.AlignCentreSection): the rings/ruler picker's right
     edge = the end of the LONGEST scan line's TEXT, so it moves as the VCP text changes — a MEASURED margin. The site
     picker is centred by layout — on the card's midpoint, which is play (RadarControls.CentreOnPlay) and the window's
     midpoint. The LEFT is empty: the NETWORK PICKER moved to the top of the map-tools rail (2026-11-04, the user's call).
     ⚠️ It sits on the console's GROUND face (not raised): every face here hovers to OverlayBarSurfaceHoverBrush.
     ⚠️ Greyed while the PastCast loading screen is up (Free(AreControlsLocked)); Inspect follows IsTransportEnabled.

     SITE PICKER — also the "which radar is selected" readout: the FACE is the site on the map now (⌂ home, ★ favorite,
     bare otherwise), and the PINNED top row is that same site (SelectedSites). Below the rule: home first, then the
     favorites (PinnedSites), so the list never reshuffles on a switch.
     ⚠️ A pick ACTS through ItemPicked, NOT SelectedItem: picking the site already loaded must still fly back to it, and
     that changes no property. SelectedItem is ONE-WAY from LoadedSite and re-asserted after the pick.
     ⚠️ DISABLED in PastCast (a pick would re-target the replay); the tooltip sits on a WRAPPER so it still explains itself.
     ⚠️ FIXED width so a long name never resizes the row; the name trims. Glyphs E80F / E735 are NOT verified.
     ⚠️ It is a SectionedComboBox (commits only on ItemClick), never a ComboBox — a ComboBox cycles on the wheel.

     INSPECT (⌕): read the active product under the pointer in every pane. Plain TwoWay; DISABLED until a loop is loaded
     (IsTransportEnabled) and disarms when it clears. The mark is a MAGNIFIER (E721, not verified), never a reticle —
     the reticle is Location's. RINGS/RULER (◎▴, Primitives/MapControlsStripRangeToolsPicker): the rings master + the
     ruler row (needs a radar on screen); the right-most tool.
     Host contract: ViewModel (MapViewModel).
     ============================================================================ -->
<UserControl x:Class="Anvil.Controls.Composites.RadarConsoleHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:conv="using:Anvil.Converters"
             xmlns:comp="using:Anvil.Controls.Composites"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:SiteAvailabilityToBrushConverter x:Key="AvailabilityToBrush"/>

        <!-- One site-picker ROW (both sections): pin mark, id, name, availability dot. -->
        <DataTemplate x:Key="SiteRowTemplate" x:DataType="vm:RadarSiteRow">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="{x:Bind comp:RadarConsoleHeader.PinGlyph(IsHome, IsFavorite), Mode=OneWay}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Id}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{x:Bind Name}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <Ellipse Grid.Column="3" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{x:Bind Availability, Converter={StaticResource AvailabilityToBrush}, Mode=OneWay}"/>
            </Grid>
        </DataTemplate>

        <!-- The FACE: the pin mark (collapsed for a site that is neither), id and name — no dot. No foregrounds set: the
             text inherits the picker's, so it greys with it in PastCast. -->
        <DataTemplate x:Key="SiteFaceTemplate" x:DataType="vm:RadarSiteRow">
            <!-- A Grid, not a horizontal StackPanel: only a * column gives the name a width to trim to.
                 Gaps are MARGINS, not ColumnSpacing, so a collapsed mark leaves no gap behind. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Margin="0,0,8,0"
                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"
                          Glyph="{x:Bind comp:RadarConsoleHeader.PinGlyph(IsHome, IsFavorite), Mode=OneWay}"
                          Visibility="{x:Bind comp:RadarConsoleHeader.PinVisibility(IsHome, IsFavorite), Mode=OneWay}"/>
                <TextBlock Grid.Column="1" Margin="0,0,8,0" Text="{x:Bind Id}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <!-- Inspect's face: the tools strip's StripToolToggleStyle (32 × 32, accent border + Elevated face while lit, the
             mark dimmer while off) but hovering on the GROUND pair — this row sits on the console's ground face. -->
        <Style x:Key="ConsoleToolToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="Root"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource OverlayBarSurfaceHoverBrush}"/>
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                                            <Setter Target="Glyph.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource OverlayBarSurfaceElevatedBrush}"/>
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                                            <Setter Target="Glyph.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Glyph.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource OverlayBarSurfaceElevatedBrush}"/>
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <Setter Target="Glyph.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource OverlayBarSurfaceElevatedHoverBrush}"/>
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <Setter Target="Glyph.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource OverlayBarSurfaceElevatedBrush}"/>
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <Setter Target="Glyph.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <Setter Target="Glyph.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Glyph"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- the row: network · site · tools -->
            <RowDefinition Height="Auto"/> <!-- the rule (card A) -->
        </Grid.RowDefinitions>

        <!-- (LEFT is EMPTY since 2026-11-04: the network picker moved to the top of the map-tools rail, MapControlsStrip.) -->

        <!-- CENTRE: the site picker, centred by layout on the card's midpoint (= play). The wrapper carries the tooltip
             (a disabled control shows none); Transparent so it hit-tests. -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="Transparent"
              ToolTipService.ToolTip="{x:Bind ViewModel.SiteFavorites.PickerToolTip, Mode=OneWay}">
            <prim:SectionedComboBox x:Name="SitePicker"
                                    Width="260"
                                    PlaceholderText="Radar site"
                                    PinnedItemsSource="{x:Bind ViewModel.SiteFavorites.SelectedSites, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.SiteFavorites.PinnedSites, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SiteFavorites.LoadedSite, Mode=OneWay}"
                                    ItemTemplate="{StaticResource SiteRowTemplate}"
                                    FaceTemplate="{StaticResource SiteFaceTemplate}"
                                    IsEnabled="{x:Bind ViewModel.SiteFavorites.CanPickSites, Mode=OneWay}"
                                    ItemPicked="OnSitePicked">
                <prim:SectionedComboBox.FooterContent>
                    <StackPanel Spacing="4">
                        <TextBlock Margin="11,2,11,2"
                                   Text="Set a home site or star favorites in the Atlas to list them here."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Visibility="{x:Bind ViewModel.SiteFavorites.IsEmpty, Mode=OneWay}"/>
                        <!-- FAVORITES ONLY — the SAME property as Settings → Radar → Radar site keys (two switches,
                             one value). Here because this list IS home + favorites: "these" needs no explaining. -->
                        <CheckBox Margin="11,0,11,0"
                                  Content="Show only these on the map"
                                  IsChecked="{x:Bind ViewModel.SiteFavorites.ShowOnlyFavoritesOnMap, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Hide every other radar site on the map. The loaded site always shows."/>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Padding="11,6"
                                Content="Open Atlas"
                                Click="OnOpenAtlasClick"/>
                    </StackPanel>
                </prim:SectionedComboBox.FooterContent>
            </prim:SectionedComboBox>
        </Grid>

        <!-- RIGHT: Inspect, then the rings + ruler picker, as ONE run. Its right margin is MEASURED (AlignToConsole) = the
             end of the longest scan line's text. -->
        <StackPanel x:Name="RadarTools"
                    Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
            <ToggleButton x:Name="InspectToggle"
                          Style="{StaticResource ConsoleToolToggleStyle}"
                          IsEnabled="{x:Bind ViewModel.Radar.IsTransportEnabled, Mode=OneWay}"
                          IsChecked="{x:Bind ViewModel.Radar.IsInspecting, Mode=TwoWay}"
                          ToolTipService.ToolTip="Inspect - read radar values under the cursor (click again to turn it off)">
                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="20" Glyph="&#xE721;"/>
            </ToggleButton>
            <prim:MapControlsStripRangeToolsPicker x:Name="MapControlsStripRangeToolsPicker"
                                                   IsEnabled="{x:Bind Free(ViewModel.Radar.AreControlsLocked), Mode=OneWay}"
                                                   AreRingsOn="{x:Bind ViewModel.Radar.RangeRings.RingsVisible, Mode=TwoWay}"
                                                   IsRulerOn="{x:Bind ViewModel.Radar.IsRangeRulerOn, Mode=TwoWay}"
                                                   CanUseRuler="{x:Bind ViewModel.Radar.HasRadarDisplay, Mode=OneWay}"/>
        </StackPanel>

        <!-- THE RULE (card A): the console's hairline, inset 11 from the card's edges (the island pads 16; -5 each side). -->
        <Rectangle x:Name="RadarConsoleHeaderRule"
                   Grid.Row="1"
                   Height="1"
                   Margin="-5,0"
                   Fill="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                   IsHitTestVisible="False"/>
    </Grid>
</UserControl>
