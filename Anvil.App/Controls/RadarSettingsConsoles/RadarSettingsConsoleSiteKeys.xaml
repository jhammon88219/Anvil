<?xml version="1.0" encoding="utf-8"?>
<!-- RadarSettingsConsoleSiteKeys — Settings → Radar's "Site keys" section (was "Radar site keys"), on a
     Primitives/SettingsConsolePlate. Set-once PREFERENCES about the radar site keys on the map.

       Site keys  [Restore defaults]                                                               DEFAULT
                  ☑ Hide the other sites while one is loaded   Click it again to unload                 On
                  ☐ Show only my home and favorite sites       Star sites in the Atlas                 Off
                  ☐ Show only the sites near the cursor        Experimental · 230 km ring              Off
       96 (empty) 420 (the box)                                hint (one line)                  150, right

     ⚠️ THE ROW GRID is Styles.xaml's (SettingsConsoleRowsStyle + Settings*ColumnWidth); checkboxes sit in the Control column. Each box = ONE rule in radar-sites.js's VISIBILITY RULES table
     (`focus`, `favorites`, `reveal`); a new way to hide keys = a rule there + a row here. The network toggles (NEXRAD / TDWR /
     research) are gestures on the map-tools rail, not here.
     ⚠️ "Show only my home and favorite sites" is the SAME property the site picker's footer binds — two switches, one value.
     ⚠️ The cursor row is the SITE-REVEAL bolt-on (grep SITE-REVEAL to excise). -->
<UserControl x:Class="Anvil.Controls.RadarSettingsConsoles.RadarSettingsConsoleSiteKeys"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="RadarSettingsConsoleSiteKeysPlate" Title="Site keys" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="SiteKeysRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    ToolTipService.ToolTip="Put the site-key switches back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <Grid Style="{StaticResource SettingsConsoleRowsStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SettingsLabelColumnWidth}"/>
                <ColumnDefinition Width="{StaticResource SettingsControlColumnWidth}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource SettingsDefaultColumnWidth}"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <CheckBox x:Name="HideOtherSitesCheckBox" Grid.Column="1" VerticalAlignment="Center"
                      Content="Hide the other sites while one is loaded"
                      IsChecked="{x:Bind ViewModel.Radar.HideOtherSitesWhileLoaded, Mode=TwoWay}"/>
            <TextBlock Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="Click it again to unload"/>
            <TextBlock Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.DefaultHideOtherSitesText}"/>

            <CheckBox x:Name="FavoritesOnlyCheckBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                      Content="Show only my home and favorite sites"
                      IsChecked="{x:Bind ViewModel.SiteFavorites.ShowOnlyFavoritesOnMap, Mode=TwoWay}"
                      ToolTipService.ToolTip="{x:Bind ViewModel.SiteFavorites.FavoritesOnlyNote, Mode=OneWay}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="Star sites in the Atlas"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.DefaultFavoritesOnlyText}"/>

            <!-- SITE-REVEAL (experimental bolt-on; grep SITE-REVEAL to excise). -->
            <CheckBox x:Name="RevealSitesCheckBox" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                      Content="Show only the sites near the cursor"
                      IsChecked="{x:Bind ViewModel.Radar.RevealSitesNearCursor, Mode=TwoWay}"
                      ToolTipService.ToolTip="A 230 km ring follows the cursor; only the sites inside it show, plus the loaded site."/>
            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="Experimental · 230 km ring"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}" Text="{x:Bind ViewModel.DefaultRevealSitesText}"/>
            <!-- end SITE-REVEAL -->
        </Grid>
    </prim:SettingsConsolePlate>
</UserControl>
