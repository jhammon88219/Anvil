<?xml version="1.0" encoding="utf-8"?>
<!-- GeneralSettingsConsoleWindow — Settings → General's "Window" section (was the Window Mode page), on a
     Primitives/SettingsConsolePlate. General B (2026-11-16).

       Window     [Restore defaults]  ← greyed                                                     DEFAULT
       Monitors   [▒Single monitor▒| Multi-monitor ]  ← the WHOLE picker greyed (pick = lifted grey)   Single monitor
       96         420                                                                       150, right

     ⚠️ THE COLUMNS (96 · 420 · * · 150) are the page's — every General section uses the same.
     ⚠️ THE BONES, NOT THE FEATURE: MapViewModel.MonitorMode is what WindowManager reads at each point where the two modes
     would differ (grep "MONITOR MODE"); every one runs the single-monitor rule today. Enabling the picker + Restore defaults
     (MapViewModel.IsMultiMonitorModeBuilt / CanResetWindow) is the LAST step of building multi-monitor, not the first. -->
<UserControl x:Class="Anvil.Controls.GeneralSettingsConsoles.GeneralSettingsConsoleWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="GeneralSettingsConsoleWindowPlate" Title="Window" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="WindowRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    IsEnabled="{x:Bind ViewModel.CanResetWindow}"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <Grid Style="{StaticResource SettingsConsoleRowsStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SettingsLabelColumnWidth}"/>
                <ColumnDefinition Width="{StaticResource SettingsControlColumnWidth}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource SettingsDefaultColumnWidth}"/>
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource SettingsConsoleLabelTextStyle}" Text="Monitors"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <prim:SegmentedPicker x:Name="MonitorModePicker" Grid.Column="1" IsEnabled="False"
                                  ItemsSource="{x:Bind ViewModel.MonitorModeLabels}"
                                  SelectedIndex="{x:Bind ViewModel.MonitorModeIndex, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Multi-monitor is coming — it needs a second screen to build and test"/>
            <TextBlock Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="Not implemented yet"/>
            <TextBlock Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}"
                       Text="{x:Bind ViewModel.DefaultMonitorModeText}"/>
        </Grid>
    </prim:SettingsConsolePlate>
</UserControl>
