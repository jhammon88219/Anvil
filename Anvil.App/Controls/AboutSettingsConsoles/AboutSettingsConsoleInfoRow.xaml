<?xml version="1.0" encoding="utf-8"?>
<!-- AboutSettingsConsoleInfoRow — ONE fact on Settings → About (canvas artboard 22, 2026-11-17). Not a setting, so NOT a
     SettingsConsoleRow: no hover/select lift, no About box, no DEFAULT well.

       Label 160          │ Value *  (Body; IsQuiet = Caption grey, wraps)            │ [Action] ← optional key, far right
       Windows App SDK      2.1.3
       Logs                 %LocalAppData%\…\Anvil\Logs                                  [Open]

     The label wraps too (large text). Value is plain text; a link is an Action key, never inline. -->
<UserControl x:Class="Anvil.Controls.AboutSettingsConsoles.AboutSettingsConsoleInfoRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid x:Name="AboutSettingsConsoleInfoRowCells" MinHeight="32" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="AboutSettingsConsoleInfoRowLabel" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"
                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind Label, Mode=OneWay}"/>
        <!-- Two value cells, one shown: plain Body, or the QUIET Caption grey (a source line, a path). -->
        <TextBlock x:Name="AboutSettingsConsoleInfoRowValue" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                   Style="{StaticResource BodyTextStyle}" IsTextSelectionEnabled="True"
                   Visibility="{x:Bind Show(IsQuiet, x:False), Mode=OneWay}"
                   Text="{x:Bind Value, Mode=OneWay}"/>
        <TextBlock x:Name="AboutSettingsConsoleInfoRowQuietValue" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextStyle}" IsTextSelectionEnabled="True"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{x:Bind Show(IsQuiet, x:True), Mode=OneWay}"
                   Text="{x:Bind Value, Mode=OneWay}"/>
        <ContentPresenter x:Name="AboutSettingsConsoleInfoRowAction" Grid.Column="2" VerticalAlignment="Center"
                          Content="{x:Bind Action, Mode=OneWay}"/>
    </Grid>
</UserControl>
