<?xml version="1.0" encoding="utf-8"?>
<!-- RingsSettingsConsoleRuler — Settings → Rings & Ruler's "Ruler" section (the old Range ruler + Knobs sections, merged), on a
     Primitives/SettingsConsolePlate.

       Ruler  [Restore defaults]                                                                   DEFAULT
       Ruler from  [   Radar site   |   My location   ]          The site until a location is placed   Radar site
       Knob size   ━━━━━━━━━━━━━●━━━━━━━━━━━━━━━━━━  32 px       Sizes the ruler and label knobs         32 px
       96          420 (slider * · value 56)                     hint (one line)                   150, right

     ⚠️ Every row is a Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText by AboutKey). Arming the ruler is a gesture (the map-tools rail); this is its anchor
     preference. "My location" is kept even with no location marker placed — the ruler measures from the site meanwhile and
     its chip says so; don't grey the segment. The knob size is SHARED: the ruler's knob and the distance-label knob are drawn
     alike, so it stays live while the distance rings are off. -->
<UserControl x:Class="Anvil.Controls.RingsSettingsConsoles.RingsSettingsConsoleRuler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="RingsSettingsConsoleRulerPlate" Title="Ruler" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="RulerRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    ToolTipService.ToolTip="Put the ruler's anchor and the knob size back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <prim:SettingsConsoleRow Label="Ruler from" AboutKey="ruler.from" Default="{x:Bind ViewModel.DefaultRulerAnchorText}">
                <prim:SegmentedPicker x:Name="RulerAnchorPicker"
                                      ItemsSource="{x:Bind ViewModel.Radar.RulerAnchorLabels}"
                                      SelectedIndex="{x:Bind ViewModel.Radar.RulerAnchorIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Knob size" AboutKey="ruler.knob" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultKnobSizeText}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Slider x:Name="KnobSizeSlider" VerticalAlignment="Center" Minimum="20" Maximum="48" StepFrequency="1" SmallChange="1" LargeChange="4"
                            IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.Radar.RangeRings.KnobSize, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                               Text="{x:Bind Px0(ViewModel.Radar.RangeRings.KnobSize), Mode=OneWay}"/>
                </Grid>
            </prim:SettingsConsoleRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
