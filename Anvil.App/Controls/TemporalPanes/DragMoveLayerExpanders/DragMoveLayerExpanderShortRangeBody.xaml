<?xml version="1.0" encoding="utf-8"?>
<!-- DragMoveLayerExpanderShortRangeBody — ForeCast's "Short Range" section body (ShortRangeViewModel): a convection-allowing
     model (the HRRR for now) drawn on the map as ONE field, the frame nearest now. The header (box · title · opacity) is the
     host's DragMoveLayerExpander.

     ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓   the card (DragMoveLayerExpanderHeaderCard, FLUSH, ONE line):
     ▓  HRRR 16Z · all 18 hours in         Next 18 hr · CAM  ▓   the run ON THE MAP + how much of it has landed │ what this
     ──────────────────────────────────────────────────────────   range IS (fixed); loading / a problem takes the right side (Footer)
       valid 11:00 PM (f05:00)                                ← the frame on the map (FrameText). It and the range note SWAPPED
                                                                places, 2026-10-21 (the user's call); collapses while empty
       Model    [ HRRR ]                                      ← SegmentedPicker, one segment for now (NAM 3 km / RRFS later)
       Product  [Future radar (composite)          ▾]         ← composite · 1 km · updraft helicity tracks
                1 km reflectivity looks most like radar's…    ← hint (caution colour): comparing, and not 1 km
       Run      [Latest (17Z)                      ▾]         ← Latest = newest run once its f00–f18 landed; until then the
                                                                one before + "18Z · arriving 7/18" to pick; others HELD
       Tracks   [ This hour | Run so far ]                    ← ONLY while the product is UH; default Run so far
       Hours    [ ] Extend to f48 (hourly past f18)           ← ONLY for a 48 h run (00/06/12/18Z); persisted
       Compare  [✓] Compare with radar                        ← radar | HRRR in two panes, radar's console sets the time;
                Radar on the left, HRRR on the right. …       ← hint: what happens / "Pick a radar site" / young-run caution

     NO LEGEND here (removed 2026-10-21): the model's ramp is in every PANE NOTCH while it draws (PaneNotchContent).

     ⚠️ The box (the host's) EXCLUDES NOWCAST: ticking it while ForeCast runs turns live radar off; unticking brings it back
     (MapViewModel's NowCast ⇄ MODEL rule) — EXCEPT while comparing, when both draw (one pane each). ⚠️ Colours are DATA, never themed. ⚠️ No time control here: the BOTTOM CONSOLE
     plays the run (Composites/ModelConsole, while the field draws). -->
<UserControl x:Class="Anvil.Controls.TemporalWindows.DragMoveLayerExpanders.DragMoveLayerExpanderShortRangeBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dragMoveLayerExpanders="using:Anvil.Controls.TemporalWindows.DragMoveLayerExpanders"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:conv="using:Anvil.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <!-- A row's hint line: small, wrapping, in the CAUTION colour (the model console's forecast-time colour). -->
        <Style x:Key="ShortRangeHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- the card -->
            <RowDefinition Height="Auto"/> <!-- the range note -->
            <RowDefinition Height="Auto"/> <!-- the rows -->
        </Grid.RowDefinitions>

        <dragMoveLayerExpanders:DragMoveLayerExpanderHeaderCard x:Name="DragMoveLayerExpanderHeaderCard" Grid.Row="0"
                Headline="{x:Bind ViewModel.CardHeadline, Mode=OneWay}"
                Context="{x:Bind ViewModel.CardContext, Mode=OneWay}"
                Footer="{x:Bind ViewModel.CardFooter, Mode=OneWay}"/>

        <!-- The frame on the map — UNDER the card (it swapped with the range note, which is now the card's right side;
             2026-10-21). A plain line, not in the card: the card is one line by rule. -->
        <TextBlock x:Name="ShortRangeFrameLine" Grid.Row="1" Margin="0,0,0,12"
                   Text="{x:Bind ViewModel.FrameText, Mode=OneWay}"
                   Visibility="{x:Bind HintVisibility(ViewModel.FrameText), Mode=OneWay}"
                   FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <!-- [label | control] in the outlook section's 60 px label column. -->
        <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Model -->
                <RowDefinition Height="Auto"/> <!-- Product -->
                <RowDefinition Height="Auto"/> <!-- Run -->
                <RowDefinition Height="Auto"/> <!-- Tracks (UH only) -->
                <RowDefinition Height="Auto"/> <!-- Hours (48 h runs only) -->
                <RowDefinition Height="Auto"/> <!-- Compare -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" Style="{StaticResource SettingsFieldLabelStyle}"/>
            <prim:SegmentedPicker x:Name="ShortRangeModelPicker" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"
                                  ItemsSource="{x:Bind ViewModel.ModelLabels}"
                                  SelectedIndex="{x:Bind ViewModel.ModelIndex, Mode=OneWay}"
                                  ToolTipService.ToolTip="The model drawn (the HRRR: NOAA's 3 km model, run every hour)"/>

            <!-- ⚠️ A ComboBox, like the outlook's Day / Product (a short list that never scrolls the map). -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Product" Style="{StaticResource SettingsFieldLabelStyle}"
                       VerticalAlignment="Top" Margin="0,6,0,0"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                <ComboBox x:Name="ShortRangeProductComboBox" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.Products}"
                          DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedProduct, Mode=TwoWay}"
                          ToolTipService.ToolTip="Future radar = the model's reflectivity; tracks = where it spins up rotating storms"/>
                <!-- Comparing, and not 1 km reflectivity: composite is the column's max, so it always looks bigger than radar. -->
                <TextBlock x:Name="ShortRangeProductHint" Style="{StaticResource ShortRangeHintStyle}"
                           Text="{x:Bind ViewModel.ProductHint, Mode=OneWay}"
                           Visibility="{x:Bind HintVisibility(ViewModel.ProductHint), Mode=OneWay}"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Run" Style="{StaticResource SettingsFieldLabelStyle}"/>
            <ComboBox x:Name="ShortRangeRunComboBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.RunOptions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{x:Bind ViewModel.SelectedRun, Mode=TwoWay}"
                      ToolTipService.ToolTip="Model run (UTC); Latest follows each new one, an earlier one stays put"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Tracks" Style="{StaticResource SettingsFieldLabelStyle}"
                       Visibility="{x:Bind ViewModel.IsTracksProduct, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            <prim:SegmentedPicker x:Name="ShortRangeTracksPicker" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left"
                                  Visibility="{x:Bind ViewModel.IsTracksProduct, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                  ItemsSource="{x:Bind ViewModel.TracksLabels}"
                                  SelectedIndex="{x:Bind ViewModel.TracksIndex, Mode=TwoWay}"
                                  ToolTipService.ToolTip="This hour's rotation, or every hour of the run so far painted as one swath"/>

            <!-- Only for a run that goes to 48 h (00/06/12/18Z): off = the console plays f00–f18 in 15-min frames; on =
                 the whole run, hourly past f18 (the 15-min files stop there). Persisted. -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Hours" Style="{StaticResource SettingsFieldLabelStyle}"
                       Visibility="{x:Bind ViewModel.CanExtend, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            <CheckBox x:Name="ShortRangeExtendCheckBox" Grid.Row="4" Grid.Column="1"
                      Content="Extend to f48 (hourly past f18)"
                      Visibility="{x:Bind ViewModel.CanExtend, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                      IsChecked="{x:Bind ViewModel.IsExtended, Mode=TwoWay}"
                      ToolTipService.ToolTip="This run goes to 48 hours; past 18 the HRRR only has hourly frames"/>

            <!-- COMPARE WITH RADAR: radar | HRRR in two panes, NowCast stays on and the RADAR console sets the time
                 (ShortRangeViewModel.IsComparing; MapViewModel owns the modes + layout). Persisted. The hint under it says
                 what happens, or what it needs (a radar site), or the young-run caution. -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Compare" Style="{StaticResource SettingsFieldLabelStyle}"
                       VerticalAlignment="Top" Margin="0,6,0,0"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Spacing="2">
                <CheckBox x:Name="ShortRangeCompareCheckBox"
                          Content="Compare with radar"
                          IsChecked="{x:Bind ViewModel.IsComparing, Mode=TwoWay}"
                          ToolTipService.ToolTip="Live radar on the left, the HRRR on the right, at the same moment"/>
                <TextBlock x:Name="ShortRangeCompareHint" Style="{StaticResource ShortRangeHintStyle}"
                           Text="{x:Bind ViewModel.CompareHint, Mode=OneWay}"
                           Visibility="{x:Bind HintVisibility(ViewModel.CompareHint), Mode=OneWay}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
