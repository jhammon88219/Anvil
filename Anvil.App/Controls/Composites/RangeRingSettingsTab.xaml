<?xml version="1.0" encoding="utf-8"?>
<!-- RangeRingSettingsTab — Settings → Rings & Ruler (was "Radar Range Ring"; redone on the section casing 2026-11-16): WHICH range
     rings are drawn around the loaded site, how each LOOKS, the distance labels, and the range ruler.

       ┌ Rings  [Restore defaults] ────────────────────────────────── DEFAULT ┐  RingsSettingsConsoleRings
       │ Site ring · Reflectivity reach · Velocity reach · Distance rings ·    │
       │ Spacing (greyed unless Distance rings)                                │
       └────────────────────────────────────────────────────────────────────────┘
          12 px of the body's darker ground
       ┌ Reflectivity reach  [Restore defaults] ───────────────────── DEFAULT ┐  RingsSettingsConsoleRingStyle ×3 (ONE control:
       │ Colour · Opacity · Thickness · Line                                    │  Reflectivity · Velocity · Distance; the
       └────────────────────────────────────────────────────────────────────────┘  Distance card greys while that ring is off)
       ┌ Velocity reach … ┐  ┌ Distance rings … ┐
       ┌ Distance labels  [Restore defaults] ──────────────────────── DEFAULT ┐  RingsSettingsConsoleLabels (greyed while the
       │ Colour · Opacity · Font · Size · Spacing · Halo · Halo colour ·        │  distance rings are off)
       │ Placement · Lines · Position · Show the unit · Show the drag knob      │
       └────────────────────────────────────────────────────────────────────────┘
       ┌ Ruler  [Restore defaults] ────────────────────────────────── DEFAULT ┐  RingsSettingsConsoleRuler (Range ruler + Knobs)
       │ Ruler from · Knob size                                                 │
       └────────────────────────────────────────────────────────────────────────┘
       [              Reset all Rings & Ruler settings  (caution amber)          ]  Primitives/CautionResetButton

     ⚠️ Every reset ASKS first (Dialogs/ConfirmResetDialog). The old single "Restore default look" (looks only) became a
     Restore defaults per card + Reset all. Everything applies LIVE to the main map and persists by itself.
     ⚠️ The DISTANCE UNIT lives on General → Units: it is app-wide, not a ring setting. The RULER is here because it ends ON the
     reflectivity ring and wears its colour (one object). The label knob (radar-scope.js, primary pane) writes the same
     bearing the Position slider does. -->
<UserControl x:Class="Anvil.Controls.Composites.RangeRingSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ringsSettingsConsoles="using:Anvil.Controls.RingsSettingsConsoles"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel Spacing="12" VerticalAlignment="Top">
        <ringsSettingsConsoles:RingsSettingsConsoleRings x:Name="RingsSettingsConsoleRings" ViewModel="{x:Bind ViewModel}"/>

        <!-- ⚠️ This ring's color is AppSettings.ScopeColor — the range ruler wears it too (its ColorKey's hint says so). -->
        <ringsSettingsConsoles:RingsSettingsConsoleRingStyle x:Name="RingsSettingsConsoleRingStyleReflectivity"
                                                             Title="Reflectivity reach"
                                                             Ring="{x:Bind ViewModel.Radar.RangeRings.Outline}"
                                                             ColorKey="ring.color.refl"/>
        <ringsSettingsConsoles:RingsSettingsConsoleRingStyle x:Name="RingsSettingsConsoleRingStyleVelocity"
                                                             Title="Velocity reach"
                                                             Ring="{x:Bind ViewModel.Radar.RangeRings.Velocity}"/>
        <ringsSettingsConsoles:RingsSettingsConsoleRingStyle x:Name="RingsSettingsConsoleRingStyleDistance"
                                                             Title="Distance rings"
                                                             Ring="{x:Bind ViewModel.Radar.RangeRings.Distance}"
                                                             IsEditable="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}"
                                                             ColorKey="ring.color.distance"/>

        <ringsSettingsConsoles:RingsSettingsConsoleLabels x:Name="RingsSettingsConsoleLabels" ViewModel="{x:Bind ViewModel}"/>
        <ringsSettingsConsoles:RingsSettingsConsoleRuler x:Name="RingsSettingsConsoleRuler" ViewModel="{x:Bind ViewModel}"/>

        <prim:CautionResetButton x:Name="RingsSettingsResetAllButton"
                                 Text="Reset all Rings &amp; Ruler settings" Click="OnResetAll"
                                 ToolTipService.ToolTip="Every Rings &amp; Ruler card back to its DEFAULT column (asks first)"/>
    </StackPanel>
</UserControl>
