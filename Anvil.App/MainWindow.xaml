<?xml version="1.0" encoding="utf-8"?>
<!-- MainWindow — the app shell. The map fills the whole window; the entire UI is ONE bar overlaid on
     its bottom edge.

       ┌─────────────────────────────┬─────────────────────────────┐
       │ Ref                         │ Vel                         │  pane watermarks — top-left
       │        map pane 2           │        map pane 3           │  of each pane, the ONLY thing
       ├─────────────────────────────┼─────────────────────────────┤  drawn inside a pane (quad
       │ SRV                         │ CC                          │  shown; single/two collapse
       │    map pane 0  (MAIN)       │        map pane 1           │  to fewer cells)
       ├─────────────────────────────┴─────────────────────────────┤
       │                       ╭─ Hide ─╮                          │  OverlayBar pull-tab
       │  [chip] │ ═════ scrubber ═════      [Past][Now][Fore]     │
       │         │ tilt ◀▶ frame · site   [panes][dev][map][sites][cog] │
       └───────────────────────────────────────────────────────────┘

     Left of the bar is RadarControls (per-pane chips + the one global time module); right is the
     global cluster — temporal mode pills stacked over the app-wide window buttons. The gap between
     them is empty bar, by design.

     There is no top bar any more. It existed to hold the controls that must not repeat per pane —
     but once the bottom bar was split into a per-pane cluster and a global cluster, that distinction
     lives INSIDE one bar and the second strip of chrome was pure cost (a band of map covered at the
     top AND the bottom). -->
<Window
    x:Class="Anvil.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anvil"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:Anvil.Models"
    xmlns:vm="using:Anvil.ViewModels"
    xmlns:ctl="using:Anvil.Controls.Primitives"
    xmlns:comp="using:Anvil.Controls.Composites"
    mc:Ignorable="d"
    Title="Anvil">

    <!-- Two overlay rows (see the sketch at the top of the file):
           Row 0 — the map band (the map shows through). Every panel that pops over the map is a real
                   top-level OS window owned by WindowManager, so nothing floats in-window.
           Row 1 — the bottom bar, pinned to the bottom edge. Its LEFT is RadarControls (the pane chips +
                   the global time module); its RIGHT is the global cluster below. The map RowSpans both,
                   so the boundary is invisible and costs the map nothing. -->
    <Grid Background="#FF0A0A0A">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>    <!-- map band (the map shows through) -->
            <RowDefinition Height="Auto"/> <!-- bottom bar (tab + bar), pinned to the bottom -->
        </Grid.RowDefinitions>

        <!-- Full-window map (bottom layer; the bar floats on top of it). -->
        <controls:WebView2 x:Name="MainMapWebView" Grid.Row="0" Grid.RowSpan="2"/>

        <!-- ===== PANE WATERMARKS =====
             One per pane: the ONLY thing drawn inside a pane, since panes carry no chrome.

             This is a 3x3 [*, gutter, *] grid laid over EXACTLY the WebView's rect (Row 0 + RowSpan 2,
             matching the WebView above), so its cells coincide with the page's pane rects: the page
             splits the same area the same way, both using PaneLayoutInfo.GutterPx. Each watermark is
             placed by PaneLayoutInfo.CellOf via the x:Bind functions below, and self-aligns to its
             cell's top-left.

             ⚠️ The pane ARRANGEMENT (pane 0 = main = bottom-left) is expressed twice: here through
             CellOf, and in map.js paneRects() which lays out the real maps. Same rule, opposite sides of
             the WebView boundary — change both.

             It lives in XAML rather than in the page so the whole visual is editable under XAML Hot
             Reload while the app runs, and so it picks up the app's theme brushes. -->
        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{x:Bind PaneGutter}"/> <!-- the groove -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="{x:Bind PaneGutter}"/>   <!-- the groove -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ctl:PaneWatermark Text="{x:Bind ViewModel.Radar.Pane0.ShortLabel, Mode=OneWay}"
                               Visibility="{x:Bind WatermarkVisibility(ViewModel.Radar.IsTransportEnabled, ViewModel.Radar.Pane0.IsVisible), Mode=OneWay}"
                               Grid.Row="{x:Bind PaneRow(ViewModel.Radar.PaneLayout, 0), Mode=OneWay}"
                               Grid.Column="{x:Bind PaneColumn(ViewModel.Radar.PaneLayout, 0), Mode=OneWay}"
                               Grid.RowSpan="{x:Bind PaneRowSpan(ViewModel.Radar.PaneLayout, 0), Mode=OneWay}"
                               Grid.ColumnSpan="{x:Bind PaneColumnSpan(ViewModel.Radar.PaneLayout, 0), Mode=OneWay}"/>
            <ctl:PaneWatermark Text="{x:Bind ViewModel.Radar.Pane1.ShortLabel, Mode=OneWay}"
                               Visibility="{x:Bind WatermarkVisibility(ViewModel.Radar.IsTransportEnabled, ViewModel.Radar.Pane1.IsVisible), Mode=OneWay}"
                               Grid.Row="{x:Bind PaneRow(ViewModel.Radar.PaneLayout, 1), Mode=OneWay}"
                               Grid.Column="{x:Bind PaneColumn(ViewModel.Radar.PaneLayout, 1), Mode=OneWay}"
                               Grid.RowSpan="{x:Bind PaneRowSpan(ViewModel.Radar.PaneLayout, 1), Mode=OneWay}"
                               Grid.ColumnSpan="{x:Bind PaneColumnSpan(ViewModel.Radar.PaneLayout, 1), Mode=OneWay}"/>
            <ctl:PaneWatermark Text="{x:Bind ViewModel.Radar.Pane2.ShortLabel, Mode=OneWay}"
                               Visibility="{x:Bind WatermarkVisibility(ViewModel.Radar.IsTransportEnabled, ViewModel.Radar.Pane2.IsVisible), Mode=OneWay}"
                               Grid.Row="{x:Bind PaneRow(ViewModel.Radar.PaneLayout, 2), Mode=OneWay}"
                               Grid.Column="{x:Bind PaneColumn(ViewModel.Radar.PaneLayout, 2), Mode=OneWay}"
                               Grid.RowSpan="{x:Bind PaneRowSpan(ViewModel.Radar.PaneLayout, 2), Mode=OneWay}"
                               Grid.ColumnSpan="{x:Bind PaneColumnSpan(ViewModel.Radar.PaneLayout, 2), Mode=OneWay}"/>
            <ctl:PaneWatermark Text="{x:Bind ViewModel.Radar.Pane3.ShortLabel, Mode=OneWay}"
                               Visibility="{x:Bind WatermarkVisibility(ViewModel.Radar.IsTransportEnabled, ViewModel.Radar.Pane3.IsVisible), Mode=OneWay}"
                               Grid.Row="{x:Bind PaneRow(ViewModel.Radar.PaneLayout, 3), Mode=OneWay}"
                               Grid.Column="{x:Bind PaneColumn(ViewModel.Radar.PaneLayout, 3), Mode=OneWay}"
                               Grid.RowSpan="{x:Bind PaneRowSpan(ViewModel.Radar.PaneLayout, 3), Mode=OneWay}"
                               Grid.ColumnSpan="{x:Bind PaneColumnSpan(ViewModel.Radar.PaneLayout, 3), Mode=OneWay}"/>
        </Grid>

        <!-- ===== Row 1: the bottom bar. Left = the radar console; right = the global cluster (temporal
             modes over the window buttons). The empty space between them is bar, by design: the scrubber
             stops at the end of the site readout rather than stretching the full width. ===== -->
        <ctl:OverlayBar Grid.Row="1">
            <ctl:OverlayBar.BarContent>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>    <!-- radar console, left-aligned -->
                        <ColumnDefinition Width="Auto"/> <!-- global cluster, right edge -->
                    </Grid.ColumnDefinitions>

                    <!-- PER-PANE + TIME. In multi-pane the chip cluster inside this grows to a 2x2 that
                         mirrors the pane grid; the time module beside it does not multiply. -->
                    <comp:RadarControls Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ViewModel="{x:Bind ViewModel.Radar}"/>

                    <!-- ===== GLOBAL CLUSTER =====
                         Two rows so it matches the time module's height: the temporal mode pills above,
                         the app-wide window buttons below. Nothing here repeats per pane. Each button
                         latches while its window is open (its IsChecked two-ways with the open flag). -->
                    <Grid Grid.Column="1"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Past / Now / Fore -->
                            <RowDefinition Height="Auto"/> <!-- window buttons -->
                        </Grid.RowDefinitions>

                        <comp:TemporalToggles Grid.Row="0"
                                                  HorizontalAlignment="Right"
                                                  ViewModel="{x:Bind ViewModel}"/>

                        <Grid Grid.Row="1" HorizontalAlignment="Right" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- pane layout -->
                                <ColumnDefinition Width="Auto"/> <!-- dev tools (Debug only) -->
                                <ColumnDefinition Width="Auto"/> <!-- map controls -->
                                <ColumnDefinition Width="Auto"/> <!-- site explorer -->
                                <ColumnDefinition Width="Auto"/> <!-- app settings -->
                            </Grid.ColumnDefinitions>

                            <!-- PANE LAYOUT. Sits here as one click rather than inside a window because it
                                 IS the view mode. Each item picks the pane grid; the chip cluster in
                                 RadarControls mirrors it, as do the watermarks above.
                                 There is deliberately no "two stacked": weather is read left-to-right
                                 across a storm, and a stacked pair halves the vertical extent that matters
                                 most on a wide monitor. -->
                            <Button Grid.Column="0" Width="32" Height="32"
                                    MinWidth="0" MinHeight="0" Padding="0" CornerRadius="6"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16"
                                    Content="&#xE8A9;"
                                    ToolTipService.ToolTip="Pane layout">
                                <Button.Flyout>
                                    <MenuFlyout Placement="Top">
                                        <RadioMenuFlyoutItem Text="Single pane" GroupName="PaneLayout"
                                                             Click="OnPaneLayoutSingle"
                                                             IsChecked="{x:Bind IsSinglePane(ViewModel.Radar.PaneLayout), Mode=OneWay}"/>
                                        <RadioMenuFlyoutItem Text="Two across" GroupName="PaneLayout"
                                                             Click="OnPaneLayoutTwoAcross"
                                                             IsChecked="{x:Bind IsTwoAcross(ViewModel.Radar.PaneLayout), Mode=OneWay}"/>
                                        <RadioMenuFlyoutItem Text="Four panes" GroupName="PaneLayout"
                                                             Click="OnPaneLayoutQuad"
                                                             IsChecked="{x:Bind IsQuad(ViewModel.Radar.PaneLayout), Mode=OneWay}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <!-- DEV-ONLY: the combined dev-tools window (site sweep + dealias validation).
                                 Collapsed in Release via DevVisibility. -->
                            <ToggleButton Grid.Column="1" Width="32" Height="32"
                                          MinWidth="0" MinHeight="0" Padding="0" CornerRadius="6"
                                          Visibility="{x:Bind DevVisibility}"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16"
                                          Content="&#xE9F5;"
                                          ToolTipService.ToolTip="Dev tools — site sweep &amp; dealias validation"
                                          IsChecked="{x:Bind ViewModel.IsDevToolsWindowOpen, Mode=TwoWay}"/>
                            <!-- Map Controls: the GLOBAL map controls (basemap, view, state isolation,
                                 radar-site markers, mile grid, Inspect). -->
                            <ToggleButton Grid.Column="2" Width="32" Height="32"
                                          MinWidth="0" MinHeight="0" Padding="0" CornerRadius="6"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16"
                                          Content="&#xE774;"
                                          ToolTipService.ToolTip="Map controls — basemap, site markers, isolation &amp; Inspect"
                                          IsChecked="{x:Bind ViewModel.IsMapControlsWindowOpen, Mode=TwoWay}"/>
                            <ToggleButton Grid.Column="3" Width="32" Height="32"
                                          MinWidth="0" MinHeight="0" Padding="0" CornerRadius="6"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16"
                                          Content="&#xE81E;"
                                          ToolTipService.ToolTip="Radar site explorer"
                                          IsChecked="{x:Bind ViewModel.IsSiteExplorerOpen, Mode=TwoWay}"/>
                            <ToggleButton Grid.Column="4" Width="32" Height="32"
                                          MinWidth="0" MinHeight="0" Padding="0" CornerRadius="6"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16"
                                          Content="&#xE713;"
                                          ToolTipService.ToolTip="App settings"
                                          IsChecked="{x:Bind ViewModel.IsSettingsWindowOpen, Mode=TwoWay}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </ctl:OverlayBar.BarContent>
        </ctl:OverlayBar>
    </Grid>
</Window>
