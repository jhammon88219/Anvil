<?xml version="1.0" encoding="utf-8"?>
<!-- MainWindow — the app shell. The map fills the whole window; the entire UI is ONE bar overlaid on
     its bottom edge.

       ┌─────────────────────────────┬─────────────────────────────┐
       │ Ref                         │ Vel                         │  pane watermarks — top-left
       │        map pane 2           │        map pane 3           │  of each pane, the ONLY thing
       ├─────────────────────────────┼─────────────────────────────┤  drawn inside a pane (quad
       │ SRV                         │ CC                          │  shown; single/two collapse
       │    map pane 0  (MAIN)       │        map pane 1           │  to fewer cells)
       ├─────────────────────────────┴─────────────────────────────┤
       │                       ╭─ Hide ─╮                          │  OverlayBar pull-tab
       │ [chip] │ ══ scrubber ══                                    │
       │        │ tilt ◀▶ frame · site  [Past][Now][Fore]     [▫▫]  [dev][map][sites][cog] │
       └────────────────────────────────┴──────────────────────────┘
                                        ↑ bar midpoint — the keys straddle it, always
                                                                 ↑ pane layout: ONE key that
                                                                   CYCLES 1→2→4, its icon
                                                                   drawing what the NEXT click
                                                                   gives you; then the window
                                                                   buttons (wider gap between)

     Left of the bar is RadarControls (per-pane chips + the one global time module); the CENTER is the
     three temporal mode keys, held on the bar's exact midpoint by a [*, Auto, *] grid so no amount of
     growth on either side can shift them (quad panes add chips on the left — the keys do not move);
     right is the pane-layout key then the app-wide window buttons. The gaps between the three
     clusters are empty bar, by design.

     ⚠️ EVERY key in this bar — the three temporal keys and all five on the right — takes its LOOK from
     ONE style chain in Controls/Styles.xaml (BarChromeButtonStyle → TemporalKeyStyle /
     BarIconToggleStyle / BarIconButtonStyle):
     hairline at rest, accent BORDER + raised face when ON. And they are all the SAME SQUARE: neither
     cluster hardcodes a size, each measures the height its row was given and mirrors it onto Width, via
     the shared Layout/BarKeyMetrics (right cluster: OnRightClusterSizeChanged below; centre:
     TemporalToggles' own code-behind). Nothing here should set a size, corner radius or font per
     instance — that is what put ~40 duplicated attributes in this file before.
     The transport buttons in RadarControls are the one cluster still on the old stock look.

     There is no top bar any more. It existed to hold the controls that must not repeat per pane —
     but once the bottom bar was split into a per-pane cluster and a global cluster, that distinction
     lives INSIDE one bar and the second strip of chrome was pure cost (a band of map covered at the
     top AND the bottom). -->
<Window
    x:Class="Anvil.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anvil"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:Anvil.Models"
    xmlns:vm="using:Anvil.ViewModels"
    xmlns:ctl="using:Anvil.Controls.Primitives"
    xmlns:comp="using:Anvil.Controls.Composites"
    mc:Ignorable="d"
    Title="Anvil">

    <!-- Two overlay rows (see the sketch at the top of the file):
           Row 0 — the map band (the map shows through). Every panel that pops over the map is a real
                   top-level OS window owned by WindowManager, so nothing floats in-window.
           Row 1 — the bottom bar, pinned to the bottom edge. Its LEFT is RadarControls (the pane chips +
                   the global time module); its RIGHT is the global cluster below. The map RowSpans both,
                   so the boundary is invisible and costs the map nothing. -->
    <Grid Background="#FF0A0A0A">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>    <!-- map band (the map shows through) -->
            <RowDefinition Height="Auto"/> <!-- bottom bar (tab + bar), pinned to the bottom -->
        </Grid.RowDefinitions>

        <!-- Full-window map (bottom layer; the bar floats on top of it). -->
        <controls:WebView2 x:Name="MainMapWebView" Grid.Row="0" Grid.RowSpan="2"/>

        <!-- ===== PANE WATERMARKS =====
             One per pane: the ONLY thing drawn inside a pane, since panes carry no chrome.

             This is a 3x3 [*, gutter, *] grid laid over EXACTLY the WebView's rect (Row 0 + RowSpan 2,
             matching the WebView above), so its cells coincide with the page's pane rects: the page
             splits the same area the same way, both using PaneLayoutInfo.GutterPx. Each watermark is
             placed by PaneLayoutInfo.CellOf via the x:Bind functions below, and self-aligns to its
             cell's top-left.

             ⚠️ The pane ARRANGEMENT (pane 0 = main = bottom-left) is expressed twice: here through
             CellOf, and in map.js paneRects() which lays out the real maps. Same rule, opposite sides of
             the WebView boundary — change both.

             It lives in XAML rather than in the page so the whole visual is editable under XAML Hot
             Reload while the app runs, and so it picks up the app's theme brushes. -->
        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{x:Bind PaneGutter}"/> <!-- the groove -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="{x:Bind PaneGutter}"/>   <!-- the groove -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ctl:PaneWatermark Text="{x:Bind ViewModel.Radar.Pane0.ShortLabel, Mode=OneWay}"
                               Visibility="{x:Bind WatermarkVisibility(ViewModel.Radar.IsTransportEnabled, ViewModel.Radar.Pane0.IsVisible), Mode=OneWay}"
                               Grid.Row="{x:Bind PaneRow(ViewModel.Radar.PaneLayout, 0), Mode=OneWay}"
                               Grid.Column="{x:Bind PaneColumn(ViewModel.Radar.PaneLayout, 0), Mode=OneWay}"
                               Grid.RowSpan="{x:Bind PaneRowSpan(ViewModel.Radar.PaneLayout, 0), Mode=OneWay}"
                               Grid.ColumnSpan="{x:Bind PaneColumnSpan(ViewModel.Radar.PaneLayout, 0), Mode=OneWay}"/>
            <ctl:PaneWatermark Text="{x:Bind ViewModel.Radar.Pane1.ShortLabel, Mode=OneWay}"
                               Visibility="{x:Bind WatermarkVisibility(ViewModel.Radar.IsTransportEnabled, ViewModel.Radar.Pane1.IsVisible), Mode=OneWay}"
                               Grid.Row="{x:Bind PaneRow(ViewModel.Radar.PaneLayout, 1), Mode=OneWay}"
                               Grid.Column="{x:Bind PaneColumn(ViewModel.Radar.PaneLayout, 1), Mode=OneWay}"
                               Grid.RowSpan="{x:Bind PaneRowSpan(ViewModel.Radar.PaneLayout, 1), Mode=OneWay}"
                               Grid.ColumnSpan="{x:Bind PaneColumnSpan(ViewModel.Radar.PaneLayout, 1), Mode=OneWay}"/>
            <ctl:PaneWatermark Text="{x:Bind ViewModel.Radar.Pane2.ShortLabel, Mode=OneWay}"
                               Visibility="{x:Bind WatermarkVisibility(ViewModel.Radar.IsTransportEnabled, ViewModel.Radar.Pane2.IsVisible), Mode=OneWay}"
                               Grid.Row="{x:Bind PaneRow(ViewModel.Radar.PaneLayout, 2), Mode=OneWay}"
                               Grid.Column="{x:Bind PaneColumn(ViewModel.Radar.PaneLayout, 2), Mode=OneWay}"
                               Grid.RowSpan="{x:Bind PaneRowSpan(ViewModel.Radar.PaneLayout, 2), Mode=OneWay}"
                               Grid.ColumnSpan="{x:Bind PaneColumnSpan(ViewModel.Radar.PaneLayout, 2), Mode=OneWay}"/>
            <ctl:PaneWatermark Text="{x:Bind ViewModel.Radar.Pane3.ShortLabel, Mode=OneWay}"
                               Visibility="{x:Bind WatermarkVisibility(ViewModel.Radar.IsTransportEnabled, ViewModel.Radar.Pane3.IsVisible), Mode=OneWay}"
                               Grid.Row="{x:Bind PaneRow(ViewModel.Radar.PaneLayout, 3), Mode=OneWay}"
                               Grid.Column="{x:Bind PaneColumn(ViewModel.Radar.PaneLayout, 3), Mode=OneWay}"
                               Grid.RowSpan="{x:Bind PaneRowSpan(ViewModel.Radar.PaneLayout, 3), Mode=OneWay}"
                               Grid.ColumnSpan="{x:Bind PaneColumnSpan(ViewModel.Radar.PaneLayout, 3), Mode=OneWay}"/>
        </Grid>

        <!-- ===== Row 1: the bottom bar. Left = the radar console; CENTER = the temporal mode pills;
             right = the app-wide window buttons. The empty space between them is bar, by design: the
             scrubber stops at the end of the site readout rather than stretching the full width.

             ⚠️ THE PILLS ARE PINNED TO THE BAR'S TRUE HORIZONTAL CENTER and nothing may move them.
             That is why the outer grid is [*, Auto, *] and NOT a content-driven [Auto, Auto, Auto] or a
             pair of stretched halves: two EQUAL star columns split whatever is left over, so the Auto
             column between them lands on the midpoint of the bar no matter how wide either side gets.
             Multi-pane grows the chip cluster on the left (quad = a 2x2 of product combos) — the star
             columns absorb that and the pills do NOT drift. If the left ever grows past its half it
             simply overlaps rather than pushing; the pills are LAST in markup so they stay on top and
             clickable. ===== -->
        <ctl:OverlayBar Grid.Row="1">
            <ctl:OverlayBar.BarContent>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>    <!-- radar console, left-aligned  ┐ equal stars: -->
                        <ColumnDefinition Width="Auto"/> <!-- temporal pills, DEAD CENTER  │ the Auto     -->
                        <ColumnDefinition Width="*"/>    <!-- window buttons, right edge   ┘ sits centered-->
                    </Grid.ColumnDefinitions>

                    <!-- PER-PANE + TIME. In multi-pane the chip cluster inside this grows to a 2x2 that
                         mirrors the pane grid; the time module beside it does not multiply. -->
                    <comp:RadarControls Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ViewModel="{x:Bind ViewModel.Radar}"/>

                    <!-- ===== GLOBAL CLUSTER =====
                         Every key here shares the bar's one look with the temporal keys at the centre:
                         hairline at rest, accent border + raised face when ON. Nothing here repeats per
                         pane.

                         The wider gap between the two groups is the only thing separating them — they are
                         different KINDS of control and a plain gap says so without adding a divider line:
                           left  — pane layout, an ACTION that cycles (its icon is the readout, never lit)
                           right — window buttons, four INDEPENDENT latches (any combination open) -->
                    <Grid x:Name="RightCluster"
                          Grid.Column="2"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Stretch"
                          ColumnSpacing="14"
                          SizeChanged="OnRightClusterSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- pane layout (one cycling key) -->
                            <ColumnDefinition Width="Auto"/> <!-- window buttons (independent) -->
                        </Grid.ColumnDefinitions>

                        <!-- ===== PANE LAYOUT — ONE key that CYCLES =====
                             Sits in the bar rather than inside a window because it IS the view mode. One
                             key, not one per layout: a click advances Single → Two across → Quad → Single.

                             ⚠️ THE ICON DRAWS THE **NEXT** LAYOUT, NOT THE CURRENT ONE — it advertises what
                             the click will DO, the way a play button shows a play triangle while paused.
                             Drawing the current layout was tried and is confusing: the app opens in single
                             pane showing a single square, which reads as "click me for one pane". So in
                             quad you see the single-square icon, because that is where the next click lands.
                             It binds Radar.NextPaneLayout for exactly this reason.

                             ⚠️ Consequence, and it is deliberate: this key no longer reports the CURRENT
                             layout. The map itself and the chip cluster in RadarControls both show that, and
                             the tooltip names it in words — an action control that lies about its action is
                             the worse trade.

                             ⚠️ It is a Button, NOT a ToggleButton, and never lights. There is no "off" pane
                             layout to be un-lit — every state is an on-state — so the accent border would
                             be meaningless here. Its neighbours latch because their windows really are
                             open or closed; this one is an action.

                             ⚠️ The ORDER lives in the view model (Radar.NextPaneLayout / CyclePaneLayout),
                             not here. The view knows only "advance" and "draw what is next"; it does not
                             own the sequence, or the icon and the click could disagree.

                             There is deliberately no "two stacked": weather is read left-to-right across a
                             storm, and a stacked pair halves the vertical extent that matters most on a
                             wide monitor.

                             ⚠️ The ICONS are drawn (Rectangles), not font glyphs: Segoe Fluent has no clean
                             1 / 2 / 4-pane trio, and a drawn icon states the layout exactly — each is a
                             little picture of a pane grid. All three are stacked in the one cell and only
                             the NEXT layout's is visible. They are STROKED, not filled: everything beside
                             them is a thin-outline Segoe Fluent glyph, and solid blocks read heavier and
                             denser than their neighbours. The brush is fixed because Shapes do not inherit
                             the content Foreground that the template's states drive.
                             ⚠️ Hollow shapes do NOT cost the key its click target — the template's Surface
                             Border has Background="Transparent", which hit-tests across the whole key. -->
                        <Button x:Name="PaneLayoutKey"
                                Grid.Column="0"
                                Style="{StaticResource BarIconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind PaneLayoutTooltip(ViewModel.Radar.PaneLayout), Mode=OneWay}"
                                Click="OnCyclePaneLayout">
                            <Grid>
                                <Grid x:Name="SinglePaneIcon" Width="14" Height="14"
                                      Visibility="{x:Bind SinglePaneVisibility(ViewModel.Radar.NextPaneLayout), Mode=OneWay}">
                                    <Rectangle Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" RadiusX="1" RadiusY="1"/>
                                </Grid>

                                <Grid x:Name="DualPaneIcon" Width="14" Height="14" ColumnSpacing="2"
                                      Visibility="{x:Bind DualPaneVisibility(ViewModel.Radar.NextPaneLayout), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" RadiusX="1" RadiusY="1"/>
                                    <Rectangle Grid.Column="1" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" RadiusX="1" RadiusY="1"/>
                                </Grid>

                                <Grid x:Name="QuadPaneIcon" Width="14" Height="14" ColumnSpacing="2" RowSpacing="2"
                                      Visibility="{x:Bind QuadPaneVisibility(ViewModel.Radar.NextPaneLayout), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="0" Grid.Column="0" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" RadiusX="1" RadiusY="1"/>
                                    <Rectangle Grid.Row="0" Grid.Column="1" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" RadiusX="1" RadiusY="1"/>
                                    <Rectangle Grid.Row="1" Grid.Column="0" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" RadiusX="1" RadiusY="1"/>
                                    <Rectangle Grid.Row="1" Grid.Column="1" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" RadiusX="1" RadiusY="1"/>
                                </Grid>
                            </Grid>
                        </Button>

                        <!-- ===== WINDOW BUTTONS =====
                             Each latches while its window is open (IsChecked two-ways with the open flag),
                             and any combination may be open at once. -->
                        <Grid Grid.Column="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- dev tools (Debug only) -->
                                <ColumnDefinition Width="Auto"/> <!-- map controls -->
                                <ColumnDefinition Width="Auto"/> <!-- site explorer -->
                                <ColumnDefinition Width="Auto"/> <!-- app settings -->
                            </Grid.ColumnDefinitions>

                            <!-- DEV-ONLY: the combined dev-tools window (site sweep + dealias validation).
                                 Collapsed in Release via DevVisibility. -->
                            <ToggleButton x:Name="DevKey"
                                          Grid.Column="0"
                                          Style="{StaticResource BarIconToggleStyle}"
                                          Visibility="{x:Bind DevVisibility}"
                                          Content="&#xE912;"
                                          ToolTipService.ToolTip="Dev tools — site sweep &amp; dealias validation"
                                          IsChecked="{x:Bind ViewModel.IsDevToolsWindowOpen, Mode=TwoWay}"/>
                            <!-- Map Controls: the GLOBAL map controls (basemap, view, state isolation,
                                 radar-site markers, mile grid, Inspect). -->
                            <ToggleButton x:Name="MapKey"
                                          Grid.Column="1"
                                          Style="{StaticResource BarIconToggleStyle}"
                                          Content="&#xE774;"
                                          ToolTipService.ToolTip="Map controls — basemap, site markers, isolation &amp; Inspect"
                                          IsChecked="{x:Bind ViewModel.IsMapControlsWindowOpen, Mode=TwoWay}"/>
                            <ToggleButton x:Name="SitesKey"
                                          Grid.Column="2"
                                          Style="{StaticResource BarIconToggleStyle}"
                                          Content="&#xEC05;"
                                          ToolTipService.ToolTip="Radar site explorer"
                                          IsChecked="{x:Bind ViewModel.IsSiteExplorerOpen, Mode=TwoWay}"/>
                            <ToggleButton x:Name="SettingsKey"
                                          Grid.Column="3"
                                          Style="{StaticResource BarIconToggleStyle}"
                                          Content="&#xE713;"
                                          ToolTipService.ToolTip="App settings"
                                          IsChecked="{x:Bind ViewModel.IsSettingsWindowOpen, Mode=TwoWay}"/>
                        </Grid>
                    </Grid>

                    <!-- ===== TEMPORAL MODE KEYS — THE BAR'S CENTERPIECE =====
                         The Auto column between two equal stars, so this is the bar's exact midpoint
                         (see the ⚠️ above). LAST in markup on purpose: if the console on the left ever
                         outgrows its half it slides UNDER these rather than over them, so the keys stay
                         clickable. Past excludes Now/Fore; Now and Fore coexist.
                         ⚠️ VerticalAlignment=Stretch is REQUIRED, not cosmetic: the keys are squares
                         measured off the height they are given, so centring this instead would collapse
                         the row to its content height and shrink them to nothing. -->
                    <comp:TemporalToggles Grid.Column="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Stretch"
                                          ViewModel="{x:Bind ViewModel}"/>
                </Grid>
            </ctl:OverlayBar.BarContent>
        </ctl:OverlayBar>
    </Grid>
</Window>
