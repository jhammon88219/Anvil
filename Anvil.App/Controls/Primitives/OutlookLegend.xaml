<?xml version="1.0" encoding="utf-8"?>
<!-- OutlookLegend — the SPC outlook's key: the official NOAA swatch + name for every level of the picked
     product's scale, then (probabilistic products only) the Conditional Intensity hatching block. Shared by
     the ForeCast and PastCast outlook sections, which each drop it in as the LAST thing in the section body.

       ›  Legend ───────────────────────────────────         ← a MINIMAL FOLD (the user's call, 2026-10-28): chevron +
                                                                 word + hairline, no box; FOLDED by default, the host
                                                                 persists it (IsExpanded + ExpandedChanged → SectionExpanded
                                                                 "fore/outlook-legend" / "past/outlook-legend"). Open:
        ▬▬ 2%                Opacity ────●──── 80%          ← hatch opacity (lines + outline; the user's call,
        ▬▬ 5%                  Intensity hatching  [✓] Show       2026-10-28), greyed while Show is off
        ▬▬ 10%                 ╱ ╱ CIG1        In Outlook      ← two EQUAL halves, both left + top aligned
        ▬▬ 15%                 ╲╲ CIG2         In Outlook         (the user's call, 2026-10-01; hatching was
        ▬▬ 30%                 ╳╳ CIG3     Not In Outlook          stacked UNDER the colours). Right half only
        ▬▬ 45%                    ^ dimmed                         when HatchRows.Count > 0, else left EMPTY
        ▬▬ 60%                                                     (colours don't jump on a product change).
                                                               ← swatch 40 × 16 (the user's call, 2026-09-30),
                                                                  both templates

     ⚠️ IT IS PART OF ITS SECTION, so collapsing the section hides it; the host hides it ITSELF when there
     is nothing to key (None, or the layer hidden) by binding Visibility to the VM's HasLegend.
     ⚠️ A Conditional Intensity Group is drawn as HATCHING over the fill, and the DIRECTION is the only
     thing telling the groups apart — every CIG level is black. So the swatch traces outlook.js's sig-hatch
     tiles exactly: three Paths — dashed '/' (CIG1), solid '/' and solid '\' (CIG2 = '\', CIG3 = both) —
     shown by the same slashDashed/slash/backslash split makeHatchImage uses. Getting a direction wrong here
     makes the legend disagree with our own map AND with spc.noaa.gov (ESRI's BackwardDiagonal is '/').
     The dash keeps the map tile's proportions (dash .65 : gap .35 of the line spacing).
     ⚠️ A hatch swatch's BORDER is the hatch ink (ThemeResource), not the catalog's black stroke — the map
     outlines every hatched area in that ink (outlook.js spc-outlook-sig-line); black vanished on dark.
     ⚠️ The hatch lines are TRUE 45° lines every 7 units, running past the swatch and CLIPPED to it (Grid.Clip) —
     never a Stretch, which would skew the angle on a non-square swatch. Resize = new Width/Height, a matching
     Clip rect, and lines that still span it (x from −Height to Width, step 7).
     ⚠️ "In Outlook" is read from the CACHED file, not the catalog — with hatching hidden, those rows are
     the reminder that it exists.
     Types: Entries = SpcRiskLevel, HatchRows = OutlookHatchLegendRow (Anvil.Models). -->
<UserControl x:Class="Anvil.Controls.Primitives.OutlookLegend"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Anvil.Converters"
             xmlns:local="using:Anvil.Controls.Primitives"
             xmlns:models="using:Anvil.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>

        <!-- One solid level: swatch (fill + stroke from SpcRiskCatalog) beside the level's own name. -->
        <DataTemplate x:Key="OutlookLegendItemTemplate" x:DataType="models:SpcRiskLevel">
            <Grid Margin="0,2" ColumnSpacing="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="16" VerticalAlignment="Center">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,40,16"/>
                    </Grid.Clip>
                    <Border Background="{x:Bind Fill, Converter={StaticResource HexToBrush}}"
                            BorderBrush="{x:Bind Stroke, Converter={StaticResource HexToBrush}}"
                            BorderThickness="1" CornerRadius="2"/>
                    <Path Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1"
                          Visibility="{x:Bind local:OutlookLegend.HatchBackslash(Hatch)}"
                          Data="M-14,0 L2,16 M-7,0 L9,16 M0,0 L16,16 M7,0 L23,16 M14,0 L30,16 M21,0 L37,16 M28,0 L44,16 M35,0 L51,16"/>
                    <Path Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1"
                          Visibility="{x:Bind local:OutlookLegend.HatchSlash(Hatch)}"
                          Data="M-14,16 L2,0 M-7,16 L9,0 M0,16 L16,0 M7,16 L23,0 M14,16 L30,0 M21,16 L37,0 M28,16 L44,0 M35,16 L51,0"/>
                    <Path Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1" StrokeDashArray="3.2 1.8"
                          Visibility="{x:Bind local:OutlookLegend.HatchSlashDashed(Hatch)}"
                          Data="M-14,16 L2,0 M-7,16 L9,0 M0,16 L16,0 M7,16 L23,0 M14,16 L30,0 M21,16 L37,0 M28,16 L44,0 M35,16 L51,0"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{x:Bind OfficialName}"
                           FontSize="13" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </DataTemplate>

        <!-- One Conditional Intensity Group: hatch swatch, name, and whether the outlook carries it. A group
             NOT in the outlook is dimmed as well as worded, so the "In Outlook" rows are what the eye lands on. -->
        <DataTemplate x:Key="OutlookHatchRowTemplate" x:DataType="models:OutlookHatchLegendRow">
            <Grid Margin="0,2" ColumnSpacing="9" Opacity="{x:Bind local:OutlookLegend.HatchRowOpacity(InOutlook)}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="16" VerticalAlignment="Center">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,40,16"/>
                    </Grid.Clip>
                    <Border Background="{x:Bind Level.Fill, Converter={StaticResource HexToBrush}}"
                            BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                            BorderThickness="1" CornerRadius="2"/>
                    <Path Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1"
                          Visibility="{x:Bind local:OutlookLegend.HatchBackslash(Level.Hatch)}"
                          Data="M-14,0 L2,16 M-7,0 L9,16 M0,0 L16,16 M7,0 L23,16 M14,0 L30,16 M21,0 L37,16 M28,0 L44,16 M35,0 L51,16"/>
                    <Path Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1"
                          Visibility="{x:Bind local:OutlookLegend.HatchSlash(Level.Hatch)}"
                          Data="M-14,16 L2,0 M-7,16 L9,0 M0,16 L16,0 M7,16 L23,0 M14,16 L30,0 M21,16 L37,0 M28,16 L44,0 M35,16 L51,0"/>
                    <Path Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1" StrokeDashArray="3.2 1.8"
                          Visibility="{x:Bind local:OutlookLegend.HatchSlashDashed(Level.Hatch)}"
                          Data="M-14,16 L2,0 M-7,16 L9,0 M0,16 L16,0 M7,16 L23,0 M14,16 L30,0 M21,16 L37,0 M28,16 L44,0 M35,16 L51,0"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{x:Bind Level.OfficialName}"
                           FontSize="13" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="{x:Bind StatusText}"
                           FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- THE FOLD: chevron · "Legend" · hairline to the edge. The same flat button as the warnings' ENDED fold. -->
        <Button x:Name="OutlookLegendFoldButton" Margin="0,8,0,0" Padding="0" Height="26"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                Background="Transparent" BorderThickness="0" CornerRadius="4"
                AutomationProperties.Name="{x:Bind FoldName(IsExpanded), Mode=OneWay}"
                Click="OnFoldClick">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform Angle="{x:Bind ChevronAngle(IsExpanded), Mode=OneWay}"/>
                    </FontIcon.RenderTransform>
                </FontIcon>
                <TextBlock Grid.Column="1" Text="Legend" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                        Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
            </Grid>
        </Button>

        <!-- Two EQUAL halves, both top-aligned: colours left, hatching right. The right half stays empty (not
             reclaimed) on a product with no intensity groups, so the colours never jump when the product changes. -->
        <Grid x:Name="OutlookLegendBody" ColumnSpacing="16" Margin="0,8,0,0"
              Visibility="{x:Bind Shown(IsExpanded), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ItemsControl VerticalAlignment="Top"
                          ItemsSource="{x:Bind Entries, Mode=OneWay}"
                          ItemTemplate="{StaticResource OutlookLegendItemTemplate}"/>

            <!-- Hatch opacity, then the heading + the Show box, then the groups. Absent on products with no
                 intensity groups. The slider fades the hatch lines AND their outline; greyed while Show is off. -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top"
                        Visibility="{x:Bind HasHatch(HatchRows), Mode=OneWay}">
                <Grid x:Name="HatchOpacityRow" Margin="0,0,0,2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Opacity" VerticalAlignment="Center"
                               Style="{StaticResource SettingsFieldLabelStyle}"/>
                    <Slider x:Name="HatchOpacitySlider" Grid.Column="1"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Minimum="0" Maximum="1"
                            StepFrequency="0.05" SmallChange="0.05" LargeChange="0.1"
                            IsThumbToolTipEnabled="False"
                            IsEnabled="{x:Bind ShowHatching, Mode=OneWay}"
                            Value="{x:Bind HatchOpacity, Mode=TwoWay}"
                            AutomationProperties.Name="Intensity hatching opacity"
                            ToolTipService.ToolTip="How strongly the hatched intensity areas are drawn">
                        <Slider.Resources>
                            <x:Double x:Key="SliderHorizontalHeight">18</x:Double>
                            <x:Double x:Key="SliderPreContentMargin">7</x:Double>
                            <x:Double x:Key="SliderPostContentMargin">7</x:Double>
                        </Slider.Resources>
                    </Slider>
                    <TextBlock Grid.Column="2" Style="{StaticResource TabularNumberTextStyle}"
                               Text="{x:Bind Percent(HatchOpacity), Mode=OneWay}"
                               Opacity="{x:Bind ReadoutOpacity(ShowHatching), Mode=OneWay}"
                               FontSize="12" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <Grid Margin="0,0,0,2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Intensity hatching" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource SettingsFieldLabelStyle}"/>
                    <CheckBox Grid.Column="1" Content="Show" MinWidth="0"
                              IsChecked="{x:Bind ShowHatching, Mode=TwoWay}"
                              ToolTipService.ToolTip="Show or hide the hatched intensity areas (fills stay)"/>
                </Grid>
                <ItemsControl ItemsSource="{x:Bind HatchRows, Mode=OneWay}"
                              ItemTemplate="{StaticResource OutlookHatchRowTemplate}"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
