<?xml version="1.0" encoding="utf-8"?>
<!-- GeneralSettingsConsoleStartup — Settings → General's "Startup" section (was the Startup page + the Radar page's
     duplicate Home site), on a Primitives/SettingsConsolePlate. General B (2026-11-16).

       Startup    [Restore defaults]                                                               DEFAULT
       Opens on   (•) Pick up where I left off        Opens Anvil in the state you closed it  Where I left off
                  ( ) Start in
                      [Map only|NowCast|ForeCast|Now + Fore|PastCast]   Select which Cast mode(s) …     NowCast
                                                  ↕ group break (SettingsGroupBreakSpace)
       Home site  KTLX · Norman                   Set it in the Atlas or from a site's map key         None
                  ☐ Load home site on launch      Only when Anvil starts in NowCast                     Off
                  ☐ Start in full screen          F11 or Esc leaves full screen                         Off
                  ☑ Show map setup at launch      While Anvil has no map set                             On
       96         420                             hint (one line)                               150, right

     ⚠️ Every row is a Primitives/SettingsConsoleRow (hover + select lifts; its words = Services/Settings/SettingsText by
     AboutKey). ⚠️ Read ONCE at launch (MapViewModel.RestoreTemporalSession at map-ready; full screen by MainWindow) — a change
     applies next launch; a fixed start is never saved over the last session. The home site is PICKED in the Radar Atlas; this
     shows it. Restore defaults asks first and CLEARS the home site (the user's call). -->
<UserControl x:Class="Anvil.Controls.GeneralSettingsConsoles.GeneralSettingsConsoleStartup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="GeneralSettingsConsoleStartupPlate" Title="Startup" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="StartupRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    ToolTipService.ToolTip="Put Startup back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <prim:SettingsConsoleRow Label="Opens on" AboutKey="startup.resume" Default="{x:Bind ViewModel.DefaultStartupResumeText}">
                <RadioButton x:Name="StartupResumeRadioButton" GroupName="StartupChoice" VerticalAlignment="Center"
                             Content="Pick up where I left off"
                             IsChecked="{x:Bind ViewModel.StartupResume, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <!-- "Start in" + its picker are ONE setting: the radio, then the picker indented 26 under the radio's text. -->
            <prim:SettingsConsoleRow AboutKey="startup.mode" Default="{x:Bind ViewModel.DefaultStartupModeText}">
                <StackPanel Spacing="8">
                    <RadioButton x:Name="StartupFixedRadioButton" GroupName="StartupChoice" VerticalAlignment="Center"
                                 Content="Start in"
                                 IsChecked="{x:Bind ViewModel.StartupFixed, Mode=TwoWay}"/>
                    <prim:SegmentedPicker x:Name="StartupModePicker" Margin="26,0,0,0"
                                          ItemsSource="{x:Bind ViewModel.StartupModeLabels}"
                                          SelectedIndex="{x:Bind ViewModel.StartupModeIndex, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.StartupFixed, Mode=OneWay}"/>
                </StackPanel>
            </prim:SettingsConsoleRow>

            <Border Height="{StaticResource SettingsGroupBreakSpace}"/>

            <prim:SettingsConsoleRow Label="Home site" AboutKey="startup.homeSite" Default="{x:Bind ViewModel.DefaultHomeSiteText}">
                <TextBlock x:Name="HomeSiteNameText" VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.SiteFavorites.HomeSiteName, Mode=OneWay}"/>
            </prim:SettingsConsoleRow>

            <!-- The rule is MapViewModel's SiteFavorites.HoldLaunchLoad (docs/bugs.md S33). -->
            <prim:SettingsConsoleRow AboutKey="startup.loadHome" Default="{x:Bind ViewModel.DefaultLoadHomeOnLaunchText}">
                <CheckBox x:Name="LoadHomeOnLaunchCheckBox" VerticalAlignment="Center"
                          Content="Load home site on launch"
                          IsChecked="{x:Bind ViewModel.SiteFavorites.LoadHomeOnLaunch, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow AboutKey="startup.fullScreen" Default="{x:Bind ViewModel.DefaultStartInFullScreenText}">
                <CheckBox x:Name="StartInFullScreenCheckBox" VerticalAlignment="Center"
                          Content="Start in full screen"
                          IsChecked="{x:Bind ViewModel.StartInFullScreen, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <!-- Moved from the Basemap page (2026-11-16): a launch preference. The setup window's "Stop showing this at launch"
                 is the SAME setting, inverted (BasemapSetupViewModel.ShowAtLaunch). -->
            <prim:SettingsConsoleRow AboutKey="startup.mapSetup" Default="{x:Bind ViewModel.DefaultShowMapSetupText}">
                <CheckBox x:Name="ShowMapSetupAtLaunchCheckBox" VerticalAlignment="Center"
                          Content="Show map setup at launch"
                          IsChecked="{x:Bind ViewModel.BasemapSetup.ShowAtLaunch, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
