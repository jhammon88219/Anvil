<?xml version="1.0" encoding="utf-8"?>
<!-- ProductColorRampComboBox — the radar Product selector, with each product's COLOR RAMP drawn next to its
     name, so the selector doubles as the legend and the separate Color Scale section goes away.

       CLOSED     Ref  ▓▓▒▒░░░│░░▒▒▓▓  ˅     the selected product: short name + its ramp,
                            -30    +75       carrying the min/max scale and the Inspect tick
                  ┌────────────────────────┐
       OPEN       │ Ref  ▓▓▒▒░░░░▒▒▓▓      │  one row per product: short name + ramp only;
                  │ Vel  ▓▓▒▒░░░░▒▒▓▓      │  the full name ("Reflectivity") is the row tooltip
                  │ SRV  ▓▓▒▒░░░░▒▒▓▓      │
                  │ CC   ░░▒▒▒▓▓▓▓▓▓▓      │
                  └────────────────────────┘

     Two different presentations, which is why the two areas are authored separately:
       • CLOSED — short name ("Ref") + a ProductColorRamp for the SELECTED product WITH its min/max values
         and the live Inspect tick.
       • DROPDOWN ROWS — short name + just the ramp (no numbers/tick); the full product name
         ("Correlation Coefficient") is the row's tooltip.

     It is a UserControl rather than a templated ComboBox on purpose: a loose ResourceDictionary has no
     code-behind, so a ControlTemplate can't use x:Bind and the inspect state had to be smuggled in through
     attached properties. Here both areas are plain x:Bind against this control's own DPs. It still READS as
     a combo box (click to open, click a row to pick, light-dismiss, arrow keys + Enter via the ListView);
     what a real ComboBox would add over this is type-ahead, which a six-item list doesn't need. -->
<UserControl
    x:Class="Anvil.Controls.Primitives.ProductColorRampComboBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctl="using:Anvil.Controls.Primitives"
    xmlns:vm="using:Anvil.ViewModels"
    mc:Ignorable="d"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    KeyDown="OnKeyDown"
    IsEnabledChanged="OnIsEnabledChanged">

    <Grid x:Name="Root"
          Background="Transparent"
          Tapped="OnTapped"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited"
          PointerPressed="OnPointerPressed"
          PointerReleased="OnPointerReleased"
          PointerCaptureLost="OnPointerExited">

        <!-- Rest is fully transparent, so hover carries the whole "this is interactable" cue: the surface
             fills with the SAME hover brush the bar's pull-tab uses (one hover look across the chrome), a
             hairline stroke appears — the fill alone is near-invisible on the bar's black — and the content
             lifts 1px. Pressed keeps fill + stroke but drops the lift to 0, so a click reads as pushing it
             back down. Only Disabled mutes the text + chevron. (The stroke costs no layout: HoverSurface is
             an empty backdrop pane, not the content's parent, so its BorderThickness can't shift anything.) -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="HoverSurface.Background" Value="{ThemeResource OverlayBarSurfaceHoverBrush}"/>
                        <Setter Target="HoverSurface.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                        <Setter Target="HoverSurface.BorderThickness" Value="1"/>
                        <Setter Target="Lift.Y" Value="-1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Target="HoverSurface.Background" Value="{ThemeResource OverlayBarSurfaceHoverBrush}"/>
                        <Setter Target="HoverSurface.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                        <Setter Target="HoverSurface.BorderThickness" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                        <Setter Target="ShortLabelText.Foreground" Value="{ThemeResource ComboBoxForegroundDisabled}"/>
                        <Setter Target="DropDownGlyph.Foreground" Value="{ThemeResource ComboBoxDropDownGlyphForegroundDisabled}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="ContentRoot">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Lift"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- short name -->
                <ColumnDefinition Width="*"/>    <!-- selected product's ramp + scale + tick -->
                <ColumnDefinition Width="Auto"/> <!-- chevron -->
            </Grid.ColumnDefinitions>

            <Border x:Name="HoverSurface"
                    Grid.ColumnSpan="3"
                    MinHeight="32"
                    CornerRadius="6"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"/>

            <!-- Short name + chevron line up with the RAMP STRIP, not with the ramp control's overall
                 centre — the min/max row hanging under the strip drags that centre down, which left both
                 sitting low against the ramp. StripAlignMargin is the ramp's own live measurement of that
                 offset (see ProductColorRamp), so neither hardcodes a guess at its internals and both follow
                 it if the scale row's metrics ever change. The gaps AROUND the ramp are the ramp's own
                 margin, leaving these two free to carry only the alignment nudge. -->
            <TextBlock x:Name="ShortLabelText"
                       Grid.Column="0"
                       Margin="{x:Bind SelectedRamp.StripAlignMargin, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource ComboBoxForeground}"
                       Text="{x:Bind SelectedItem.ShortLabel, Mode=OneWay}"/>

            <ctl:ProductColorRamp x:Name="SelectedRamp"
                                  Grid.Column="1"
                                  Margin="10,0,8,0"
                                  VerticalAlignment="Center"
                                  ShowScale="True"
                                  Ramp="{x:Bind SelectedItem.Ramp, Mode=OneWay}"
                                  InspectFraction="{x:Bind InspectFraction, Mode=OneWay}"
                                  IsInspectVisible="{x:Bind IsInspectVisible, Mode=OneWay}"/>

            <!-- The wrapper carries the chevron's inset from the control's right edge, so the icon itself is
                 free to carry the bound alignment nudge. -->
            <Grid Grid.Column="2" Margin="0,0,2,0">
                <FontIcon x:Name="DropDownGlyph"
                          Margin="{x:Bind SelectedRamp.StripAlignMargin, Mode=OneWay}"
                          VerticalAlignment="Center"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14"
                          Glyph="&#xE70D;"
                          Foreground="{ThemeResource ComboBoxDropDownGlyphForeground}"
                          IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="DropDown" Placement="Bottom" Opening="OnDropDownOpening">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"/>
                        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}"/>
                        <Setter Property="Padding" Value="0,4,0,4"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="MaxWidth" Value="1000"/>
                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled"/>
                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                    </Style>
                </Flyout.FlyoutPresenterStyle>

                <ListView x:Name="ProductList"
                          MaxHeight="504"
                          SelectionMode="Single"
                          ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                          SelectionChanged="OnProductListSelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="32"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RadarProductOption">
                            <Grid ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind Label}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind ShortLabel}"
                                           VerticalAlignment="Center"/>
                                <ctl:ProductColorRamp Grid.Column="1"
                                                      MinWidth="96"
                                                      VerticalAlignment="Center"
                                                      Ramp="{x:Bind Ramp, Mode=OneWay}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Flyout>
        </FlyoutBase.AttachedFlyout>
    </Grid>
</UserControl>
