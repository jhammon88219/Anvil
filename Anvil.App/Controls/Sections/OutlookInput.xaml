<?xml version="1.0" encoding="utf-8"?>
<!-- OutlookInput — the SPC outlook selectors, shown as the body of the ForeCast settings window (see
     above the overlay bar). Laid out entirely with grids ([label | control] rows, no StackPanels) so it's
     easy to edit. The Day combo is self-labeling ("Day 1 · Sat Jun 14"); changing it cascades the Product
     list and re-selects a product. Opacity is the polygon fill (outlines stay opaque). Watches moved to
     the NowCast window (they're active current-conditions alerts, not a forecast). Bound to OutlookViewModel. -->
<UserControl x:Class="Anvil.Controls.Sections.OutlookInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Anvil.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="OutlookLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>

        <!-- One legend row: an official SPC color swatch (fill + stroke straight from the outlook GeoJSON)
             next to the level's name. Significant/hatched levels overlay white '/' stripes to mirror how the
             map draws them (a hatch pattern, not a solid). Item type: Anvil.Models.OutlookLegendEntry. -->
        <DataTemplate x:Key="OutlookLegendItemTemplate">
            <Grid Margin="0,2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="20" Height="13" VerticalAlignment="Center">
                    <Border Background="{Binding Fill, Converter={StaticResource HexToBrush}}"
                            BorderBrush="{Binding Stroke, Converter={StaticResource HexToBrush}}"
                            BorderThickness="1" CornerRadius="2"/>
                    <Path Stroke="White" StrokeThickness="1"
                          Visibility="{Binding IsSignificant, Converter={StaticResource BoolToVis}}"
                          Data="M0,13 L13,0 M7,13 L20,0 M0,6.5 L6.5,0 M13,13 L20,6.5"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Label}"
                           FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Outer grid: label column + control column, one row per field. -->
    <Grid ColumnSpacing="12" RowSpacing="10" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Day -->
            <RowDefinition Height="Auto"/> <!-- Product -->
            <RowDefinition Height="Auto"/> <!-- Opacity -->
            <RowDefinition Height="Auto"/> <!-- Legend -->
        </Grid.RowDefinitions>

        <!-- Day: self-labeling day picker. -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Day" Style="{StaticResource OutlookLabelStyle}"/>
        <ComboBox Grid.Row="0" Grid.Column="1"
                  Width="180" HorizontalAlignment="Left"
                  ItemsSource="{x:Bind ViewModel.Days}"
                  DisplayMemberPath="Label"
                  SelectedItem="{x:Bind ViewModel.SelectedDayOption, Mode=TwoWay}"
                  ToolTipService.ToolTip="SPC outlook day"/>

        <!-- Product: the day's outlook types (+ None). -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Product" Style="{StaticResource OutlookLabelStyle}"/>
        <ComboBox Grid.Row="1" Grid.Column="1"
                  Width="180" HorizontalAlignment="Left"
                  ItemsSource="{x:Bind ViewModel.ProductOptions, Mode=OneWay}"
                  DisplayMemberPath="Label"
                  SelectedItem="{x:Bind ViewModel.SelectedOption, Mode=TwoWay}"
                  ToolTipService.ToolTip="Outlook product (None clears the overlay)"/>

        <!-- Opacity: fill opacity (outlines stay solid). -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Opacity" Style="{StaticResource OutlookLabelStyle}"/>
        <Slider Grid.Row="2" Grid.Column="1"
                Width="180" HorizontalAlignment="Left"
                Minimum="0" Maximum="1"
                StepFrequency="0.05" SmallChange="0.05"
                IsThumbToolTipEnabled="False"
                VerticalAlignment="Center"
                Value="{x:Bind ViewModel.OutlookOpacity, Mode=TwoWay}"
                ToolTipService.ToolTip="Outlook fill opacity (outlines stay solid)"/>

        <!-- Legend: the loaded outlook's risk/probability levels, colors + names pulled straight from SPC's
             own outlook GeoJSON (the same file the map draws), most-severe first. Hidden when None is
             selected or the layer is off (HasLegend). Spans both columns under the selectors. -->
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="0,4,0,0" Spacing="6"
                    Visibility="{x:Bind ViewModel.HasLegend, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <TextBlock Text="Legend" FontSize="12" FontWeight="SemiBold" CharacterSpacing="40"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            <!-- Bounded so an unusually long legend scrolls rather than overflowing the window. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200" HorizontalScrollMode="Disabled">
                <ItemsControl ItemsSource="{x:Bind ViewModel.LegendEntries, Mode=OneWay}"
                              ItemTemplate="{StaticResource OutlookLegendItemTemplate}"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
