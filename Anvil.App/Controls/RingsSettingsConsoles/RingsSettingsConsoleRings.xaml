<?xml version="1.0" encoding="utf-8"?>
<!-- RingsSettingsConsoleRings — Settings → Rings & Ruler's "Rings" section: WHICH rings are drawn around the loaded site, on a
     Primitives/SettingsConsolePlate. The page SIZES the reach rings from the frame on screen; these only choose.

       Rings  [Restore defaults]                                                                   DEFAULT
                ☑ Site ring                        Shown even with the Rings key off                     On
                ☑ Reflectivity reach               Where reflectivity data ends                          On
                ☑ Velocity reach                   Where velocity data ends                              On
                ☐ Distance rings                   Evenly spaced, in your distance unit                 Off
       Spacing  [ Auto | 25 | 50 | 100 ]  ← greyed unless Distance rings   Turn on Distance rings first     Auto
       96       420                                hint (one line)                               150, right

     ⚠️ Every row is a Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText by AboutKey); checkboxes
     sit in the Control column. ⚠️ The SITE RING is OUTSIDE the map-tools Rings key (the plain ring that stays when that key
     is off, and gives way to the styled reflectivity ring while that draws). Spacing is in your distance unit
     (General → Units → Distance). -->
<UserControl x:Class="Anvil.Controls.RingsSettingsConsoles.RingsSettingsConsoleRings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="RingsSettingsConsoleRingsPlate" Title="Rings" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="RingsRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    ToolTipService.ToolTip="Put which rings are drawn back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <prim:SettingsConsoleRow AboutKey="rings.site" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultSiteRingText}">
                <CheckBox x:Name="SiteRingCheckBox" VerticalAlignment="Center" Content="Site ring"
                          IsChecked="{x:Bind ViewModel.Radar.RangeRings.ShowSiteRing, Mode=TwoWay}"
                          ToolTipService.ToolTip="A plain ring at the edge of the radar's data, around every site. The styled Reflectivity reach ring replaces it while that one is on"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow AboutKey="rings.refl" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultReflectivityRingText}">
                <CheckBox x:Name="ReflectivityRingCheckBox" VerticalAlignment="Center" Content="Reflectivity reach"
                          IsChecked="{x:Bind ViewModel.Radar.RangeRings.ShowReflectivityRing, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow AboutKey="rings.vel" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultVelocityRingText}">
                <CheckBox x:Name="VelocityRingCheckBox" VerticalAlignment="Center" Content="Velocity reach"
                          IsChecked="{x:Bind ViewModel.Radar.RangeRings.ShowVelocityRing, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow AboutKey="rings.distance" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultDistanceRingsText}">
                <CheckBox x:Name="DistanceRingsCheckBox" VerticalAlignment="Center" Content="Distance rings"
                          IsChecked="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Spacing" AboutKey="rings.spacing" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultSpacingText}"
                                     Hint="{x:Bind SpacingHint(ViewModel.Radar.RangeRings.ShowDistanceRings), Mode=OneWay}">
                <prim:SegmentedPicker x:Name="DistanceRingSpacingPicker"
                                      IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.Radar.RangeRings.DistanceRingSpacingLabels}"
                                      SelectedIndex="{x:Bind ViewModel.Radar.RangeRings.DistanceRingSpacingIndex, Mode=TwoWay}"
                                      ToolTipService.ToolTip="How far apart the distance rings are, in your distance unit. Auto picks a step to suit the radar's reach"/>
            </prim:SettingsConsoleRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
