<?xml version="1.0" encoding="utf-8"?>
<!-- AboutSettingsConsoleThisCopy — Settings → About → This copy (artboard 22): what is running, for a bug report.

       ┌ This copy  [Copy details] ───────────────────────────────┐
       │ Version           1.0.0.0 · Debug                         │
       │ Windows App SDK   2.1.3                                   │   ← AboutAnvil reads each, once, never throws ("—")
       │ Map engine        WebView2 131.0 · MapLibre GL JS 5.21.1  │
       │ Logs              %LocalAppData%\Anvil\Logs        [Open] │   ← StorageManagerFolderLauncher (package-aware)
       └───────────────────────────────────────────────────────────┘
     Copy details = every line above + the Windows version, on the clipboard (AboutAnvil.Details). -->
<UserControl x:Class="Anvil.Controls.AboutSettingsConsoles.AboutSettingsConsoleThisCopy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:local="using:Anvil.Controls.AboutSettingsConsoles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="AboutSettingsConsoleThisCopyPlate" Title="This copy">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="AboutSettingsConsoleThisCopyCopyButton" Content="Copy details" Click="OnCopyClick"
                    ToolTipService.ToolTip="Puts these lines on the clipboard, to paste into a bug report"/>
        </prim:SettingsConsolePlate.HeaderContent>
        <StackPanel>
            <local:AboutSettingsConsoleInfoRow x:Name="AboutSettingsConsoleThisCopyVersion" Label="Version" Value="{x:Bind VersionText}"/>
            <local:AboutSettingsConsoleInfoRow x:Name="AboutSettingsConsoleThisCopyWindowsAppSdk" Label="Windows App SDK" Value="{x:Bind WindowsAppSdk}"/>
            <local:AboutSettingsConsoleInfoRow x:Name="AboutSettingsConsoleThisCopyMapEngine" Label="Map engine" Value="{x:Bind MapEngine}"/>
            <local:AboutSettingsConsoleInfoRow x:Name="AboutSettingsConsoleThisCopyLogs" Label="Logs" Value="{x:Bind LogsPath}" IsQuiet="True">
                <local:AboutSettingsConsoleInfoRow.Action>
                    <Button Content="Open" Click="OnOpenLogsClick" ToolTipService.ToolTip="Opens the logs folder in File Explorer"/>
                </local:AboutSettingsConsoleInfoRow.Action>
            </local:AboutSettingsConsoleInfoRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
