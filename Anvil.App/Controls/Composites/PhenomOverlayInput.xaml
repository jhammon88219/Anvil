<?xml version="1.0" encoding="utf-8"?>
<!-- PhenomOverlayInput — the controls for ONE convective-alert overlay: a card, one row per phenomenon
     (Tornado / Severe thunderstorm), and overlay opacity. Used TWICE in the NowCast window — once for the
     watch boxes, once for the storm-based warnings — bound to a PhenomOverlayViewModel each time.

       ┌────────────────────────────────────────────┐
       │ 7 active warnings                          │   the card: the total in effect, when it was
       │ Updated 12:04 PM · checking every 15s      │   last confirmed, and — in the footer — what
       │ Severe thunderstorm only                   │   the rows below are actually drawing
       └────────────────────────────────────────────┘
       ────────────────────────────────────────────────
       [ ] ■ Tornado                              0     ← one row per phenomenon: the toggle, the
       [x] ■ Severe thunderstorm                  7       map colour, the name, that type's count
       Opacity ──────●──────────────

     ⚠️ IT IS THE STORM-REPORT ROWS, DELIBERATELY. StormReportsInput draws the same card over the same
     kind of type rows one section below, so the two read as one control used three times rather than as
     three separate forms. The one visual difference is the SWATCH SHAPE: alerts are SQUARE (they are
     areas on the map), reports are ROUND (they are dots). That is the only thing keeping five near
     identical rows apart, so do not square the dots or round these.

     ⚠️ THERE IS NO MASTER SHOW/HIDE ROW. It used to be one checkbox reading "Tornado / Severe
     Thunderstorm" with the counts stranded on a separate "Active" line below it; splitting the checkbox
     in two put the count on the line that switches it and left nothing for a master to do. The layer is
     on when either type is on (PhenomOverlayViewModel.AnyShown, which also drives visibility).

     ⚠️ The swatch colours are the phenom colours the map draws (watches.js / warnings.js, both TO red /
     SV yellow). They are literals in both places — change one, change the other.

     ⚠️ Opacity is DISABLED while both types are off: nothing is on the map, so there is nothing for it to
     act on. Same off-switch rule as the storm-report dots and the outlook's "None".

     ⚠️ THE SECTION HEADING IS NOT HERE — the host draws its own above this control (NowCastTab writes
     "Watches" over one instance and "Warnings" over the other). The window owns its section structure;
     this is content. Same rule as StormReportsInput, and the reason there is no divider in here either.

     ⚠️ The two instances are IDENTICAL on screen — same two names, same two colours, one section apart —
     so the headings carry the whole distinction between them. That is exactly why the old shared
     "Watches and warnings" heading had to become two. -->
<UserControl x:Class="Anvil.Controls.Composites.PhenomOverlayInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- the card -->
            <RowDefinition Height="Auto"/> <!-- rule -->
            <RowDefinition Height="Auto"/> <!-- the two type rows + opacity -->
        </Grid.RowDefinitions>

        <!-- THE CARD, the same shape as every other card in the two temporal windows. Like the storm
             reports' and the outlook's it is a RESULT — the polygons appear as you switch types on — so
             it carries no button. -->
        <Border Grid.Row="0" CornerRadius="8" Padding="13,12"
                Background="{ThemeResource OverlayBarSurfaceHoverBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}">
            <StackPanel>
                <TextBlock Text="{x:Bind ViewModel.CardHeadline, Mode=OneWay}"
                           FontSize="15"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.CardContext, Mode=OneWay}"
                           FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{x:Bind HasText(ViewModel.CardContext), Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.CardFooter, Mode=OneWay}"
                           FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                           Visibility="{x:Bind HasText(ViewModel.CardFooter), Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Height="1" Margin="0,14"
                Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>

        <Grid Grid.Row="2" RowSpacing="9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Tornado -->
                <RowDefinition Height="Auto"/> <!-- Severe thunderstorm -->
                <RowDefinition Height="Auto"/> <!-- Opacity -->
            </Grid.RowDefinitions>

            <!-- One row per phenomenon. The count is right-aligned in its own column so the numbers form a
                 column of their own however long the names get — the same three-column row as the
                 storm-report types. -->
            <CheckBox Grid.Row="0" MinWidth="0" HorizontalAlignment="Stretch"
                      IsChecked="{x:Bind ViewModel.ShowTornado, Mode=TwoWay}"
                      ToolTipService.ToolTip="{x:Bind TornadoTooltip(AlertNoun), Mode=OneWay}">
                <Grid ColumnSpacing="9" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="11" Height="11" CornerRadius="2"
                            Background="#FF2A2A" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Tornado" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{x:Bind Fmt(ViewModel.TornadoCount), Mode=OneWay}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </CheckBox>

            <CheckBox Grid.Row="1" MinWidth="0" HorizontalAlignment="Stretch"
                      IsChecked="{x:Bind ViewModel.ShowSevere, Mode=TwoWay}"
                      ToolTipService.ToolTip="{x:Bind SevereTooltip(AlertNoun), Mode=OneWay}">
                <Grid ColumnSpacing="9" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="11" Height="11" CornerRadius="2"
                            Background="#FFD21A" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Severe thunderstorm" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{x:Bind Fmt(ViewModel.SevereCount), Mode=OneWay}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </CheckBox>

            <Grid Grid.Row="2" ColumnSpacing="12" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Opacity" Style="{StaticResource SettingsFieldLabelStyle}"/>
                <Slider Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.AnyShown, Mode=OneWay}"
                        Minimum="0" Maximum="1"
                        StepFrequency="0.05" SmallChange="0.05"
                        IsThumbToolTipEnabled="False"
                        VerticalAlignment="Center"
                        Value="{x:Bind ViewModel.Opacity, Mode=TwoWay}"
                        ToolTipService.ToolTip="Overall opacity of the polygons (fill and outline together)"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
