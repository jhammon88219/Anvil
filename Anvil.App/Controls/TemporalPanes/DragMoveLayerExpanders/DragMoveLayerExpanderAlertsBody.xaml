<?xml version="1.0" encoding="utf-8"?>
<!-- DragMoveLayerExpanderAlertsBody — the controls for ONE convective-alert overlay: a card, one row per phenomenon
     (Tornado / Severe thunderstorm), and overlay opacity. Used TWICE in the NowCast window — once for the
     watch boxes, once for the storm-based warnings — bound to a PhenomOverlayViewModel each time.

     ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓   the card (DragMoveLayerExpanderHeaderCard, FLUSH
     ▓  9 active warnings   Updated 12:04 PM · every 15s▓   under the header, ONE line): the total in effect
     ──────────────────────────────────────────────────────  left, when it was last confirmed right (a failure
                                                             takes that slot) — ⚠️ never a line about the ticked
                                                             rows. The elevated-tag line ("1 tornado emergency")
                                                             was removed 2026-10-21.
       [ ] ■ Tornado                                  2  ← one DragMoveLayerExpanderCountRow per phenomenon: the
       [x] ■ Severe thunderstorm                      5    toggle, the map colour, the name, that type's count at the
       [x] ■ Flash flood                              2    FAR RIGHT (hover lifts the row); the flood row: "Flash
       [x] ■ Special marine                           1    flood" (warnings, FF) or "Flood" (watches, FA/FL/FF, sea
                                                           green) — FloodLabel/FloodColor from the VM; the marine row
                                                           (MA, orange) is warnings only (SupportsMarine)
       ────────────────────────────────────────────────
         IN EFFECT 2                                     ← THE DAY LIST, TWO LISTS (NowCast warnings only — watches
     █ ■ 11:52 AM  Cleveland, OK      PDS  until 12:30 PM  and PastCast leave both empty → collapsed). IN EFFECT
     █ ■ 11:40 AM  Sedgwick, KS            until 12:15 PM  (ActiveAlerts) = CAP, the map's set, newest issued first;
       ▸ ENDED 11                                          click → fly + flash (FlyTo). ENDED (EndedAlerts) = IEM +
     █ ░  9:05 AM  Tulsa, OK                ended 9:45 AM  what this session saw end (WarningDayList), newest ENDED
     ↑                                    ↑                first, FOLDED by default (ShowEndedList, persisted), INERT
     left lane: PanelScroller LaneOnLeft  the status column (no click, no tooltip, no hover), dimmed 45%. An unticked
     (12 px, always claimed); 8 rows,     is FIXED + RIGHT-   type's live row dims too but still flies. Rows edited IN
     then it scrolls                      aligned             PLACE (RowSync) — never a rebuilt list.

     ⚠️ OPACITY IS NOT HERE — it lives in the host's section header (DragMoveLayerExpander ShowOpacity), so it can be
     set with the section closed.

     ⚠️ IT IS THE STORM-REPORT ROWS, DELIBERATELY. DragMoveLayerExpanderStormReportsBody draws the same card over the same
     kind of type rows one section below, so the two read as one control used three times rather than as
     three separate forms. The swatch is the SAME rounded square in both (the user's call, 2026-10-21 — reports were
     round dots until then).

     ⚠️ THERE IS NO MASTER SHOW/HIDE ROW. It used to be one checkbox reading "Tornado / Severe
     Thunderstorm" with the counts stranded on a separate "Active" line below it; splitting the checkbox
     in two put the count on the line that switches it and left nothing for a master to do. The layer is
     on when either type is on AND its mode runs (PhenomOverlayViewModel.AnyShown + IsModeActive). The
     select-all lives in the HOST's section header (TemporalWindowNowCastContent), not here.

     ⚠️ The swatch colours are the phenom colours the map draws (watches.js / warnings.js, both TO red /
     SV yellow; warnings.js FF green; watches.js FA sea green = WatchFlood.Color). They are literals in both
     places — change one, change the other.

     ⚠️ THE SECTION HEADING IS NOT HERE — the host draws its own above this control (TemporalWindowNowCastContent writes
     "Watches" over one instance and "Warnings" over the other). The window owns its section structure;
     this is content. Same rule as DragMoveLayerExpanderStormReportsBody, and the reason there is no divider in here either.

     ⚠️ The two instances are IDENTICAL on screen — same two names, same two colours, one section apart —
     so the headings carry the whole distinction between them. That is exactly why the old shared
     "Watches and warnings" heading had to become two. -->
<UserControl x:Class="Anvil.Controls.TemporalWindows.DragMoveLayerExpanders.DragMoveLayerExpanderAlertsBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tw="using:Anvil.Controls.TemporalWindows"
             xmlns:dragMoveLayerExpanders="using:Anvil.Controls.TemporalWindows.DragMoveLayerExpanders"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- A list row: tight, full-width — the storm-reports list's container style. -->
        <Style x:Key="AlertRowContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- The two list headers: "IN EFFECT" / "ENDED" small caps + the count. -->
        <Style x:Key="AlertListHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="60"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AlertListHeaderCountStyle" TargetType="TextBlock" BasedOn="{StaticResource TabularNumberTextStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>

        <!-- A ROW: ■ issued · place · tag · until/ended. ⚠️ The status is its OWN fixed column, RIGHT-aligned, so every
             "until 12:30 PM" / "ended 9:45 AM" ends on the same edge (user's call, 2026-10-22). The two templates
             differ only in the tooltip — an ended row offers no fly-to. Change both. -->
        <DataTemplate x:Key="ActiveAlertRowTemplate" x:DataType="vm:WarningListRow">
            <Grid ColumnSpacing="8" ToolTipService.ToolTip="Fly to this warning"
                  Opacity="{x:Bind dragMoveLayerExpanders:DragMoveLayerExpanderAlertsBody.RowOpacity(Dim), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- the type square -->
                    <ColumnDefinition Width="58"/>    <!-- 11:52 AM (issued) -->
                    <ColumnDefinition Width="*"/>     <!-- Cleveland, OK -->
                    <ColumnDefinition Width="Auto"/>  <!-- PDS / Emergency / … -->
                    <ColumnDefinition Width="100"/>   <!-- until 12:30 PM (right-aligned) -->
                </Grid.ColumnDefinitions>
                <Border Width="9" Height="9" CornerRadius="2" VerticalAlignment="Center"
                        Background="{x:Bind dragMoveLayerExpanders:DragMoveLayerExpanderAlertsBody.PhenomBrush(Phenom)}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind TimeText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                           Style="{StaticResource TabularNumberTextStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="{x:Bind PlaceText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{x:Bind TagText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="4" Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                           HorizontalAlignment="Right" TextAlignment="Right"
                           Style="{StaticResource TabularNumberTextStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="EndedAlertRowTemplate" x:DataType="vm:WarningListRow">
            <Grid ColumnSpacing="8"
                  Opacity="{x:Bind dragMoveLayerExpanders:DragMoveLayerExpanderAlertsBody.RowOpacity(Dim), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Border Width="9" Height="9" CornerRadius="2" VerticalAlignment="Center"
                        Background="{x:Bind dragMoveLayerExpanders:DragMoveLayerExpanderAlertsBody.PhenomBrush(Phenom)}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind TimeText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                           Style="{StaticResource TabularNumberTextStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="{x:Bind PlaceText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{x:Bind TagText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="4" Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                           HorizontalAlignment="Right" TextAlignment="Right"
                           Style="{StaticResource TabularNumberTextStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- the card (its bottom edge is the rule) -->
            <RowDefinition Height="Auto"/> <!-- the type rows -->
            <RowDefinition Height="Auto"/> <!-- the day list -->
        </Grid.RowDefinitions>

        <!-- THE CARD, flush under the section header (DragMoveLayerExpanderHeaderCard — every expander's top
             card; its bottom edge is the rule). Like the storm
             reports' and the outlook's it is a RESULT — the polygons appear as you switch types on — so
             it carries no button. -->
        <dragMoveLayerExpanders:DragMoveLayerExpanderHeaderCard Grid.Row="0"
                Headline="{x:Bind ViewModel.CardHeadline, Mode=OneWay}"
                Context="{x:Bind ViewModel.CardContext, Mode=OneWay}"
                Footer="{x:Bind ViewModel.CardFooter, Mode=OneWay}"/>

        <!-- THE TYPE ROWS (DragMoveLayerExpanderCountRow — every expander's). A StackPanel: its Spacing skips the
             watches instance's COLLAPSED flood row, so no gap is left where it would be. -->
        <StackPanel Grid.Row="1" Spacing="4">
            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="Tornado"
                    IsChecked="{x:Bind ViewModel.ShowTornado, Mode=TwoWay}"
                    Count="{x:Bind Fmt(ViewModel.TornadoCount), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind TornadoTooltip(AlertNoun), Mode=OneWay}">
                <Border Width="11" Height="11" CornerRadius="2" Background="#FF2A2A"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>

            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="Severe thunderstorm"
                    IsChecked="{x:Bind ViewModel.ShowSevere, Mode=TwoWay}"
                    Count="{x:Bind Fmt(ViewModel.SevereCount), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind SevereTooltip(AlertNoun), Mode=OneWay}">
                <Border Width="11" Height="11" CornerRadius="2" Background="#FFD21A"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>

            <!-- The flood row: "Flash flood" on warnings, "Flood" on watches — name + swatch from the VM
                 (FloodLabel / FloodColor). Collapses on an overlay without the type (SupportsFlashFlood). -->
            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="{x:Bind ViewModel.FloodLabel, Mode=OneWay}"
                    Visibility="{x:Bind Shown(ViewModel.SupportsFlashFlood), Mode=OneWay}"
                    IsChecked="{x:Bind ViewModel.ShowFlashFlood, Mode=TwoWay}"
                    Count="{x:Bind Fmt(ViewModel.FlashFloodCount), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind FloodTooltip(ViewModel.FloodLabel, AlertNoun), Mode=OneWay}">
                <Border Width="11" Height="11" CornerRadius="2" Background="{x:Bind Swatch(ViewModel.FloodColor), Mode=OneWay}"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>

            <!-- The marine row (MA, Special Marine Warning): warnings only — collapses on watches (SupportsMarine).
                 NWS's own SMW orange = WarningsViewModel.MarineFill = warnings.js MA. -->
            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="Special marine"
                    Visibility="{x:Bind Shown(ViewModel.SupportsMarine), Mode=OneWay}"
                    IsChecked="{x:Bind ViewModel.ShowMarine, Mode=TwoWay}"
                    Count="{x:Bind Fmt(ViewModel.MarineCount), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind MarineTooltip(AlertNoun), Mode=OneWay}">
                <Border Width="11" Height="11" CornerRadius="2" Background="#FFA500"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>
        </StackPanel>

        <!-- THE DAY LIST = TWO LISTS (the storm-reports list's shape): IN EFFECT (newest issued first, click → fly) over
             ENDED (newest ended first, folded by default, INERT). Each is a PanelScroller LIST LANE: bar on the LEFT in
             its own 12 px gutter, 8 rows then it scrolls. The headers start past that lane (Margin 12) so they line up
             with the rows. ⚠️ ItemsSources are the VM's collections, edited in place — don't swap them for fresh lists. -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0"
                    Visibility="{x:Bind Shown(ViewModel.HasAlertList), Mode=OneWay}">
            <Border Height="1" Margin="0,0,0,8"
                    Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>

            <!-- IN EFFECT · 6 -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="18,0,0,4">
                <TextBlock Text="IN EFFECT" Style="{StaticResource AlertListHeaderTextStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.ActiveAlertCount, Mode=OneWay}" Style="{StaticResource AlertListHeaderCountStyle}"/>
            </StackPanel>
            <prim:PanelScroller LaneOnLeft="True" MaxRows="8"
                                Visibility="{x:Bind Shown(ViewModel.HasActiveAlerts), Mode=OneWay}">
                <ListView MaxHeight="208"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAlertClick"
                          ItemsSource="{x:Bind ViewModel.ActiveAlerts}"
                          ItemContainerStyle="{StaticResource AlertRowContainerStyle}"
                          ItemTemplate="{StaticResource ActiveAlertRowTemplate}"/>
            </prim:PanelScroller>

            <!-- ▸ ENDED · 11 — the fold. The whole line is the button; the count shows while folded. -->
            <Button x:Name="EndedAlertsFoldButton" Margin="12,10,0,0" Padding="6,0" Height="26"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" CornerRadius="4"
                    Visibility="{x:Bind Shown(ViewModel.HasEndedAlerts), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind EndedFoldName(ViewModel.ShowEndedList), Mode=OneWay}"
                    Click="OnEndedFoldClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="{x:Bind ChevronAngle(ViewModel.ShowEndedList), Mode=OneWay}"/>
                        </FontIcon.RenderTransform>
                    </FontIcon>
                    <TextBlock Text="ENDED" Style="{StaticResource AlertListHeaderTextStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.EndedAlertCount, Mode=OneWay}" Style="{StaticResource AlertListHeaderCountStyle}"/>
                </StackPanel>
            </Button>
            <!-- ⚠️ ENDED ROWS ARE INERT (user's call): no ItemClick, no tooltip, and the hover/press lift is blanked by
                 the lightweight brushes below — so nothing on them looks clickable. -->
            <prim:PanelScroller LaneOnLeft="True" MaxRows="8" Margin="0,2,0,0"
                                Visibility="{x:Bind ShownBoth(ViewModel.HasEndedAlerts, ViewModel.ShowEndedList), Mode=OneWay}">
                <ListView MaxHeight="208"
                          SelectionMode="None" IsItemClickEnabled="False"
                          ItemsSource="{x:Bind ViewModel.EndedAlerts}"
                          ItemContainerStyle="{StaticResource AlertRowContainerStyle}"
                          ItemTemplate="{StaticResource EndedAlertRowTemplate}">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/>
                    </ListView.Resources>
                </ListView>
            </prim:PanelScroller>
        </StackPanel>
    </Grid>
</UserControl>
