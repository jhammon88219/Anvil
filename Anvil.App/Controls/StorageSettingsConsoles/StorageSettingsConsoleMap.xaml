<?xml version="1.0" encoding="utf-8"?>
<!-- StorageSettingsConsoleMap — Settings → Storage's "Map" section (from the retired Basemap page, 2026-11-16), on a
     Primitives/SettingsConsolePlate: WHICH map Anvil draws now, and the map files on this PC. Over BasemapSetupViewModel
     (MapViewModel.BasemapSetup) — the SAME instance the map setup window uses.

       Map                                                                              (no reset, no DEFAULT — files are yours)
       In use     Offline map · Standard · Lower 48 states
       Files      ▤ Offline map  [In use]                                              [📁][🗑]
                    28.8 GB · Jun 8, 2026 · usa_full.pmtiles
                  ▤ Standard · Lower 48 states, Alaska                              [Use][📁][🗑]
                    5.0 GB · Oct 20, 2026 · anvil-map-standard-l48-ak.pmtiles
                  ⚠ Delete Offline map? Anvil is using it…                       [Keep][Delete]  ← the trash ASKS inline first
                  [Add a map file…]                                212.3 GB free
       96         420 + hint (a file row spans both)

     ⚠️ Every choice here is drawn AT ONCE (Use, a delete — MainWindow re-points the map). A delete Windows refuses (the file still
     open) finishes at the next launch (AppSettings.BasemapPendingDeletes). Added files stay where they are
     (AppSettings.BasemapAddedFiles). The SAME file list sizes On disk's Maps row (BasemapSetupViewModel.MapFilePaths). -->
<UserControl x:Class="Anvil.Controls.StorageSettingsConsoles.StorageSettingsConsoleMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One map file. Two faces on one row: the details, or (trash pressed) the delete question. -->
        <DataTemplate x:Key="MapFileRowTemplate" x:DataType="vm:BasemapFileRow">
            <Grid Padding="0,8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                  ToolTipService.ToolTip="{x:Bind Path}">
                <Grid ColumnSpacing="8" Visibility="{x:Bind IsShowingDetails, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE826;" FontSize="16" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Name}"/>
                            <Border Padding="6,0" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    Visibility="{x:Bind IsInUse}">
                                <TextBlock Text="In use" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Details}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource TabularNumberTextStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Content="Use" Visibility="{x:Bind CanUse}" Click="OnUseFileClick"
                                ToolTipService.ToolTip="Draw this map"/>
                        <Button Click="OnShowFileClick" ToolTipService.ToolTip="Show in folder">
                            <FontIcon Glyph="&#xE838;" FontSize="14"/>
                        </Button>
                        <Button Click="OnAskDeleteClick" ToolTipService.ToolTip="Delete">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="8" Visibility="{x:Bind IsConfirmingDelete, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" VerticalAlignment="Center"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind DeleteQuestion}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Content="Keep" Click="OnKeepFileClick"/>
                        <Button Content="Delete" Click="OnDeleteFileClick"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <prim:SettingsConsolePlate x:Name="StorageSettingsConsoleMapPlate" Title="Map">
        <Grid ColumnSpacing="12" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- in use -->
                <RowDefinition Height="Auto"/> <!-- files -->
                <RowDefinition Height="Auto"/> <!-- add + free -->
                <RowDefinition Height="Auto"/> <!-- message -->
            </Grid.RowDefinitions>

            <TextBlock VerticalAlignment="Center" Text="In use"/>
            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{x:Bind ViewModel.InUseText, Mode=OneWay}"/>

            <TextBlock Grid.Row="1" Margin="0,10,0,0" Text="Files"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
                <ItemsControl x:Name="MapFileRows" IsTabStop="False" ItemsSource="{x:Bind ViewModel.Files}" ItemTemplate="{StaticResource MapFileRowTemplate}"/>
                <TextBlock Margin="0,8,0,0" Style="{StaticResource SettingsConsoleHintTextStyle}"
                           Visibility="{x:Bind ViewModel.HasNoFiles, Mode=OneWay}"
                           Text="No map files yet. Download one below, or add one you have."/>
            </StackPanel>

            <Button x:Name="AddMapFileButton" Grid.Row="2" Grid.Column="1" Content="Add a map file…" Click="OnAddFileClick"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}" Text="{x:Bind ViewModel.FreeSpaceText, Mode=OneWay}"/>

            <!-- What the last Add / Delete did (a refused file says why). -->
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" FontSize="12" TextWrapping="Wrap"
                       Text="{x:Bind ViewModel.FilesMessage, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </prim:SettingsConsolePlate>
</UserControl>
