<?xml version="1.0" encoding="utf-8"?>
<!-- AppearanceSettingsConsoleTheme — Settings → Appearance's "Theme" section, on a Primitives/SettingsConsolePlate.

       Theme                                                                                    DEFAULT
       Theme    [Anvil Dark      ⌄]  The app's chrome and basemap theme                   Anvil Dark
       Basemap  [Data Viz Black  ⌄]  Overrides the theme aware map colors                The theme's
       96       220                  hint (one line, trims)                              150, right

     ⚠️ THE LABEL COLUMN (96) and DEFAULT COLUMN (150) are the page's — AppearanceSettingsConsoleEdges uses the same, so
     every label and control on the page starts on one edge. Change both.
     ⚠️ Picking a THEME brings its own basemap (and ends any Basemap override). The Basemap pick is PERSISTED
     (AppSettings.BasemapStyleId, "" = the theme's) — MapViewModel.SelectedStyle. -->
<UserControl x:Class="Anvil.Controls.AppearanceSettingsConsoles.AppearanceSettingsConsoleTheme"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="AppearanceSettingsConsoleThemePlate" Title="Theme" ShowDefaultHeader="True">
        <Grid ColumnSpacing="12" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>  <!-- label -->
                <ColumnDefinition Width="220"/> <!-- picker -->
                <ColumnDefinition Width="*"/>   <!-- hint -->
                <ColumnDefinition Width="150"/> <!-- default -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Theme"/>
            <ComboBox x:Name="ThemeComboBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ItemsSource="{x:Bind ViewModel.AvailableThemes}"
                      DisplayMemberPath="DisplayName"
                      SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="The app's chrome and basemap theme"/>
            <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.DefaultThemeName}"/>

            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Basemap"/>
            <ComboBox x:Name="BasemapComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ItemsSource="{x:Bind ViewModel.AvailableStyles}"
                      DisplayMemberPath="DisplayName"
                      SelectedItem="{x:Bind ViewModel.SelectedStyle, Mode=TwoWay}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Overrides the theme aware map colors"/>
            <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.DefaultBasemapText}"/>
        </Grid>
    </prim:SettingsConsolePlate>
</UserControl>
