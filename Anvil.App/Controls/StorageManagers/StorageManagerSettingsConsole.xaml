<?xml version="1.0" encoding="utf-8"?>
<!-- StorageManagerSettingsConsole — Settings → Storage's "Disk usage" card (was "On disk" until 2026-11-18): everything Anvil
     keeps on disk, on a Primitives/SettingsConsolePlate (2026-11-16 — it drew its own surface before). Title row: Disk usage · Restore defaults (every
     limit, asks first; a lowered limit sweeps like any change) · DEFAULT (each row's limits a first run gets, the table's 9th column).

       ┌──────────────────────────────────────────────────────────────────────────────────────┐
       │ 6.1 GB                                                                                │ ← StorageManagerSettingsConsoleUsageBar
       │ used by Anvil                                                                         │
       │ ████████████████████████████████████████▌▌▏▏   (hover = legend)  │ DEFAULT col clear │
       │                                                                                       │   14 gap
       │ DATA                         SIZE ?                       MAX SIZE ?  KEEP FOR ?      │ ← StorageManagerSettingsConsoleDataTable
       │ ■ Radar volumes …            1.8 GB  [ Clear ] [📁]  [5 GB ⌄]   [5 days ⌄]            │
       │ …  (five rows)                                                                        │
       └──────────────────────────────────────────────────────────────────────────────────────┘
        surface = CardBackgroundFillColorDefaultBrush, hairline SectionBorderBrush, radius 6, padding 12,14,12,10

     The page around it (Composites/StorageSettingsTab) is just this control. (The usage bar's "Open folder" key was removed
     2026-11-17 — each row opens its own folder.) One ViewModel (StorageSettingsViewModel = MapViewModel.Storage) feeds both parts. -->
<UserControl x:Class="Anvil.Controls.StorageManagers.StorageManagerSettingsConsole"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:storageManagers="using:Anvil.Controls.StorageManagers"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="StorageManagerSettingsConsolePlate" Title="Disk usage" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="OnDiskRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    ToolTipService.ToolTip="Every Max size and Keep for back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <StackPanel Spacing="14">
            <storageManagers:StorageManagerSettingsConsoleUsageBar x:Name="StorageManagerSettingsConsoleUsageBar"
                                                                  ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>
            <storageManagers:StorageManagerSettingsConsoleDataTable x:Name="StorageManagerSettingsConsoleDataTable"
                                                                   ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
