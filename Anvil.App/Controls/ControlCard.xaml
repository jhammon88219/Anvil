<?xml version="1.0" encoding="utf-8"?>
<!-- ControlCard — the reusable chrome for a temporal feature's settings card that floats just above the
     OverlayBar. It's a fixed-size, theme-aware panel (SAME opaque surface + border as the bar, from the
     shared OverlayBarSurfaceBrush) with a header (title + a down-triangle that HIDES the card) over a
     content slot (CardBody). Fixed size on purpose: every temporal card is the same footprint; less-busy
     cards just carry unused space for now. The triangle raises CloseRequested — hiding the card does NOT
     disable the feature (the host clears only the open-card state). -->
<UserControl
    x:Class="Anvil.Controls.ControlCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Anvil.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Fixed width for EVERY temporal card; height defaults to 260 but a busier card (e.g. Past Event +
         its historical outlook controls) can grow via CardHeight. Editing a card body won't change the size. -->
    <Border x:Name="CardRoot"
            Width="460"
            Height="{x:Bind CardHeight, Mode=OneWay}"
            Background="{ThemeResource OverlayBarSurfaceBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid Margin="16,10,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: title on the left, close (X) on the right. Doubles as the DRAG HANDLE
                 (DragMove.MoveTarget → CardRoot); the lifted background (OverlayBarSurfaceHoverBrush, a
                 step above the card surface) hints the strip is grabbable and gives the drag a hit area,
                 and a press on the close Button is left alone (DragMove skips ButtonBase). -->
            <Border Grid.Row="0" Margin="0,0,0,10"
                    Background="{ThemeResource OverlayBarSurfaceHoverBrush}"
                    CornerRadius="6"
                    Padding="10,3,4,3"
                    ctl:DragMove.MoveTarget="{x:Bind CardRoot}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind Title, Mode=OneWay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               CharacterSpacing="40"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <!-- Windows-style close (X, ChromeClose E711): hides the card. -->
                    <Button Grid.Column="1"
                            Click="OnCloseClick"
                            Width="28" Height="24"
                            Padding="0"
                            MinWidth="0" MinHeight="0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Hide this panel">
                        <FontIcon Glyph="&#xE711;"
                                  FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                  FontSize="12"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Feature controls. -->
            <ContentPresenter Grid.Row="1"
                              VerticalAlignment="Top"
                              Content="{x:Bind CardBody, Mode=OneWay}"/>
        </Grid>
    </Border>
</UserControl>
