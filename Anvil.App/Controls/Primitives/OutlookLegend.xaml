<?xml version="1.0" encoding="utf-8"?>
<!-- OutlookLegend — the SPC outlook's key: the official NOAA swatch + name for every level of the picked
     product's scale, then (probabilistic products only) the Conditional Intensity hatching block. Shared by
     the ForeCast and PastCast outlook sections, which each drop it in as the LAST thing in the section body.

       ──────────────────────────────────────────────         ← rule
        ■ 2%
        ■ 5%
        ■ 10%
        Intensity hatching                     [✓] Show        ← HatchRows.Count > 0 only
        ╲ CIG1                               In Outlook
        ╱ CIG2                               In Outlook
        ╳ CIG3                           Not In Outlook        ← dimmed

     ⚠️ IT IS PART OF ITS SECTION, so collapsing the section hides it; the host hides it ITSELF when there
     is nothing to key (None, or the layer hidden) by binding Visibility to the VM's HasLegend.
     ⚠️ A Conditional Intensity Group is drawn as HATCHING over the fill, and the DIRECTION is the only
     thing telling the groups apart — every CIG level is black. So the swatch traces outlook.js's sig-hatch
     tiles exactly: two Paths, '' and '/', shown by the same back/fwd rule makeHatchImage uses, which makes
     CIG3 (both) fall out for free. Getting a direction wrong here makes the legend disagree with our own
     map AND with spc.noaa.gov.
     ⚠️ "In Outlook" is read from the CACHED file, not the catalog — with hatching hidden, those rows are
     the reminder that it exists.
     Types: Entries = SpcRiskLevel, HatchRows = OutlookHatchLegendRow (Anvil.Models). -->
<UserControl x:Class="Anvil.Controls.Primitives.OutlookLegend"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Anvil.Converters"
             xmlns:local="using:Anvil.Controls.Primitives"
             xmlns:models="using:Anvil.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>

        <!-- One solid level: swatch (fill + stroke from SpcRiskCatalog) beside the level's own name. -->
        <DataTemplate x:Key="OutlookLegendItemTemplate" x:DataType="models:SpcRiskLevel">
            <Grid Margin="0,2" ColumnSpacing="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="20" Height="13" VerticalAlignment="Center">
                    <Border Background="{x:Bind Fill, Converter={StaticResource HexToBrush}}"
                            BorderBrush="{x:Bind Stroke, Converter={StaticResource HexToBrush}}"
                            BorderThickness="1" CornerRadius="2"/>
                    <Path Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1"
                          Visibility="{x:Bind local:OutlookLegend.HatchBackward(Hatch)}"
                          Data="M0,0 L13,13 M7,0 L20,13 M0,6.5 L6.5,13 M13,0 L20,6.5"/>
                    <Path Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1"
                          Visibility="{x:Bind local:OutlookLegend.HatchForward(Hatch)}"
                          Data="M0,13 L13,0 M7,13 L20,0 M0,6.5 L6.5,0 M13,13 L20,6.5"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{x:Bind OfficialName}"
                           FontSize="13" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </DataTemplate>

        <!-- One Conditional Intensity Group: hatch swatch, name, and whether the outlook carries it. A group
             NOT in the outlook is dimmed as well as worded, so the "In Outlook" rows are what the eye lands on. -->
        <DataTemplate x:Key="OutlookHatchRowTemplate" x:DataType="models:OutlookHatchLegendRow">
            <Grid Margin="0,2" ColumnSpacing="9" Opacity="{x:Bind local:OutlookLegend.HatchRowOpacity(InOutlook)}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="20" Height="13" VerticalAlignment="Center">
                    <Border Background="{x:Bind Level.Fill, Converter={StaticResource HexToBrush}}"
                            BorderBrush="{x:Bind Level.Stroke, Converter={StaticResource HexToBrush}}"
                            BorderThickness="1" CornerRadius="2"/>
                    <Path Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1"
                          Visibility="{x:Bind local:OutlookLegend.HatchBackward(Level.Hatch)}"
                          Data="M0,0 L13,13 M7,0 L20,13 M0,6.5 L6.5,13 M13,0 L20,6.5"/>
                    <Path Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1"
                          Visibility="{x:Bind local:OutlookLegend.HatchForward(Level.Hatch)}"
                          Data="M0,13 L13,0 M7,13 L20,0 M0,6.5 L6.5,0 M13,13 L20,6.5"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{x:Bind Level.OfficialName}"
                           FontSize="13" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="{x:Bind StatusText}"
                           FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Border Height="1" Margin="0,14"
                Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>

        <ItemsControl ItemsSource="{x:Bind Entries, Mode=OneWay}"
                      ItemTemplate="{StaticResource OutlookLegendItemTemplate}"/>

        <!-- Hatching heading + the Show box. Absent on products with no intensity groups. -->
        <Grid Margin="0,12,0,2" ColumnSpacing="8"
              Visibility="{x:Bind HasHatch(HatchRows), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Intensity hatching" VerticalAlignment="Center"
                       Style="{StaticResource SettingsFieldLabelStyle}"/>
            <CheckBox Grid.Column="1" Content="Show" MinWidth="0"
                      IsChecked="{x:Bind ShowHatching, Mode=TwoWay}"
                      ToolTipService.ToolTip="Show or hide the hatched intensity areas (fills stay)"/>
        </Grid>
        <ItemsControl ItemsSource="{x:Bind HatchRows, Mode=OneWay}"
                      ItemTemplate="{StaticResource OutlookHatchRowTemplate}"/>
    </StackPanel>
</UserControl>
