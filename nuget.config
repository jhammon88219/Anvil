<?xml version="1.0" encoding="utf-8"?>
<!-- Where restore finds packages: nuget.org as usual, plus LocalPackages, the NativeMaps packages committed in this repo
     (NativeMaps.Core + NativeMaps.WinUI), so a clone of Anvil builds with nothing beside it. To take a newer NativeMaps:
     bump <Version> in BOTH NativeMaps csprojs, pack them into this folder (CLAUDE.md, "Map engine"), then raise the
     NativeMaps.WinUI version in Anvil.App.csproj. -->
<configuration>
  <packageSources>
    <add key="NativeMaps (LocalPackages)" value="LocalPackages" />
  </packageSources>
</configuration>
