<?xml version="1.0" encoding="utf-8"?>
<!-- ClassicScrubber — the original loop scrubber: one solid cell per frame on a track, a playhead bar over the
     frame on screen. Lifted out of RadarControls (2026-10-06) so the Settings → Radar Console tab can show it as a
     live preview beside DotMatrixScrubber; the console picks one (RadarViewModel.IsDotMatrixScrubber).

       ┌─ 16 tall ─────────────────────────────────────────────┐
       │ ▬▬ ▬▬ ▬▬ ▬▬ ▬▬ ▬▬ ▬▬┃▬ ░░ ░░ ░░ ░░                    │  ← 8 px cells (EqualCellsPanel), accent at
       └───────────────────────────────────────────────────────┘    ReadyOpacity; ┃ = playhead, positioned in code

     ⚠️ The playhead asks EqualCellsPanel.CellCenter where the cell sits — one rounding rule, no drift.
     ⚠️ Not hit-testable: the host (RadarControls.ScrubberHost) owns the pointer. -->
<UserControl x:Class="Anvil.Controls.Primitives.ClassicScrubber"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:layout="using:Anvil.Layout"
             mc:Ignorable="d"
             IsTabStop="False"
             IsHitTestVisible="False"
             VerticalAlignment="Center">

    <Grid x:Name="Root" Height="16" SizeChanged="OnRootSizeChanged">
        <!-- Always-present track: same footprint whether or not a loop is loaded. -->
        <Border Height="8"
                VerticalAlignment="Center"
                CornerRadius="4"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"/>
        <ItemsControl ItemsSource="{x:Bind Segments, Mode=OneWay}"
                      VerticalAlignment="Center"
                      Height="8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <layout:EqualCellsPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RadarFrameSegment">
                    <Border Margin="1,0"
                            CornerRadius="2"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Opacity="{x:Bind ReadyOpacity, Mode=OneWay}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="Playhead"
                Width="3"
                Height="16"
                CornerRadius="1.5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{ThemeResource TextFillColorPrimaryBrush}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PlayheadTransform"/>
            </Border.RenderTransform>
        </Border>
    </Grid>
</UserControl>
