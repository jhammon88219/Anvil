<?xml version="1.0" encoding="utf-8"?>
<!-- NowCastWindow — the NowCast (live radar) settings: watch boxes + storm-based warnings, and today's
     storm reports. Hosted in its OWN OS window by WindowManager (MapViewModel.IsNowWindowOpen), so there is
     no panel frame: the root is the dark surface stretched to fill the window. Content extends into the
     title bar, so the panel carries its own title. Bound to the coordinator MapViewModel. -->
<UserControl x:Class="Anvil.Controls.Windows.NowCastWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="using:Anvil.Controls.Sections"
             xmlns:ctl="using:Anvil.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- Dark surface fills the whole window; content sits top-left. -->
    <Grid Background="{ThemeResource OverlayBarSurfaceBrush}">
        <Grid Margin="16" VerticalAlignment="Top" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- title -->
                <RowDefinition Height="Auto"/> <!-- watches + warnings -->
                <RowDefinition Height="Auto"/> <!-- divider -->
                <RowDefinition Height="Auto"/> <!-- storm reports (today) -->
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Live Radar"
                       FontSize="15" FontWeight="SemiBold" CharacterSpacing="40"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <sections:NowCastInput Grid.Row="1" ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>
            <Border Grid.Row="2" Height="1" Margin="0,2"
                    Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
            <sections:StormReportsInput Grid.Row="3" ViewModel="{x:Bind ViewModel.StormReports, Mode=OneWay}"/>
        </Grid>

        <!-- Pin: keep this window on top. -->
        <ctl:PinToggle IsChecked="{x:Bind ViewModel.IsNowWindowOnTop, Mode=TwoWay}"/>
    </Grid>
</UserControl>
