<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalWindowPastCastUserDecisionCard — the card under the PastCast header that offers the user's TWO
     SOURCES for a replay (the user's design, 2026-10-01): pick your own window with the picker below, OR play a
     saved event from the Atlas. Bound to the coordinator MapViewModel.

      ┌──────────────────────────────────────────────────────┐
      │ Choose timeframe… ⁘⁘⁘⁘⁘⁘  Or  ⁘⁘⁘⁘⁘⁘   [ ◫ Atlas ]   │  ← dot bridges (MapControlsStripSeparator)
      │ Casting  Joplin 2011  [Custom]          [ Tornado ]   │  ← only while a saved event is the pick
      └──────────────────────────────────────────────────────┘
        ↑ CardEdge: its border lights ACCENT while the picker's selection is DIRTY (SelectionStates)

     ⚠️ THE EDGE'S TWO BRUSHES ARE VISUAL STATES, NOT x:Bind FUNCTIONS — a correctness fix, not a tidy-up. They
     used to come from code, through Application.Current.Resources.TryGetValue, which resolves against the OS
     theme, not the pinned app theme (MainWindow.ApplyAppTheme): on a dark-mode machine the light theme drew its
     dirty accent in the dark theme's colours. {ThemeResource} in a state setter resolves against THIS element and
     re-resolves on a live switch. The listener in code-behind exists ONLY to drive these states.
     ⚠️ ATLAS is 84 × 32 with its right edge on the picker's Clear (this card's 1 border + 13 padding = Clear's 14
     right margin) — the user's call, 2026-10-01: the two doors line up. Change both together. Its mark is the
     bar's Atlas key glyph (EC05, MainWindow AtlasKey) — the same door, the same mark; change both.
     ⚠️ WHAT'S CASTING (2026-10-02): "Casting" + the name + the Custom tag (the Atlas's accent tag); the TYPE PILL in
     the Atlas column, 84 wide = the door's width, centred under it — the Atlas's type colour on a deep shade. -->

<UserControl x:Class="Anvil.Controls.TemporalWindows.TemporalWindowPastCastUserDecisionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tw="using:Anvil.Controls.TemporalWindows"
             xmlns:comp="using:Anvil.Controls.Composites"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsTabStop="False">

    <UserControl.Resources>
        <!-- The ATLAS button: transparent face, 1 px ACCENT hairline, 6 px corners (a quiet door, not a primary
             action). Minimal template so it can't pick up the stock button's chrome; hover and press only fill the
             face. LOCAL: this card is its only consumer. -->
        <Style x:Key="OpenAtlasButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Content.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Content"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ⚠️ The VisualStateManager groups live on THIS root (the first element of the UserControl's content) —
         GoToState looks for them here. -->
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="SelectionClean">
                    <VisualState.Setters>
                        <Setter Target="CardEdge.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectionDirty">
                    <VisualState.Setters>
                        <Setter Target="CardEdge.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border x:Name="CardEdge" CornerRadius="8" Padding="13,12"
                Background="{ThemeResource OverlayBarSurfaceHoverBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/> <!-- Atlas -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Choose timeframe… ⁘ Or ⁘ [Atlas] -->
                    <RowDefinition Height="Auto"/> <!-- Casting <event> [Custom] [Tornado] — a chosen event only -->
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.SavedEvents.HasPlaying, Mode=OneWay}">
                    <TextBlock Text="Casting" FontSize="13" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.SavedEvents.PlayingTitle, Mode=OneWay}" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Border CornerRadius="8" Padding="6,0" VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind ViewModel.SavedEvents.IsPlayingCustom, Mode=OneWay}">
                        <TextBlock Text="Custom" FontSize="11"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                </StackPanel>
                <Border Grid.Row="1" Grid.Column="1" Width="84" Margin="0,10,0,0" CornerRadius="4" Padding="0,1,0,2"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{x:Bind comp:PastEventsAtlasTab.KindBandBrush(ViewModel.SavedEvents.PlayingKind), Mode=OneWay}"
                        Visibility="{x:Bind PillShown(ViewModel.SavedEvents.HasPlaying, ViewModel.SavedEvents.HasPlayingKind), Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.SavedEvents.PlayingKindLabel, Mode=OneWay}" FontSize="12"
                               FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{x:Bind comp:PastEventsAtlasTab.KindInkBrush(ViewModel.SavedEvents.PlayingKind), Mode=OneWay}"/>
                </Border>

                <!-- Dot bridges span the gaps either side of "Or"; equal stars, so "Or" sits between them. The right
                     bridge's −6 cancels most of the 14 column gap, matching the left side. -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Choose timeframe…" FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <prim:MapControlsStripSeparator Grid.Column="1" FillWidth="True" Margin="8,0"/>
                    <!-- "Or": capital, 20 px — its letters (~14 px) stand a little proud of the 9.5 px dot bridges, the
                         user's call. ⚠️ TextLineBounds="Tight" trims the layout box to the letters (cap line →
                         baseline), so VerticalAlignment Center centres the LETTERS on the bridges' middle row, not the
                         line box (which sat them low). It only trims LAYOUT — the O's round overshoot still draws. -->
                    <TextBlock Grid.Column="2" Text="Or" FontSize="20" VerticalAlignment="Center"
                               TextLineBounds="Tight"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <prim:MapControlsStripSeparator Grid.Column="3" FillWidth="True" Margin="8,0,-6,0"/>
                </Grid>

                <!-- OPEN ATLAS, on Past events (MapViewModel.OpenAtlasOnEvents — also selects the event PastCast has
                     picked). Live even while a window is loaded (Play asks before replacing it). -->
                <Button Grid.Column="1" Style="{StaticResource OpenAtlasButtonStyle}" Width="84" Height="32"
                        Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="OnOpenAtlasClick"
                        ToolTipService.ToolTip="Browse saved severe-weather days in the Anvil Atlas and play one here">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14" Glyph="&#xEC05;"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Atlas" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
