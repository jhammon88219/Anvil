<?xml version="1.0" encoding="utf-8"?>
<!-- OutlookDiscussionWindow — SPC's forecast discussion for the outlook ON THE MAP, in its own OS window
     (WindowManager, Center anchor). Opened by the "Discussion." button on the Product row of BOTH outlook
     sections (ForeCast + PastCast); Past excludes Fore, so ONE window serves both and reads whichever runs.

       ┌──────────────────────────────────────────────[lock][pin]─┐
       │  Outlook discussion                                      │  ← the window's own name
       │  Day 1 · Categorical                                     │  ← which outlook (the section card's headline)
       │  ┌────────────────────────────────────────────────────┐  │
       │  │ SPC AC 011257                                      ┃  │  SPC's own teletype prose, fixed-pitch,
       │  │ DAY 1 CONVECTIVE OUTLOOK                           ┃  │  in PanelScroller (gutter always claimed)
       │  │ ...VALID 011300Z - 021200Z...                      ┃  │
       │  └────────────────────────────────────────────────────┘  │
       └──────────────────────────────────────────────────────────┘

     ⚠️ A FIRST CUT, by the user's call (2026-10-01): it shows the SAME raw text ForeCast's old inline
     "Forecast discussion" section showed (that section is gone). Making SPC's awful layout readable is the
     next job, here — keep it in this window.
     ⚠️ PastCast has no archived discussion yet; MapViewModel.OutlookDiscussionText says so in words.
     Closed by MapViewModel when neither outlook mode runs. -->
<UserControl x:Class="Anvil.Controls.Windows.OutlookDiscussionWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- Dark surface fills the whole window (custom chrome, like the temporal windows). -->
    <Grid Background="{ThemeResource OverlayBarSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- name -->
            <RowDefinition Height="Auto"/> <!-- which outlook -->
            <RowDefinition Height="*"/>    <!-- the text, scrolling -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="16,14,16,0" Text="Outlook discussion"
                   FontSize="15" FontWeight="SemiBold" CharacterSpacing="40"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <TextBlock Grid.Row="1" Margin="16,6,16,0"
                   Text="{x:Bind ViewModel.OutlookDiscussionTitle, Mode=OneWay}"
                   FontSize="13" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

        <!-- Margin right 4 = 16 − the scroller's 12 px gutter bleed (the PanelScroller header's rule). -->
        <ctl:PanelScroller Grid.Row="2" Margin="16,12,4,14">
            <!-- Monospace: SPC ships the discussion as pre-formatted teletype text, whose columns and hand-drawn
                 separators only line up in a fixed-pitch face. Selectable so a line can be copied out. -->
            <TextBlock Text="{x:Bind ViewModel.OutlookDiscussionText, Mode=OneWay}"
                       FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                       IsTextSelectionEnabled="True"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </ctl:PanelScroller>

        <!-- Lock + pin; both self-position top-right, clearing the caption. -->
        <ctl:LockToggle IsChecked="{x:Bind ViewModel.IsOutlookDiscussionLocked, Mode=TwoWay}"/>
        <ctl:PinToggle IsChecked="{x:Bind ViewModel.IsOutlookDiscussionOnTop, Mode=TwoWay}"/>
    </Grid>
</UserControl>
