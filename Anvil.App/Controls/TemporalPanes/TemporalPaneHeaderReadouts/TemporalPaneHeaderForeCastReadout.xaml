<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalPaneHeaderForeCastReadout — the ForeCast header's Readout: the shown outlook's HIGHEST risk over
     when the next update comes.

       MDT 4/5          ← 30 SemiLight (the PastCast range's size); "No areas" / "No outlook" dims to 40%
       next check 3:15 PM   ← 13 secondary: "live · when SPC issues" while a live source carries the outlooks
                               (OutlookNextUpdateText — a clock time, never a countdown) -->

<UserControl x:Class="Anvil.Controls.TemporalPanes.TemporalPaneHeaderReadouts.TemporalPaneHeaderForeCastReadout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tp="using:Anvil.Controls.TemporalPanes"
             xmlns:temporalPaneHeaderReadouts="using:Anvil.Controls.TemporalPanes.TemporalPaneHeaderReadouts"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsTabStop="False">

    <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="{x:Bind ViewModel.HeaderRiskText, Mode=OneWay}"
                   FontSize="30" FontWeight="SemiLight"
                   Opacity="{x:Bind PeakOpacity(ViewModel.HasPeak), Mode=OneWay}"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        <TextBlock Text="{x:Bind ViewModel.OutlookNextUpdateText, Mode=OneWay}" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
</UserControl>
