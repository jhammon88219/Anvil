<?xml version="1.0" encoding="utf-8"?>
<!-- FavoriteSitesFlyoutContent — the body of the flyout on the Atlas key's side car (MainWindow owns the
     Flyout): the home radar site, then the favorites, then a way into the full Radar Atlas. Clicking a
     site LOADS it; the host closes the flyout.

       ┌──────────────────────────────────┐
       │ ⌂  KTLX   Norman               ● │  ← home first (⌂), then favorites (★) in starred order
       │ ★  KFWS   Dallas/Ft Worth      ● │     ● = online / offline / grey not-checked, the Atlas's dot
       │ ★  KINX   Tulsa                ● │
       │──────────────────────────────────│
       │ Open Radar Atlas               │
       └──────────────────────────────────┘

     Empty (no home, no favorites): a hint line replaces the list. In PastCast the list is DISABLED and a
     note says why — a pick would re-target the replay, which the Home key must not do either. The Atlas
     link stays live in both.

     ⚠️ A ListView with IsItemClickEnabled and SelectionMode None, NOT selection: a pick is an action, and a
     selected row would still be highlighted the next time the flyout opened.
     ⚠️ Glyphs E80F (Home) / E735 (FavoriteStarFill) are NOT verified by rendering in the real font. -->
<UserControl x:Class="Anvil.Controls.Composites.FavoriteSitesFlyoutContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:conv="using:Anvil.Converters"
             xmlns:comp="using:Anvil.Controls.Composites"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:SiteAvailabilityToBrushConverter x:Key="AvailabilityToBrush"/>
    </UserControl.Resources>

    <Grid Width="260" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- home + favorites -->
            <RowDefinition Height="Auto"/> <!-- empty hint -->
            <RowDefinition Height="Auto"/> <!-- PastCast note -->
            <RowDefinition Height="Auto"/> <!-- rule -->
            <RowDefinition Height="Auto"/> <!-- open Atlas -->
        </Grid.RowDefinitions>

        <ListView Grid.Row="0" MaxHeight="320"
                  ItemsSource="{x:Bind ViewModel.PinnedSites, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnSiteClick"
                  IsEnabled="{x:Bind ViewModel.CanPickSites, Mode=OneWay}"
                  Visibility="{x:Bind CollapsedWhen(ViewModel.IsEmpty), Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:RadarSiteRow">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontSize="14" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Glyph="{x:Bind comp:FavoriteSitesFlyoutContent.PinGlyph(IsHome), Mode=OneWay}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Id}" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Name}" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <Ellipse Grid.Column="3" Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{x:Bind Availability, Converter={StaticResource AvailabilityToBrush}, Mode=OneWay}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1" Margin="8,4"
                   Text="Star sites in the Radar Atlas, or set a home site, to pin them here."
                   TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Visibility="{x:Bind VisibleWhen(ViewModel.IsEmpty), Mode=OneWay}"/>

        <TextBlock Grid.Row="2" Margin="8,0"
                   Text="Site picks are off in PastCast."
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Visibility="{x:Bind CollapsedWhen(ViewModel.CanPickSites), Mode=OneWay}"/>

        <Rectangle Grid.Row="3" Height="1" Fill="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>

        <Button Grid.Row="4"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Background="Transparent" BorderThickness="0" Padding="8,6"
                Content="Open Radar Atlas"
                Click="OnOpenAtlasClick"/>
    </Grid>
</UserControl>
