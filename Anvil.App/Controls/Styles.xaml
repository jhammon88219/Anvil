<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================================
     Styles.xaml — the app-wide shared resource dictionary. Merged in App.xaml, so anything in any
     control or window can reference these by key.

     ORGANIZATION — three sections, in this order, and please keep it that way:

       1. THEME BRUSHES   the ThemeDictionaries block. Colors that must follow Win11 light/dark.
                          MUST come first: the styles below resolve these keys.
       2. SIZES           the handful of numbers two different clusters have to agree on.
                          MUST precede the styles: StaticResource resolves at parse time, in
                          document order, and cannot look forward.
       3. STYLES          reusable Styles, grouped by the control they target. Within the section,
                          a BASE style must appear ABOVE anything BasedOn it — XAML resolves
                          BasedOn at parse time and cannot look forward.

     WHAT BELONGS HERE: a brush or style used by MORE THAN ONE control, or one that must not drift
     between controls (the overlay surfaces are the case in point — the bar and every floating window
     share them so the app reads as one system). A look used by exactly ONE control belongs in that
     control's own Resources instead; this file is not a dumping ground.

     …with one STANDING EXCEPTION, by decision: SettingsTabKeyStyle (one consumer, TabStrip). It is here
     because the tab look is hand-tuned often and needs to sit beside the bar-key chain it is
     deliberately unlike, so the two stay in one voice. That is the bar for an exception — "I will be
     editing this next to that" — not merely "it might get a second consumer one day".

     ⚠️ HISTORY, so it isn't repeated: two ComboBox styles used to live here, each carrying ~300 lines
     of ControlTemplate for a single consumer. Both were deleted and became the UserControl that was
     their only user. A ControlTemplate here needs to earn its place — see the note on
     BarChromeButtonStyle, which does.
     ============================================================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <!-- ══════════════════════════════ 1. THEME BRUSHES ══════════════════════════════
         The opaque, theme-aware surfaces used by the bottom OverlayBar AND the floating app-wide
         windows over the map, so the two read as one system in Win11 light/dark. Defined app-wide
         (here) rather than inside a single control so every consumer references the SAME keys and
         they can't drift. (Moved out of OverlayBar.xaml's local ThemeDictionaries.)

         The family, resting → raised:
           Surface           the bar / window ground
           SurfaceHover      hovering something interactive on that ground
           SurfaceElevated   a control that is ON / selected — it sits above the ground
           SurfaceElevatedHover   … and hovered

         ⚠️ "Elevated" is LIGHTER than the ground in dark theme and DARKER in light. Elevation is not
         a direction, it is a contrast step away from the ground: on the light ground (#F3F3F3) there
         is almost no headroom above, so going lighter would make a selected control invisible. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="OverlayBarSurfaceBrush" Color="#FF000000"/>
            <SolidColorBrush x:Key="OverlayBarSurfaceHoverBrush" Color="#FF1A1A1A"/>
            <SolidColorBrush x:Key="OverlayBarSurfaceElevatedBrush" Color="#FF2B2B2B"/>
            <SolidColorBrush x:Key="OverlayBarSurfaceElevatedHoverBrush" Color="#FF383838"/>

            <!-- Expander (every panel section). Header on the raised face, body on the ground. -->
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#FF1A1A1A"/>
            <SolidColorBrush x:Key="ExpanderHeaderPointerOverBackground" Color="#FF2B2B2B"/>
            <SolidColorBrush x:Key="ExpanderHeaderPressedBackground" Color="#FF2B2B2B"/>
            <SolidColorBrush x:Key="ExpanderContentBackground" Color="#FF000000"/>
            <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="CardStrokeColorDefaultSolidBrush"/>
            <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="CardStrokeColorDefaultSolidBrush"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="OverlayBarSurfaceBrush" Color="#FFF3F3F3"/>
            <SolidColorBrush x:Key="OverlayBarSurfaceHoverBrush" Color="#FFE4E4E4"/>
            <SolidColorBrush x:Key="OverlayBarSurfaceElevatedBrush" Color="#FFDCDCDC"/>
            <SolidColorBrush x:Key="OverlayBarSurfaceElevatedHoverBrush" Color="#FFD0D0D0"/>

            <!-- Expander (every panel section). Header on the raised face, body on the ground. -->
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#FFE4E4E4"/>
            <SolidColorBrush x:Key="ExpanderHeaderPointerOverBackground" Color="#FFDCDCDC"/>
            <SolidColorBrush x:Key="ExpanderHeaderPressedBackground" Color="#FFDCDCDC"/>
            <SolidColorBrush x:Key="ExpanderContentBackground" Color="#FFF3F3F3"/>
            <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="CardStrokeColorDefaultSolidBrush"/>
            <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="CardStrokeColorDefaultSolidBrush"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="OverlayBarSurfaceBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="OverlayBarSurfaceHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="OverlayBarSurfaceElevatedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="OverlayBarSurfaceElevatedHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ══════════════════════════════ 2. SIZES ══════════════════════════════
         How big a key in the bottom bar is. FIVE numbers, and they are here for exactly one reason:
         TWO clusters have to agree on them. The temporal keys sit at the bar's centre and the pane /
         Sites / Settings keys sit at its right edge, side by side in one strip — a local copy in
         either would let the two halves of one bar drift apart the first time either was tuned.

         ⚠️ THESE ARE THE ONLY SIZES THAT ARE SHARED. Anything used by ONE key belongs to that key,
         not here — the pane key's wide mark lives in MainWindow.xaml's own Resources, the side car's
         mark lives in SplitTemporalToggle.xaml. Same rule as the styles below: more than one
         consumer, or it doesn't earn a place in this file.

         ⚠️ HISTORY — THERE USED TO BE A WHOLE CLASS FOR THIS (Anvil.App/Layout/BarKeyMetrics), and
         it is GONE. It existed to COMPUTE: the bar's height was set by the per-pane product chips,
         which grew it in quad layout, so every key measured the row it was given and mirrored that
         onto its Width, with ratios and floors and a name-font probe on top. The chips moved to the
         pane notches, the bar's height stopped moving, and all that machinery was left reacting to
         nothing — while leaving the keys at whatever size the radar console implied rather than a
         size anyone chose. The keys declare a size now and the bar's Auto row sizes to THEM, so
         there is nothing to compute and no code to hold it: five numbers, applied by Setters and by
         XAML, and no code-behind sizing anywhere in the bar. Don't re-introduce the measuring.

         ⚠️ ONE THING WAS LOST WITH IT, knowingly: the name font size used to be MEASURED against the
         longest label so a rename could never overflow its key. It is a chosen constant now
         (BarKeyNameSize). The labels are fixed strings and an overflow is visible the moment it
         happens, so the probe was paying for a problem nobody had. If a long name ever does land,
         the fix is this number — not a return to measuring. -->

    <!-- The square every bar key is built on. THE knob: change this and both clusters follow. -->
    <x:Double x:Key="BarKeySide">72</x:Double>

    <!-- The glyph in a key that also carries a NAME — small, because the name takes the rest of the
         square. Roughly 0.30 of the side; a solo glyph would want more, but no key is solo now. -->
    <x:Double x:Key="BarKeyGlyphSize">21</x:Double>

    <!-- The name under the glyph. One size for every key in the bar, so the two clusters read as one
         set rather than as keys with their own type sizes. ⚠️ Sized to fit the LONGEST name in the
         bar ("PastCast" / "ForeCast" / "Settings") inside BarKeySide less its padding — check it
         against this if you rename a key. -->
    <x:Double x:Key="BarKeyNameSize">13</x:Double>

    <!-- The SIDE CAR: the settings column on a split temporal key (Controls/Primitives/
         SplitTemporalToggle). Shared because it decides how wide those keys are, and therefore how
         much of the bar the centre cluster takes. ⚠️ It runs the FULL height of the key — that is the
         whole point of it, and what a foot rail could not do: the glyph-and-name stack already owns
         the key's height, so a settings affordance carved out of the height is always a sliver,
         while one carved out of the width can be full size. -->
    <x:Double x:Key="BarSideCarWidth">28</x:Double>

    <!-- HEIGHT of the drawn three-dot mark inside the car. Its WIDTH is not a number anywhere: the
         Viewbox takes it from the shape's own 6x26 box, which is TALL — the dots run vertically, along
         the car rather than across it. -->
    <x:Double x:Key="BarSideCarMarkHeight">24</x:Double>

    <!-- ══════════════════════════════ 3. STYLES ══════════════════════════════ -->

    <!-- ───────────────────── ButtonBase — the shared bar-chrome look ─────────────────────

         BarChromeButtonStyle — ONE definition of what an interactive key in the bottom bar looks
         like, in every state. It carries the TEMPLATE and nothing that has a size:

           OFF            HOVER           ON (checked)     ON + HOVER
          ┌────────┐     ┌────────┐      ┏━━━━━━━━┓       ┏━━━━━━━━┓     ━━ = accent border
          │   ↺    │     │▒▒ ↺ ▒▒▒│      ┃▓▓ ↺ ▓▓▓┃       ┃██ ↺ ███┃     ▒  = hover fill
          │PastCast│     │▒PastCast│     ┃▓PastCast┃      ┃█PastCast┃    ▓  = elevated surface
          └────────┘     └────────┘      ┗━━━━━━━━┛       ┗━━━━━━━━┛
           hairline       hairline        ACCENT           ACCENT

         ⚠️ ON is carried by the BORDER, not by flooding the face with the accent color. The default
         ToggleButton does the latter: checked = an accent-filled block. A row of those at this size is
         a wall of accent in the bar, it fights the map behind it, and it leaves the glyph and label
         sitting on a saturated ground. Here the border takes the accent and the face only steps up one
         surface level, so "which of these is on" still reads at a glance without the bar shouting.

         ⚠️ IT TARGETS ButtonBase, AND IT IS A BASE ONLY — never applied directly. Two roles derive from
         it, and they differ only by CONTROL TYPE, not by look: BarKeyToggleStyle for the seven latching
         keys and BarIconButtonStyle for the one that acts. Both are empty derivations, which is the
         point — every key in the bar is the same square holding a mark over a name.

         ⚠️ THE SQUARE IS SET HERE, and that is a REVERSAL. Every bar key is BarKeySide on both sides,
         applied by the two Setters below, and the bar's Auto content row sizes to the keys. It used to
         be the other way round — the key stretched to the row and each cluster's code-behind measured
         that height and mirrored it onto Width — because the per-pane product chips lived in the bar
         and changed its height. They don't any more. See the ⚠️ history in section 2.
         ⚠️ A key that needs a different WIDTH overrides it locally (the pane key, whose mark is a wide
         picture of the map band). Nothing should override the HEIGHT: one row of keys, one height.

         WHY A ControlTemplate (this file's default is: don't). The checked look is applied by the
         default template's own visual states, so a Style full of Setters cannot reach it — a Setter
         loses to a VisualState every time. The alternatives were overriding the ToggleButton* theme
         brushes app-wide, which would repaint every other toggle in the app, or repeating this look per
         control. A minimal template shared by every bar key is the contained option, and it is the same
         move OverlayBarTabStyle makes for the pull-tab.

         ⚠️ The border lives on its OWN backdrop Border, a SIBLING of the content rather than its
         parent. That is what lets the checked state thicken the stroke 1px → 2px without nudging the
         content half a pixel as it lights up. Same trick as ProductComboBox.

         The Checked* states never fire on a plain Button (nothing calls GoToState for them), so this
         template is safe for both Button and ToggleButton consumers. -->
    <Style x:Key="BarChromeButtonStyle" TargetType="primitives:ButtonBase">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Width" Value="{StaticResource BarKeySide}"/>
        <Setter Property="Height" Value="{StaticResource BarKeySide}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:ButtonBase">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>

                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource OverlayBarSurfaceHoverBrush}"/>
                                        <Setter Target="Surface.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource OverlayBarSurfaceElevatedBrush}"/>
                                        <Setter Target="Surface.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>

                                <!-- ON. Accent goes on the stroke; the face steps up one surface level. -->
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource OverlayBarSurfaceElevatedBrush}"/>
                                        <Setter Target="Surface.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                        <Setter Target="Surface.BorderThickness" Value="2"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource OverlayBarSurfaceElevatedHoverBrush}"/>
                                        <Setter Target="Surface.BorderBrush" Value="{ThemeResource AccentFillColorSecondaryBrush}"/>
                                        <Setter Target="Surface.BorderThickness" Value="2"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource OverlayBarSurfaceElevatedBrush}"/>
                                        <Setter Target="Surface.BorderBrush" Value="{ThemeResource AccentFillColorTertiaryBrush}"/>
                                        <Setter Target="Surface.BorderThickness" Value="2"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource OverlayBarSurfaceElevatedBrush}"/>
                                        <Setter Target="Surface.BorderBrush" Value="{ThemeResource AccentFillColorDisabledBrush}"/>
                                        <Setter Target="Surface.BorderThickness" Value="2"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Backdrop pane: carries the fill AND the stroke, and holds no content, so the
                             checked state's thicker border costs no layout (see the ⚠️ above). -->
                        <Border x:Name="Surface"
                                Background="Transparent"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"/>

                        <ContentPresenter x:Name="Content"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────────────────────────── Button ───────────────────────────── -->

    <!-- Square transport button base: no min-size padding, centered glyph, rounded. Applied by the radar
         transport (prev / play-stop / next).
         ⚠️ Deliberately NOT on BarChromeButtonStyle yet — the transport was left on the stock look when
         the rest of the bar chrome moved over, so it is the one cluster still speaking the old language.
         Rebasing it is a one-line change (BasedOn) when that is wanted. -->
    <Style x:Key="TransportButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- A bar key that ACTS rather than latching — today just the pane-layout key, which cycles
         Single → Two across → Quad and reports its state through its icon, not through being lit.
         Same square and same rest/hover/pressed look as every other key; it simply never reaches the
         Checked states, which is why a Button is the honest control for it. -->
    <Style x:Key="BarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource BarChromeButtonStyle}"/>

    <!-- ───────────────────────────── ToggleButton ───────────────────────────── -->

    <!-- EVERY latching key in the bar: the three temporal keys at the centre
         (Controls/Composites/TemporalToggles) and the four window buttons on the right (MainWindow).
         Its content is a glyph over a NAME, both sized by the hosting control's code-behind via
         Layout/BarKeyMetrics — so there is nothing to add here beyond the base. The style exists to name
         the role and to keep one reference for both clusters if they ever need to diverge again.

         ⚠️ It must NOT set the icon FontFamily. There used to be a second style, BarIconToggleStyle,
         that did exactly that for the then-glyph-only right cluster; naming those keys made it actively
         harmful, because a FontFamily on the BUTTON renders the name in the icon font too (the name comes
         out as boxes). The glyph now carries its own font on the FontIcon, where it belongs, and the two
         styles collapsed into this one. Don't re-add a font setter here. -->
    <Style x:Key="BarKeyToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource BarChromeButtonStyle}"/>

    <!-- ───────────────────────────── Expander — a panel SECTION ─────────────────────────────

         Every section in every temporal window and every Settings tab is one of these.

           COLLAPSED                          EXPANDED
          ┌────────────────────────┐     ┌────────────────────────┐
          │ ›  Warnings              │     │ ⌄  Warnings              │  ← header, raised face
          └────────────────────────┘     ├────────────────────────┤
                                             │ ┌───────────────────┐ │
                                             │ │ 7 active warnings  │ │  ← body, on the window's
                                             │ └───────────────────┘ │     own ground
                                             │ [x] ■ Severe         7   │
                                             └────────────────────────┘

         The header text is the SECTION TITLE — pass a plain string to Header and the HeaderTemplate
         below renders it, so a call site is one line and every section reads the same.

         ⚠️ HorizontalContentAlignment must be Stretch. Expander does NOT stretch its content by
         default, so without it every card, slider and combo inside collapses to its own width and the
         section looks half-built.

         ⚠️ This REPLACED Controls/Primitives/SectionHeading (a title + a hairline to the panel's edge),
         which is DELETED. The expander's own box is the boundary now, and it can be closed. -->
    <Style x:Key="SectionExpanderStyle" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────────────────────────── TextBlock — settings-body labels ─────────────────────────────

         The inline FIELD label ("State", "Spacing (mi)") inside a panel body. Shared because every Settings
         tab and every temporal window uses it — it was copied into the local Resources of all three windows
         the tabs replaced, and the copies had already begun to drift.

         ⚠️ THE SECTION HEADING RANK IS NOT A STYLE, AND IS NOT A CONTROL ANY MORE EITHER. It was
         SettingsSectionLabelStyle here, then Controls/Primitives/SectionHeading (a title + a hairline to
         the panel's edge); both are DELETED. A section title is the Header of a SectionExpanderStyle
         Expander now — see that style above. -->
    <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
    </Style>

    <!-- One tab in Controls/Primitives/TabStrip — today the Settings window's rail, which is the whole of
         what used to be three separate windows (App Settings / Map Controls / Dev Tools).

           OFF          HOVER        SELECTED         SELECTED + HOVER
          ┌──────┐     ┌──────┐     ┌──────┐         ┌──────┐        ▒ = hover fill
          │  ⛰   │     │▒ ⛰ ▒▒│     │▓ ⛰ ▓▓│         │█ ⛰ ██│        ▓ = elevated surface
          │ Map  │     │▒Map ▒│     │▓Map ▓│         │█Map █│        ▀ = accent indicator
          └──────┘     └──────┘     └─▀▀▀▀─┘         └─▀▀▀▀─┘          (drawn by the item template)

         ⚠️ IT IS NOT BasedOn THE BAR-KEY CHAIN, and that is deliberate. A bar key is a bordered SQUARE
         sized off the bar's height; a tab is content-width with no box at all, so a rail of them reads as
         one strip instead of a row of loose keys. What the two share is the vocabulary — a mark over a
         name, hover/elevated faces from the same OverlayBarSurface* family, accent reserved for "this one
         is on" — not a template. Deriving would mean unsetting the border, the square and the stretch.

         ⚠️ NO indicator lives here. The accent edge is drawn by the item template, because WHICH edge it
         sits on depends on the strip's placement (bottom for a top rail, leading for a side rail) and a
         ControlTemplate cannot see that. This style owns the face and the text; the template owns the mark.

         ⚠️ It carries a ControlTemplate for the same reason BarChromeButtonStyle does: "selected" is
         applied by the default ToggleButton template's visual states, which a Setter cannot beat, and the
         default look is an accent-FILLED block.

         ⚠️ HOUSE-RULE EXCEPTION: this file's rule is that a style earns its place here by having more than
         one consumer, and today TabStrip is the only one. It lives here anyway, by decision — the tab look
         is exactly the kind of thing that gets hand-tuned, and it wants to sit beside the bar-key chain it
         is deliberately unlike, so the two can be compared and kept in the same voice. -->
    <Style x:Key="SettingsTabKeyStyle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>

                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource OverlayBarSurfaceHoverBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource OverlayBarSurfaceElevatedBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>

                                <!-- SELECTED. The face steps up one level and the text goes primary; the
                                     accent is spent on the indicator the item template draws. -->
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource OverlayBarSurfaceElevatedBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource OverlayBarSurfaceElevatedHoverBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource OverlayBarSurfaceElevatedBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Transparent at rest: an unselected tab is just its mark and name on the window's
                             own surface. Hit-testing still covers the whole tab (Background is set, not null). -->
                        <Border x:Name="Surface"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}"/>

                        <ContentPresenter x:Name="Content"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
