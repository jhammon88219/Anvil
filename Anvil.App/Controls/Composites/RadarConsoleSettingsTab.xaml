<?xml version="1.0" encoding="utf-8"?>
<!-- RadarConsoleSettingsTab — the Radar Console tab of the Settings window: how the bar's radar console (the
     GLOBAL time module, Composites/RadarControls) looks: which loop scrubber it draws, and the hatch scrubber's look.

       ┌──────────────────────────────────────────────────────┐
       │                                 [ Restore defaults ] │  ← ABOVE the sections; resets the hatch look only
       │  ⌄  Scrubber                                         │
       │    ┌────────────────────────────────────────────┐    │
       │    │ ◯ Classic cells                            │    │
       │    │   One solid cell per frame                 │    │
       │    │   ▬▬ ▬▬ ▬▬┃▬ ▬▬ ░░ ░░ ░░                   │    │  ← Primitives/ClassicScrubber, LIVE
       │    └────────────────────────────────────────────┘    │
       │    ┌────────────────────────────────────────────┐    │
       │    │ ◉ Dot matrix                               │    │
       │    │   Each frame a block of dots that fill …   │    │
       │    │   ⁙⁙ ⁙⁙ ◆◆ ⁙⁙ ⁚⁚ ·· ··                      │    │  ← Primitives/DotMatrixScrubber, LIVE
       │    └────────────────────────────────────────────┘    │
       │    ┌────────────────────────────────────────────┐    │
       │    │ ◯ Hatch                                    │    │
       │    │   The edge hatch along the loop …          │    │
       │    │   ╱╲╱╲╱╲║╲║╱╲╱╲ ╱ ╱                        │    │  ← Primitives/HatchScrubber, LIVE (look = the section below)
       │    └────────────────────────────────────────────┘    │
       │    Previews show the loaded loop; a sample until one loads.
       │  ⌄  Hatch scrubber                                   │  ← its OWN look, apart from Settings → Edges
       │    Line colour  (A) ■ ■ ■ ■ ■ ■ (+)                  │  ← A = the accent (HatchScrubberLook presets)
       │    Line spacing ──●───────────────   5 px            │  ← all measured at the edge's 35 px, scaled
       │    Line weight  ───────●─────────  1.0 px            │    to the 24 px strip
       │    Line opacity ──────────●──────   60%              │  ← the frame on screen is always full
       └──────────────────────────────────────────────────────┘

     ⚠️ REAL PREVIEWS: the three scrubbers are the console's own controls fed the console's own Segments and frame
     index (set from code — the source flips to a fixed SAMPLE while no loop is loaded, so a preview is never blank).
     ⚠️ Picking is a RadioButton CLICK writing RadarViewModel.ScrubberStyleIndex; IsChecked is ONE-WAY from it. -->

<UserControl x:Class="Anvil.Controls.Composites.RadarConsoleSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- An option card: the radio's content is title · description · preview, the whole card the hit target. -->
        <Style x:Key="ScrubberOptionStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ScrubberStyle"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,8,12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="8" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- restore -->
            <RowDefinition Height="Auto"/> <!-- scrubber -->
            <RowDefinition Height="Auto"/> <!-- hatch scrubber look -->
        </Grid.RowDefinitions>

        <Button x:Name="HatchScrubberRestoreDefaultsButton" Grid.Row="0" HorizontalAlignment="Right" Content="Restore defaults"
                Click="{x:Bind ViewModel.Radar.HatchLook.RestoreDefaults}"
                ToolTipService.ToolTip="Hatch scrubber: accent colour, 5 px spacing, 1.0 px lines, 60% opacity"/>

        <prim:SettingsExpander Grid.Row="1" Header="Scrubber" IsExpanded="True">
            <StackPanel Spacing="8" Margin="4,0,0,0">
                <RadioButton Style="{StaticResource ScrubberOptionStyle}"
                             IsChecked="{x:Bind IsStyle(ViewModel.Radar.ScrubberStyleIndex, 0), Mode=OneWay}"
                             Click="OnClassicClick">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Classic cells"/>
                        <TextBlock Text="One solid cell per frame, a playhead over the frame on screen."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid Height="20" Margin="0,8,0,0">
                            <prim:ClassicScrubber x:Name="ClassicPreview"/>
                        </Grid>
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource ScrubberOptionStyle}"
                             IsChecked="{x:Bind IsStyle(ViewModel.Radar.ScrubberStyleIndex, 1), Mode=OneWay}"
                             Click="OnDotMatrixClick">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Dot matrix"/>
                        <TextBlock Text="Each frame a block of dots that fill as it loads; the frame on screen lights whole."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid Height="20" Margin="0,8,0,0">
                            <prim:DotMatrixScrubber x:Name="DotMatrixPreview" FillOrder="LeftToRight"/>
                        </Grid>
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource ScrubberOptionStyle}"
                             IsChecked="{x:Bind IsStyle(ViewModel.Radar.ScrubberStyleIndex, 2), Mode=OneWay}"
                             Click="OnHatchClick">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Hatch"/>
                        <TextBlock Text="The edge hatch along the loop: each frame's lines grow as it loads; the frame on screen is bolder. Its colour, spacing, weight and opacity are set below."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid Height="20" Margin="0,12,0,0">
                            <prim:HatchScrubber x:Name="HatchPreview"
                                                Spacing="{x:Bind ViewModel.Radar.HatchLook.Spacing, Mode=OneWay}"
                                                Weight="{x:Bind ViewModel.Radar.HatchLook.Weight, Mode=OneWay}"
                                                Ink="{x:Bind ViewModel.Radar.HatchLook.ColorHex, Mode=OneWay}"
                                                LineOpacity="{x:Bind ViewModel.Radar.HatchLook.LineOpacity, Mode=OneWay}"/>
                        </Grid>
                    </StackPanel>
                </RadioButton>

                <TextBlock x:Name="PreviewNote"
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </prim:SettingsExpander>

        <!-- The hatch scrubber's OWN look (RadarViewModel.HatchLook) — apart from Settings → Edges. Rows = the Edges
             tab's, so the two read alike; the sizes are at the edge's 35 px and the scrubber scales them to its strip. -->
        <prim:SettingsExpander Grid.Row="2" Header="Hatch scrubber" IsExpanded="True">
            <Grid RowSpacing="10" ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>

                <!-- "A" = the accent (follows Windows); "+" = any colour. -->
                <TextBlock Grid.Row="0" Margin="4,0,0,0" VerticalAlignment="Center" Text="Line colour"/>
                <prim:ColorSwatchPicker x:Name="HatchScrubberColorPicker" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                        HorizontalAlignment="Left"
                                        AllowCustom="True"
                                        ItemsSource="{x:Bind ViewModel.Radar.HatchLook.ColorSwatches}"
                                        ToolTips="{x:Bind ViewModel.Radar.HatchLook.ColorNames}"
                                        SelectedIndex="{x:Bind ViewModel.Radar.HatchLook.ColorIndex, Mode=TwoWay}"
                                        CustomHex="{x:Bind ViewModel.Radar.HatchLook.ColorHex, Mode=TwoWay}"/>

                <TextBlock Grid.Row="1" Margin="4,0,0,0" VerticalAlignment="Center" Text="Line spacing"/>
                <Slider x:Name="HatchScrubberSpacingSlider" Grid.Row="1" Grid.Column="1" Minimum="3" Maximum="12" StepFrequency="1"
                        Value="{x:Bind ViewModel.Radar.HatchLook.Spacing, Mode=TwoWay}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource TabularNumberTextStyle}"
                           Text="{x:Bind ViewModel.Radar.HatchLook.SpacingText, Mode=OneWay}"/>

                <TextBlock Grid.Row="2" Margin="4,0,0,0" VerticalAlignment="Center" Text="Line weight"/>
                <Slider x:Name="HatchScrubberWeightSlider" Grid.Row="2" Grid.Column="1" Minimum="0.5" Maximum="2" StepFrequency="0.5"
                        Value="{x:Bind ViewModel.Radar.HatchLook.Weight, Mode=TwoWay}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource TabularNumberTextStyle}"
                           Text="{x:Bind ViewModel.Radar.HatchLook.WeightText, Mode=OneWay}"/>

                <TextBlock Grid.Row="3" Margin="4,0,0,0" VerticalAlignment="Center" Text="Line opacity"/>
                <Slider x:Name="HatchScrubberOpacitySlider" Grid.Row="3" Grid.Column="1" Minimum="10" Maximum="100" StepFrequency="1"
                        SmallChange="1" LargeChange="10"
                        Value="{x:Bind ViewModel.Radar.HatchLook.Opacity, Mode=TwoWay}"/>
                <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource TabularNumberTextStyle}"
                           Text="{x:Bind ViewModel.Radar.HatchLook.OpacityText, Mode=OneWay}"/>
            </Grid>
        </prim:SettingsExpander>
    </Grid>
</UserControl>
