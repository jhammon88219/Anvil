<?xml version="1.0" encoding="utf-8"?>
<!-- MapControlsWindow — whole-map controls (basemap, view extent, state isolation, radar-site markers,
     the mile grid, and the Inspect cursor tool). Hosted in its
     OWN OS window by WindowManager (native title bar is the only chrome), so there is no panel frame: the
     root is the dark surface, stretched to fill the window, content laid out top-left. Bound to the
     coordinator MapViewModel (basemap + FitToViewAsync on it, isolation on its StateIso). -->
<UserControl x:Class="Anvil.Controls.Windows.MapControlsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Section header inside the body (e.g. "Basemap", "State Isolation"). -->
        <Style x:Key="MapWindowSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="40"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>
        <!-- Inline field label (e.g. "State"). -->
        <Style x:Key="MapWindowFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- Dark surface fills the whole window; content sits top-left. -->
    <Grid Background="{ThemeResource OverlayBarSurfaceBrush}">
        <!-- Body: [section label] over its controls, grid rows (no StackPanels). -->
        <Grid Margin="16" RowSpacing="8" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Basemap label -->
                <RowDefinition Height="Auto"/> <!-- Basemap combo -->
                <RowDefinition Height="Auto"/> <!-- View label -->
                <RowDefinition Height="Auto"/> <!-- CONUS toggle -->
                <RowDefinition Height="Auto"/> <!-- Fit to view button -->
                <RowDefinition Height="Auto"/> <!-- Reset north button -->
                <RowDefinition Height="Auto"/> <!-- State Isolation label -->
                <RowDefinition Height="Auto"/> <!-- Isolate toggle -->
                <RowDefinition Height="Auto"/> <!-- State combo row -->
                <RowDefinition Height="Auto"/> <!-- Radar Sites label -->
                <RowDefinition Height="Auto"/> <!-- Show site markers -->
                <RowDefinition Height="Auto"/> <!-- Show TDWRs -->
                <RowDefinition Height="Auto"/> <!-- Show research radars -->
                <RowDefinition Height="Auto"/> <!-- Mile Grid label -->
                <RowDefinition Height="Auto"/> <!-- Grid toggle -->
                <RowDefinition Height="Auto"/> <!-- Spacing combo -->
                <RowDefinition Height="Auto"/> <!-- Opacity slider -->
                <RowDefinition Height="Auto"/> <!-- Tools label -->
                <RowDefinition Height="Auto"/> <!-- Inspect toggle -->
            </Grid.RowDefinitions>

            <!-- ── Basemap ── -->
            <TextBlock Grid.Row="0" Text="Basemap"
                       Style="{StaticResource MapWindowSectionLabelStyle}"/>
            <ComboBox Grid.Row="1" Margin="4,0,0,0"
                      Width="240" HorizontalAlignment="Left"
                      ItemsSource="{x:Bind ViewModel.AvailableStyles}"
                      DisplayMemberPath="DisplayName"
                      SelectedItem="{x:Bind ViewModel.SelectedStyle, Mode=TwoWay}"
                      ToolTipService.ToolTip="Map basemap style"/>

            <!-- ── View extent ── -->
            <TextBlock Grid.Row="2" Text="View" Margin="0,6,0,0"
                       Style="{StaticResource MapWindowSectionLabelStyle}"/>

            <!-- Base extent: mask everything outside the contiguous 48 (on by default), or the full
                 map. A single isolated state (below) still overrides this until cleared. -->
            <CheckBox Grid.Row="3" Margin="4,0,0,0"
                      Content="CONUS only (mask outside the lower 48)"
                      IsChecked="{x:Bind ViewModel.StateIso.IsConusIsolated, Mode=TwoWay}"
                      ToolTipService.ToolTip="Hide everything outside the contiguous United States. Uncheck for the full map (incl. AK/HI/PR)."/>

            <!-- Fit-to-view: frame the current region (isolated state, else CONUS) — center + zoom. -->
            <Button Grid.Row="4" Margin="4,2,0,0"
                    Click="OnFitToViewClick"
                    ToolTipService.ToolTip="Frame the current view (isolated state, else CONUS) — center &amp; zoom to fit">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14" Glyph="&#xE740;"/>
                    <TextBlock Text="Fit to view" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Reset north: animate bearing + pitch back to 0 (north up, flat). -->
            <Button Grid.Row="5" Margin="4,2,0,0"
                    Click="OnResetNorthClick"
                    ToolTipService.ToolTip="Reset the map's rotation and 3D tilt — face north, flat">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14" Glyph="&#xE72C;"/>
                    <TextBlock Text="Reset north" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- ── State Isolation ── -->
            <TextBlock Grid.Row="6" Text="State Isolation" Margin="0,6,0,0"
                       Style="{StaticResource MapWindowSectionLabelStyle}"/>

            <!-- Arms hover-to-highlight + click-to-isolate on the map (the original workflow). -->
            <CheckBox Grid.Row="7" Margin="4,0,0,0"
                      Content="Isolate a state (hover &amp; click the map)"
                      IsChecked="{x:Bind ViewModel.StateIso.IsArmed, Mode=TwoWay}"
                      ToolTipService.ToolTip="Highlight a state on hover; click it to isolate. Or pick one below."/>

            <!-- Direct pick by name — also the way to SWITCH states while one is isolated. -->
            <Grid Grid.Row="8" Margin="4,0,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="State"
                           Style="{StaticResource MapWindowFieldLabelStyle}"/>
                <ComboBox Grid.Column="1"
                          Width="200" HorizontalAlignment="Left"
                          PlaceholderText="Pick a state…"
                          ItemsSource="{x:Bind ViewModel.StateIso.States}"
                          SelectedItem="{x:Bind ViewModel.StateIso.SelectedState, Mode=TwoWay}"
                          ToolTipService.ToolTip="Isolate this state (arms isolation if it's off)"/>
            </Grid>

            <!-- ── Radar Sites ── -->
            <!-- Which site markers the map draws. All three live together here because marker visibility is
                 map content: the master toggle came from the radar console, TDWR/research came from App
                 Settings, and splitting them across two windows meant hunting for "why is my site gone".
                 None of them affect a loaded radar loop — hiding a marker never unloads its data. -->
            <TextBlock Grid.Row="9" Text="Radar Sites" Margin="0,6,0,0"
                       Style="{StaticResource MapWindowSectionLabelStyle}"/>

            <CheckBox Grid.Row="10" Margin="4,0,0,0"
                      Content="Show site markers"
                      IsChecked="{x:Bind ViewModel.Radar.RadarSitesVisible, Mode=TwoWay}"
                      ToolTipService.ToolTip="Show the on-map radar site markers. Hiding them never affects the loaded radar loop."/>

            <!-- Opt-in TDWRs (the FAA Terminal Doppler Weather Radar T*** network). PERSISTED. -->
            <CheckBox Grid.Row="11" Margin="4,0,0,0"
                      Content="Show TDWRs"
                      IsChecked="{x:Bind ViewModel.Radar.ShowTdwrs, Mode=TwoWay}"
                      ToolTipService.ToolTip="Show FAA Terminal Doppler Weather Radar markers (e.g. TOKC, TDAL)"/>

            <!-- Opt-in research/test radars (e.g. the ROC test bed KCRI). PERSISTED. -->
            <CheckBox Grid.Row="12" Margin="4,0,0,0"
                      Content="Show research radars"
                      IsChecked="{x:Bind ViewModel.Radar.ShowResearchRadars, Mode=TwoWay}"
                      ToolTipService.ToolTip="Show research/test radar markers such as KCRI (ROC test bed, Norman OK)"/>

            <!-- ── Mile Grid ── -->
            <TextBlock Grid.Row="13" Text="Mile Grid" Margin="0,6,0,0"
                       Style="{StaticResource MapWindowSectionLabelStyle}"/>

            <CheckBox Grid.Row="14" Margin="4,0,0,0"
                      Content="Show mile grid (centered on the radar)"
                      IsChecked="{x:Bind ViewModel.MileGrid.IsShown, Mode=TwoWay}"
                      ToolTipService.ToolTip="Overlay a square grid centered on the selected radar. Pick one and select a site to see it."/>

            <!-- Spacing: one cell = N miles square. -->
            <Grid Grid.Row="15" Margin="4,0,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Spacing (mi)"
                           Style="{StaticResource MapWindowFieldLabelStyle}"/>
                <ComboBox Grid.Column="1"
                          Width="120" HorizontalAlignment="Left"
                          ItemsSource="{x:Bind ViewModel.MileGrid.SpacingOptions}"
                          SelectedItem="{x:Bind ViewModel.MileGrid.SpacingMiles, Mode=TwoWay}"
                          ToolTipService.ToolTip="Grid cell size in miles"/>
            </Grid>

            <!-- Grid line opacity. -->
            <Grid Grid.Row="16" Margin="4,2,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Opacity" VerticalAlignment="Center"
                           Style="{StaticResource MapWindowFieldLabelStyle}"/>
                <Slider Grid.Column="1" MinWidth="180" HorizontalAlignment="Left"
                        Minimum="0" Maximum="1" StepFrequency="0.05"
                        Value="{x:Bind ViewModel.MileGrid.Opacity, Mode=TwoWay}"
                        ToolTipService.ToolTip="Mile grid line opacity"/>
            </Grid>

            <!-- ── Tools ── -->
            <!-- Inspect is a MAP tool, not a per-pane radar control: one armed cursor mode. It reads the
                 active product's value under the pointer; the readout itself stays on the radar console's
                 product ramp (the live tick). Disabled until a loop is loaded. -->
            <TextBlock Grid.Row="17" Text="Tools" Margin="0,6,0,0"
                       Style="{StaticResource MapWindowSectionLabelStyle}"/>

            <CheckBox Grid.Row="18" Margin="4,0,0,0"
                      Content="Inspect values under the cursor"
                      IsEnabled="{x:Bind ViewModel.Radar.IsTransportEnabled, Mode=OneWay}"
                      IsChecked="{x:Bind ViewModel.Radar.IsInspecting, Mode=TwoWay}"
                      ToolTipService.ToolTip="Read the radar value under the cursor on the map, marked live on the product color scale"/>
        </Grid>

        <!-- Pin: keep this window on top. -->
        <ctl:PinToggle IsChecked="{x:Bind ViewModel.IsMapControlsWindowOnTop, Mode=TwoWay}"/>
    </Grid>
</UserControl>
