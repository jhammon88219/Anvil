<?xml version="1.0" encoding="utf-8"?>
<!-- DragMoveLayerExpanderAlertsBody — the controls for ONE convective-alert overlay: a card, one row per phenomenon
     (Tornado / Severe thunderstorm), and overlay opacity. Used TWICE in the NowCast window — once for the
     watch boxes, once for the storm-based warnings — bound to a PhenomOverlayViewModel each time.

     ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓   the card (DragMoveLayerExpanderHeaderCard, FLUSH
     ▓  9 active warnings   Updated 12:04 PM · every 15s▓   under the header, ONE line): the total in effect
     ──────────────────────────────────────────────────────  left, when it was last confirmed right (a failure
                                                             takes that slot) — ⚠️ never a line about the ticked
                                                             rows. The elevated-tag line ("1 tornado emergency")
                                                             was removed 2026-10-21.
       [ ] ■ Tornado                                  2  ← one DragMoveLayerExpanderCountRow per phenomenon: the
       [x] ■ Severe thunderstorm                      5    toggle, the map colour, the name, that type's count at the
       [x] ■ Flash flood                              2    FAR RIGHT (hover lifts the row); the flood row: "Flash
                                                           flood" (warnings, FF) or "Flood" (watches, FA/FL/FF, sea
                                                           green) — FloodLabel/FloodColor from the VM
       ────────────────────────────────────────────────
       ■ 11:52 AM  Cleveland, OK · until 12:30 PM    PDS  ← THE DAY LIST (AlertList; NowCast warnings only — watches
       ■ 11:40 AM  Sedgwick, KS · until 12:15 PM            and PastCast leave it empty → collapsed): every warning of
       ░  9:05 AM  Tulsa, OK · ended 9:45 AM                the convective day (12Z→now), newest issued first. In effect
                                                            = CAP (the map's set), ended = IEM + what this session saw
                                                            end (WarningDayList). An ENDED row or an unticked type's dims
                                                            to 45%. Click → fly + flash (FlyTo). Capped 240 px, scrolls;
                                                            rows edited IN PLACE (RowSync) — never a rebuilt list.

     ⚠️ OPACITY IS NOT HERE — it lives in the host's section header (DragMoveLayerExpander ShowOpacity), so it can be
     set with the section closed.

     ⚠️ IT IS THE STORM-REPORT ROWS, DELIBERATELY. DragMoveLayerExpanderStormReportsBody draws the same card over the same
     kind of type rows one section below, so the two read as one control used three times rather than as
     three separate forms. The swatch is the SAME rounded square in both (the user's call, 2026-10-21 — reports were
     round dots until then).

     ⚠️ THERE IS NO MASTER SHOW/HIDE ROW. It used to be one checkbox reading "Tornado / Severe
     Thunderstorm" with the counts stranded on a separate "Active" line below it; splitting the checkbox
     in two put the count on the line that switches it and left nothing for a master to do. The layer is
     on when either type is on AND its mode runs (PhenomOverlayViewModel.AnyShown + IsModeActive). The
     select-all lives in the HOST's section header (TemporalWindowNowCastContent), not here.

     ⚠️ The swatch colours are the phenom colours the map draws (watches.js / warnings.js, both TO red /
     SV yellow; warnings.js FF green; watches.js FA sea green = WatchFlood.Color). They are literals in both
     places — change one, change the other.

     ⚠️ THE SECTION HEADING IS NOT HERE — the host draws its own above this control (TemporalWindowNowCastContent writes
     "Watches" over one instance and "Warnings" over the other). The window owns its section structure;
     this is content. Same rule as DragMoveLayerExpanderStormReportsBody, and the reason there is no divider in here either.

     ⚠️ The two instances are IDENTICAL on screen — same two names, same two colours, one section apart —
     so the headings carry the whole distinction between them. That is exactly why the old shared
     "Watches and warnings" heading had to become two. -->
<UserControl x:Class="Anvil.Controls.TemporalWindows.DragMoveLayerExpanders.DragMoveLayerExpanderAlertsBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tw="using:Anvil.Controls.TemporalWindows"
             xmlns:dragMoveLayerExpanders="using:Anvil.Controls.TemporalWindows.DragMoveLayerExpanders"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- A list row: tight, full-width — the storm-reports list's container style. -->
        <Style x:Key="AlertRowContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- the card (its bottom edge is the rule) -->
            <RowDefinition Height="Auto"/> <!-- the type rows -->
            <RowDefinition Height="Auto"/> <!-- the day list -->
        </Grid.RowDefinitions>

        <!-- THE CARD, flush under the section header (DragMoveLayerExpanderHeaderCard — every expander's top
             card; its bottom edge is the rule). Like the storm
             reports' and the outlook's it is a RESULT — the polygons appear as you switch types on — so
             it carries no button. -->
        <dragMoveLayerExpanders:DragMoveLayerExpanderHeaderCard Grid.Row="0"
                Headline="{x:Bind ViewModel.CardHeadline, Mode=OneWay}"
                Context="{x:Bind ViewModel.CardContext, Mode=OneWay}"
                Footer="{x:Bind ViewModel.CardFooter, Mode=OneWay}"/>

        <!-- THE TYPE ROWS (DragMoveLayerExpanderCountRow — every expander's). A StackPanel: its Spacing skips the
             watches instance's COLLAPSED flood row, so no gap is left where it would be. -->
        <StackPanel Grid.Row="1" Spacing="4">
            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="Tornado"
                    IsChecked="{x:Bind ViewModel.ShowTornado, Mode=TwoWay}"
                    Count="{x:Bind Fmt(ViewModel.TornadoCount), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind TornadoTooltip(AlertNoun), Mode=OneWay}">
                <Border Width="11" Height="11" CornerRadius="2" Background="#FF2A2A"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>

            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="Severe thunderstorm"
                    IsChecked="{x:Bind ViewModel.ShowSevere, Mode=TwoWay}"
                    Count="{x:Bind Fmt(ViewModel.SevereCount), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind SevereTooltip(AlertNoun), Mode=OneWay}">
                <Border Width="11" Height="11" CornerRadius="2" Background="#FFD21A"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>

            <!-- The flood row: "Flash flood" on warnings, "Flood" on watches — name + swatch from the VM
                 (FloodLabel / FloodColor). Collapses on an overlay without the type (SupportsFlashFlood). -->
            <dragMoveLayerExpanders:DragMoveLayerExpanderCountRow Label="{x:Bind ViewModel.FloodLabel, Mode=OneWay}"
                    Visibility="{x:Bind Shown(ViewModel.SupportsFlashFlood), Mode=OneWay}"
                    IsChecked="{x:Bind ViewModel.ShowFlashFlood, Mode=TwoWay}"
                    Count="{x:Bind Fmt(ViewModel.FlashFloodCount), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind FloodTooltip(ViewModel.FloodLabel, AlertNoun), Mode=OneWay}">
                <Border Width="11" Height="11" CornerRadius="2" Background="{x:Bind Swatch(ViewModel.FloodColor), Mode=OneWay}"/>
            </dragMoveLayerExpanders:DragMoveLayerExpanderCountRow>
        </StackPanel>

        <!-- THE DAY LIST (the storm-reports list's shape): every warning of the day, newest issued first. ⚠️ A ListView
             with a MaxHeight, so it virtualizes inside the window's PanelScroller; SelectionMode None + ItemClick (a click
             ACTS). ⚠️ ItemsSource is the VM's ONE collection, edited in place — don't swap it for a fresh list. -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0"
                    Visibility="{x:Bind Shown(ViewModel.HasAlertList), Mode=OneWay}">
            <Border Height="1" Margin="0,0,0,8"
                    Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
            <ListView MaxHeight="240"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAlertClick"
                      ItemsSource="{x:Bind ViewModel.AlertList, Mode=OneWay}"
                      ItemContainerStyle="{StaticResource AlertRowContainerStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WarningListRow">
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="Fly to this warning"
                              Opacity="{x:Bind dragMoveLayerExpanders:DragMoveLayerExpanderAlertsBody.RowOpacity(Dim), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- the type square -->
                                <ColumnDefinition Width="56"/>    <!-- 11:52 AM (issued) -->
                                <ColumnDefinition Width="*"/>     <!-- Cleveland, OK · until 12:30 PM -->
                                <ColumnDefinition Width="Auto"/>  <!-- PDS / Emergency / … -->
                            </Grid.ColumnDefinitions>
                            <Border Width="9" Height="9" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{x:Bind dragMoveLayerExpanders:DragMoveLayerExpanderAlertsBody.PhenomBrush(Phenom)}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind TimeText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                                       Style="{StaticResource TabularNumberTextStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Bind PlaceText, Mode=OneWay}"/><Run Text=" · " Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Run Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Text="{x:Bind TagText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</UserControl>
