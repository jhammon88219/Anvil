<?xml version="1.0" encoding="utf-8"?>
<!-- TabStrip — the LEFT NAV RAIL that selects ONE page of its host (the Settings window and the Anvil Atlas,
     2026-11-11: one look in both, the user's call). Chrome only: it draws the rows and reports the selected
     index, and knows nothing about the bodies its host swaps beside it.

       ┌──────────────────┬──────────────────────────────┐
       │▌▓ ⛰  Map  ▓▓▓▓▓▓▓│                              │   ▌ accent bar on the selected row (3 × 18)
       │   ◎  Radar       │        (host's body)         │   ▓ elevated face on the selected row
       │   ▤  Storage     │                              │   one row = 36 tall, mark BESIDE the name,
       │        ⋮         │                              │   2 px between rows
       │ ──────────────── │                              │   ─ a rule ABOVE an entry with IsSeparated
       │   ⚒  Dev         │                              │     (Settings' Dev, Debug only)
       └──────────────────┴──────────────────────────────┘
        ↑ the HOST sizes and colours the rail (raised surface, a hairline on its right edge)

     The look of a row lives in Controls/Styles.xaml (NavRailTabStyle); everything below is structure.
     It is NOT a WinUI NavigationView — that brings its own chrome (hamburger, back button, a settings item, a
     pane that collapses). If this look doesn't hold up, a customised NavigationView is the next thing to try.

     ⚠️ SELECTION IS SHOWN BY THE BAR + FACE, not by flooding the row with accent.

     A row can be UNAVAILABLE (TabEntry.IsEnabled false) — greyed and unpickable but still IN the rail, so the
     rail neither reflows nor hides that the page exists. The host owns that flag AND the selection that goes
     with it. ⚠️ NOTHING SETS IT TODAY; the support is kept for "this page exists but you can't use it yet".

     ⚠️ Clicking the ALREADY-selected row: the handler re-asserts IsChecked (see OnTabClick). A ToggleButton
     flips itself on click, and a OneWay binding does not push back when the source did not change — so the
     current row would go dark. Do not "simplify" the re-assert away. -->

<UserControl x:Class="Anvil.Controls.Primitives.TabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- ONE row: an optional rule above, then the button. ⚠️ THE TOOLTIP IS ON THE OUTER GRID, not on the
             button, so a DISABLED row can still say why — a disabled control is not hit-testable, so the pointer
             falls through to this parent (hence Background="Transparent": a null background catches nothing). -->
        <DataTemplate x:Key="TabItemTemplate" x:DataType="prim:TabEntry">
            <Grid Background="Transparent"
                  ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- The rule above a separated entry (Settings' Dev). -->
                <Rectangle Height="1" Margin="6,4,6,6"
                           Fill="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                           Visibility="{x:Bind prim:TabStrip.Show(IsSeparated)}"/>

                <ToggleButton Grid.Row="1" Height="36"
                              Style="{StaticResource NavRailTabStyle}"
                              IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                              IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                              Click="OnTabClick">
                    <Grid>
                        <!-- Mark beside the name, left-aligned. -->
                        <StackPanel Margin="12,0,12,0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Glyph="{x:Bind Glyph}"/>
                            <TextBlock Text="{x:Bind Label}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- The selected row's accent bar, on the leading edge. -->
                        <Rectangle Width="3" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   RadiusX="1.5" RadiusY="1.5"
                                   Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                   Visibility="{x:Bind prim:TabStrip.Show(IsSelected), Mode=OneWay}"/>
                    </Grid>
                </ToggleButton>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ItemsControl x:Name="Host"
                  ItemTemplate="{StaticResource TabItemTemplate}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" Spacing="2"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>
