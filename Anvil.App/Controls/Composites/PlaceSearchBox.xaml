<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     PlaceSearchBox — find a town and fly there. Lives CENTRED on the top menu bar (the user's call, 2026-11-03; it was
     the tools strip's left edge), the bar taking its height from this box plus the strip's old 7 px top/bottom margins.

       ┌ Atlas View Settings Temporal Mode ───── [ Moore, OK          ✕ ⌕ ] ───────────── – □ ✕ ┐
                                                ┌──────────────────────────────┐
                                                │ Moore, OK            pop 62k │  ← gazetteer rows (offline)
                                                │ Moore Haven, FL       pop 2k │
                                                └──────────────────────────────┘

     Typing shows GAZETTEER rows (offline); Enter / a row flies there and drops the search pin (MarkersViewModel).
     ⚠️ ONLINE (Nominatim) runs ONLY on Enter when the gazetteer found nothing — its policy forbids autocomplete.
     Don't wire it to TextChanged. ⚠️ Clearing the box removes the pin; that is the remove.
     ⚠️ Text is ONE-WAY from PlaceSearch.QueryText: picking a PastCast saved event pins the town it is named for through
     the SAME pin and puts the name in this box, so the box's X clears that pin too.
     ⚠️ The ✕ STAYS while there is text, focused or not (stock WinUI hides it on focus loss) — code-behind pins the
     template's own DeleteButton; see PinClearButton for why it works.
     ⚠️ It sits IN THE CAPTION BAND: MainWindow.UpdateNotchInputRegions punches it as a Passthrough hole, or clicks
     would drag the window instead. ⚠️ No Ctrl+F: the WebView owns keyboard focus once the map is clicked.
     Status ("Searching online…", "No places match …") is shown nowhere for now (WatchPlaceSearch is unhooked).
     Greyed while the PastCast loading screen is up (Radar.AreControlsLocked), like every map tool.
     Host contract: ViewModel (MapViewModel).
     ============================================================================ -->
<UserControl x:Class="Anvil.Controls.Composites.PlaceSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Anvil.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One place-search row: the name left, population (or the OpenStreetMap credit) right. -->
        <DataTemplate x:Key="PlaceRowTemplate" x:DataType="models:PlaceResult">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Detail}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ⚠️ THE HOST SETS THE WIDTH (the user's call, 2026-11-03): MainWindow sizes this control to the SINGLE-pane
         selector's width (OnPaneSelectorSizeChanged) and keeps it through the other layouts; the box stretches to it. -->
    <AutoSuggestBox x:Name="PlaceSearchBoxInput"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    PlaceholderText="Search places"
                    IsEnabled="{x:Bind Free(ViewModel.Radar.AreControlsLocked), Mode=OneWay}"
                    QueryIcon="Find"
                    TextMemberPath="Display"
                    Text="{x:Bind ViewModel.PlaceSearch.QueryText, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.PlaceSearch.Suggestions}"
                    ItemTemplate="{StaticResource PlaceRowTemplate}"
                    Loaded="OnPlaceSearchLoaded"
                    TextChanged="OnPlaceSearchTextChanged"
                    QuerySubmitted="OnPlaceSearchQuerySubmitted"
                    ToolTipService.ToolTip="Find a city or town and fly there. Clear the box to remove the pin."/>
</UserControl>
