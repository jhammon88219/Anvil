<?xml version="1.0" encoding="utf-8"?>
<!-- PastCastWindow — the PastCast (historical replay) settings: date / start / window, the historical SPC
     outlook for that date, and that day's storm reports. Hosted in its OWN OS window by WindowManager
     (MapViewModel.IsPastWindowOpen), so there is no panel frame: the root is the dark surface stretched to
     fill the window. Content extends into the title bar, so the panel carries its own title. Bound to the
     coordinator MapViewModel.

       ┌─ Past Event ───────────────────────────────────[pin]─┐
       │  Date    [2013] [05] [20]                            │
       │  Start   [07] : [00]  [ ] AM  [x] PM                 │  ← replay form (ViewModel.Radar)
       │  Window  [3 hours          ]                         │
       │          ( Load )   status…                          │
       │  ────────────────────────────────────────────────    │
       │  Outlook [Day 1   ] cycle [Auto  ]                   │
       │  Product [Categorical      ]                         │  ← historical SPC outlook for that
       │  Opacity ──────●───────────                          │     date (ViewModel.PastOutlook)
       │          status… / issued + valid                    │
       │  ────────────────────────────────────────────────    │
       │  StormReportsInput  (that day's verification dots)   │
       └──────────────────────────────────────────────────────┘

     Both bodies are laid out ENTIRELY with grids (rows/columns, no StackPanels) so rows are easy to
     add/rearrange: a fixed [label | controls] outer grid, one row per field, and each multi-widget field is
     its own nested column grid.
       • Replay form (row 1, ViewModel.Radar) — date + window bind RadarViewModel indices directly; the
         editable hour/minute combos + AM/PM pair convert to/from the VM's PastEventTime (TimeSpan) in
         code-behind (element names HourCombo / MinuteCombo / AmCheck / PmCheck must stay).
       • Historical outlook (row 3, ViewModel.PastOutlook) — Day / issuance Cycle / Product / Opacity + a
         status line and issued/valid readout. Selecting a product fetches the archived issuance for the
         entered replay date and overlays it on the past radar.
     Storm reports stay a separate control — the Now window shows the same block, so it is content of TWO
     windows. -->
<UserControl x:Class="Anvil.Controls.Windows.PastCastWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Anvil.Controls.Primitives"
             xmlns:comp="using:Anvil.Controls.Composites"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One shared label style for both bodies (they were identical when these were separate files). -->
        <Style x:Key="PastLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- Dark surface fills the whole window; content sits top-left. -->
    <Grid Background="{ThemeResource OverlayBarSurfaceBrush}">
        <Grid Margin="16" VerticalAlignment="Top" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- title -->
                <RowDefinition Height="Auto"/> <!-- radar: date / start / window -->
                <RowDefinition Height="Auto"/> <!-- divider -->
                <RowDefinition Height="Auto"/> <!-- historical SPC outlook -->
                <RowDefinition Height="Auto"/> <!-- divider -->
                <RowDefinition Height="Auto"/> <!-- storm reports (verification) -->
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Past Event"
                       FontSize="15" FontWeight="SemiBold" CharacterSpacing="40"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- ===================== Replay form: date / start / window ===================== -->
            <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="10" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Date -->
                    <RowDefinition Height="Auto"/> <!-- Start time -->
                    <RowDefinition Height="Auto"/> <!-- Window duration -->
                    <RowDefinition Height="Auto"/> <!-- Load + status -->
                </Grid.RowDefinitions>

                <!-- Date: year / month / day. -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Date" Style="{StaticResource PastLabelStyle}"/>
                <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="6" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Width="88" IsEditable="True"
                              ItemsSource="{x:Bind ViewModel.Radar.PastEventYearOptions}"
                              SelectedIndex="{x:Bind ViewModel.Radar.PastEventYearIndex, Mode=TwoWay}"/>
                    <ComboBox Grid.Column="1" Width="64" IsEditable="True"
                              ItemsSource="{x:Bind ViewModel.Radar.PastEventMonthOptions}"
                              SelectedIndex="{x:Bind ViewModel.Radar.PastEventMonthIndex, Mode=TwoWay}"/>
                    <ComboBox Grid.Column="2" Width="64" IsEditable="True"
                              ItemsSource="{x:Bind ViewModel.Radar.PastEventDayOptions}"
                              SelectedIndex="{x:Bind ViewModel.Radar.PastEventDayIndex, Mode=TwoWay}"/>
                </Grid>

                <!-- Start time: hour : minute + AM/PM pair. -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Start" Style="{StaticResource PastLabelStyle}"/>
                <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="6" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="HourCombo" Grid.Column="0" Width="64" IsEditable="True"
                              SelectionChanged="OnTimePartChanged" TextSubmitted="OnTimeTextSubmitted"/>
                    <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" FontSize="14"/>
                    <ComboBox x:Name="MinuteCombo" Grid.Column="2" Width="64" IsEditable="True"
                              SelectionChanged="OnTimePartChanged" TextSubmitted="OnTimeTextSubmitted"/>
                    <CheckBox x:Name="AmCheck" Grid.Column="3" Content="AM" MinWidth="0" Margin="6,0,0,0" Click="OnAmClick"/>
                    <CheckBox x:Name="PmCheck" Grid.Column="4" Content="PM" MinWidth="0" Click="OnPmClick"/>
                </Grid>

                <!-- Window duration. -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Window" Style="{StaticResource PastLabelStyle}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Width="130" HorizontalAlignment="Left" IsEditable="True"
                          ItemsSource="{x:Bind ViewModel.Radar.PastEventDurationOptions}"
                          SelectedIndex="{x:Bind ViewModel.Radar.PastEventDurationIndex, Mode=TwoWay}"/>

                <!-- Load button + status text. -->
                <Grid Grid.Row="3" Grid.Column="1" ColumnSpacing="10" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Load" Style="{ThemeResource AccentButtonStyle}" Click="OnLoadClick"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Radar.PastEventStatus, Mode=OneWay}"
                               TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Height="1" Margin="0,2"
                    Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>

            <!-- ===================== Historical SPC outlook for the replay date ===================== -->
            <Grid Grid.Row="3" ColumnSpacing="12" RowSpacing="10" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Day + Cycle -->
                    <RowDefinition Height="Auto"/> <!-- Product -->
                    <RowDefinition Height="Auto"/> <!-- Opacity -->
                    <RowDefinition Height="Auto"/> <!-- status -->
                    <RowDefinition Height="Auto"/> <!-- issued/valid times -->
                </Grid.RowDefinitions>

                <!-- Day + issuance Cycle, side by side. -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Outlook" Style="{StaticResource PastLabelStyle}"/>
                <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="8" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Width="90"
                              ItemsSource="{x:Bind ViewModel.PastOutlook.Days}"
                              DisplayMemberPath="Label"
                              SelectedItem="{x:Bind ViewModel.PastOutlook.SelectedDayOption, Mode=TwoWay}"
                              ToolTipService.ToolTip="Outlook day (1-3) for the replay date"/>
                    <TextBlock Grid.Column="1" Text="cycle" Style="{StaticResource PastLabelStyle}"/>
                    <ComboBox Grid.Column="2" Width="86"
                              ItemsSource="{x:Bind ViewModel.PastOutlook.CycleOptions, Mode=OneWay}"
                              DisplayMemberPath="Label"
                              SelectedItem="{x:Bind ViewModel.PastOutlook.SelectedCycleOption, Mode=TwoWay}"
                              ToolTipService.ToolTip="SPC issuance cycle (UTC); Auto picks the one in effect at the replay time"/>
                </Grid>

                <!-- Product (None + the day's products). -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Product" Style="{StaticResource PastLabelStyle}"/>
                <ComboBox Grid.Row="1" Grid.Column="1"
                          Width="184" HorizontalAlignment="Left"
                          ItemsSource="{x:Bind ViewModel.PastOutlook.ProductOptions, Mode=OneWay}"
                          DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.PastOutlook.SelectedProductOption, Mode=TwoWay}"
                          ToolTipService.ToolTip="Historical outlook product (None clears the overlay)"/>

                <!-- Opacity: fill opacity (outlines stay solid). -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Opacity" Style="{StaticResource PastLabelStyle}"/>
                <Slider Grid.Row="2" Grid.Column="1"
                        Width="184" HorizontalAlignment="Left"
                        Minimum="0" Maximum="1"
                        StepFrequency="0.05" SmallChange="0.05"
                        IsThumbToolTipEnabled="False"
                        VerticalAlignment="Center"
                        Value="{x:Bind ViewModel.PastOutlook.Opacity, Mode=TwoWay}"
                        ToolTipService.ToolTip="Outlook fill opacity (outlines stay solid)"/>

                <!-- Status line (loading / not-found / loaded). -->
                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{x:Bind ViewModel.PastOutlook.StatusText, Mode=OneWay}"
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <!-- Issued / valid times, when available. -->
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{x:Bind ViewModel.PastOutlook.TimesText, Mode=OneWay}"
                           Visibility="{x:Bind VisibleWhen(ViewModel.PastOutlook.HasTimes), Mode=OneWay}"
                           TextWrapping="Wrap" FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </Grid>

            <Border Grid.Row="4" Height="1" Margin="0,2"
                    Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
            <comp:StormReportsInput Grid.Row="5" ViewModel="{x:Bind ViewModel.StormReports, Mode=OneWay}"/>
        </Grid>

        <!-- Pin: keep this window on top. -->
        <ctl:PinToggle IsChecked="{x:Bind ViewModel.IsPastWindowOnTop, Mode=TwoWay}"/>
    </Grid>
</UserControl>
