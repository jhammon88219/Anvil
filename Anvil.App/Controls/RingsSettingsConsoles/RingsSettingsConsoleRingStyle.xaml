<?xml version="1.0" encoding="utf-8"?>
<!-- RingsSettingsConsoleRingStyle — ONE range ring's look, on a Primitives/SettingsConsolePlate. Declared THREE times by
     Composites/RangeRingSettingsTab (Reflectivity reach · Velocity reach · Distance rings) over one RingStyleViewModel each
     (replaced the old RingStyleEditor, 2026-11-16). One control on purpose: three hand-written copies would drift.

       Reflectivity reach  [Restore defaults]                                                      DEFAULT
       Color       (A)(■)(■)(■)(■)(■)(■)(+)                      The range ruler wears it too        Theme
       Opacity     ━━━━━━━━━━━━●━━━━━━━━━━━━━━━━━━━  55%                                             55%
       Thickness   ━━━●━━━━━━━━━━━━━━━━━━━━━━━━━━━━  1.3 px                                       1.3 px
       Line        [ Solid | Dashed | Dotted | Dash-dot ]                                         Solid
       96          420 (slider * · value 56)                     hint (one line)              150, right

     ⚠️ Every row is a Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText by AboutKey). The Color
     row's entry is the card's ColorKey (each ring its own hint). A = the theme's color for this ring; + = any color.
     ⚠️ IsEditable = false greys every row AND Restore defaults (the Distance rings card while that ring is off); the Color
     row's hint then says what turns it on. Everything applies LIVE to the main map and persists on its own. -->
<UserControl x:Class="Anvil.Controls.RingsSettingsConsoles.RingsSettingsConsoleRingStyle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="RingsSettingsConsoleRingStylePlate" Title="{x:Bind Title, Mode=OneWay}" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="RingStyleRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                    ToolTipService.ToolTip="Put this ring's look back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <prim:SettingsConsoleRow Label="Color" AboutKey="{x:Bind ColorKey, Mode=OneWay}"
                                     Hint="{x:Bind HintFor(IsEditable, ColorKey), Mode=OneWay}"
                                     Default="{x:Bind Ring.DefaultColorText, Mode=OneWay}">
                <prim:ColorSwatchPicker x:Name="RingColorPicker" HorizontalAlignment="Left"
                                        IsEnabled="{x:Bind IsEditable, Mode=OneWay}" AllowCustom="True"
                                        ItemsSource="{x:Bind Ring.ColorSwatches, Mode=OneWay}"
                                        ToolTips="{x:Bind Ring.ColorNames, Mode=OneWay}"
                                        SelectedIndex="{x:Bind Ring.ColorIndex, Mode=TwoWay}"
                                        CustomHex="{x:Bind Ring.ColorHex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Opacity" AboutKey="ring.opacity" Default="{x:Bind Ring.DefaultOpacityText, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Slider x:Name="RingOpacitySlider" VerticalAlignment="Center" IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                            Minimum="5" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10" IsThumbToolTipEnabled="False"
                            Value="{x:Bind Ring.Opacity, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                               Text="{x:Bind Pct(Ring.Opacity), Mode=OneWay}"/>
                </Grid>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Thickness" AboutKey="ring.thickness" Default="{x:Bind Ring.DefaultWidthText, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Slider x:Name="RingThicknessSlider" VerticalAlignment="Center" IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                            Minimum="0.5" Maximum="6" StepFrequency="0.1" SmallChange="0.1" LargeChange="0.5" IsThumbToolTipEnabled="False"
                            Value="{x:Bind Ring.Width, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                               Text="{x:Bind Px(Ring.Width), Mode=OneWay}"/>
                </Grid>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Line" AboutKey="ring.line" Default="{x:Bind Ring.DefaultLineText, Mode=OneWay}">
                <prim:SegmentedPicker x:Name="RingLinePicker" IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                                      ItemsSource="{x:Bind Ring.LineLabels, Mode=OneWay}"
                                      SelectedIndex="{x:Bind Ring.LineIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
