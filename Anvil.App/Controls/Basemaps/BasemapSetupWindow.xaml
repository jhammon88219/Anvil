<?xml version="1.0" encoding="utf-8"?>
<!-- BasemapSetupWindow — the MAP SETUP window: shown ON ITS OWN, before Anvil, while Anvil has no usable map
     (BasemapSetupViewModel.ShouldShowAtLaunch; hosted by BasemapSetupHost). Every launch, until "Stop showing this".

       ┌───────────────────────────────────────────────[–][×]─┐  ← no native caption bar: the surface runs up under
                                                                    it (ExtendsContentIntoTitleBar, BasemapSetupHost)
       │  Anvil                                                │
       │  Weather Workstation                                  │
       │                                                       │
       │  CHOOSE (step 0)                                      │
       │  Choose your map                                      │
       │  Radar, warnings and outlooks work either way…        │
       │  ┌──────────────────────┐ ┌──────────────────────┐    │  ← BasemapSetupWindowOnlineCard |
       │  │ ◍ Online map         │ │ ⤓ Offline map        │    │    BasemapSetupWindowOfflineCard (Area list,
       │  └──────────────────────┘ └──────────────────────┘    │    detail, size total, save folder)
       │  ───────────────────────────────────────────────────  │
       │  Continue without a map                [Use online map]  ← names what it'll do (Download map — greyed
                                                                        while no area is ticked)
       │  You can set this up later in Settings → Basemap.     │
       │  [ ] Stop showing this at launch                      │
       │                                                       │
       │  EXISTING FILE (1)  path [Browse…] · three checks (BasemapFileCheck: readable · radars covered · detail,
       │                     size, date) · Back to map choice / [Use this map] (lit once the file can be read)
       │  DOWNLOADING (2)    a ROW PER STEP (BasemapSetupWindowDownloadStep ×5), each with its own bar:
       │                       ✓ Find the newest map      20 Oct 2026 build   (done = full bar, dimmed)
       │                       ✓ Read the map's index     83 sections
       │                       ◉ Plan your file           Sorting 3.06 M tiles  ▓▓▓░░░
       │                       ○ Download                                     (waiting = no bar)
       │                       ○ Finish
       │                     Saving to … · Cancel and go back / [Open Anvil] (greyed)
       │  READY (3)          which map ✓ Done ▓▓▓▓▓▓▓▓ where it comes from · [ → Open Anvil ] lit (accent,
       │                     larger) — NEVER opens by itself. Reached by a download, Use online map, Use this map.
       │  FAILED (4)         ⚠ what happened · what's kept · Back to map choice / [Retry]
       └───────────────────────────────────────────────────────┘

     RULES (the user's calls, 2026-10-20): Anvil does NOT show while a download runs. Ready waits for the click — the
     Open Anvil button just becomes the obvious thing on screen. "Continue without a map" opens Anvil over a blank map.
     ⚠️ Steps switch on VISIBILITY by StepIndex (one per step, all declared here). ⚠️ Plain words: map, map key,
     download — never tiles, PMTiles, API, zoom. Pickers come from BasemapPickers (this window's own handle). -->
<UserControl x:Class="Anvil.Controls.Basemaps.BasemapSetupWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:basemaps="using:Anvil.Controls.Basemaps"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="BasemapSetupStepTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,2"/>
        </Style>
        <Style x:Key="BasemapSetupStepLeadStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="BasemapSetupFootNoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="BasemapSetupBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource OverlayBarSurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <!-- The hairline every step's footer sits under. -->
        <Style x:Key="BasemapSetupFootRuleStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,18,0,14"/>
            <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- Top padding = 20 + the 32 px caption band the surface now runs under (ExtendsContentIntoTitleBar). -->
    <Grid Background="{ThemeResource OverlayBarSurfaceBrush}" Padding="24,52,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Anvil / Weather Workstation -->
            <RowDefinition Height="*"/>    <!-- the step -->
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Anvil" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Weather Workstation" Margin="0,-2,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- ===== CHOOSE ===== -->
        <StackPanel x:Name="BasemapSetupChooseStep" Grid.Row="1"
                    Visibility="{x:Bind StepVisibility(ViewModel.StepIndex, 0), Mode=OneWay}">
            <TextBlock Text="Choose your map" Style="{StaticResource BasemapSetupStepTitleStyle}"/>
            <TextBlock Style="{StaticResource BasemapSetupStepLeadStyle}"
                       Text="Radar, warnings and outlooks work either way. This is the map they sit on: roads, towns, county and state lines."/>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <basemaps:BasemapSetupWindowOnlineCard x:Name="BasemapSetupWindowOnlineCard" ViewModel="{x:Bind ViewModel}"/>
                <basemaps:BasemapSetupWindowOfflineCard x:Name="BasemapSetupWindowOfflineCard" Grid.Column="1" ViewModel="{x:Bind ViewModel}"/>
            </Grid>
            <Border Style="{StaticResource BasemapSetupFootRuleStyle}"/>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <HyperlinkButton x:Name="ContinueWithoutMapLink" Content="Continue without a map" Padding="0,2"
                                     Click="OnOpenAnvilClick"/>
                    <TextBlock Text="You can set this up later in Settings → Basemap." Style="{StaticResource BasemapSetupFootNoteStyle}"/>
                </StackPanel>
                <Button x:Name="BasemapSetupPrimaryButton" Grid.Column="1" VerticalAlignment="Bottom"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanRunPrimaryAction, Mode=OneWay}"
                        Click="{x:Bind ViewModel.RunPrimaryAction}"/>
            </Grid>
            <CheckBox x:Name="StopShowingAtLaunchCheckBox" Content="Stop showing this at launch" Margin="0,10,0,0"
                      IsChecked="{x:Bind ViewModel.StopShowingAtLaunch, Mode=TwoWay}"/>
        </StackPanel>

        <!-- ===== EXISTING FILE ===== -->
        <StackPanel x:Name="BasemapSetupExistingFileStep" Grid.Row="1"
                    Visibility="{x:Bind StepVisibility(ViewModel.StepIndex, 1), Mode=OneWay}">
            <TextBlock Text="Use a map file you already have" Style="{StaticResource BasemapSetupStepTitleStyle}"/>
            <TextBlock Style="{StaticResource BasemapSetupStepLeadStyle}"
                       Text="Pick a map file Anvil downloaded before, on this PC or another."/>
            <Border Style="{StaticResource BasemapSetupBoxStyle}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ExistingFileText(ViewModel.ExistingFilePath), Mode=OneWay}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="BasemapSetupExistingFileBrowseButton" Grid.Column="1" Content="Browse…"
                                Click="OnBrowseExistingFileClick"/>
                    </Grid>
                    <!-- Before a pick: what gets checked. After: the three checks, one line each (BasemapFileCheck). -->
                    <TextBlock Text="Anvil checks that it's a map it can read, which radars it covers, and its detail, size and date."
                               Style="{StaticResource BasemapSetupFootNoteStyle}"
                               Visibility="{x:Bind NoText(ViewModel.ExistingReadLine), Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.ExistingReadLine, Mode=OneWay}" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.ExistingCoverLine, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{StaticResource BasemapSetupFootNoteStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.ExistingDetailLine, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{StaticResource BasemapSetupFootNoteStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource BasemapSetupFootRuleStyle}"/>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <HyperlinkButton Content="Back to map choice" Padding="0,2" Click="{x:Bind ViewModel.BackToChoice}"/>
                    <TextBlock Text="The file stays where it is. Anvil doesn't copy it." Style="{StaticResource BasemapSetupFootNoteStyle}"/>
                </StackPanel>
                <Button x:Name="UseExistingFileButton" Grid.Column="1" VerticalAlignment="Bottom" Content="Use this map"
                        Style="{StaticResource AccentButtonStyle}" Click="{x:Bind ViewModel.UseExistingFile}"
                        IsEnabled="{x:Bind ViewModel.CanUseExistingFile, Mode=OneWay}"/>
            </Grid>
        </StackPanel>

        <!-- ===== DOWNLOADING ===== -->
        <StackPanel x:Name="BasemapSetupDownloadingStep" Grid.Row="1"
                    Visibility="{x:Bind StepVisibility(ViewModel.StepIndex, 2), Mode=OneWay}">
            <TextBlock Text="Downloading your map" Style="{StaticResource BasemapSetupStepTitleStyle}"/>
            <TextBlock Style="{StaticResource BasemapSetupStepLeadStyle}"
                       Text="Open Anvil lights up when the map is ready. You can minimise this window meanwhile."/>
            <Border Style="{StaticResource BasemapSetupBoxStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BasemapSetupFootNoteStyle}" TextWrapping="Wrap" Margin="0,0,0,2">
                        <Run Text="Offline map ·"/>
                        <Run Text="{x:Bind ViewModel.DownloadMapText, Mode=OneWay}"/>
                    </TextBlock>
                    <!-- One row per BasemapDownloadPhase, in order — each fills its own bar. -->
                    <basemaps:BasemapSetupWindowDownloadStep x:Name="BasemapSetupWindowDownloadStepFind" Step="{x:Bind ViewModel.FindStep}"/>
                    <basemaps:BasemapSetupWindowDownloadStep x:Name="BasemapSetupWindowDownloadStepIndex" Step="{x:Bind ViewModel.IndexStep}"/>
                    <basemaps:BasemapSetupWindowDownloadStep x:Name="BasemapSetupWindowDownloadStepPlan" Step="{x:Bind ViewModel.PlanStep}"/>
                    <basemaps:BasemapSetupWindowDownloadStep x:Name="BasemapSetupWindowDownloadStepDownload" Step="{x:Bind ViewModel.DownloadStep}"/>
                    <basemaps:BasemapSetupWindowDownloadStep x:Name="BasemapSetupWindowDownloadStepFinish" Step="{x:Bind ViewModel.FinishStep}"/>
                    <Border Height="1" Margin="0,4,0,8" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <TextBlock Style="{StaticResource BasemapSetupFootNoteStyle}">
                        <Run Text="Saving to"/>
                        <Run Text="{x:Bind ViewModel.SaveFolder, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource BasemapSetupFootRuleStyle}"/>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <HyperlinkButton Content="Cancel and go back" Padding="0,2" Click="{x:Bind ViewModel.CancelDownload}"/>
                    <TextBlock Text="A stopped download picks up where it left off." Style="{StaticResource BasemapSetupFootNoteStyle}"/>
                </StackPanel>
                <!-- Greyed while downloading — the SAME spot the lit one takes on Ready, so the change is easy to see. -->
                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Open Anvil" IsEnabled="False"/>
            </Grid>
        </StackPanel>

        <!-- ===== READY ===== -->
        <StackPanel x:Name="BasemapSetupReadyStep" Grid.Row="1"
                    Visibility="{x:Bind StepVisibility(ViewModel.StepIndex, 3), Mode=OneWay}">
            <TextBlock Text="Your map is ready" Style="{StaticResource BasemapSetupStepTitleStyle}"/>
            <TextBlock Style="{StaticResource BasemapSetupStepLeadStyle}" Text="Open Anvil whenever you're ready."/>
            <Border Style="{StaticResource BasemapSetupBoxStyle}">
                <StackPanel Spacing="8">
                    <!-- Which map (a download, the online map, an existing file) and where it comes from. -->
                    <Grid>
                        <TextBlock Text="{x:Bind ViewModel.ReadyMapText, Mode=OneWay}" Margin="0,0,64,0" TextWrapping="Wrap"/>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text="Done" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        </StackPanel>
                    </Grid>
                    <ProgressBar Maximum="100" Value="100"/>
                    <TextBlock Style="{StaticResource BasemapSetupFootNoteStyle}" Text="{x:Bind ViewModel.ReadyDetailText, Mode=OneWay}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource BasemapSetupFootRuleStyle}"/>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Change it anytime in Settings → Basemap."
                           Style="{StaticResource BasemapSetupFootNoteStyle}"/>
                <!-- LIT: the accent face, a size up, an arrow — the one thing to press. -->
                <Button x:Name="OpenAnvilButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                        Padding="20,8" FontSize="15" Click="OnOpenAnvilClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72A;" FontSize="14"/>
                        <TextBlock Text="Open Anvil"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- ===== FAILED ===== -->
        <StackPanel x:Name="BasemapSetupFailedStep" Grid.Row="1"
                    Visibility="{x:Bind StepVisibility(ViewModel.StepIndex, 4), Mode=OneWay}">
            <TextBlock Text="The download stopped" Style="{StaticResource BasemapSetupStepTitleStyle}"/>
            <TextBlock Style="{StaticResource BasemapSetupStepLeadStyle}" Text="{x:Bind ViewModel.FailureText, Mode=OneWay}"/>
            <Border Style="{StaticResource BasemapSetupBoxStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock>
                            <Run Text="Offline map ·"/>
                            <Run Text="{x:Bind ViewModel.DownloadMapText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="Retry picks up where it left off." Style="{StaticResource BasemapSetupFootNoteStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource BasemapSetupFootRuleStyle}"/>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <HyperlinkButton Content="Back to map choice" Padding="0,2" Click="{x:Bind ViewModel.BackToChoice}"/>
                    <TextBlock Text="Or continue without a map and finish later in Settings → Basemap."
                               Style="{StaticResource BasemapSetupFootNoteStyle}"/>
                </StackPanel>
                <Button x:Name="RetryDownloadButton" Grid.Column="1" VerticalAlignment="Bottom" Content="Retry"
                        Style="{StaticResource AccentButtonStyle}" Click="{x:Bind ViewModel.RetryDownload}"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
