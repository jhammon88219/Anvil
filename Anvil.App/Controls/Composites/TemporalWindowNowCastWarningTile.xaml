<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalWindowNowCastWarningTile — ONE warning tile under the NowCast header. ONE control, three uses
     (x:Name = type name + hazard: …WarningTileTornado / …Severe / …FlashFlood); only the CONTENTS differ — the
     label, the two band colours, and which WarningStepper / count / threat line it shows.

       ┌▓▓▓▓▓▓▓▓▓▓▓▓▓┐  ← THE BAND (variant B, 2026-10-07): BandFill = a DEEP shade of the warning colour; the
       │▓Tornado  ‹ ›▓│     Label + ‹ › in Ink, the BRIGHT colour (the Outlook Discussion risk cards' title band,
       │ 5           │     OutlookRiskCard.Deep: the same hue at 38% brightness). DATA literals, never themed.
       │ ─────────── │  ← count 34 SemiLight (tap = Reset); the rule only when Count > 0
       │▒Oklahoma▒▒3▒│  ← STATE LINES (Stepper.States), 13 px whole-row buttons; ▒ = LIT (accent wash + text)
       │ Kansas    2 │
       │ 2 of 5 · Cle│  ← tag line (Threats), or — while the ‹ › have you on a warning — the accent position line
       └─────────────┘
     A tile with nothing in effect DIMS (40%), never hides — the three keep their places.

     ⚠️ The ‹ › drive the tile's WarningStepper (Forward / Back); tapping the COUNT resets it (Reset). Their glyphs
     take Ink, so a DISABLED arrow dims itself (ArrowOpacity) — the template's grey can't reach an explicit
     Foreground. ⚠️ NO OUTLINE (the user's call, 2026-09-30). Glyphs E76B / E76C are NOT verified by rendering. -->

<UserControl x:Class="Anvil.Controls.Composites.TemporalWindowNowCastWarningTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsTabStop="False">

    <!-- The tile's look, local: nothing else draws a tile. -->
    <UserControl.Resources>
        <Style x:Key="WarningTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{ThemeResource OverlayBarSurfaceHoverBrush}"/>
        </Style>
        <!-- The band across the tile's top: its DEEP colour is BandFill. Top corners only. -->
        <Style x:Key="WarningTileBandStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6,6,0,0"/>
            <Setter Property="Padding" Value="10,3,4,3"/>
        </Style>
        <!-- The LABEL on the band, in Ink. -->
        <Style x:Key="WarningTileBandLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="WarningTileCountStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="SemiLight"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="WarningTileTagStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- One STATE LINE: "Oklahoma          3" — a whole-row button (click = fly to that state's warnings,
             WarningStateLine.Fly). Name trims, the count is its own right column. The row bleeds 6 px each side so
             its hover / lit wash pads the text while the text stays on the tile's edge.
             ⚠️ LIT (IsLit: the clicked state, or the state of the warning the ‹ › have you on) = an accent wash
             under the row + the accent text pair. Two text pairs swapped by Visibility, because a theme brush
             can't be picked in code; the lists are rebuilt when the lit line moves, so OneTime binds are enough. -->
        <Style x:Key="WarningStateLineButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="-6,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <DataTemplate x:Key="WarningStateLineTemplate" x:DataType="vm:WarningStateLine">
            <Button Style="{StaticResource WarningStateLineButtonStyle}" Click="{x:Bind Fly}"
                    ToolTipService.ToolTip="Fly to these warnings">
                <Grid>
                    <Border Visibility="{x:Bind IsLit}" CornerRadius="4" Opacity="0.18"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <Grid ColumnSpacing="6" Padding="6,3" Visibility="{x:Bind IsUnlit}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind CountText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                    <Grid ColumnSpacing="6" Padding="6,3" Visibility="{x:Bind IsLit}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind CountText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>
        <Style x:Key="WarningTileRuleStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
            <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
        </Style>
        <!-- "2 of 3 · Cleveland, OK · PDS" — the tag line's place while the arrows have you on a warning. -->
        <Style x:Key="WarningTilePositionStyle" TargetType="TextBlock" BasedOn="{StaticResource WarningTileTagStyle}">
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
        </Style>
        <!-- The ‹ › pair in the tile's top-right. The stock button's template (its hover/pressed/disabled faces),
             shrunk and made transparent at rest so it sits on the tile rather than on a plate of its own. -->
        <Style x:Key="WarningTileArrowStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Opacity="{x:Bind TileOpacity(Count), Mode=OneWay}">
        <Border Style="{StaticResource WarningTileStyle}"
                ToolTipService.ToolTip="{x:Bind TileTip(Hazard), Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- the band: label · ‹ › -->
                    <RowDefinition Height="Auto"/> <!-- the count, the state lines, the tag -->
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource WarningTileBandStyle}" Background="{x:Bind BandFill, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource WarningTileBandLabelStyle}"
                                   Foreground="{x:Bind Ink, Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource WarningTileArrowStyle}"
                                    IsEnabled="{x:Bind ViewModel.CanBack, Mode=OneWay}"
                                    Click="OnBackClick"
                                    ToolTipService.ToolTip="{x:Bind BackTip(Hazard), Mode=OneWay}">
                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Glyph="&#xE76B;"
                                          Foreground="{x:Bind Ink, Mode=OneWay}"
                                          Opacity="{x:Bind ArrowOpacity(ViewModel.CanBack), Mode=OneWay}"/>
                            </Button>
                            <Button Style="{StaticResource WarningTileArrowStyle}"
                                    IsEnabled="{x:Bind ViewModel.CanForward, Mode=OneWay}"
                                    Click="OnForwardClick"
                                    ToolTipService.ToolTip="{x:Bind ForwardTip(Hazard), Mode=OneWay}">
                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Glyph="&#xE76C;"
                                          Foreground="{x:Bind Ink, Mode=OneWay}"
                                          Opacity="{x:Bind ArrowOpacity(ViewModel.CanForward), Mode=OneWay}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Padding="10,6,10,10">
                    <TextBlock Text="{x:Bind Count, Mode=OneWay}" Style="{StaticResource WarningTileCountStyle}"
                               Tapped="OnCountTapped"/>
                    <Border Style="{StaticResource WarningTileRuleStyle}"
                            Visibility="{x:Bind NonZero(Count), Mode=OneWay}"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.States, Mode=OneWay}"
                                  ItemTemplate="{StaticResource WarningStateLineTemplate}"/>
                    <TextBlock Text="{x:Bind Threats, Mode=OneWay}" Style="{StaticResource WarningTileTagStyle}"
                               Visibility="{x:Bind Hidden(ViewModel.IsActive), Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" Style="{StaticResource WarningTilePositionStyle}"
                               Visibility="{x:Bind Shown(ViewModel.IsActive), Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
