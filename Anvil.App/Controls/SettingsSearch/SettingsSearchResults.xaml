<?xml version="1.0" encoding="utf-8"?>
<!-- SettingsSearchResults — the Settings window's RESULTS page (canvas artboard 15): Enter in the rail's "Find a setting" box
     (or its "all N results" line) swaps the body to this. The header above it (SettingsWindow) reads
     "Results for “time”" · "9 settings on 3 pages"; no rail entry is selected, no Reset all, no About box.

       ┌ General ─────────────────────────────────────────────────────────────────────────┐  ← one Primitives/SettingsConsolePlate
       │ Time zone          Whether times across Anvil read in your computer's local …  › │    PER PAGE (rail order), its rows =
       │ Units                                                                             │    SettingsSearchResultRow
       │ Clock              …                                                           › │
       └──────────────────────────────────────────────────────────────────────────────────┘
       ┌ Radar ───────────────────────────────────────────────────────────────────────────┐
       │ …                                                                                 │
       Nothing matches “zzz”. Try fewer or shorter words.                                    ← no matches

     Picking a row raises HitPicked(key) → SettingsWindow lands on it (opens its page, selects the row, flashes it).
     The words searched and their order are Services/Settings/SettingsSearch's. -->
<UserControl x:Class="Anvil.Controls.SettingsSearch.SettingsSearchResults"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:settingsSearch="using:Anvil.Controls.SettingsSearch"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="SettingsSearchHitTemplate" x:DataType="settingsSearch:SettingsSearchItem">
            <settingsSearch:SettingsSearchResultRow Item="{x:Bind}" Picked="OnRowPicked"/>
        </DataTemplate>
        <DataTemplate x:Key="SettingsSearchGroupTemplate" x:DataType="settingsSearch:SettingsSearchGroup">
            <prim:SettingsConsolePlate Title="{x:Bind Page}">
                <ItemsControl ItemsSource="{x:Bind Items}" ItemTemplate="{StaticResource SettingsSearchHitTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </prim:SettingsConsolePlate>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel x:Name="SettingsSearchResultsPanel">
        <ItemsControl x:Name="SettingsSearchResultsGroups" ItemsSource="{x:Bind Groups, Mode=OneWay}"
                      ItemTemplate="{StaticResource SettingsSearchGroupTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="12"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock x:Name="SettingsSearchResultsNothing" Style="{StaticResource BodyLargeTextStyle}" Margin="2,4,0,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{x:Bind NothingVisibility, Mode=OneWay}" Text="{x:Bind NothingText, Mode=OneWay}"/>
    </StackPanel>
</UserControl>
