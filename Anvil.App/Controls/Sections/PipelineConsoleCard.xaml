<?xml version="1.0" encoding="utf-8"?>
<!-- PIPELINE CONSOLE (dev/diagnostic — safe to remove as a unit).
     A read-only "glass cockpit" over the Level-2 build pipeline: one mini-scrubber per radar product (all
     seven at once, regardless of what the main viewer shows) so you can watch on-demand builds fill in real
     time ("Duo fills, Trio completes"), plus a VWP/storm-motion readout so you can watch the SRV gate
     resolve. Observe-only: the shared playhead mirrors the main viewer's frame; no seek, no render change.

     Its own chrome (not ControlCard) because it's wider than the 460-wide temporal cards — and keeping it
     self-contained means removing the feature touches no shared control. Reuses the shared OverlayBar
     surface brush + border so it matches the other floating cards. Bound to the coordinator MapViewModel;
     reaches ViewModel.PipelineConsole.* and ViewModel.IsPipelineConsoleOpen. -->
<UserControl x:Class="Anvil.Controls.Sections.PipelineConsoleCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Anvil.Converters"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:controls="using:Anvil.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:PipelineCellStateToBrushConverter x:Key="CellBrush"/>
        <conv:RampToBrushConverter x:Key="RampBrush"/>
    </UserControl.Resources>

    <Grid Visibility="{x:Bind VisibleWhen(ViewModel.IsPipelineConsoleOpen), Mode=OneWay}">
        <Border Width="680"
                Background="{ThemeResource OverlayBarSurfaceBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid Margin="16,10,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- header -->
                    <RowDefinition Height="Auto"/> <!-- telemetry -->
                    <RowDefinition Height="Auto"/> <!-- product rows -->
                </Grid.RowDefinitions>

                <!-- Header: title + down-triangle (hide). -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Pipeline Console"
                               FontSize="13" FontWeight="SemiBold" CharacterSpacing="40"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button Grid.Column="1"
                            Click="OnCloseClick"
                            Width="28" Height="24" Padding="0" MinWidth="0" MinHeight="0"
                            CornerRadius="6" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Hide the Pipeline Console">
                        <FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                </Grid>

                <!-- Telemetry: VWP/storm-motion + what the pipeline is building. -->
                <StackPanel Grid.Row="1" Spacing="2" Margin="0,0,0,10">
                    <TextBlock Text="{x:Bind ViewModel.PipelineConsole.VwpStatusText, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.PipelineConsole.StormMotionText, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="NoWrap"/>
                    <TextBlock Text="{x:Bind ViewModel.PipelineConsole.PipelineFlagsText, Mode=OneWay}"
                               FontSize="11" FontFamily="Consolas,Cascadia Mono,monospace"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="NoWrap"/>
                </StackPanel>

                <!-- Product rows + the shared playhead overlay (aligned to the scrubber column at 80px in). -->
                <Grid Grid.Row="2">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PipelineConsole.Rows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PipelineProductRow">
                                <Grid Height="16" Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/> <!-- label + ramp swatch (fixed → rows align) -->
                                        <ColumnDefinition Width="*"/>  <!-- mini-scrubber -->
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ShortLabel}" Width="34"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Border Width="30" Height="9" CornerRadius="2"
                                                Background="{x:Bind Option.Ramp, Mode=OneWay, Converter={StaticResource RampBrush}}"/>
                                    </StackPanel>

                                    <Grid Grid.Column="1">
                                        <!-- Always-present track. -->
                                        <Border Height="6" VerticalAlignment="Center" CornerRadius="3"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"/>
                                        <ItemsControl ItemsSource="{x:Bind Cells, Mode=OneWay}"
                                                      IsHitTestVisible="False"
                                                      VerticalAlignment="Center" Height="10">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:UniformHorizontalPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PipelineCell">
                                                    <Border Margin="1,0" CornerRadius="2"
                                                            Background="{x:Bind State, Mode=OneWay, Converter={StaticResource CellBrush}}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Shared playhead: one vertical line across all rows, over the scrubber column (80px in).
                         Positioned in code-behind from PipelineConsole.CurrentIndex / FrameCount. -->
                    <Grid x:Name="PlayheadLayer" Margin="80,0,0,0" IsHitTestVisible="False"
                          SizeChanged="OnPlayheadLayerSizeChanged">
                        <Border x:Name="Playhead" Width="2" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                CornerRadius="1" Background="{ThemeResource TextFillColorPrimaryBrush}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PlayheadTransform"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <!-- Empty state (no loop). -->
                    <TextBlock Text="No radar loop loaded — click a site to watch the pipeline."
                               FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" Margin="0,4"
                               Visibility="{x:Bind VisibleWhen2(ViewModel.PipelineConsole.HasLoop), Mode=OneWay}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
