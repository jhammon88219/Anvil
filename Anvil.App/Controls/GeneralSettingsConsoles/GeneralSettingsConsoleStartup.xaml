<?xml version="1.0" encoding="utf-8"?>
<!-- GeneralSettingsConsoleStartup — Settings → General's "Startup" section (was the Startup page + the Radar page's
     duplicate Home site), on a Primitives/SettingsConsolePlate.

       Startup                                                                                      DEFAULT
       Opens on   (•) Pick up where I left off          The modes that were on when you…   Where I left off
                  ( ) Start in [Map only|NowCast|…]     PastCast starts ready to load…              NowCast
       Home site  KTLX · Norman                         Pick it in the Radar Atlas                    None
       ☐ Load home site on launch                       Skipped when Anvil starts in PastCast          Off
       96         420                                   hint (one line, trims)                  150, right

     ⚠️ THE COLUMNS (96 · 420 · * · 150) are the page's — every General section uses the same, so labels, controls,
     hints and defaults line up down the page. Change them together.
     ⚠️ Read ONCE at map-ready (MapViewModel.RestoreTemporalSession) — a change applies next launch; a fixed start is never
     saved over the last session. The home site is PICKED in the Radar Atlas; this shows it. -->
<UserControl x:Class="Anvil.Controls.GeneralSettingsConsoles.GeneralSettingsConsoleStartup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="GeneralSettingsConsoleStartupPlate" Title="Startup" ShowDefaultHeader="True">
        <Grid ColumnSpacing="12" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Opens on"/>
            <RadioButton x:Name="StartupResumeRadioButton" Grid.Row="0" Grid.Column="1" GroupName="StartupChoice" VerticalAlignment="Center"
                         Content="Pick up where I left off"
                         IsChecked="{x:Bind ViewModel.StartupResume, Mode=TwoWay}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}"
                       Text="The modes that were on when you closed Anvil"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}"
                       Text="{x:Bind ViewModel.DefaultStartupResumeText}"/>

            <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <RadioButton x:Name="StartupFixedRadioButton" GroupName="StartupChoice" VerticalAlignment="Center" MinWidth="0"
                             Content="Start in"
                             IsChecked="{x:Bind ViewModel.StartupFixed, Mode=TwoWay}"/>
                <prim:SegmentedPicker x:Name="StartupModePicker" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      ItemsSource="{x:Bind ViewModel.StartupModeLabels}"
                                      SelectedIndex="{x:Bind ViewModel.StartupModeIndex, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.StartupFixed, Mode=OneWay}"/>
            </Grid>
            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}"
                       Text="PastCast starts ready to load, not loaded"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}"
                       Text="{x:Bind ViewModel.DefaultStartupModeText}"/>

            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Home site"/>
            <TextBlock x:Name="HomeSiteNameText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.SiteFavorites.HomeSiteName, Mode=OneWay}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}"
                       Text="Pick it in the Radar Atlas"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}"
                       Text="{x:Bind ViewModel.DefaultHomeSiteText}"/>

            <CheckBox x:Name="LoadHomeOnLaunchCheckBox" Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Center"
                      Content="Load home site on launch"
                      IsChecked="{x:Bind ViewModel.SiteFavorites.LoadHomeOnLaunch, Mode=TwoWay}"
                      ToolTipService.ToolTip="Start the live radar loop for your home site when Anvil opens"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource SettingsConsoleHintTextStyle}"
                       Text="Skipped when Anvil starts in PastCast"/>
            <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource SettingsConsoleDefaultTextStyle}"
                       Text="{x:Bind ViewModel.DefaultLoadHomeOnLaunchText}"/>
        </Grid>
    </prim:SettingsConsolePlate>
</UserControl>
