<?xml version="1.0" encoding="utf-8"?>
<!-- AppearanceSettingsConsoleTheme — Settings → Appearance's "Theme" section, on a Primitives/SettingsConsolePlate.

       Theme    [Restore defaults]                                                              DEFAULT
       Theme    [Anvil Dark      ⌄]  Sets the app theme and map colors together           Anvil Dark
       Basemap  [Data Viz Black  ⌄]  Overrides the theme-aware map colors                The theme's
       96       420 (each picker 220, left)  hint (one line, trims)                       150, right

     ⚠️ Every row is a Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText by AboutKey).
     ⚠️ The pickers are Primitives/SectionedComboBox (commit only on a click), NEVER a ComboBox — a ComboBox changes its pick on
     the mouse wheel (docs/ui-patterns.md "Row kinds"). Both lists are records, so each needs a template (ToString is the record).
     ⚠️ Picking a THEME brings its own basemap (and ends any Basemap override). The Basemap pick is PERSISTED
     (AppSettings.BasemapStyleId, "" = the theme's) — MapViewModel.SelectedStyle. Restore defaults = MapViewModel.ResetTheme. -->
<UserControl x:Class="Anvil.Controls.AppearanceSettingsConsoles.AppearanceSettingsConsoleTheme"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:models="using:Anvil.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One theme, as a row AND as the closed face. -->
        <DataTemplate x:Key="ThemeRowTemplate" x:DataType="models:AppTheme">
            <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <!-- One basemap style, as a row AND as the closed face. -->
        <DataTemplate x:Key="StyleRowTemplate" x:DataType="models:MapStyle">
            <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
    </UserControl.Resources>

    <prim:SettingsConsolePlate x:Name="AppearanceSettingsConsoleThemePlate" Title="Theme" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="ThemeRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    ToolTipService.ToolTip="Put the theme and basemap back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <prim:SettingsConsoleRow Label="Theme" AboutKey="theme.theme" Default="{x:Bind ViewModel.DefaultThemeName}">
                <prim:SectionedComboBox x:Name="ThemePicker" Width="220" HorizontalAlignment="Left"
                                        DropDownPlacement="BottomEdgeAlignedLeft"
                                        ItemsSource="{x:Bind ViewModel.AvailableThemes}"
                                        SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                                        ItemTemplate="{StaticResource ThemeRowTemplate}"
                                        FaceTemplate="{StaticResource ThemeRowTemplate}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Basemap" AboutKey="theme.basemap" Default="{x:Bind ViewModel.DefaultBasemapText}">
                <prim:SectionedComboBox x:Name="BasemapPicker" Width="220" HorizontalAlignment="Left"
                                        DropDownPlacement="BottomEdgeAlignedLeft"
                                        ItemsSource="{x:Bind ViewModel.AvailableStyles}"
                                        SelectedItem="{x:Bind ViewModel.SelectedStyle, Mode=TwoWay}"
                                        ItemTemplate="{StaticResource StyleRowTemplate}"
                                        FaceTemplate="{StaticResource StyleRowTemplate}"/>
            </prim:SettingsConsoleRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
