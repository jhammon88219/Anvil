<?xml version="1.0" encoding="utf-8"?>
<!-- LockToggle — the "lock this window in place" button in each app-wide window's title-bar area, sitting
     directly LEFT of the PinToggle. Self-positions at the top-right like the pin. Bind IsChecked to that
     window's lock VM flag; WindowManager's window subclass reads the flag and, while it is set, refuses
     every move and resize (drag, snap, Win+Arrow, Alt+Space).

       ┌──────────────────────────────────────────────────────────┐
       │                              [lock] [pin]    –   □   ✕   │
       │                                 ^      ^     ^^^^^^^^^^  │
       │   …the hosting window's own content…   │     THREE caption buttons (maximize greyed)
       │                                 │      └── PinToggle, inset 140 to clear them
       │                                 └── this control, inset 178 = pin's 140 + its 32 width + 6 gap
       └──────────────────────────────────────────────────────────┘

     ⚠️ THE GLYPH FOLLOWS THE STATE: closed padlock (E72E) while locked, open padlock (E785) while not — a
     lock is read as a state, not an action, unlike the pin whose one glyph lights.
     ⚠️ THE INSET RIDES ON THE PIN'S. Move the pin (or re-add a caption button) and this 178 moves with it. -->
<UserControl x:Class="Anvil.Controls.Primitives.LockToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             HorizontalAlignment="Right" VerticalAlignment="Top"
             Margin="0,2,178,0">
    <ToggleButton Width="32" Height="28"
                  Padding="0" MinWidth="0" MinHeight="0"
                  CornerRadius="6" Background="Transparent" BorderThickness="0"
                  IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                  ToolTipService.ToolTip="{x:Bind ToolTipFor(IsChecked), Mode=OneWay}">
        <FontIcon Glyph="{x:Bind GlyphFor(IsChecked), Mode=OneWay}"
                  FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14"/>
    </ToggleButton>
</UserControl>
