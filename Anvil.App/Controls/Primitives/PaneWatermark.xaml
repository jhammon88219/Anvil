<?xml version="1.0" encoding="utf-8"?>
<!-- PaneWatermark — the product label stamped in one map pane's corner ("Ref" / "Vel" / "SRV" / "CC").

     THE ONLY THING DRAWN INSIDE A PANE. Panes carry no chrome — every control lives in the bottom bar —
     so this corner label is the sole in-pane hint of what you are looking at, and it keeps a screenshot
     or a stream legible without the viewer having to read the bar.

     Self-positions at its cell's top-left, the same 12px inset the single-pane watermark always used.
     MainWindow places one of these per pane in an overlay grid whose cells match the page's pane rects
     (see the PANE WATERMARKS block there); this control only draws.

     Dumb by design: one plain Text DP, no view model, no domain knowledge — so it lives in Primitives/
     per the "what binds it?" rule, and so the whole visual is in this one small file to tweak under XAML
     Hot Reload while the app runs. -->
<UserControl x:Class="Anvil.Controls.Primitives.PaneWatermark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             HorizontalAlignment="Left" VerticalAlignment="Top"
             Margin="12"
             IsHitTestVisible="False">
    <!-- Faint backing so the label survives over bright radar returns as well as over the dark basemap. -->
    <Border Padding="8,2"
            CornerRadius="4"
            Opacity="0.72"
            Background="{ThemeResource OverlayBarSurfaceBrush}">
        <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Border>
</UserControl>
