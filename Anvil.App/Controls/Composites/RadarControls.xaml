<?xml version="1.0" encoding="utf-8"?>
<!-- RadarControls — the GLOBAL time module, and only that. The "clock face" layout: the displayed frame's
     time is the HERO (the NowCast header's clock, restated), everything else steps down to one quiet line.

       ┌─ clock ────────┐ ┌─ scrubber (8 px cells, 16 px hit strip) ───────────────────┐
       │ 1:07 PM        │ │ ▬▬ ▬▬ ▬▬ ▬▬ ▬▬ ▬▬ ▬▬ ▬▬ ▬▬ ▬▬ ▬┃                          │
       │ 2 min ago      │ │ ⏮  ▶  ⏭   11 / 11   KTLX  VCP 212 · precip          ⟳     │
       └────────────────┘ └────────────────────────────────────────────────────────────┘
         ^ digits 40 SemiLight,   ^ transport is GLYPH-ONLY (no plates) — the clock carries
           AM/PM 16 beside them     the weight; ⟳ = check for a newer frame (2 s debounce)
         ^ age (14) of the NEWEST frame, ramped fresh→stale (AgeBrush); with the clock it
           answers "how current?"

         The clock LEADS, at the bar's left edge (2026-09-29, when Inspect left for the tools tier): it is
         read first, and the scrubber now runs toward the bar's centre. Column 0 is a RESERVED 140.

     THE ORGANIZING RULE: the bar holds what does NOT repeat per pane. One site, one camera, one time
     cursor, shared by every pane — which is why the scrubber does not multiply. Per-pane controls (product,
     ramp, tilt) are the pane NOTCH (Composites/PaneNotchContent), not here.

     ⚠️ THE MODULE IS A FIXED WIDTH, and that is load-bearing: it is auto-width, and the scrubber stretches to
     exactly the control line beneath it. Every variable-length readout (clock, age, frame count, ICAO, scan)
     has a RESERVED fixed width, so nothing ticking over (the age, a VCP change, 9:59 → 10:00) can resize the
     scrubber and reflow its cells.

     History: this was a 2x2 readout block (time/age over site/scan) beside plated 30/38/30 transport buttons.
     J replaced it (2026-09-28) to match the tiles/clock language of the redesigned windows. -->
<UserControl x:Class="Anvil.Controls.Composites.RadarControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:layout="using:Anvil.Layout"
             mc:Ignorable="d">

    <UserControl.Resources>
        <x:Double x:Key="ReadoutFontSize">12</x:Double>
        <!-- Glyph-only transport: no resting plate, the shared hover/pressed look still shows on pointer. -->
        <Style x:Key="GlyphTransportStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- The whole assembly is CENTRED vertically in the bar, and each column is centred within it, so the
         clock and the scrubber block share one midline. -->
    <Grid HorizontalAlignment="Left" VerticalAlignment="Center" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>  <!-- the clock — reserved: "12:59 PM" at 40 px fits -->
            <ColumnDefinition Width="Auto"/> <!-- scrubber over the control line -->
        </Grid.ColumnDefinitions>

        <!-- ===== THE CLOCK: the DISPLAYED frame's time (the one scrubbed to), not the newest ===== -->
        <Grid Grid.Column="0" VerticalAlignment="Center" RowSpacing="2"
              ToolTipService.ToolTip="When the frame on screen was scanned">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 1:07 PM -->
                <RowDefinition Height="Auto"/> <!-- 2 min ago -->
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="4" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Bind ClockDigits(ViewModel.CurrentFrameTimeText), Mode=OneWay}"
                           FontSize="40"
                           FontWeight="SemiLight"
                           LineHeight="42"
                           LineStackingStrategy="BlockLineHeight"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <!-- AM/PM rides the digits' baseline-ish bottom edge, small and secondary. -->
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,5"
                           Text="{x:Bind ClockSuffix(ViewModel.CurrentFrameTimeText), Mode=OneWay}"
                           FontSize="16"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
            <!-- Age of the FRESHEST frame, ramped green → amber (12 min) → red (30 min) by AgeBrush, knees
                 matching RadarSiteStatus so the colour and the status dot agree. -->
            <TextBlock Grid.Row="1"
                       Text="{x:Bind ViewModel.RadarAgeText, Mode=OneWay}"
                       FontSize="14"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{x:Bind AgeBrush(ViewModel.RadarAgeMinutes), Mode=OneWay}"
                       ToolTipService.ToolTip="How long ago the newest available frame was scanned. Green = fresh, red = stale."/>
        </Grid>

        <!-- ===== SCRUBBER over the CONTROL LINE =====
             ⚠️ THE Auto COLUMN IS LOAD-BEARING: a star column would measure EqualCellsPanel with the width
             AVAILABLE (half the bar) and the scrubber would stretch toward the centred temporal keys. Under
             Auto it measures with infinity, the panel returns 0, and the fixed-width line sets the width. -->
        <Grid Grid.Column="1" VerticalAlignment="Center" RowSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- segmented scrubber -->
                <RowDefinition Height="Auto"/> <!-- transport · frame · site · scan · check now -->
            </Grid.RowDefinitions>

            <!-- One cell per frame (ViewModel.Segments), each lighting as its frame builds — the load
                 indicator for the whole loop (Rule 2). Cells 8 px inside a 16 px hit strip, so the grab
                 area is bigger than what you see. Playhead positioned in code-behind. -->
            <Grid x:Name="ScrubberHost"
                  Grid.Row="0"
                  Height="16"
                  Background="Transparent"
                  IsHitTestVisible="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                  Opacity="{x:Bind ScrubberOpacity(ViewModel.IsTransportEnabled), Mode=OneWay}"
                  SizeChanged="OnScrubberSizeChanged"
                  PointerPressed="OnScrubberPointerPressed"
                  PointerMoved="OnScrubberPointerMoved"
                  PointerReleased="OnScrubberPointerReleased"
                  PointerCaptureLost="OnScrubberPointerReleased"
                  PointerCanceled="OnScrubberPointerReleased">
                <!-- Always-present track: same footprint whether or not a loop is loaded. -->
                <Border Height="8"
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"/>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Segments, Mode=OneWay}"
                              IsHitTestVisible="False"
                              VerticalAlignment="Center"
                              Height="8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <layout:EqualCellsPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RadarFrameSegment">
                            <Border Margin="1,0"
                                    CornerRadius="2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="{x:Bind ReadyOpacity, Mode=OneWay}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="Playhead"
                        Width="3"
                        Height="16"
                        CornerRadius="1.5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{ThemeResource TextFillColorPrimaryBrush}"
                        IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PlayheadTransform"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <!-- Control line. EVERY text column has a reserved fixed width (see the header note). -->
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- prev -->
                    <ColumnDefinition Width="Auto"/> <!-- play/stop -->
                    <ColumnDefinition Width="Auto"/> <!-- next -->
                    <ColumnDefinition Width="52"/>   <!-- frame N / M -->
                    <ColumnDefinition Width="44"/>   <!-- ICAO -->
                    <ColumnDefinition Width="200"/>  <!-- scan strategy -->
                    <ColumnDefinition Width="Auto"/> <!-- check now -->
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource GlyphTransportStyle}"
                        Click="OnPrevClick"
                        IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                        ToolTipService.ToolTip="Previous frame">
                    <FontIcon Glyph="&#xE892;" FontSize="13"/>
                </Button>
                <!-- Play is the one transport glyph at full strength: it's the one you reach for. -->
                <Button Grid.Column="1"
                        Style="{StaticResource GlyphTransportStyle}"
                        Width="32"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Click="OnPlayStopClick"
                        IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                        ToolTipService.ToolTip="Play / stop (stop returns to the newest frame)">
                    <FontIcon Glyph="{x:Bind PlayStopGlyph(ViewModel.IsPlaying), Mode=OneWay}" FontSize="16"/>
                </Button>
                <Button Grid.Column="2"
                        Style="{StaticResource GlyphTransportStyle}"
                        Click="OnNextClick"
                        IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                        ToolTipService.ToolTip="Next frame">
                    <FontIcon Glyph="&#xE893;" FontSize="13"/>
                </Button>

                <TextBlock Grid.Column="3"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{x:Bind FrameCountText(ViewModel.CurrentFrameIndex, ViewModel.MaxFrameIndex), Mode=OneWay}"
                           FontSize="{StaticResource ReadoutFontSize}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           ToolTipService.ToolTip="Which frame of the loop is on screen"/>

                <!-- The site. Its location name is the tooltip — the ICAO is the real label. -->
                <TextBlock Grid.Column="4"
                           VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.RadarSiteId, Mode=OneWay}"
                           FontWeight="SemiBold"
                           FontSize="{StaticResource ReadoutFontSize}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           ToolTipService.ToolTip="{x:Bind ViewModel.RadarSiteName, Mode=OneWay}"/>
                <!-- The volume's scan strategy (see RadarVcpText for why SAILS belongs here). -->
                <TextBlock Grid.Column="5"
                           VerticalAlignment="Center"
                           Text="{x:Bind RadarVcpText(ViewModel.RadarModeText), Mode=OneWay}"
                           FontSize="{StaticResource ReadoutFontSize}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           ToolTipService.ToolTip="{x:Bind ScanTooltip(ViewModel.RadarModeText), Mode=OneWay}"/>

                <!-- One live poll now instead of waiting for the timer; the VM debounces it (disabled while
                     running + 2 s after), and the disabled look IS the cooldown cue. -->
                <Button Grid.Column="6"
                        Style="{StaticResource GlyphTransportStyle}"
                        Width="24"
                        Height="24"
                        Click="OnForceLiveCheckClick"
                        IsEnabled="{x:Bind ViewModel.CanForceLiveCheck, Mode=OneWay}"
                        ToolTipService.ToolTip="Check for a newer frame now (skips the poll timer)">
                    <FontIcon Glyph="&#xE72C;" FontSize="11"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
