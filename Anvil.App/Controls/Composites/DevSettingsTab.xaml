<?xml version="1.0" encoding="utf-8"?>
<!-- DevSettingsTab — DEV-ONLY. The Dev tab of the Settings window: the automated site sweep, the
     fixed-corpus dealias-validation harness, and the Pipeline Console's switch, stacked as labeled sections.

       ┌──────────────────────────────────────────────────────┐
       │  ⌄  Site sweep                                       │
       │   ┌────────────────────────────────────────────┐     │
       │   │ KTLX (34/160) · dwell 12s…                 │     │  ← live status + dwell countdown
       │   └────────────────────────────────────────────┘     │
       │   Dwell s [30]      Timeout s [120]                  │
       │   Frames (0 = full dwell) [0]                        │
       │   [x] Operational only   [ ] Skip offline            │
       │   ( Start ) ( Stop ) ( Report… )                     │
       │  ────────────────────────────────────────────────    │
       │  ⌄  Dealias validation                               │
       │   ┌────────────────────────────────────────────┐     │
       │   │ 4/6 · KBUF-013012 31.2% (base 31.4%)       │     │
       │   └────────────────────────────────────────────┘     │
       │   what it does…                                      │
       │   ( Run ) ( Stop ) ( Report… )                       │
       │  ────────────────────────────────────────────────    │
       │  ⌄  Pipeline console                                 │
       │   what it does…                                      │
       │   [ Hidden ●───]                                     │  ← opens the console's own window
       │  ────────────────────────────────────────────────    │
       │  ⌄  Load-time seeding                                │
       │   ┌────────────────────────────────────────────┐     │
       │   │ 7/168 · Joplin, MO · KSGF · 2 hr · cold ·… │     │  ← live status (wraps)
       │   └────────────────────────────────────────────┘     │
       │   what it does…                                      │
       │   Windows [ ]30 min [x]1 hr [x]2 hr [x]3 hr [ ]6 hr …│
       │   [x]Cold [x]Warm [x]Revisit                         │  ← revisit = files kept, decoded frames forgotten
       │   [x]Tornado [x]Hurricane [x]Derecho                 │
       │   Speed cap Mbps [0]  Pause s [10]  Timeout min [20] │  ← cap = DevBandwidthLimit (all radar downloads)
       │   17 events × 3 windows × 3 passes = 153 loads       │
       │   ( Start ) ( Stop )                                 │
       └──────────────────────────────────────────────────────┘

     The first two are the two halves of one loop: the sweep is DISCOVERY over live data (it harvests
     suspects), the corpus scorer is REGRESSION over fixed data (deterministic, so the only variable is the
     code). They share a tab because you run the second to prove a fix for what the first found. The console
     is the third kind — pure OBSERVATION, no run to start.

     ⚠️ DEBUG-ONLY, and the gating is NOT in this file — XAML has no preprocessor. SettingsWindow omits this
     tab's entry from the strip and never x:Loads this body in Release, and MainWindow only constructs
     SweepVm / ValidationVm under #if DEBUG. Both VMs are null in a shipped build, which is exactly why the
     body must not be constructed there.

     ⚠️ CONSEQUENCE, unchanged by the window merge: the Pipeline Console's only trigger is this Debug-only
     tab, so a Release build still has no way to open it — even though the "pipeline" window registration
     itself is not Debug-gated. Shipping the console needs a non-dev trigger, not just a registration. -->

<UserControl x:Class="Anvil.Controls.Composites.DevSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- Body: the dev-tool sections. -->
    <Grid RowSpacing="8" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Site sweep section -->
            <RowDefinition Height="Auto"/> <!-- Dealias validation section -->
            <RowDefinition Height="Auto"/> <!-- Pipeline console section -->
            <RowDefinition Height="Auto"/> <!-- Load-time seeding section -->
            <!-- (row 3 was the removed map style tuner's; the seeding section took it) -->
        </Grid.RowDefinitions>

        <!-- ===== Section 1: automated site sweep (SiteSweepViewModel). ===== -->
        <prim:PanelSection Grid.Row="0" Header="Site sweep" IsExpanded="True">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- status / live countdown -->
                    <RowDefinition Height="Auto"/> <!-- dwell + timeout -->
                    <RowDefinition Height="Auto"/> <!-- frames-per-site -->
                    <RowDefinition Height="Auto"/> <!-- scope checkboxes -->
                    <RowDefinition Height="Auto"/> <!-- start/stop + report -->
                </Grid.RowDefinitions>

                <!-- Live status + per-second dwell countdown. Prominent, always visible. -->
                <Border Grid.Row="0" CornerRadius="6" Padding="10,7"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Text="{x:Bind SweepVm.StatusText, Mode=OneWay}"/>
                </Border>

                <!-- Dwell + per-site timeout, side by side, compact. -->
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Dwell s" VerticalAlignment="Center" FontSize="12"/>
                    <NumberBox x:Name="DwellBox" Grid.Column="1"
                               SpinButtonPlacementMode="Compact" SmallChange="5" LargeChange="30"
                               Minimum="5" Maximum="600" ValueChanged="OnDwellChanged"/>
                    <TextBlock Grid.Column="2" Text="Timeout s" VerticalAlignment="Center" FontSize="12"/>
                    <NumberBox x:Name="TimeoutBox" Grid.Column="3"
                               SpinButtonPlacementMode="Compact" SmallChange="10" LargeChange="30"
                               Minimum="10" Maximum="1200" ValueChanged="OnTimeoutChanged"/>
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Frames (0 = full dwell)"
                               VerticalAlignment="Center" FontSize="12"/>
                    <NumberBox x:Name="FramesBox" Grid.Column="1"
                               SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="5"
                               Minimum="0" Maximum="50" ValueChanged="OnFramesChanged"/>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16">
                    <CheckBox Content="Operational only" IsChecked="{x:Bind SweepVm.OperationalOnly, Mode=TwoWay}"
                              ToolTipService.ToolTip="Operational WSR-88D only, by site class (excludes research + TDWR; still includes OCONUS operational sites — AK/HI/PR/overseas)"/>
                    <CheckBox Content="Skip offline" IsChecked="{x:Bind SweepVm.SkipOffline, Mode=TwoWay}"
                              ToolTipService.ToolTip="Skip sites the status feed reports down / no data"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                    <Button Content="Start" Click="OnStartClick"
                            IsEnabled="{x:Bind SweepVm.IsIdle, Mode=OneWay}"/>
                    <Button Content="Stop" Click="OnStopClick"
                            IsEnabled="{x:Bind SweepVm.IsRunning, Mode=OneWay}"/>
                    <Button Content="Report…" Click="OnSweepReportClick"
                            IsEnabled="{x:Bind SweepVm.HasReport, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </prim:PanelSection>

        <!-- Divider between the two tools. -->

        <!-- ===== Section 2: dealias validation (RadarValidationViewModel). ===== -->
        <prim:PanelSection Grid.Row="1" Header="Dealias validation" IsExpanded="True">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- status / live progress -->
                    <RowDefinition Height="Auto"/> <!-- what it does -->
                    <RowDefinition Height="Auto"/> <!-- run/stop + report -->
                </Grid.RowDefinitions>

                <!-- Live status + per-volume progress. Prominent, always visible. -->
                <Border Grid.Row="0" CornerRadius="6" Padding="10,7"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Text="{x:Bind ValidationVm.StatusText, Mode=OneWay}"/>
                </Border>

                <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Replays the fixed corpus (Assets/RadarCorpus/radar-corpus.json) through the real decode/dealias path and flags any volume whose over-unfold % exceeds its baseline."/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Run" Click="OnRunClick"
                            IsEnabled="{x:Bind ValidationVm.IsIdle, Mode=OneWay}"/>
                    <Button Content="Stop" Click="OnValidationStopClick"
                            IsEnabled="{x:Bind ValidationVm.IsRunning, Mode=OneWay}"/>
                    <Button Content="Report…" Click="OnValidationReportClick"
                            IsEnabled="{x:Bind ValidationVm.HasReport, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </prim:PanelSection>

        <!-- Divider before the console. -->

        <!-- ===== Section 3: the Pipeline Console's open toggle. =====
             A toggle rather than a button because the window's existence IS the state (WindowManager
             reconciles the flag), so it unlatches when you close the console from its own caption. -->
        <!-- MAP STYLE TUNER. Five sliders over a LEVELS transform of the basemap's colours, applied LIVE.
             ⚠️ It exists to kill the F5 loop: tuning a basemap by editing a JSON asset and redeploying the
             MSIX is minutes per colour. The tuned map is not the product — the EXPORTED style file is, which
             then becomes a bundled asset like the other five.
             ⚠️ White is THE knob. The whole "too bright" pass that preceded this tool was one number.
             ⚠️ Export writes a COPY of the pristine style with the colours substituted, so the file keeps its
             formatting; drop it into Assets/Map and it is a real style. The click bubbles to MainWindow for
             the save picker (a UserControl has no HWND) — same chain as the report dialogs. -->
        <prim:PanelSection Grid.Row="2" Header="Pipeline console" IsExpanded="True">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- what it does -->
                    <RowDefinition Height="Auto"/> <!-- the toggle -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Opens the read-only Level-2 pipeline window: a mini-scrubber per product plus VWP/storm-motion state. Observe-only — it polls the WebView while open and changes nothing."/>

                <ToggleSwitch Grid.Row="1"
                              OffContent="Hidden" OnContent="Shown"
                              IsOn="{x:Bind ViewModel.IsPipelineConsoleOpen, Mode=TwoWay}"/>
            </Grid>
        </prim:PanelSection>

        <!-- ===== Load-time seeding (LoadTimeSeedingViewModel): every built-in event × window × cold/warm, into the
             Debug-only load-time log (Usage\loop-load-times.jsonl). You watch it; it presses "View event" itself. ===== -->
        <prim:PanelSection Grid.Row="3" Header="Load-time seeding" IsExpanded="True">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- status -->
                    <RowDefinition Height="Auto"/> <!-- what it does -->
                    <RowDefinition Height="Auto"/> <!-- windows -->
                    <RowDefinition Height="Auto"/> <!-- passes + types -->
                    <RowDefinition Height="Auto"/> <!-- speed cap · pause · timeout -->
                    <RowDefinition Height="Auto"/> <!-- the plan -->
                    <RowDefinition Height="Auto"/> <!-- start / stop -->
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="6" Padding="10,7"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <TextBlock TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Text="{x:Bind SeedVm.StatusText, Mode=OneWay}"/>
                </Border>

                <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Plays every built-in event at each ticked window: COLD (that window's cached files and decoded frames forgotten first), then WARM. Shortest window first, so every cold pass is truly cold. PastCast must be on. Each load is logged with its timings, bytes and the speed cap."/>

                <StackPanel Grid.Row="2" Spacing="4">
                    <TextBlock Text="Windows" FontSize="12"/>
                    <ItemsControl ItemsSource="{x:Bind SeedVm.Windows}" IsEnabled="{x:Bind SeedVm.IsIdle, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SeedWindowOption">
                                <CheckBox Content="{x:Bind Label}" MinWidth="0" IsChecked="{x:Bind IsChecked, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox Content="Cold" MinWidth="0" IsChecked="{x:Bind SeedVm.Cold, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Forget the window's cached files and decoded frames, then load"/>
                        <CheckBox Content="Warm" MinWidth="0" IsChecked="{x:Bind SeedVm.Warm, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Load the same window again with everything cached, decoded frames included (a reload in the same session)"/>
                        <CheckBox Content="Revisit" MinWidth="0" IsChecked="{x:Bind SeedVm.Revisit, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Keep the cached files but forget the decoded frames, then load (coming back to an event another day)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox Content="Tornado" MinWidth="0" IsChecked="{x:Bind SeedVm.Tornado, Mode=TwoWay}"/>
                        <CheckBox Content="Hurricane" MinWidth="0" IsChecked="{x:Bind SeedVm.Hurricane, Mode=TwoWay}"/>
                        <CheckBox Content="Derecho" MinWidth="0" IsChecked="{x:Bind SeedVm.Derecho, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="4" ColumnSpacing="8"> <!-- (read once at Start: a change mid-run waits for the next run) -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Speed cap Mbps (0 = off)" VerticalAlignment="Center" FontSize="12"/>
                    <NumberBox x:Name="SeedSpeedBox" Grid.Column="1" SpinButtonPlacementMode="Compact"
                               SmallChange="5" LargeChange="25" Minimum="0" Maximum="10000"
                               ValueChanged="OnSeedSpeedChanged"
                               ToolTipService.ToolTip="Simulated connection speed for ALL radar downloads while set (stays on after the run until 0)"/>
                    <TextBlock Grid.Column="2" Text="Pause s" VerticalAlignment="Center" FontSize="12"/>
                    <NumberBox x:Name="SeedPauseBox" Grid.Column="3" SpinButtonPlacementMode="Compact"
                               SmallChange="5" LargeChange="30" Minimum="0" Maximum="600"
                               ValueChanged="OnSeedPauseChanged"/>
                    <TextBlock Grid.Column="4" Text="Timeout min" VerticalAlignment="Center" FontSize="12"/>
                    <NumberBox x:Name="SeedTimeoutBox" Grid.Column="5" SpinButtonPlacementMode="Compact"
                               SmallChange="5" LargeChange="15" Minimum="1" Maximum="240"
                               ValueChanged="OnSeedTimeoutChanged"/>
                </Grid>

                <TextBlock Grid.Row="5" FontSize="12" Text="{x:Bind SeedVm.PlanText, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8">
                    <Button Content="Start" Click="OnSeedStartClick" IsEnabled="{x:Bind SeedVm.IsIdle, Mode=OneWay}"/>
                    <Button Content="Stop" Click="OnSeedStopClick" IsEnabled="{x:Bind SeedVm.IsRunning, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </prim:PanelSection>
    </Grid>
</UserControl>
