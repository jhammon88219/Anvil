<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalWindowFooter — the bottom band of a temporal window: what Anvil is WORKING ON for THAT mode (an
     Activity = BarActivityViewModel). It replaced the main bar's activity slot (2026-10-16, the user's call): each
     mode's work shows in its own window. Declared ONCE in TemporalWindow, under whichever Content is loaded.

       │   …the Content's last expander…                             │
       │                                                              │  ← the Content's 14 px bottom margin keeps
       ├──────────────────────────────────────────────────────────────┤    the expanders off the band; the top
       │▓ New scan                          1:47:12 PM scan · painting▓│    hairline turns the TONE colour while
       │▓ ███████████████████████████████████░░░░░░░░░░░░░░░░░░░░░░░░ ▓│    loud (blue = radar work · green =
       │▓ ─────────────────────────────────────────────                ▓│    done flash · red = failed)
       └──────────────────────────────────────────────────────────────┘
         full width, FIXED 72 tall, the header grey (SectionHeaderBackground) — it is part of the window's frame,
         so the band itself never dims; only its LINES dim to 45% when nothing is active (the idle countdown).

       NowCast's lines (the live poll, the announced site check) and the idle line are the view model's — see
       BarActivityViewModel for every wording. Past / Fore: no activity yet (Activity null) → an EMPTY band.

     ⚠️ The tone colours are LITERALS (TemporalWindowFooter.xaml.cs ToneBrush), like the gate's: never resolve a
     theme brush in C#. The blue matches the gate's built bar; green/red are the old site-check toast's.
     ⚠️ FIXED height: the Content above must not move as lines come and go.
     ⚠️ Wording and priority live in the view model, not here. -->
<UserControl x:Class="Anvil.Controls.TemporalWindows.TemporalWindowFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsTabStop="False">

    <Grid x:Name="Band" Height="72"
          Background="{ThemeResource SectionHeaderBackground}">

        <!-- The top hairline (themed), then THE TONE EDGE over it: a 1 px coloured line. Code-behind sets its literal
             brush and fades its opacity (ApplyTone) — a quiet tone (idle / housekeeping) fades it out WITHOUT changing
             the brush, so a green flash fades green, never grey. Two elements, not a Border + child: a child can't
             paint over its parent's own border. -->
        <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False"
                Background="{ThemeResource SectionBorderBrush}"/>
        <Border x:Name="ToneEdge" Height="1" VerticalAlignment="Top" Opacity="0"
                IsHitTestVisible="False">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.3"/>
            </Border.OpacityTransition>
        </Border>

        <!-- The LINES — 16 px sides, the Content's own margin. Dimmed (not hidden) while idle. -->
        <StackPanel x:Name="Lines" VerticalAlignment="Center" Margin="16,0,16,0"
                    Visibility="{x:Bind HasActivity(Activity), Mode=OneWay}"
                    Opacity="{x:Bind LinesOpacity(Activity.IsShown), Mode=OneWay}">
            <StackPanel.OpacityTransition>
                <ScalarTransition Duration="0:0:0.25"/>
            </StackPanel.OpacityTransition>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Bind Activity.Title, Mode=OneWay}"
                               FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Border Padding="5,0" CornerRadius="4" VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind HasText(Activity.QueuedText), Mode=OneWay}">
                        <TextBlock Text="{x:Bind Activity.QueuedText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind Activity.Detail, Mode=OneWay}" FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>

            <!-- IDLE ONLY: how the last live frame did against its due time (LastFrameLine; empty = collapsed). -->
            <TextBlock Text="{x:Bind Activity.LastFrameLine, Mode=OneWay}" FontSize="11.5" Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind HasText(Activity.LastFrameLine), Mode=OneWay}"/>

            <!-- Main bar: star columns split by the fraction, so it needs no measured width. -->
            <Grid Height="5" CornerRadius="2.5" Margin="0,7,0,0"
                  Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                  Visibility="{x:Bind Activity.HasProgress, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind Filled(Activity.Progress), Mode=OneWay}"/>
                    <ColumnDefinition Width="{x:Bind Rest(Activity.Progress), Mode=OneWay}"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="2.5" Background="{x:Bind ToneBrush(Activity.Tone), Mode=OneWay}"/>
            </Grid>

            <!-- Thin line under it (a source's secondary fraction, e.g. the poll's chunk download). -->
            <Grid Height="2" CornerRadius="1" Margin="0,2,0,0"
                  Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                  Visibility="{x:Bind Activity.HasSecondary, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind Filled(Activity.Secondary), Mode=OneWay}"/>
                    <ColumnDefinition Width="{x:Bind Rest(Activity.Secondary), Mode=OneWay}"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="1" Background="#FF8A8F98"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
