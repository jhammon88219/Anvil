<?xml version="1.0" encoding="utf-8"?>
<!-- TemporalPaneActivityExpanderLoadRow — ONE row of PastCast's LAYER · RESULT · SOURCE table (a PastLayerStatus: what
     the loaded event downloaded for that layer), or, with IsHeader, the table's fixed column labels. ONE control for both
     so the column widths are written ONCE. NowCast/ForeCast's sibling is TemporalPaneActivityExpanderFeedRow.

        ┌───┬──────────────────────┬──────────────────┬──────────────┐
        │   │ LAYER                │ RESULT           │ SOURCE       │   ← IsHeader: 11 px small caps, never lifts
        │ ● │ Storm reports        │ 214 reports that day │ SPC + IEM │   ← 26 tall, 13 px; HOVER lifts the row
        │ ● │ Damage surveys       │ failed 3:12 PM   │ [ Retry ]    │   ← failed: RESULT red (tooltip = why) + Retry
        │ ● │ Tropical             │ none in window   │ IEM          │      in place of the source
        └───┴──────────────────────┴──────────────────┴──────────────┘
          10          *                    150              104        ColumnSpacing 12 · Padding 6,0 · CornerRadius 4

     ● = the layer's state (green loaded · blue loading · red failed · grey none / not shown / waiting) — DATA colours.
     RESULT reads primary when it holds something, secondary when it doesn't ("none in window", "not shown", "—").
     ⚠️ CLOCK TIMES ONLY ("failed 3:12 PM"). TABULAR digits so a count never shifts the row.
     ⚠️ Brushes in VisualStates are {ThemeResource} (never resolved in C#); the red is a literal DATA colour. -->
<UserControl x:Class="Anvil.Controls.TemporalPanes.TemporalPaneActivityExpanderLoadRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsTabStop="False">

    <Grid x:Name="RowSurface" Height="26" Padding="6,0" CornerRadius="4" ColumnSpacing="12"
          Background="Transparent"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" PointerCanceled="OnPointerExited">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="RowSurface.Background" Value="{ThemeResource ActivityRowHoverBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ResultStates">
                <VisualState x:Name="ResultNormal"/>
                <VisualState x:Name="ResultQuiet">
                    <VisualState.Setters>
                        <Setter Target="ResultText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ResultFailed">
                    <VisualState.Setters>
                        <Setter Target="ResultText.Foreground" Value="#FFF85149"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>  <!-- state dot -->
            <ColumnDefinition Width="*"/>   <!-- LAYER -->
            <ColumnDefinition Width="150"/> <!-- RESULT -->
            <ColumnDefinition Width="104"/> <!-- SOURCE / Retry -->
        </Grid.ColumnDefinitions>

        <!-- THE LABELS (IsHeader). -->
        <TextBlock Grid.Column="1" Text="LAYER" Style="{StaticResource AtlasFieldLabelStyle}" VerticalAlignment="Center"
                   Visibility="{x:Bind Shown(IsHeader), Mode=OneWay}"/>
        <TextBlock Grid.Column="2" Text="RESULT" Style="{StaticResource AtlasFieldLabelStyle}" VerticalAlignment="Center"
                   Visibility="{x:Bind Shown(IsHeader), Mode=OneWay}"/>
        <TextBlock Grid.Column="3" Text="SOURCE" Style="{StaticResource AtlasFieldLabelStyle}" VerticalAlignment="Center"
                   Visibility="{x:Bind Shown(IsHeader), Mode=OneWay}"/>

        <!-- THE ROW (a PastLayerStatus). -->
        <Ellipse Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left"
                 Visibility="{x:Bind RowShown(IsHeader, Status), Mode=OneWay}"
                 Fill="{x:Bind StateBrush(Status.State), Mode=OneWay}"/>
        <TextBlock Grid.Column="1" Text="{x:Bind Status.Name, Mode=OneWay}" FontSize="13" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{x:Bind RowShown(IsHeader, Status), Mode=OneWay}"/>
        <TextBlock x:Name="ResultText" Grid.Column="2" Text="{x:Bind Status.ResultText, Mode=OneWay}" FontSize="13"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Style="{StaticResource TabularNumberTextStyle}"
                   ToolTipService.ToolTip="{x:Bind TipOf(Status.Reason), Mode=OneWay}"
                   Visibility="{x:Bind RowShown(IsHeader, Status), Mode=OneWay}"/>
        <TextBlock Grid.Column="3" Text="{x:Bind Status.Source, Mode=OneWay}" FontSize="13" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{x:Bind SourceShown(IsHeader, Status.CanRetry), Mode=OneWay}"/>
        <!-- RETRY: in the source's place while the layer has failed; fetches only that layer again. -->
        <Button x:Name="LoadRowRetryButton" Grid.Column="3" Content="Retry" FontSize="12" Padding="8,0" MinHeight="0"
                Height="20" VerticalAlignment="Center" Click="OnRetryClick"
                ToolTipService.ToolTip="Fetch this layer again for the loaded event"
                Visibility="{x:Bind RetryShown(IsHeader, Status.CanRetry), Mode=OneWay}"/>
    </Grid>
</UserControl>
