<?xml version="1.0" encoding="utf-8"?>
<!-- LiveDataSettingsConsolePolling — Settings → Live Data's "Polling" section, on a Primitives/SettingsConsolePlate: how often each
     feed is checked when no live source carries it. Mock-up: the "Polling plate — live tags" Design canvas (2026-11-18).

       Polling  [Restore defaults]                                                                       DEFAULT
       These intervals run when Polling only is the source, or while the live source is down. …   ← a FIXED note (the link's
                                                                       state is the Connection plate's Status row — never repeat it)
       Warnings      [ 30 ⌃⌄]  seconds when IEM is down · min 15 s   [Live]    Waits for IEM · safety check every 10 min  30 s
       …             (one row per feed, LiveDataViewModel.Polling)
       Storm cells   [ 60 ⌃⌄]  seconds · min 30 s                     [Polling] Every 1 min · no live feed carries it     1 min
       Radar         Follows the radar's scan pattern                 Set in Radar → Live polling
       96            420 (NumberBox 96 · unit text)                   hint: tag + words (one line)                 150, right

     ⭐ THE TAG FOLLOWS THE LINK (LivePollRow.SetLink ← LiveDataViewModel.Refresh), what the row is doing NOW:
       connected       → a pushed feed: green Live, its number is the OUTAGE interval ("seconds when IEM is down")
       live source not connected (connecting / lost / needs an account) → a pushed feed: AMBER Polling ("Every 30 s until IEM is back")
       Polling only, and storm cells / HRRR always → plain grey Polling ("Every 1 min")
     ⚠️ NEVER greyed: every number stays editable in every state — the outage interval is set BEFORE the outage.
     ⚠️ Every row is a Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText). Each NumberBox is clamped to
     the feed's minimum … 30 min (LivePollRow.Seconds). "Live" = no schedule while connected: the feed fetches when the NWS issues
     one of its products (+ a few re-checks and a 10-min safety — LiveFeedChannel).
     ⚠️ Tag colours are THEME brushes (SystemFillColorSuccess* / Caution* / ControlFill*) — chrome, not data; three
     declared Borders, one shown by the row's IsTag* bools. -->
<UserControl x:Class="Anvil.Controls.LiveDataSettingsConsoles.LiveDataSettingsConsolePolling"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:local="using:Anvil.Controls.LiveDataSettingsConsoles"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One feed. Columns = the page's (keep in step with the Radar row below). -->
        <DataTemplate x:Key="PollRowTemplate" x:DataType="vm:LivePollRow">
            <prim:SettingsConsoleRow Label="{x:Bind Name}" AboutKey="polling.feed" Default="{x:Bind DefaultText}" Margin="0,0,0,2">
                <prim:SettingsConsoleRow.HintContent>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Padding="6,1" CornerRadius="3" VerticalAlignment="Center"
                                Visibility="{x:Bind local:LiveDataSettingsConsolePolling.Shown(IsTagLive), Mode=OneWay}"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                            <TextBlock Text="Live" FontSize="{StaticResource CaptionFontSize}" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        </Border>
                        <Border Padding="6,1" CornerRadius="3" VerticalAlignment="Center"
                                Visibility="{x:Bind local:LiveDataSettingsConsolePolling.Shown(IsTagFallback), Mode=OneWay}"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                            <TextBlock Text="Polling" FontSize="{StaticResource CaptionFontSize}" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        </Border>
                        <Border Padding="6,1" CornerRadius="3" VerticalAlignment="Center"
                                Visibility="{x:Bind local:LiveDataSettingsConsolePolling.Shown(IsTagPolling), Mode=OneWay}"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="Polling" FontSize="{StaticResource CaptionFontSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Border>
                        <TextBlock Style="{StaticResource SettingsConsoleHintTextStyle}" Text="{x:Bind LiveHint, Mode=OneWay}"/>
                    </StackPanel>
                </prim:SettingsConsoleRow.HintContent>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <NumberBox Width="96" Value="{x:Bind Seconds, Mode=TwoWay}"
                               Minimum="{x:Bind MinimumSeconds}" Maximum="{x:Bind MaximumSeconds}"
                               SmallChange="5" LargeChange="60" SpinButtonPlacementMode="Compact"
                               ToolTipService.ToolTip="Seconds between checks when no live source carries this feed"/>
                    <TextBlock Text="{x:Bind UnitText, Mode=OneWay}" VerticalAlignment="Center" FontSize="{StaticResource CaptionFontSize}"
                               Style="{StaticResource TabularNumberTextStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </prim:SettingsConsoleRow>
        </DataTemplate>
    </UserControl.Resources>

    <prim:SettingsConsolePlate x:Name="LiveDataSettingsConsolePollingPlate" Title="Polling" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="PollingRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    ToolTipService.ToolTip="Every feed's interval back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <StackPanel>
            <!-- WHEN these intervals run — a fixed note. The link's state lives on the Connection plate's Status row
                 (it was repeated here until 2026-11-19); each row's tag still says what THAT layer is doing now. -->
            <TextBlock x:Name="PollingWhenNote" Style="{StaticResource SettingsConsoleHintTextStyle}" Margin="0,0,0,8" TextWrapping="Wrap"
                       Text="These intervals run when Polling only is the source, or while the live source is down. Storm cells and HRRR always poll."/>

            <ItemsControl x:Name="PollRows" IsTabStop="False" ItemsSource="{x:Bind ViewModel.Polling}" ItemTemplate="{StaticResource PollRowTemplate}"/>

            <!-- The radar keeps its own scan schedule — shown so the list reads as every NowCast feed. -->
            <prim:SettingsConsoleRow Label="Radar" AboutKey="polling.radar" IsLabelDimmed="True">
                <TextBlock Text="Follows the radar's scan pattern" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </prim:SettingsConsoleRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
