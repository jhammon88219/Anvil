<?xml version="1.0" encoding="utf-8"?>
<!-- GeneralSettingsConsoleUnits — Settings → General's "Units" section, on a Primitives/SettingsConsolePlate. ONE place for
     every unit the app shows: each picker writes a TOKEN to AppSettings; MapViewModel hands the set to Models/Map/UnitFormat
     (every C# readout) and the page (js/units.js). General B (2026-11-16).

       Units        [Restore defaults]                                                             DEFAULT
       Unit set     [ US | Metric | Forecaster | Custom ]          Use Anvil's presets or choose Custom   Custom
       Clock        [  12-hour  |  24-hour  ]                      5:04 PM                         12-hour
       Time zone    [   Local   |    UTC    ]                      5:04 PM CST                       Local
       Date         [Written|Month first|Day first|ISO]            Sun Nov 16, 2026                Written
       Distance     [Kilometers|Miles|Nautical miles]              230 km                       Kilometers
       Speed        [ kt | mph | km/h | m/s ]                      49 mph                              mph
       Height       [ km | kft | ft ]                              44.0 kft                            kft
       Hail size    [ in | cm ]                                    1.75 in                              in
       Coordinates  [ Decimal | Deg · min · sec ]                  35.333° N, 97.278° W            Decimal
       96           420 — EVERY picker fills it, segments equal    hint = the RESULT (a live sample) 150, right

     ⚠️ Every row is a Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText by AboutKey). The sample
     hints are DATA (MapViewModel.*Sample), passed as the row's Hint.
     ⚠️ UNIT SET: a preset (US / Metric / Forecaster) writes its whole set and LOCKS the pickers below (greyed, the pick a lifted
     grey — never the accent); Custom frees them and brings back your last custom picks (MapViewModel.UnitSetIndex).
     ⚠️ 12-hour greys while UTC (UTC is always "17:04Z").
     ⚠️ No temperature / rainfall row: nothing in the app shows either yet (parked). -->
<UserControl x:Class="Anvil.Controls.GeneralSettingsConsoles.GeneralSettingsConsoleUnits"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="GeneralSettingsConsoleUnitsPlate" Title="Units" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="UnitsRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    ToolTipService.ToolTip="Put every unit back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

        <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
            <prim:SettingsConsoleRow Label="Unit set" AboutKey="units.set" Default="{x:Bind ViewModel.DefaultUnitSetText}">
                <prim:SegmentedPicker x:Name="UnitsSetPicker"
                                      ItemsSource="{x:Bind ViewModel.UnitSetLabels}"
                                      SelectedIndex="{x:Bind ViewModel.UnitSetIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Clock" AboutKey="units.clock" Hint="{x:Bind ViewModel.ClockSample, Mode=OneWay}"
                                     Default="{x:Bind ViewModel.DefaultClockText}">
                <prim:SegmentedPicker x:Name="UnitsClockPicker"
                                      IsEnabled="{x:Bind ViewModel.AreUnitsCustom, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.ClockFormatLabels}"
                                      DisabledIndex="{x:Bind ViewModel.ClockFormatDisabledIndex, Mode=OneWay}"
                                      SelectedIndex="{x:Bind ViewModel.ClockFormatIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Time zone" AboutKey="units.zone" Hint="{x:Bind ViewModel.TimeZoneSample, Mode=OneWay}"
                                     Default="{x:Bind ViewModel.DefaultTimeZoneText}">
                <prim:SegmentedPicker x:Name="UnitsTimeZonePicker"
                                      IsEnabled="{x:Bind ViewModel.AreUnitsCustom, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.TimeZoneLabels}"
                                      SelectedIndex="{x:Bind ViewModel.TimeZoneIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Date" AboutKey="units.date" Hint="{x:Bind ViewModel.DateSample, Mode=OneWay}"
                                     Default="{x:Bind ViewModel.DefaultDateText}">
                <prim:SegmentedPicker x:Name="UnitsDatePicker"
                                      IsEnabled="{x:Bind ViewModel.AreUnitsCustom, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.DateFormatLabels}"
                                      SelectedIndex="{x:Bind ViewModel.DateFormatIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Distance" AboutKey="units.distance" Hint="{x:Bind ViewModel.DistanceSample, Mode=OneWay}"
                                     Default="{x:Bind ViewModel.DefaultDistanceText}">
                <prim:SegmentedPicker x:Name="UnitsDistancePicker"
                                      IsEnabled="{x:Bind ViewModel.AreUnitsCustom, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.DistanceUnitLabels}"
                                      SelectedIndex="{x:Bind ViewModel.DistanceUnitIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Speed" AboutKey="units.speed" Hint="{x:Bind ViewModel.SpeedSample, Mode=OneWay}"
                                     Default="{x:Bind ViewModel.DefaultSpeedText}">
                <prim:SegmentedPicker x:Name="UnitsSpeedPicker"
                                      IsEnabled="{x:Bind ViewModel.AreUnitsCustom, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.SpeedUnitLabels}"
                                      SelectedIndex="{x:Bind ViewModel.SpeedUnitIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Height" AboutKey="units.height" Hint="{x:Bind ViewModel.HeightSample, Mode=OneWay}"
                                     Default="{x:Bind ViewModel.DefaultHeightText}">
                <prim:SegmentedPicker x:Name="UnitsHeightPicker"
                                      IsEnabled="{x:Bind ViewModel.AreUnitsCustom, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.HeightUnitLabels}"
                                      SelectedIndex="{x:Bind ViewModel.HeightUnitIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Hail size" AboutKey="units.hail" Hint="{x:Bind ViewModel.HailSample, Mode=OneWay}"
                                     Default="{x:Bind ViewModel.DefaultHailText}">
                <prim:SegmentedPicker x:Name="UnitsHailPicker"
                                      IsEnabled="{x:Bind ViewModel.AreUnitsCustom, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.HailUnitLabels}"
                                      SelectedIndex="{x:Bind ViewModel.HailUnitIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>

            <prim:SettingsConsoleRow Label="Coordinates" AboutKey="units.coords" Hint="{x:Bind ViewModel.CoordinateSample, Mode=OneWay}"
                                     Default="{x:Bind ViewModel.DefaultCoordinateText}">
                <prim:SegmentedPicker x:Name="UnitsCoordinatesPicker"
                                      IsEnabled="{x:Bind ViewModel.AreUnitsCustom, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.CoordinateFormatLabels}"
                                      SelectedIndex="{x:Bind ViewModel.CoordinateFormatIndex, Mode=TwoWay}"/>
            </prim:SettingsConsoleRow>
        </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
