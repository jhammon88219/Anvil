<?xml version="1.0" encoding="utf-8"?>
<!-- RadarControls — the GLOBAL time module, and only that. The "clock face" layout: the displayed frame's
     time is the HERO (the NowCast header's clock, restated), everything else steps down to one quiet line.

       ┌─ clock ────────┐ ┌─ scrubber: FIXED 420 (8 px cells, 16 px) ───────┐ ┌─ scan ─────────────────┐
       │ 1:07 PM        │ │ ▬▬ ▬▬ ▬▬ ▬▬ ▬▬ ▬▬ ▬▬ ▬▬ ▬▬ ▬┃                        │ │ VCP:        212        │
       │                │ │                                                     │ │ Mode:       precip     │
       │ 2 min ago      │ │ 11 / 11            ⏮  ▶  ⏭                      ⟳  │ │ SAILS/MRLE: ×1         │
       └────────────────┘ └─────────────────────────────────────────────────────┘ └────────────────────────┘
         ^ digits 40 SemiLight,   ^ frame count LEFT · transport CENTRED under the          ^ ALWAYS three LABELLED
           AM/PM 16 beside them     scrubber · ⟳ (check for a newer frame, 2 s               lines; a missing fact is
         ^ age (14) of the NEWEST   debounce) RIGHT — a [*, Auto, *] grid, so the             a placeholder (—, none,
           frame, ramped fresh→     transport sits on the scrubber's exact midpoint           n/a), never a gap.
           stale (AgeBrush)                                                                   RESERVED 180.

         The clock LEADS at the bar's left edge and the scan readout closes the module on the right, so the
         two readouts FLANK the scrubber (2026-09-29, when Inspect left for the tools tier).
         ⚠️ NO SITE ID HERE any more: the tools tier's site picker, directly above, names the loaded site — and
         its RIGHT EDGE sits on the END OF THE LONGEST SCAN LINE here (MainWindow.AlignSitePicker measures ScanTextRightEdge).

     THE ORGANIZING RULE: the bar holds what does NOT repeat per pane. One site, one camera, one time
     cursor, shared by every pane — which is why the scrubber does not multiply. Per-pane controls (product,
     ramp, tilt) are the pane NOTCH (Composites/PaneNotchContent), not here.

     ⚠️ ONLY THE CLOCK CHANGES WIDTH. It sits at its real width (a digit wider when the hour needs two); the
     scrubber block (a FIXED 420, control line included) and the scan block (a reserved 180) are one rigid run
     that SLIDES right/left behind it, the gap always 16. Nothing else ticking over (the age, a VCP change) can
     resize or move the scrubber. The site picker above tracks the scan text's END, so it slides with the run
     (and a longer VCP line slides it a little further).
     ⚠️ WIDTH BUDGET: ~732 at a 1-digit hour, ~754 at 2. At 1920 wide the bar's left star column (beside the
     centred temporal keys) is ~770, so there is ~16 px to spare at worst — widen the run and it clips.

     History: this was a 2x2 readout block (time/age over site/scan) beside plated 30/38/30 transport buttons.
     J replaced it (2026-09-28) to match the tiles/clock language of the redesigned windows. -->
<UserControl x:Class="Anvil.Controls.Composites.RadarControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Anvil.ViewModels"
             xmlns:layout="using:Anvil.Layout"
             mc:Ignorable="d">

    <UserControl.Resources>
        <x:Double x:Key="ReadoutFontSize">12</x:Double>
        <!-- The scan block's two text roles: a quiet LABEL ("VCP:") and a primary VALUE ("212"). -->
        <Style x:Key="ScanLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>
        <Style x:Key="ScanValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- LEFT, so ActualWidth is the TEXT: ScanTextRightEdge reads it to place the site picker. -->
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>
        <!-- A STAND-IN value (—, ?, none, n/a, loading…): same slot, DIMMED, so a missing fact reads as absent
             rather than as data. A separate TextBlock, not a converted brush — a theme brush is never resolved
             in C#. -->
        <Style x:Key="ScanStandInStyle" TargetType="TextBlock" BasedOn="{StaticResource ScanValueStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
        </Style>
        <!-- Glyph-only transport: no resting plate, the shared hover/pressed look still shows on pointer. -->
        <Style x:Key="GlyphTransportStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- The whole assembly is CENTRED vertically in the bar, and each column is centred within it, so the
         clock, the scrubber block and the scan lines share one midline. -->
    <!-- ⚠️ THE CLOCK IS THE ONLY THING THAT CHANGES WIDTH. Column 0 is Auto and holds the clock at its REAL width
         (it grows a digit when the hour needs two, "10:05"); everything after it — the scrubber block (a FIXED 420,
         with the control line under it) and the scan block (a reserved 180) — is one rigid run that SLIDES right
         when the clock grows and back when it shrinks. The gap between them is always the column spacing, 16.
         The tools tier's site picker ends where the scan text ends, so it slides with this run (MainWindow). -->
    <Grid HorizontalAlignment="Left" VerticalAlignment="Center" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/> <!-- the clock, at its real width -->
            <ColumnDefinition Width="Auto"/> <!-- scrubber over the control line: a fixed 420 -->
            <ColumnDefinition Width="180"/>  <!-- the scan readout: three LABELLED lines — reserved -->
        </Grid.ColumnDefinitions>

        <!-- ===== THE CLOCK: the DISPLAYED frame's time (the one scrubbed to), not the newest =====
             LEFT-aligned, so its left edge lines up with the tools tier's first site key above it, and the age
             sits left under it. It follows the frame ON SCREEN: stepping or playing from 9:59 to 10:00 widens
             it and slides the run after it. ⚠️ A DRAG across that hour doesn't feed back: the scrubber maps the
             pointer from where it stood at PRESS (_dragOriginX), so the slide can't change which frame is under
             the pointer. -->
        <Grid Grid.Column="0" VerticalAlignment="Center" RowSpacing="2"
              ToolTipService.ToolTip="When the frame on screen was scanned">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 1:07 PM -->
                <RowDefinition Height="Auto"/> <!-- 2 min ago -->
            </Grid.RowDefinitions>
            <Grid x:Name="ClockTime" ColumnSpacing="4" HorizontalAlignment="Left"
                  SizeChanged="OnClockTimeSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- ⚠️ TABULAR digits: Segoe's default digits are PROPORTIONAL ("1:11" is narrower than "1:08"), so
                     every frame nudged the clock's width and the whole run behind it undulated while scrubbing.
                     Tabular, the width changes only with the digit COUNT (9:59 → 10:00). -->
                <TextBlock Grid.Column="0"
                           Text="{x:Bind ClockDigits(ViewModel.CurrentFrameTimeText), Mode=OneWay}"
                           Typography.NumeralAlignment="Tabular"
                           FontSize="40"
                           FontWeight="SemiLight"
                           LineHeight="42"
                           LineStackingStrategy="BlockLineHeight"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <!-- AM/PM rides the digits' baseline-ish bottom edge, small and secondary.
                     ⚠️ Its slot is as wide as the WIDER designator (two invisible samples share the cell), so noon /
                     midnight don't nudge the width either ("AM" and "PM" differ by a hair). -->
                <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,5">
                    <TextBlock Text="{x:Bind AmDesignator}" FontSize="16" Opacity="0" IsHitTestVisible="False"/>
                    <TextBlock Text="{x:Bind PmDesignator}" FontSize="16" Opacity="0" IsHitTestVisible="False"/>
                    <TextBlock Text="{x:Bind ClockSuffix(ViewModel.CurrentFrameTimeText), Mode=OneWay}"
                               FontSize="16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Grid>
            <!-- Age of the FRESHEST frame, ramped green → amber (12 min) → red (30 min) by AgeBrush, knees
                 matching RadarSiteStatus so the colour and the status dot agree. -->
            <!-- ⚠️ Capped to the TIME's width in code (OnClockTimeSizeChanged): only the time may size this column —
                 a long replay age ("11 mo 29 day ago") trims instead of pushing the run right. -->
            <TextBlock x:Name="AgeText"
                       Grid.Row="1"
                       HorizontalAlignment="Left"
                       Text="{x:Bind ViewModel.RadarAgeText, Mode=OneWay}"
                       FontSize="14"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{x:Bind AgeBrush(ViewModel.RadarAgeMinutes), Mode=OneWay}"
                       ToolTipService.ToolTip="How long ago the newest available frame was scanned. Green = fresh, red = stale."/>
        </Grid>

        <!-- ===== SCRUBBER over the CONTROL LINE =====
             ⚠️ THE Width="420" IS LOAD-BEARING: in an Auto column EqualCellsPanel measures with infinity and returns
             0, so without a fixed width the scrubber would have none. Fixed, it never changes as the clock grows. -->
        <Grid Grid.Column="1" Width="420" VerticalAlignment="Center" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- segmented scrubber -->
                <RowDefinition Height="Auto"/> <!-- frame count · transport · check now -->
            </Grid.RowDefinitions>

            <!-- One cell per frame (ViewModel.Segments), each lighting as its frame builds — the load
                 indicator for the whole loop (Rule 2). Cells 8 px inside a 16 px hit strip, so the grab
                 area is bigger than what you see. Playhead positioned in code-behind. -->
            <Grid x:Name="ScrubberHost"
                  Grid.Row="0"
                  Height="16"
                  Background="Transparent"
                  IsHitTestVisible="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                  Opacity="{x:Bind ScrubberOpacity(ViewModel.IsTransportEnabled), Mode=OneWay}"
                  SizeChanged="OnScrubberSizeChanged"
                  PointerPressed="OnScrubberPointerPressed"
                  PointerMoved="OnScrubberPointerMoved"
                  PointerReleased="OnScrubberPointerReleased"
                  PointerCaptureLost="OnScrubberPointerReleased"
                  PointerCanceled="OnScrubberPointerReleased">
                <!-- Always-present track: same footprint whether or not a loop is loaded. -->
                <Border Height="8"
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"/>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Segments, Mode=OneWay}"
                              IsHitTestVisible="False"
                              VerticalAlignment="Center"
                              Height="8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <layout:EqualCellsPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RadarFrameSegment">
                            <Border Margin="1,0"
                                    CornerRadius="2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="{x:Bind ReadyOpacity, Mode=OneWay}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="Playhead"
                        Width="3"
                        Height="16"
                        CornerRadius="1.5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{ThemeResource TextFillColorPrimaryBrush}"
                        IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PlayheadTransform"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <!-- Control line: frame count LEFT · transport CENTRED · check-now RIGHT. [*, Auto, *] puts the
                 transport on the scrubber's exact midpoint whatever the two sides hold (the bar's own trick). -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>    <!-- frame N / M, left-aligned -->
                    <ColumnDefinition Width="Auto"/> <!-- prev · play/stop · next -->
                    <ColumnDefinition Width="*"/>    <!-- check now, right-aligned -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="{x:Bind FrameCountText(ViewModel.CurrentFrameIndex, ViewModel.MaxFrameIndex), Mode=OneWay}"
                           FontSize="{StaticResource ReadoutFontSize}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           ToolTipService.ToolTip="Which frame of the loop is on screen"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource GlyphTransportStyle}"
                            Click="OnPrevClick"
                            IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="Previous frame">
                        <FontIcon Glyph="&#xE892;" FontSize="13"/>
                    </Button>
                    <!-- Play is the one transport glyph at full strength: it's the one you reach for. -->
                    <Button Style="{StaticResource GlyphTransportStyle}"
                            Width="32"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Click="OnPlayStopClick"
                            IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="Play / stop (stop returns to the newest frame)">
                        <FontIcon Glyph="{x:Bind PlayStopGlyph(ViewModel.IsPlaying), Mode=OneWay}" FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource GlyphTransportStyle}"
                            Click="OnNextClick"
                            IsEnabled="{x:Bind ViewModel.IsTransportEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="Next frame">
                        <FontIcon Glyph="&#xE893;" FontSize="13"/>
                    </Button>
                </StackPanel>

                <!-- One live poll now instead of waiting for the timer; the VM debounces it (disabled while
                     running + 2 s after), and the disabled look IS the cooldown cue. -->
                <Button Grid.Column="2"
                        HorizontalAlignment="Right"
                        Style="{StaticResource GlyphTransportStyle}"
                        Width="24"
                        Height="24"
                        Click="OnForceLiveCheckClick"
                        IsEnabled="{x:Bind ViewModel.CanForceLiveCheck, Mode=OneWay}"
                        ToolTipService.ToolTip="Check for a newer frame now (skips the poll timer)">
                    <FontIcon Glyph="&#xE72C;" FontSize="11"/>
                </Button>
            </Grid>
        </Grid>

        <!-- ===== SCAN: the volume's scan strategy, ALWAYS THREE LABELLED LINES =====
               VCP:         212          ← the number ("?" unparsed; "—" / "loading…" before a frame)
               Mode:        precip       ← the regime word (clear-air · precip · TDWR monitor/hazardous)
               SAILS/MRLE:  ×1           ← extra base-tilt cuts; "none" = counted and zero, "n/a" = TDWR,
                                           "—" = not known (the archive path reads no sweep count)
             ⚠️ Every line ALWAYS shows — a missing fact is a placeholder, never an empty or collapsed row, so
             the block's height and the labels' column never move. Values come from ScanValue, which cuts the ONE
             rule's string (RadarViewModel.ScanStrategyText, shared with the Atlas), so they can't disagree with it.
             Labels tertiary, values primary; the whole block carries the glossary tooltip. -->
        <Grid x:Name="ScanBlock" Grid.Column="2" VerticalAlignment="Center" ColumnSpacing="8" RowSpacing="1"
              Background="Transparent"
              ToolTipService.ToolTip="{x:Bind ScanTooltip(ViewModel.RadarModeText), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- label -->
                <ColumnDefinition Width="*"/>    <!-- value -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Each value cell holds a FACT and a STAND-IN; exactly one of the two is non-empty (ScanFact /
                 ScanStandIn split ScanValue), so the dim one only ever shows in place of a missing fact. -->
            <TextBlock Grid.Row="0" Text="VCP:" Style="{StaticResource ScanLabelStyle}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ScanFact(ViewModel.RadarModeText, 0), Mode=OneWay}"
                       Style="{StaticResource ScanValueStyle}" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ScanStandIn(ViewModel.RadarModeText, 0), Mode=OneWay}"
                       Style="{StaticResource ScanStandInStyle}"/>
            <TextBlock Grid.Row="1" Text="Mode:" Style="{StaticResource ScanLabelStyle}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ScanFact(ViewModel.RadarModeText, 1), Mode=OneWay}"
                       Style="{StaticResource ScanValueStyle}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ScanStandIn(ViewModel.RadarModeText, 1), Mode=OneWay}"
                       Style="{StaticResource ScanStandInStyle}"/>
            <TextBlock Grid.Row="2" Text="SAILS/MRLE:" Style="{StaticResource ScanLabelStyle}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ScanFact(ViewModel.RadarModeText, 2), Mode=OneWay}"
                       Style="{StaticResource ScanValueStyle}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ScanStandIn(ViewModel.RadarModeText, 2), Mode=OneWay}"
                       Style="{StaticResource ScanStandInStyle}"/>
        </Grid>
    </Grid>
</UserControl>
