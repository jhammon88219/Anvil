<?xml version="1.0" encoding="utf-8"?>
<!-- PastCastTab — the body of the PastCast window: date / start / window, the historical SPC outlook for
     that date, and that day's storm reports. One of three mode bodies (see Controls/Windows/TemporalWindow,
     registered once per mode); the window supplies the surface, the title and the pin, so this is content
     only.
     ⚠️ The file keeps its "Tab" name from when the three were tabs of one Timeframe window. It is the same
     control, unchanged by the split; renaming all three would be churn. Bound to the coordinator MapViewModel.

       ┌──────────────────────────────────────────────────────┐
       │  Timeframe ──────────────────────────────────────    │
       │  ┌──────────────────────────────────┬─────────┐      │
       │  │ Tue May 24, 2011                 │         │      │  the CARD previews what Load
       │  │ 5:00 PM → 7:00 PM                │  Load   │      │  will do; its footer reports
       │  │ 28 frames loaded                 │         │      │  whether that is on the map
       │  └──────────────────────────────────┴─────────┘      │
       │  ────────────────────────────────────────────────    │
       │  Date    [ May 24, 2011              ▾]              │
       │  Start   [ 5:00 PM                   ▾]              │  ← the PICKERS (ViewModel.Radar)
       │  Window  [30m│1h│▓2h▓│3h│6h│12h]                     │
       │  ────────────────────────────────────────────────    │
       │  Outlook [Day 1   ] cycle [Auto  ]                   │
       │  Product [Categorical      ]                         │  ← historical SPC outlook for that
       │  Opacity ──────●───────────                          │     date (ViewModel.PastOutlook)
       │          status… / issued + valid                    │
       │  ────────────────────────────────────────────────    │
       │  StormReportsInput  (that day's verification dots)   │
       └──────────────────────────────────────────────────────┘

     Laid out ENTIRELY with grids (rows/columns, no StackPanels) so rows are easy to add/rearrange: a fixed
     [label | control] outer grid, one row per field.

     ⚠️ THE SECTION FOLLOWS THE SETTINGS TABS' LANGUAGE, deliberately — a Primitives/SectionHeading over
     SettingsFieldLabelStyle rows in one aligned label column. It used to carry a local PastLabelStyle that
     was character-for-character the shared field label, and no section headings at all, which is most of
     why the window read as loose controls rather than as part of this app.

     ⚠️ THE CARD IS A PREVIEW, NOT A RECEIPT. Its two readouts come from the pickers below (PastEventDateText
     / PastEventRangeText), so they describe what Load WILL do; only the footer describes what already
     happened. Do not re-point them at the loaded window — the split between the two is the entire reason
     the card can show a stale selection honestly.
       • Timeframe (row 0, ViewModel.Radar) — a CalendarDatePicker on the PastEventDate facade, a TimePicker
         bound straight to PastEventTime, and a SegmentedPicker on PastEventDurationIndex. No element names
         are load-bearing here any more; there is no widget-sync code left to reach them.
       • Historical outlook (row 2, ViewModel.PastOutlook) — Day / issuance Cycle / Product / Opacity + a
         status line and issued/valid readout. Selecting a product fetches the archived issuance for the
         entered replay date and overlays it on the past radar.
     Storm reports stay a separate control — the NowCast tab shows the same block, so it is content of TWO
     hosts.

     ⚠️ This tab does NOT enter or leave replay; that is the PastCast key in the bottom bar's centre cluster
     (Load fills the armed replay with frames). A tab body configures a mode, the key runs it. -->
<UserControl x:Class="Anvil.Controls.Composites.PastCastTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:Anvil.Controls.Composites"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid VerticalAlignment="Top" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- radar: date / start / window -->
            <RowDefinition Height="Auto"/> <!-- divider -->
            <RowDefinition Height="Auto"/> <!-- historical SPC outlook -->
            <RowDefinition Height="Auto"/> <!-- divider -->
            <RowDefinition Height="Auto"/> <!-- storm reports (verification) -->
        </Grid.RowDefinitions>

        <!-- ===================== TIMEFRAME: the card, then the pickers ===================== -->
        <Grid Grid.Row="0" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- section label -->
                <RowDefinition Height="Auto"/> <!-- summary card + Load -->
                <RowDefinition Height="Auto"/> <!-- rule -->
                <RowDefinition Height="Auto"/> <!-- the three pickers -->
            </Grid.RowDefinitions>

            <prim:SectionHeading Grid.Row="0" Margin="0,0,0,12" Text="Timeframe"/>

            <!-- THE CARD previews what Load WILL do — both readouts derive from the pickers below, not from
                 the last load — and its footer says whether that is what is actually on the map. Those two
                 disagree the moment a picker moves, which is the state the old trailing status line could
                 not express: it was written once, by the load, and then just sat there.
                 ⚠️ Load is the ACCENT action except in the one state where there is nothing to do (loaded,
                 and the pickers still agree with it), where it steps back to a plain button. -->
            <Border Grid.Row="1" CornerRadius="8" Padding="13,12"
                    Background="{ThemeResource OverlayBarSurfaceHoverBrush}"
                    BorderThickness="1"
                    BorderBrush="{x:Bind CardStroke(ViewModel.Radar.IsReplaySelectionDirty), Mode=OneWay}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Radar.PastEventDateText, Mode=OneWay}"
                                   FontSize="15"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.Radar.PastEventRangeText, Mode=OneWay}"
                                   FontSize="13" Margin="0,4,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind CardFooter(ViewModel.Radar.HasLoadedReplayWindow, ViewModel.Radar.IsReplaySelectionDirty, ViewModel.Radar.PastEventStatus), Mode=OneWay}"
                                   FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{x:Bind FooterBrush(ViewModel.Radar.IsReplaySelectionDirty), Mode=OneWay}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Load" MinWidth="84"
                            VerticalAlignment="Center"
                            Style="{x:Bind LoadStyle(ViewModel.Radar.HasLoadedReplayWindow, ViewModel.Radar.IsReplaySelectionDirty), Mode=OneWay}"
                            Click="OnLoadClick"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Height="1" Margin="0,14"
                    Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>

            <!-- THE PICKERS. Everything below the rule is what you change; everything above it is what
                 happens when you press Load. -->
            <Grid Grid.Row="3" ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Date -->
                    <RowDefinition Height="Auto"/> <!-- Start -->
                    <RowDefinition Height="Auto"/> <!-- Window -->
                </Grid.RowDefinitions>

                <!-- ⚠️ ONE calendar, not three combos. Its Date is a DateTimeOffset?, which the view model
                     exposes as a FACADE over the year/month/day indices everything downstream still reads —
                     see PastEventDate. It also cannot express Feb 30, which three independent combos could,
                     so the day-clamp in the loop engine is no longer reachable from this form.
                     ⚠️ Min/MaxDate are REQUIRED, not decoration: the year combo used to bound the choice to
                     the archive's range, and a bare calendar will happily offer next century. -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Date" Style="{StaticResource SettingsFieldLabelStyle}"/>
                <CalendarDatePicker Grid.Row="0" Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    DateFormat="{}{month.abbreviated} {day.integer}, {year.full}"
                                    MinDate="{x:Bind ViewModel.Radar.PastEventMinDate}"
                                    MaxDate="{x:Bind ViewModel.Radar.PastEventMaxDate}"
                                    Date="{x:Bind ViewModel.Radar.PastEventDate, Mode=TwoWay}"
                                    ToolTipService.ToolTip="The date to replay (local time)"/>

                <!-- ⚠️ ONE picker, bound STRAIGHT to the view model's TimeSpan. It replaced an editable hour
                     combo, an editable minute combo, an AM/PM checkbox pair, and the ~110 lines of
                     code-behind that converted between them and kept them in step. PastEventTime was always
                     a TimeSpan; the form simply was not shaped like one. -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Start" Style="{StaticResource SettingsFieldLabelStyle}"/>
                <TimePicker Grid.Row="1" Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            ClockIdentifier="12HourClock"
                            MinuteIncrement="5"
                            Time="{x:Bind ViewModel.Radar.PastEventTime, Mode=TwoWay}"
                            ToolTipService.ToolTip="Start of the replay window (local time)"/>

                <!-- ⚠️ Six segments, not a dropdown: the list is short and fixed, so the choice is worth one
                     click. The SHORT labels are their own list on the view model, kept beside the long ones
                     and the minutes array because all three are indexed by PastEventDurationIndex. -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Window" Style="{StaticResource SettingsFieldLabelStyle}"/>
                <prim:SegmentedPicker Grid.Row="2" Grid.Column="1"
                                      ItemsSource="{x:Bind ViewModel.Radar.PastEventDurationShortLabels}"
                                      SelectedIndex="{x:Bind ViewModel.Radar.PastEventDurationIndex, Mode=TwoWay}"
                                      ToolTipService.ToolTip="How much of the day to replay, starting at the time above"/>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Height="1" Margin="0,2"
                Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>

        <!-- ===================== Historical SPC outlook for the replay date ===================== -->
        <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="10" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Day + Cycle -->
                <RowDefinition Height="Auto"/> <!-- Product -->
                <RowDefinition Height="Auto"/> <!-- Opacity -->
                <RowDefinition Height="Auto"/> <!-- status -->
                <RowDefinition Height="Auto"/> <!-- issued/valid times -->
            </Grid.RowDefinitions>

            <!-- Day + issuance Cycle, side by side. -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Outlook" Style="{StaticResource SettingsFieldLabelStyle}"/>
            <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="8" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Width="90"
                          ItemsSource="{x:Bind ViewModel.PastOutlook.Days}"
                          DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.PastOutlook.SelectedDayOption, Mode=TwoWay}"
                          ToolTipService.ToolTip="Outlook day (1-3) for the replay date"/>
                <TextBlock Grid.Column="1" Text="cycle" Style="{StaticResource SettingsFieldLabelStyle}"/>
                <ComboBox Grid.Column="2" Width="86"
                          ItemsSource="{x:Bind ViewModel.PastOutlook.CycleOptions, Mode=OneWay}"
                          DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.PastOutlook.SelectedCycleOption, Mode=TwoWay}"
                          ToolTipService.ToolTip="SPC issuance cycle (UTC); Auto picks the one in effect at the replay time"/>
            </Grid>

            <!-- Product (None + the day's products). -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Product" Style="{StaticResource SettingsFieldLabelStyle}"/>
            <ComboBox Grid.Row="1" Grid.Column="1"
                      Width="184" HorizontalAlignment="Left"
                      ItemsSource="{x:Bind ViewModel.PastOutlook.ProductOptions, Mode=OneWay}"
                      DisplayMemberPath="Label"
                      SelectedItem="{x:Bind ViewModel.PastOutlook.SelectedProductOption, Mode=TwoWay}"
                      ToolTipService.ToolTip="Historical outlook product (None clears the overlay)"/>

            <!-- Opacity: fill opacity (outlines stay solid). -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Opacity" Style="{StaticResource SettingsFieldLabelStyle}"/>
            <Slider Grid.Row="2" Grid.Column="1"
                    Width="184" HorizontalAlignment="Left"
                    Minimum="0" Maximum="1"
                    StepFrequency="0.05" SmallChange="0.05"
                    IsThumbToolTipEnabled="False"
                    VerticalAlignment="Center"
                    Value="{x:Bind ViewModel.PastOutlook.Opacity, Mode=TwoWay}"
                    ToolTipService.ToolTip="Outlook fill opacity (outlines stay solid)"/>

            <!-- Status line (loading / not-found / loaded). -->
            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{x:Bind ViewModel.PastOutlook.StatusText, Mode=OneWay}"
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- Issued / valid times, when available. -->
            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{x:Bind ViewModel.PastOutlook.TimesText, Mode=OneWay}"
                       Visibility="{x:Bind VisibleWhen(ViewModel.PastOutlook.HasTimes), Mode=OneWay}"
                       TextWrapping="Wrap" FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Grid>

        <Border Grid.Row="3" Height="1" Margin="0,2"
                Background="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
        <comp:StormReportsInput Grid.Row="4" ViewModel="{x:Bind ViewModel.StormReports, Mode=OneWay}"/>
    </Grid>
</UserControl>
