<?xml version="1.0" encoding="utf-8"?>
<!-- UnitsSettingsTab — the Settings window's "Units" tab: ONE place for every unit the app shows (user's call,
     2026-10-22, from a mock-up). Each picker writes a TOKEN to AppSettings; MapViewModel hands the set to
     Models/Map/UnitFormat (every C# readout) and the page (js/units.js) — so a change shows everywhere at once.

       ┌──────────────────────────────────────────────────────────┐
       │                                     [ Restore defaults ] │  ← ABOVE the sections (every reset is)
       │  Start from  [ US ] [ Metric ] [ Forecaster ]            │  ← presets set several pickers at once
       │  ⌄  Time                                                 │
       │    Clock      [ 12-hour | 24-hour ]                      │  ← 12-hour greyed while UTC (UTC is always "17:04Z")
       │    Time zone  [ Local | UTC ]                            │
       │    Shows as 5:04 PM · until 5:30 PM                      │  ← the sample line, in the chosen units
       │  ⌄  Distance                                             │
       │    [ Kilometers | Miles | Nautical miles ]               │  ← moved here from Radar → Readouts
       │  ⌄  Speed        [ kt | mph | km/h | m/s ]               │
       │  ⌄  Height       [ km | kft | ft ]                       │
       │  ⌄  Hail size    [ in | cm ]                             │
       └──────────────────────────────────────────────────────────┘

     ⚠️ No temperature / rainfall row: nothing in the app shows either yet (the HRRR fields are reflectivity and
     helicity). Add the row with the first field that draws one.
     ⚠️ Section open/closed persists under "settings/units/…" (SettingsWindow.Persist). -->
<UserControl x:Class="Anvil.Controls.Composites.UnitsSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- The "Shows as …" line under a picker. -->
        <Style x:Key="UnitSampleTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,2,0,0"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="8" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- presets + restore -->
            <RowDefinition Height="Auto"/> <!-- Time -->
            <RowDefinition Height="Auto"/> <!-- Distance -->
            <RowDefinition Height="Auto"/> <!-- Speed -->
            <RowDefinition Height="Auto"/> <!-- Height -->
            <RowDefinition Height="Auto"/> <!-- Hail size -->
        </Grid.RowDefinitions>

        <!-- PRESETS + RESTORE, above the sections. A preset is an action, not a kept selection — plain buttons. -->
        <Grid Grid.Row="0" ColumnSpacing="6" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Start from" VerticalAlignment="Center" Opacity="0.75" Margin="4,0,4,0"/>
            <Button x:Name="UnitsPresetUsButton" Grid.Row="1" Grid.Column="1" Content="US" Click="OnPresetUs"
                    ToolTipService.ToolTip="12-hour local time, miles, mph, kft, inches"/>
            <Button x:Name="UnitsPresetMetricButton" Grid.Row="1" Grid.Column="2" Content="Metric" Click="OnPresetMetric"
                    ToolTipService.ToolTip="24-hour local time, kilometres, km/h, km, centimetres"/>
            <Button x:Name="UnitsPresetForecasterButton" Grid.Row="1" Grid.Column="3" Content="Forecaster" Click="OnPresetForecaster"
                    ToolTipService.ToolTip="UTC (Z) time, nautical miles, knots, kft, inches — as in SPC / NWS products"/>
            <Button x:Name="UnitsRestoreDefaultsButton" Grid.Row="0" Grid.ColumnSpan="5" HorizontalAlignment="Right" Content="Restore defaults"
                    Click="{x:Bind ViewModel.ResetUnits}"
                    ToolTipService.ToolTip="12-hour local time, kilometres, mph, kft, inches"/>
        </Grid>

        <prim:SettingsExpander Grid.Row="1" Header="Time" IsExpanded="True">
            <Grid RowSpacing="6" ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Margin="4,0,0,0" VerticalAlignment="Center" Text="Clock"/>
                <prim:SegmentedPicker Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="200"
                                      ItemsSource="{x:Bind ViewModel.ClockFormatLabels}"
                                      DisabledIndex="{x:Bind ViewModel.ClockFormatDisabledIndex, Mode=OneWay}"
                                      SelectedIndex="{x:Bind ViewModel.ClockFormatIndex, Mode=TwoWay}"/>
                <TextBlock Grid.Row="1" Margin="4,0,0,0" VerticalAlignment="Center" Text="Time zone"/>
                <prim:SegmentedPicker Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Width="200"
                                      ItemsSource="{x:Bind ViewModel.TimeZoneLabels}"
                                      SelectedIndex="{x:Bind ViewModel.TimeZoneIndex, Mode=TwoWay}"/>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource UnitSampleTextStyle}"
                           Text="{x:Bind ViewModel.ClockSample, Mode=OneWay}"/>
            </Grid>
        </prim:SettingsExpander>

        <prim:SettingsExpander Grid.Row="2" Header="Distance" IsExpanded="True">
            <StackPanel Spacing="2">
                <prim:SegmentedPicker HorizontalAlignment="Left" Width="300" Margin="4,0,0,0"
                                      ItemsSource="{x:Bind ViewModel.DistanceUnitLabels}"
                                      SelectedIndex="{x:Bind ViewModel.DistanceUnitIndex, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource UnitSampleTextStyle}" Text="{x:Bind ViewModel.DistanceSample, Mode=OneWay}"/>
            </StackPanel>
        </prim:SettingsExpander>

        <prim:SettingsExpander Grid.Row="3" Header="Speed" IsExpanded="True">
            <StackPanel Spacing="2">
                <prim:SegmentedPicker HorizontalAlignment="Left" Width="280" Margin="4,0,0,0"
                                      ItemsSource="{x:Bind ViewModel.SpeedUnitLabels}"
                                      SelectedIndex="{x:Bind ViewModel.SpeedUnitIndex, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource UnitSampleTextStyle}" Text="{x:Bind ViewModel.SpeedSample, Mode=OneWay}"/>
            </StackPanel>
        </prim:SettingsExpander>

        <prim:SettingsExpander Grid.Row="4" Header="Height" IsExpanded="True">
            <StackPanel Spacing="2">
                <prim:SegmentedPicker HorizontalAlignment="Left" Width="210" Margin="4,0,0,0"
                                      ItemsSource="{x:Bind ViewModel.HeightUnitLabels}"
                                      SelectedIndex="{x:Bind ViewModel.HeightUnitIndex, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource UnitSampleTextStyle}" Text="{x:Bind ViewModel.HeightSample, Mode=OneWay}"/>
            </StackPanel>
        </prim:SettingsExpander>

        <prim:SettingsExpander Grid.Row="5" Header="Hail size" IsExpanded="True">
            <StackPanel Spacing="2">
                <prim:SegmentedPicker HorizontalAlignment="Left" Width="140" Margin="4,0,0,0"
                                      ItemsSource="{x:Bind ViewModel.HailUnitLabels}"
                                      SelectedIndex="{x:Bind ViewModel.HailUnitIndex, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource UnitSampleTextStyle}" Text="{x:Bind ViewModel.HailSample, Mode=OneWay}"/>
            </StackPanel>
        </prim:SettingsExpander>
    </Grid>
</UserControl>
