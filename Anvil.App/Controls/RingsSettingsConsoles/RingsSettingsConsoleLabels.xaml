<?xml version="1.0" encoding="utf-8"?>
<!-- RingsSettingsConsoleLabels — Settings → Rings & Ruler's "Distance labels" section ("100 mi", "200 mi"…), on a
     Primitives/SettingsConsolePlate. Text has a font, size and halo, not a line pattern — so its own rows, not a ring card.

       Distance labels  [Restore defaults]                                                         DEFAULT
       Color        (A)(■)…(+)                                A = the distance rings' color         Rings'
       Opacity      ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━●  100%                                         100%
       Font         [ Regular | Medium | Italic ]                                                 Medium
       Size         ━━━●━━━━━━━━━━━━━━━━━━━━━━━━━━━  10 px                                          10 px
       Spacing      ●━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━  0.00 em  Space between the letters          0.00 em
       Halo         ━━━━━━●━━━━━━━━━━━━━━━━━━━━━━━━━  1.2 px  Keeps it readable over returns       1.2 px
       Halo color   (A)(■)…(+)                                A = the theme's dark casing           Theme
       Placement    [ Above | On the ring | Below ]            Where each label sits on its ring    Above
       Lines        [ 1 | 2 | 4 ]                             How many lines of labels run out…        1
       Position     ●━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━  000°     Or drag the knob on the ring   000° (North)
                    ☑ Show the unit                           100 mi, not 100                         On
                    ☑ Show the drag knob on the map           Hide it once the labels are placed      On
       96           420 (slider * · value 56)                 hint (one line)                  150, right

     ⚠️ Every row is a Primitives/SettingsConsoleRow (lifts; words = Services/Settings/SettingsText by AboutKey); checkboxes sit
     in the Control column. Every CONTROL greys while the distance rings are off (not the rows — a greyed row
     can still be picked to read its About); the Color row's hint then says what turns it on. The old "North" button is gone: Restore defaults
     covers it. ⚠️ The map's label knob writes Position too (RangeRingsViewModel.OnLabelBearingDragged, no echo). -->
<UserControl x:Class="Anvil.Controls.RingsSettingsConsoles.RingsSettingsConsoleLabels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="using:Anvil.Controls.Primitives"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <prim:SettingsConsolePlate x:Name="RingsSettingsConsoleLabelsPlate" Title="Distance labels" ShowDefaultHeader="True">
        <prim:SettingsConsolePlate.HeaderContent>
            <Button x:Name="LabelsRestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaults"
                    IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}"
                    ToolTipService.ToolTip="Put the distance labels back to the DEFAULT column (asks first)"/>
        </prim:SettingsConsolePlate.HeaderContent>

            <StackPanel Style="{StaticResource SettingsConsoleRowsStyle}">
                <prim:SettingsConsoleRow Label="Color" AboutKey="labels.color"
                                         Hint="{x:Bind LockedOr(ViewModel.Radar.RangeRings.ShowDistanceRings, 'labels.color'), Mode=OneWay}"
                                         Default="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelColorText}">
                    <prim:ColorSwatchPicker x:Name="LabelColorPicker" HorizontalAlignment="Left" AllowCustom="True"
                                            IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}"
                                            ItemsSource="{x:Bind ViewModel.Radar.RangeRings.LabelColorSwatches}"
                                            ToolTips="{x:Bind ViewModel.Radar.RangeRings.LabelColorNames}"
                                            SelectedIndex="{x:Bind ViewModel.Radar.RangeRings.LabelColorIndex, Mode=TwoWay}"
                                            CustomHex="{x:Bind ViewModel.Radar.RangeRings.LabelColorHex, Mode=TwoWay}"/>
                </prim:SettingsConsoleRow>

                <prim:SettingsConsoleRow Label="Opacity" AboutKey="labels.opacity" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelOpacityText}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                        <Slider x:Name="LabelOpacitySlider" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}" Minimum="5" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10"
                                IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.Radar.RangeRings.LabelOpacity, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                                   Text="{x:Bind Pct(ViewModel.Radar.RangeRings.LabelOpacity), Mode=OneWay}"/>
                    </Grid>
                </prim:SettingsConsoleRow>

                <!-- Only the three stacks the bundled glyph host serves; any other renders nothing. -->
                <prim:SettingsConsoleRow Label="Font" AboutKey="labels.font" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelFontText}">
                    <prim:SegmentedPicker x:Name="LabelFontPicker" IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}"
                                          ItemsSource="{x:Bind ViewModel.Radar.RangeRings.LabelFontLabels}"
                                          SelectedIndex="{x:Bind ViewModel.Radar.RangeRings.LabelFontIndex, Mode=TwoWay}"/>
                </prim:SettingsConsoleRow>

                <prim:SettingsConsoleRow Label="Size" AboutKey="labels.size" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelSizeText}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                        <Slider x:Name="LabelSizeSlider" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}" Minimum="8" Maximum="24" StepFrequency="1" SmallChange="1" LargeChange="2"
                                IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.Radar.RangeRings.LabelSize, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                                   Text="{x:Bind Px0(ViewModel.Radar.RangeRings.LabelSize), Mode=OneWay}"/>
                    </Grid>
                </prim:SettingsConsoleRow>

                <prim:SettingsConsoleRow Label="Spacing" AboutKey="labels.spacing" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelSpacingText}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                        <Slider x:Name="LabelSpacingSlider" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}" Minimum="0" Maximum="0.5" StepFrequency="0.01" SmallChange="0.01" LargeChange="0.05"
                                IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.Radar.RangeRings.LabelSpacing, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                                   Text="{x:Bind Em(ViewModel.Radar.RangeRings.LabelSpacing), Mode=OneWay}"/>
                    </Grid>
                </prim:SettingsConsoleRow>

                <prim:SettingsConsoleRow Label="Halo" AboutKey="labels.halo" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelHaloText}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                        <Slider x:Name="LabelHaloSlider" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}" Minimum="0" Maximum="4" StepFrequency="0.1" SmallChange="0.1" LargeChange="0.5"
                                IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.Radar.RangeRings.LabelHalo, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                                   Text="{x:Bind Px(ViewModel.Radar.RangeRings.LabelHalo), Mode=OneWay}"/>
                    </Grid>
                </prim:SettingsConsoleRow>

                <prim:SettingsConsoleRow Label="Halo color" AboutKey="labels.haloColor" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultHaloColorText}">
                    <prim:ColorSwatchPicker x:Name="HaloColorPicker" HorizontalAlignment="Left" AllowCustom="True"
                                            IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}"
                                            ItemsSource="{x:Bind ViewModel.Radar.RangeRings.HaloColorSwatches}"
                                            ToolTips="{x:Bind ViewModel.Radar.RangeRings.HaloColorNames}"
                                            SelectedIndex="{x:Bind ViewModel.Radar.RangeRings.HaloColorIndex, Mode=TwoWay}"
                                            CustomHex="{x:Bind ViewModel.Radar.RangeRings.HaloColorHex, Mode=TwoWay}"/>
                </prim:SettingsConsoleRow>

                <prim:SettingsConsoleRow Label="Placement" AboutKey="labels.placement" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultPlacementText}">
                    <prim:SegmentedPicker x:Name="LabelPlacementPicker" IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}"
                                          ItemsSource="{x:Bind ViewModel.Radar.RangeRings.LabelPlacementLabels}"
                                          SelectedIndex="{x:Bind ViewModel.Radar.RangeRings.LabelPlacementIndex, Mode=TwoWay}"/>
                </prim:SettingsConsoleRow>

                <prim:SettingsConsoleRow Label="Lines" AboutKey="labels.lines" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelLinesText}">
                    <prim:SegmentedPicker x:Name="LabelLinesPicker" IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}"
                                          ItemsSource="{x:Bind ViewModel.Radar.RangeRings.LabelAxesLabels}"
                                          SelectedIndex="{x:Bind ViewModel.Radar.RangeRings.LabelAxesIndex, Mode=TwoWay}"/>
                </prim:SettingsConsoleRow>

                <prim:SettingsConsoleRow Label="Position" AboutKey="labels.position" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelBearingText}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                        <Slider x:Name="LabelPositionSlider" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}" Minimum="0" Maximum="359" StepFrequency="1" SmallChange="1" LargeChange="15"
                                IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.Radar.RangeRings.LabelBearing, Mode=TwoWay}"
                                ToolTipService.ToolTip="The bearing the labels sit on, clockwise from north"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TabularNumberTextStyle}"
                                   Text="{x:Bind Deg(ViewModel.Radar.RangeRings.LabelBearing), Mode=OneWay}"/>
                    </Grid>
                </prim:SettingsConsoleRow>

                <prim:SettingsConsoleRow AboutKey="labels.showUnit" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultShowUnitsText}">
                    <CheckBox x:Name="LabelShowUnitsCheckBox" VerticalAlignment="Center" Content="Show the unit"
                              IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}"
                              IsChecked="{x:Bind ViewModel.Radar.RangeRings.LabelShowUnits, Mode=TwoWay}"/>
                </prim:SettingsConsoleRow>

                <prim:SettingsConsoleRow AboutKey="labels.knob" Default="{x:Bind ViewModel.Radar.RangeRings.DefaultLabelHandleText}">
                    <CheckBox x:Name="LabelKnobCheckBox" VerticalAlignment="Center" Content="Show the drag knob on the map"
                              IsEnabled="{x:Bind ViewModel.Radar.RangeRings.ShowDistanceRings, Mode=OneWay}"
                              IsChecked="{x:Bind ViewModel.Radar.RangeRings.ShowLabelHandle, Mode=TwoWay}"
                              ToolTipService.ToolTip="The knob on the outer range ring. Drag it around to move every label; hide it once they're where you want them"/>
                </prim:SettingsConsoleRow>
            </StackPanel>
    </prim:SettingsConsolePlate>
</UserControl>
