<?xml version="1.0" encoding="utf-8"?>
<!-- SettingsExpander — ONE section of a Settings tab: a 28 px header over a collapsible body. It never
     re-orders and carries no layer controls — the temporal windows' draggable map layers are
     TemporalWindows/DragMoveLayerExpander. Both read Styles.xaml SectionHeaderHeight and the Section* brushes,
     so the two headers stay the same height and face.

      ┌──────────────────────────────────────────────────────────────┐
      │ ›  Readouts                                                  │  ← 28 px header, raised face
      ├──────────────────────────────────────────────────────────────┤
      │   …Body…                                                     │  ← body on the window's ground
      └──────────────────────────────────────────────────────────────┘
        │  └ title, fills the rest
        └ chevron: expand / collapse (hidden when there is no Body; the column stays)

     ⚠️ ONE GRID, EVERY CELL VerticalAlignment=Center; no cell carries a vertical margin or a minimum height.
     ⚠️ Clicking anywhere on the header toggles (the chevron included).
     ⚠️ Header brushes are {ThemeResource} in VISUAL STATES (Normal / PointerOver), never resolved in code.
     ⚠️ LAZY BODY: a never-opened section's body is NOT in the live tree (it attaches on the first expand and
     stays). Code that needs a body's elements loaded must expand it first. -->

<UserControl x:Class="Anvil.Controls.Primitives.SettingsExpander"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch"
             IsTabStop="False">

    <Border x:Name="Frame"
            CornerRadius="4" BorderThickness="1"
            BorderBrush="{ThemeResource SectionBorderBrush}"
            Background="{ThemeResource SectionBodyBackground}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeaderStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="HeaderRow.Background" Value="{ThemeResource SectionHeaderPointerOverBackground}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- header -->
                <RowDefinition Height="Auto"/> <!-- body -->
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderRow" Grid.Row="0"
                  Height="{StaticResource SectionHeaderHeight}"
                  Padding="6,0,10,0"
                  CornerRadius="{x:Bind HeaderCorners(IsExpanded, Body), Mode=OneWay}"
                  Background="{ThemeResource SectionHeaderBackground}"
                  PointerEntered="OnHeaderPointerEntered"
                  PointerExited="OnHeaderPointerExited"
                  Tapped="OnHeaderTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/> <!-- chevron -->
                    <ColumnDefinition Width="*"/>  <!-- title -->
                </Grid.ColumnDefinitions>

                <Button x:Name="ChevronButton" Grid.Column="0"
                        Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" CornerRadius="4"
                        Visibility="{x:Bind ChevronVisibility(Body), Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ChevronName(Header, IsExpanded), Mode=OneWay}"
                        Click="OnChevronClick">
                    <FontIcon Glyph="&#xE76C;" FontSize="10"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="{x:Bind ChevronAngle(IsExpanded), Mode=OneWay}"/>
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{x:Bind Header, Mode=OneWay}"
                           FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Opacity="{x:Bind DimUnless(IsEnabled), Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </Grid>

            <Border Grid.Row="1"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource SectionBorderBrush}"
                    Padding="12"
                    Visibility="{x:Bind BodyVisibility(IsExpanded, Body), Mode=OneWay}">
                <!-- ⚠️ Stretch: ContentPresenter's default style is Left/Top, which would shrink every card,
                     slider and combo in the body to its own width.
                     ⚠️ LAZY BODY: the body joins the live tree on the FIRST expand and stays (PresentedBody). -->

                <ContentPresenter Content="{x:Bind PresentedBody(IsExpanded, Body), Mode=OneWay}"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                  HorizontalContentAlignment="Stretch"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
