<!-- EdgeHatch — EDGE-HATCH (experimental bolt-on, grep EDGE-HATCH): a cross-hatch band where the chrome meets the map, in
     place of the black cast shadow. Click-through; drawn over the map.

       Direction = Up (above the bottom tiers)          Direction = Right (a left pane's map side; Left mirrors it)
       ╱╲  ╱╲      ╱    ╲      ╱╲          ╱╲           │╲╱╲╱ ╲╱  ╲
       ╱╲╱╲╱╲╱╲  ╱╲╱╲  ╱╲╱╲  ╱╲╱╲╱╲╱╲  ╱╲╱╲            │╱╲╱╲ ╱╲    ← the lines THIN out (1 in 2 stops at ¼, 1 in 4
       ╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱╲╱             │╲╱╲╱ ╲╱  ╲     at ½ …) and/or FADE toward the map
       ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀  ← edge   │╱╲╱╲ ╱╲
                                                       ↑ edge
       Dots = true (the dot-matrix pattern — the scrubber's language): a pitch grid, dithered thinner toward the map
       ·   ·     ·       ·   ·         ·     ·
       · · · ·  ·  · · ·  · · · ·  · ·  · · ·    ← ordered (Bayer 4×4) dither: density 1 at the edge → 0 at the band's
       ●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●     far side (Thin off = every cell); Spacing = pitch, Weight = dot size
       ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀  ← edge

     ⚠️ THE LINES ARE COMPUTED GEOMETRY — the one thing XAML can't declare (WinUI 3 has no tiling pattern brush): the
     Path below is DECLARED here; code-behind fills its Data from Models/Map/EdgeHatchGeometry (pure, tested) whenever the
     band's size or a setting changes — never per frame. The geometry is always laid out in the UP orientation (edge at
     the bottom) and turned by a RenderTransform for Right / Left, so ONE set of brushes fades the right way in all three.
     ⚠️ THE INK: Ink "" = the SURFACE colour — a VisualState (InkStates: ground / raised × fade / solid), because those
     are THEME colours (Styles.xaml OverlayBarSurface*Color + their clear twins) and a theme brush is never resolved in
     C#. Ink "#RRGGBB" = a CHOSEN colour (Settings → Edges' swatches, or "+"): the ChosenInk state (no setters) and a DATA
     brush made in code from the hex, as ColorSwatchPicker's chips are. LineOpacity = the user's line opacity; the
     canvas's Styles.xaml EdgeHatchOpacity is the themed strength (0 in high contrast). -->
<UserControl x:Class="Anvil.Controls.Primitives.EdgeHatch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsHitTestVisible="False"
             IsTabStop="False">

    <Canvas x:Name="EdgeHatchCanvas" Opacity="{ThemeResource EdgeHatchOpacity}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="InkStates">
                <VisualState x:Name="SurfaceFade">
                    <VisualState.Setters>
                        <Setter Target="EdgeHatchPath.Stroke">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Offset="0" Color="{ThemeResource OverlayBarSurfaceColor}"/>
                                    <GradientStop Offset="1" Color="{ThemeResource OverlayBarSurfaceClearColor}"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SurfaceSolid">
                    <VisualState.Setters>
                        <Setter Target="EdgeHatchPath.Stroke" Value="{ThemeResource OverlayBarSurfaceBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RaisedFade">
                    <VisualState.Setters>
                        <Setter Target="EdgeHatchPath.Stroke">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Offset="0" Color="{ThemeResource OverlayBarSurfaceRaisedColor}"/>
                                    <GradientStop Offset="1" Color="{ThemeResource OverlayBarSurfaceRaisedClearColor}"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RaisedSolid">
                    <VisualState.Setters>
                        <Setter Target="EdgeHatchPath.Stroke" Value="{ThemeResource OverlayBarSurfaceRaisedBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- A CHOSEN colour (Ink = #RRGGBB): no setter — the code-behind sets the Path's own Stroke to a DATA brush
                     made from that hex (solid, or fading to its clear twin), the ColorSwatchPicker rule. -->
                <VisualState x:Name="ChosenInk"/>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Data + RenderTransform set in code (computed geometry — see the header). -->
        <!-- Dots = near-zero-length segments with ROUND caps, so each is a dot Weight across (same Path, same brushes). -->
        <Path x:Name="EdgeHatchPath" StrokeThickness="{x:Bind Weight, Mode=OneWay}" Opacity="{x:Bind LineOpacity, Mode=OneWay}"
              StrokeStartLineCap="{x:Bind Cap(Dots), Mode=OneWay}" StrokeEndLineCap="{x:Bind Cap(Dots), Mode=OneWay}"/>
    </Canvas>
</UserControl>
