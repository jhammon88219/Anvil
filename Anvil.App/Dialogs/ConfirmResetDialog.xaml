<?xml version="1.0" encoding="utf-8"?>
<!-- ConfirmResetDialog — asked before ANY Settings reset: a section's Restore defaults, and a page's "Reset all …".

       ┌─ Reset all General settings? ───────────────────────┐
       │  Startup, Units and Window go back to their         │  ← body (the caller's words)
       │  defaults — the DEFAULT column on this page. Your   │
       │  home site is cleared. This can't be undone.        │
       │                [ Reset ]          ( Cancel )        │  Reset = caution amber; CANCEL is default
       └─────────────────────────────────────────────────────┘

     ⚠️ DefaultButton is Close (Cancel), so Enter never resets anything.
     ⚠️ The caller writes the title + body (it knows what its reset touches); the dialog assembles no words of its own. -->
<ContentDialog x:Class="Anvil.Dialogs.ConfirmResetDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d"
               PrimaryButtonText="Reset"
               CloseButtonText="Cancel"
               DefaultButton="Close">

    <!-- The reset key wears the CAUTION amber (Styles.xaml SettingsCaution*), like the page's Reset all. Only the resting look
         is re-coloured (a Style can't reach the template's hover/pressed keys). -->
    <ContentDialog.PrimaryButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SettingsCautionForegroundBrush}"/>
            <Setter Property="Background" Value="{ThemeResource SettingsCautionBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource SettingsCautionBorderBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </ContentDialog.PrimaryButtonStyle>

    <TextBlock x:Name="BodyText" TextWrapping="Wrap" MaxWidth="420"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
</ContentDialog>
